---
// src/layouts/RentalLayout.astro
// Layout reutilizable para páginas de rental/arriendos (v2 — con slots)

import BaseLayout from './BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import Icon from '@/components/ui/Icon.astro';
import CTABand from '@/components/ui/CTABand.astro';
import EquipmentCatalog from '@/components/rental/EquipmentCatalog.astro';
import edificio from '@/assets/imgs/edificio.jpg';
import type { Equipment } from '@/data/rental';

export interface Props {
  // Existentes (sin cambios)
  title: string;
  subtitle: string;
  description: string;
  heroImage: string;
  heroImageAlt: string;
  category: string;
  features: string[];
  breadcrumbs: Array<{ label: string; url: string }>;
  whatsappMessage: string;
  catalogUrl?: string;
  catalogLabel?: string;

  // Nuevas (todas opcionales)
  showRelated?: boolean;
  showFaq?: boolean;
  catalogItems?: Equipment[];
  catalogColumns?: 2 | 3 | 4;
  relatedItems?: Array<{ name: string; href: string; shortDesc: string; badge?: string }>;
  faqItems?: Array<{ question: string; answer: string }>;
  jsonLd?: any;
}

const {
  title,
  subtitle,
  description,
  heroImage,
  heroImageAlt,
  category,
  features,
  breadcrumbs,
  whatsappMessage,
  catalogUrl = '/catalogo.pdf',
  catalogLabel = 'Descargar catálogo',
  showRelated = false,
  showFaq = false,
  catalogItems,
  catalogColumns = 3,
  relatedItems,
  faqItems,
} = Astro.props;

const hasHeroSlot = Astro.slots.has('hero');
const hasCatalogSlot = Astro.slots.has('catalog');
const hasStatsSlot = Astro.slots.has('stats');
const hasRelatedSlot = Astro.slots.has('related');
const hasFaqSlot = Astro.slots.has('faq');
---

<BaseLayout
  title={title}
  description={description}
  breadcrumbs={breadcrumbs}
>
  <!-- Hero de subcategoría (slot) -->
  {hasHeroSlot && <slot name="hero" />}

  <!-- Catálogo (slot o prop) -->
  {hasCatalogSlot ? (
    <slot name="catalog" />
  ) : catalogItems && catalogItems.length > 0 ? (
    <EquipmentCatalog items={catalogItems} columns={catalogColumns} background="dark" />
  ) : null}

  <!-- Specs/stats (slot) — antes "Especificaciones técnicas", ahora un StatsCounter -->
  {hasStatsSlot && (
    <section class="rental-slot-section rental-slot-section--dark">
      <slot name="stats" />
    </section>
  )}

  <!-- Related (slot o prop) -->
  {(hasRelatedSlot || (showRelated && relatedItems && relatedItems.length > 0)) && (
    <section class="rental-slot-section rental-slot-section--dark">
      {hasRelatedSlot ? <slot name="related" /> : null}
    </section>
  )}

  <!-- FAQ (slot o prop) -->
  {(hasFaqSlot || (showFaq && faqItems && faqItems.length > 0)) && (
    <section class="rental-slot-section rental-slot-section--light">
      {hasFaqSlot ? <slot name="faq" /> : null}
    </section>
  )}

  <!-- CTA de cotización -->
  <div id="cotizar">
  <CTABand
    eyebrow="¿Necesitas equipos para tu faena?"
    title="Arrienda con nosotros"
    subtitle="Contamos con operadores certificados y disponibilidad 24/7 para tu proyecto."
    backgroundImage={edificio.src}
    backgroundAlt="Edificio corporativo de IP Proyectos Industriales en Chile"
    backgroundWidth={edificio.width}
    backgroundHeight={edificio.height}
    buttons={[
      { label: 'Ir al cotizador', href: '/cotizador', variant: 'primary', icon: 'arrow-right', ariaLabel: 'Ir al cotizador en línea' },
      { label: 'Hablar por WhatsApp', href: 'https://wa.me/56956594144?text=Hola%20IP%20Proyectos%20Industriales%2C%20quisiera%20solicitar%20una%20cotizaci%C3%B3n.', variant: 'outline', external: true, icon: 'whatsapp' },
    ]}
    contentAlign="center"
    minHeight="md"
  />
  </div>
  <!--       eyebrow="¿Necesitas equipos para tu faena?"
        title="Arrienda con nosotros"
        subtitle="Contamos con operadores certificados y disponibilidad 24/7 para tu proyecto." -->
</BaseLayout>

<style>
  /* Slots sections */
  .rental-slot-section {
    /**padding-block: clamp(48px, 6vw, 80px);**/
  }

  .rental-slot-section--light {
    background-color: var(--theme-bg-alt);
    color: var(--theme-text);
  }

  .rental-slot-section--dark {
    background-color: var(--theme-bg);
    color: var(--theme-text);
  }
</style>
