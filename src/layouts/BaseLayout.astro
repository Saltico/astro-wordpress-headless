---
// src/layouts/BaseLayout.astro
import '@/styles/base.css';
import type { NavItem } from '@/types/navigation';
import type { FooterColumn, FooterLink } from '@/types/layout';
import type { BaseLayoutProps } from '@/types/layout';
import SkipLink from '@/components/layout/SkipLink.astro';
import TopBar from '@/components/layout/TopBar.astro';
import Header from '@/components/layout/Header.astro';
import Navigation from '@/components/layout/Navigation.astro';
import Footer from '@/components/layout/Footer.astro';

export interface Props extends BaseLayoutProps {
  topBar?: {
    phone?: string;
    email?: string;
    integrityUrl?: string;
    newsUrl?: string;
  };
  navigation?: {
    items: NavItem[];
    ariaLabel?: string;
  };
  footer?: {
    columns: FooterColumn[];
    legal: FooterLink[];
    brand: string;
    description?: string;
    phone?: string;
    email?: string;
  };
}

const {
  title,
  description,
  canonical,
  showTopBar = true,
  showHeader = true,
  showFooter = true,
  topBar,
  navigation,
  footer,
} = Astro.props;

const defaultNavItems: NavItem[] = [
  { label: 'Nosotros', url: '/nosotros' },
  {
    label: 'Servicios Industriales',
    url: '/servicios-industriales',
    children: [
      { label: 'Montaje Industrial', url: '/servicios-industriales/montaje-industrial' },
      { label: 'Obras Civiles', url: '/servicios-industriales/obras-civiles' },
    ],
  },
  {
    label: 'Arriendo e Izaje',
    url: '/arriendo-maquinaria',
    children: [
      { label: 'Grúas Alto Tonelaje', url: '/arriendo-maquinaria/gruas-alto-tonelaje' },
      { label: 'Equipos de Izaje', url: '/arriendo-maquinaria/equipos-de-izaje' },
    ],
  },
  { label: 'Proyectos', url: '/proyectos' },
];

const defaultFooterColumns: FooterColumn[] = [
  {
    title: 'Servicios Industriales',
    links: [
      { label: 'Montaje Industrial', url: '/servicios-industriales/montaje-industrial' },
      { label: 'Obras Civiles', url: '/servicios-industriales/obras-civiles' },
    ],
  },
  {
    title: 'Arriendo e Izaje',
    links: [
      { label: 'Grúas Alto Tonelaje', url: '/arriendo-maquinaria/gruas-alto-tonelaje' },
      { label: 'Equipos de Izaje', url: '/arriendo-maquinaria/equipos-de-izaje' },
    ],
  },
  {
    title: 'Compliance',
    links: [
      { label: 'HSEQ', url: '/compliance/hseq' },
      { label: 'Certificaciones', url: '/compliance/certificaciones' },
    ],
  },
  {
    title: 'Empresa',
    links: [
      { label: 'Nosotros', url: '/nosotros' },
      { label: 'Noticias', url: '/noticias' },
      { label: 'Contacto', url: '/contacto' },
    ],
  },
];

const defaultLegalLinks: FooterLink[] = [
  { label: 'Aviso Legal', url: '/aviso-legal' },
  { label: 'Política de Privacidad', url: '/privacidad' },
  { label: 'Cookies', url: '/cookies' },
];

const navItems = navigation?.items ?? defaultNavItems;
const footerColumns = footer?.columns ?? defaultFooterColumns;
const footerLegal = footer?.legal ?? defaultLegalLinks;
const footerBrand = footer?.brand ?? 'IP Proyectos Industriales';
const footerDescription =
  footer?.description ??
  'Especialistas en obras civiles, montaje industrial y arriendo de maquinaria de alto tonelaje para la gran minería.';
const footerPhone = footer?.phone ?? topBar?.phone ?? '+56 9 0000 0000';
const footerEmail = footer?.email ?? topBar?.email ?? 'contacto@ipproyectosindustriales.cl';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    {canonical && <link rel="canonical" href={canonical} />}
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <SkipLink targetId="main-content" />

    {showTopBar && <TopBar {...topBar} />}

    {
      showHeader && (
        <Header>
          <a href="/" slot="logo" class="header-logo">
            <span class="header-logo__text">IP Proyectos Industriales</span>
          </a>
          <Navigation slot="navigation" items={navItems} aria-label={navigation?.ariaLabel} />
          <a slot="cta" href="/contacto" class="header-cta">
            Solicitar cotización
          </a>
        </Header>
      )
    }

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    {
      showFooter && (
        <Footer
          columns={footerColumns}
          legal={footerLegal}
          brand={footerBrand}
          description={footerDescription}
          phone={footerPhone}
          email={footerEmail}
        />
      )
    }
  </body>
</html>

<style>
  .header-logo {
    display: inline-block;
    text-decoration: none;
  }

  .header-logo__text {
    display: block;
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-ink);
    line-height: 1.2;
  }

  @media (min-width: 768px) {
    .header-logo__text {
      font-size: 1.25rem;
    }
  }

  .header-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0.625rem 1.25rem;
    background-color: var(--color-brand);
    color: var(--color-on-brand);
    font-weight: 600;
    border-radius: var(--radius-sm);
    transition: background-color var(--motion-base) var(--ease-out),
      transform var(--motion-base) var(--ease-out);
  }

  .header-cta:hover,
  .header-cta:focus {
    background-color: var(--color-brand-600);
    transform: scale(1.02);
  }

  .header-cta:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
  }
</style>
