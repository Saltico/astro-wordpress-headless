---
// src/components/rental/PromoBanner.astro
// Banner promocional full-width con crossfade entre slides.
// Edge case: 1 slide = banner estático, sin dots ni autoplay.

import type { BannerSlide } from '@/data/promotions';
import Icon from '@/components/ui/Icon.astro';

export interface Props {
  slides: BannerSlide[];
  /** Intervalo de autoplay en ms (default: 6000) */
  interval?: number;
}

const { slides, interval = 6000 } = Astro.props;

// Edge case: sin slides = no renderizar
const hasSlides = slides && slides.length > 0;
// Edge case: 1 slide = banner estático
const isStatic = slides.length === 1;
---

{hasSlides && (
  <section
    class="promo-banner"
    aria-roledescription={isStatic ? undefined : 'carousel'}
    aria-label={isStatic ? 'Promoción destacada' : 'Banner promocional de categorías'}
  >
    <div class="promo-banner__track">
      {slides.map((slide, index) => (
        <article
          class:list={['promo-banner__slide', { 'promo-banner__slide--active': index === 0 }]}
          aria-roledescription={isStatic ? undefined : 'slide'}
          aria-label={`Slide ${index + 1} de ${slides.length}`}
          aria-hidden={index !== 0 ? 'true' : 'false'}
        >
          {/* Imagen de fondo completa */}
          <div class="promo-banner__image-wrapper">
            <img
              src={slide.image}
              alt={slide.imageAlt}
              class="promo-banner__image"
              width="1200"
              height="675"
              loading={index === 0 ? 'eager' : 'lazy'}
              fetchpriority={index === 0 ? 'high' : undefined}
              decoding="async"
            />
          </div>

          {/* Overlay con gradiente difuminado desde la izquierda */}
          <div class="promo-banner__overlay" aria-hidden="true"></div>

          {/* Contenido (lado izquierdo sobre el overlay) */}
          <div class="promo-banner__content">
            <div class="promo-banner__text">
              <h2 class="promo-banner__title">{slide.title}</h2>
              <p class="promo-banner__subtitle">{slide.subtitle}</p>
              <a href={slide.ctaHref} class="promo-banner__cta">
                {slide.ctaLabel}
                <Icon name="arrow-right" size={18} />
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>

    {/* Dots: solo si hay más de 1 slide */}
    {!isStatic && (
      <div class="promo-banner__dots" role="tablist" aria-label="Navegación de slides">
        {slides.map((_, index) => (
          <button
            class:list={['promo-banner__dot', { 'promo-banner__dot--active': index === 0 }]}
            role="tab"
            aria-selected={index === 0 ? 'true' : 'false'}
            aria-label={`Ir al slide ${index + 1}`}
            data-slide={index}
            type="button"
          />
        ))}
      </div>
    )}
  </section>
)}

<style>
  /* ─────────────────────────────────────────────────────────────
      LAYOUT PRINCIPAL
      ───────────────────────────────────────────────────────────── */
  .promo-banner {
    position: relative;
    margin-top: calc(-1 * (var(--topbar-height, 40px) + var(--header-height, 80px)));
    height: calc(clamp(320px, 40vw, 350px) + var(--topbar-height, 40px) + var(--header-height, 80px));
    width: 100%;
    overflow: hidden;
    background-color: var(--color-graphite, #0d1611);
  }

  /* ─────────────────────────────────────────────────────────────
      TRACK (contenedor de slides)
      ───────────────────────────────────────────────────────────── */
  .promo-banner__track {
    position: relative;
    width: 100%;
    height: 100%;
  }

  /* ─────────────────────────────────────────────────────────────
      SLIDE
      ───────────────────────────────────────────────────────────── */
  .promo-banner__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.7s var(--ease-out, ease), visibility 0.7s var(--ease-out, ease);
    z-index: 1;
  }

  .promo-banner__slide--active {
    opacity: 1;
    visibility: visible;
    z-index: 2;
  }

  /* ─────────────────────────────────────────────────────────────
      IMAGEN (fondo completo)
      ───────────────────────────────────────────────────────────── */
  .promo-banner__image-wrapper {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .promo-banner__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* ─────────────────────────────────────────────────────────────
      OVERLAY — gradiente desde la IZQUIERDA (sólido → transparente)
      ───────────────────────────────────────────────────────────── */
  .promo-banner__overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        90deg,
        rgba(13, 22, 17, 1) 0%,
        rgba(13, 22, 17, 0.97) 18%,
        rgba(13, 22, 17, 0.88) 30%,
        rgba(13, 22, 17, 0.62) 44%,
        rgba(13, 22, 17, 0.28) 58%,
        rgba(13, 22, 17, 0.08) 72%,
        rgba(13, 22, 17, 0) 85%
      );
    z-index: 1;
  }

  /* ─────────────────────────────────────────────────────────────
      CONTENT WRAPPER — centra el texto con max-width
      ───────────────────────────────────────────────────────────── */
  .promo-banner__content {
    position: relative;
    width: 100%;
    height: 100%;
    max-width: var(--container-max-width, 1536px);
    margin-inline: auto;
    z-index: 2;
  }

  /* ─────────────────────────────────────────────────────────────
      TEXTO (lado izquierdo sobre el overlay)
      ───────────────────────────────────────────────────────────── */
  .promo-banner__text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 20px;
    padding-top: calc(var(--topbar-height, 40px) + var(--header-height, 80px) + 16px);
    padding-bottom: clamp(24px, 3vw, 40px);
    padding-inline: clamp(24px, 4vw, 64px);
    height: 100%;
    max-width: 52%;
  }

  .promo-banner__title {
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: clamp(1.85rem, 3.6vw, 3.1rem);
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: var(--color-on-dark, #f3f7f4);
    margin: 0;
    text-wrap: balance;
  }

  .promo-banner__subtitle {
    font-family: var(--font-body);
    font-size: clamp(0.95rem, 1.2vw, 1.125rem);
    font-weight: 400;
    line-height: 1.55;
    color: var(--color-on-dark-muted, #9bab9f);
    margin: 0;
    max-width: 44ch;
  }

  /* CTA: botón pill primary con presencia transaccional */
  .promo-banner__cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 4px;
    padding: 14px 30px;
    background-color: var(--color-brand, #308f40);
    color: #fff;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: 0.01em;
    border-radius: 999px;
    text-decoration: none;
    box-shadow: 0 4px 16px rgba(48, 143, 64, 0.3);
    transition:
      background-color 0.2s ease,
      transform 0.2s ease,
      box-shadow 0.2s ease,
      gap 0.2s ease;
    width: fit-content;
  }

  .promo-banner__cta:hover {
    background-color: var(--color-brand-600, #226f31);
    transform: translateY(-2px);
    box-shadow: 0 6px 24px rgba(48, 143, 64, 0.4);
    gap: 14px;
  }

  .promo-banner__cta:active {
    transform: translateY(0) scale(0.99);
    box-shadow: 0 2px 8px rgba(48, 143, 64, 0.25);
  }

  .promo-banner__cta:focus-visible {
    outline: 2px solid var(--color-brand, #308f40);
    outline-offset: 3px;
  }

  /* ─────────────────────────────────────────────────────────────
      DOTS (esquina inferior derecha del área de contenido)
      ───────────────────────────────────────────────────────────── */
  .promo-banner__dots {
    position: absolute;
    bottom: 20px;
    left: clamp(24px, 4vw, 64px);
    display: flex;
    gap: 10px;
    align-items: center;
    z-index: 10;
    padding: 8px 14px;
    background: rgba(13, 22, 17, 0.5);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .promo-banner__dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    border: none;
    background-color: rgba(255, 255, 255, 0.35);
    cursor: pointer;
    padding: 0;
    transition: background-color 0.3s ease;
  }

  .promo-banner__dot:hover {
    background-color: rgba(255, 255, 255, 0.65);
  }

  .promo-banner__dot--active {
    background-color: var(--color-brand, #308f40);
    width: 24px;
  }

  .promo-banner__dot:focus-visible {
    outline: 2px solid var(--color-brand, #308f40);
    outline-offset: 2px;
  }

  /* ─────────────────────────────────────────────────────────────
      TABLET (768–1023px)
      ───────────────────────────────────────────────────────────── */
  @media (max-width: 1023px) {
    .promo-banner {
      height: calc(clamp(280px, 38vw, 400px) + var(--topbar-height, 40px) + var(--header-height, 80px));
    }

    .promo-banner__text {
      max-width: 58%;
      gap: 16px;
    }

    .promo-banner__title {
      font-size: clamp(1.6rem, 3.2vw, 2.4rem);
    }
  }

  /* ─────────────────────────────────────────────────────────────
      MOBILE (< 768px) — imagen como fondo, texto superpuesto
      ───────────────────────────────────────────────────────────── */
  @media (max-width: 767px) {
    .promo-banner {
      height: auto;
      min-height: clamp(420px, 72vh, 560px);
    }

    .promo-banner__slide {
      display: flex;
      flex-direction: column;
    }

    /* La imagen sigue siendo fondo absoluto */
    .promo-banner__image-wrapper {
      position: absolute;
      inset: 0;
    }

    .promo-banner__image {
      object-position: center 30%;
    }

    /* Overlay: ligero arriba para mostrar imagen, oscuro solo abajo donde va el texto */
    .promo-banner__overlay {
      background:
        linear-gradient(
          180deg,
          rgba(13, 22, 17, 0.15) 0%,
          rgba(13, 22, 17, 0.05) 30%,
          rgba(13, 22, 17, 0.1) 50%,
          rgba(13, 22, 17, 0.55) 72%,
          rgba(13, 22, 17, 0.88) 100%
        );
    }

    .promo-banner__content {
      position: relative;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      min-height: clamp(420px, 72vh, 560px);
    }

    .promo-banner__text {
      max-width: 100%;
      padding-top: calc(var(--topbar-height, 40px) + var(--header-height, 80px) + 32px);
      padding-bottom: clamp(60px, 10vw, 80px);
      padding-inline: clamp(20px, 5vw, 32px);
      gap: 14px;
      justify-content: flex-end;
    }

    .promo-banner__title {
      font-size: clamp(1.65rem, 6.5vw, 2.2rem);
      line-height: 1.1;
    }

    .promo-banner__subtitle {
      font-size: clamp(0.9rem, 3.2vw, 1rem);
      line-height: 1.5;
    }

    .promo-banner__cta {
      padding: 13px 26px;
      font-size: 0.9rem;
    }

    /* Dots: bottom center en mobile */
    .promo-banner__dots {
      bottom: 16px;
      left: 50%;
      transform: translateX(-50%);
    }
  }

  /* ─────────────────────────────────────────────────────────────
      REDUCED MOTION
      ───────────────────────────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .promo-banner__slide {
      transition: none;
    }

    .promo-banner__cta {
      transition: none;
    }
  }
</style>

<script>
  // ─────────────────────────────────────────────────────────────
  // PROMO BANNER: Autoplay + Dots + Keyboard + Swipe
  // Edge case: si hay 1 solo slide, no se ejecuta este script.
  // ─────────────────────────────────────────────────────────────
  function initPromoBanner() {
    const banner = document.querySelector<HTMLElement>('.promo-banner');
    if (!banner) return;

    const slides = banner.querySelectorAll<HTMLElement>('.promo-banner__slide');
    const dots = banner.querySelectorAll<HTMLButtonElement>('.promo-banner__dot');

    // Edge case: 0 o 1 slide = no hacer nada
    if (slides.length <= 1) return;

    const intervalAttr = banner.dataset.interval;
    const interval = intervalAttr ? parseInt(intervalAttr, 10) : 6000;
    let currentIndex = 0;
    let autoplayTimer: ReturnType<typeof setInterval> | null = null;
    let isPaused = false;

    // ── Navegación ──
    function goToSlide(index: number) {
      // Desactivar slide actual
      slides[currentIndex].classList.remove('promo-banner__slide--active');
      slides[currentIndex].setAttribute('aria-hidden', 'true');
      dots[currentIndex].classList.remove('promo-banner__dot--active');
      dots[currentIndex].setAttribute('aria-selected', 'false');

      // Activar nuevo slide
      currentIndex = (index + slides.length) % slides.length;
      slides[currentIndex].classList.add('promo-banner__slide--active');
      slides[currentIndex].setAttribute('aria-hidden', 'false');
      dots[currentIndex].classList.add('promo-banner__dot--active');
      dots[currentIndex].setAttribute('aria-selected', 'true');
    }

    function nextSlide() {
      goToSlide(currentIndex + 1);
    }

    function prevSlide() {
      goToSlide(currentIndex - 1);
    }

    // ── Autoplay ──
    function startAutoplay() {
      if (isPaused) return;
      stopAutoplay();
      autoplayTimer = setInterval(nextSlide, interval);
    }

    function stopAutoplay() {
      if (autoplayTimer) {
        clearInterval(autoplayTimer);
        autoplayTimer = null;
      }
    }

    // ── Pausa en hover/focus ──
    banner.addEventListener('mouseenter', () => {
      isPaused = true;
      stopAutoplay();
    });

    banner.addEventListener('mouseleave', () => {
      isPaused = false;
      startAutoplay();
    });

    banner.addEventListener('focusin', () => {
      isPaused = true;
      stopAutoplay();
    });

    banner.addEventListener('focusout', (e) => {
      // Solo reanudar si el focus sale completamente del banner
      if (!banner.contains(e.relatedTarget as Node)) {
        isPaused = false;
        startAutoplay();
      }
    });

    // ── Dots click ──
    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => {
        goToSlide(index);
        stopAutoplay();
        // Reiniciar autoplay después de 10s de inactividad
        setTimeout(startAutoplay, 10000);
      });
    });

    // ── Keyboard navigation ──
    banner.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        prevSlide();
        stopAutoplay();
        setTimeout(startAutoplay, 10000);
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        nextSlide();
        stopAutoplay();
        setTimeout(startAutoplay, 10000);
      }
    });

    // ── Touch swipe ──
    let touchStartX = 0;
    let touchEndX = 0;
    const SWIPE_THRESHOLD = 50;

    banner.addEventListener('touchstart', (e: TouchEvent) => {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });

    banner.addEventListener('touchend', (e: TouchEvent) => {
      touchEndX = e.changedTouches[0].screenX;
      const diff = touchStartX - touchEndX;

      if (Math.abs(diff) > SWIPE_THRESHOLD) {
        if (diff > 0) {
          nextSlide(); // Swipe izquierda = siguiente
        } else {
          prevSlide(); // Swipe derecha = anterior
        }
        stopAutoplay();
        // Pausa de 10s después del swipe
        setTimeout(startAutoplay, 10000);
      }
    }, { passive: true });

    // ── Reduced motion ──
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (!prefersReducedMotion.matches) {
      startAutoplay();
    }

    prefersReducedMotion.addEventListener('change', (e) => {
      if (e.matches) {
        stopAutoplay();
      } else {
        startAutoplay();
      }
    });
  }

  // Inicializar cuando el DOM esté listo
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPromoBanner);
  } else {
    initPromoBanner();
  }
</script>
