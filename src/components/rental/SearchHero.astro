---
// src/components/rental/SearchHero.astro
// Sección de búsqueda centrada: eyebrow + h1 + subtitle + EquipmentSearch.
// Fondo con video de arriendos + overlay oscuro para legibilidad.

import EquipmentSearch from '@/components/rental/EquipmentSearch.astro';
import arriendosVideo from '@/assets/videos/arriendos.mp4';

export interface Props {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  searchPlaceholder?: string;
}

const {
  eyebrow = 'Encuentra tu equipo',
  title = 'Arriendo de equipos y maquinaria para construcción y minería',
  subtitle = 'Grúas de hasta 400 toneladas, movimiento de tierra, transporte y equipos especiales. Disponibilidad 24/7 en Atacama, Coquimbo y Antofagasta.',
  searchPlaceholder = 'Grúa 100 toneladas...',
} = Astro.props;
---

<section class="search-hero">
  <video
    class="search-hero__video"
    src={arriendosVideo}
    muted
    loop
    playsinline
    preload="none"
    aria-hidden="true"
  />
  <div class="search-hero__overlay"></div>
  <div class="search-hero__container">
    {eyebrow && <p class="search-hero__eyebrow">{eyebrow}</p>}
    <h1 class="search-hero__title">{title}</h1>
    {subtitle && <p class="search-hero__subtitle">{subtitle}</p>}
    <div class="search-hero__search">
      <EquipmentSearch placeholder={searchPlaceholder} />
    </div>
  </div>
</section>

<style>
  .search-hero {
    position: relative;
    padding-block: clamp(40px, 6vw, 72px);
    background-color: var(--color-graphite-2, #15201a);
    overflow: hidden;
  }

  .search-hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .search-hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      180deg,
      rgba(13, 22, 17, 0.88) 0%,
      rgba(13, 22, 17, 0.82) 50%,
      rgba(13, 22, 17, 0.92) 100%
    );
  }

  /* Pausar video si el usuario prefiere menos movimiento */
  @media (prefers-reduced-motion: reduce) {
    .search-hero__video {
      display: none;
    }
  }

  .search-hero__container {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    max-width: var(--container-max-width, 1536px);
    margin-inline: auto;
    padding-inline: var(--container-padding, 20px);
    text-align: center;
  }

  .search-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-brand-300, #62bb74);
    margin: 0;
  }

  .search-hero__eyebrow::before {
    content: '';
    width: 42px;
    height: 2px;
    background: currentColor;
  }

  .search-hero__title {
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: clamp(1.8rem, 4vw, 3rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--color-on-dark, #fff);
    margin: 0;
    text-wrap: balance;
    max-width: 32ch;
  }

  .search-hero__subtitle {
    font-size: clamp(0.9rem, 1.2vw, 1.05rem);
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.78);
    margin: 0;
    max-width: 80ch;
  }

  .search-hero__search {
    width: 100%;
    max-width: 900px;
    margin-top: 8px;
    display: flex;
    justify-content: center;
  }

  /* Sobrescribir max-width del EquipmentSearch para que sea más ancho */
  .search-hero__search :global(.equipment-search) {
    max-width: 100%;
    width: 100%;
  }
</style>
