---
// src/components/rental/CategoryShowcase.astro
// Grid visual de categorías de rental con card de Promociones destacada.
// Estructura: header centrado → banner Promociones full-width → grid 2×2 de categorías.

import { RENTAL_CATEGORIES } from '@/data/rental';
import { promotionCard } from '@/data/promotions';
import Icon from '@/components/ui/Icon.astro';

export interface Props {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  class?: string;
}

const {
  eyebrow = 'Nuestro catálogo',
  title = 'Equipos en arriendo para minería e industria',
  subtitle = '',
  class: className,
} = Astro.props;
---

<section class:list={['category-showcase', className]}>
  <div class="category-showcase__container">
    <div class="category-showcase__header">
      {eyebrow && <p class="category-showcase__eyebrow">{eyebrow}</p>}
      {title && <h2 class="category-showcase__title">{title}</h2>}
      {subtitle && <p class="category-showcase__subtitle">{subtitle}</p>}
    </div>

    {/* Card de Promociones — banner visual con imagen de fondo + overlay */}
    <article class="promo-card" aria-label="Promociones de arriendo de equipos">
      <div class="promo-card__bg">
        <img
          src={promotionCard.image}
          alt=""
          aria-hidden="true"
          loading="lazy"
          decoding="async"
          width="1200"
          height="400"
        />
      </div>
      <div class="promo-card__overlay" aria-hidden="true"></div>
      <div class="promo-card__pattern" aria-hidden="true"></div>
      <span class="promo-card__badge" aria-hidden="true">PROMO</span>
      <div class="promo-card__content">
        <div class="promo-card__text">
          <h3 class="promo-card__title">{promotionCard.title}</h3>
          <p class="promo-card__desc">{promotionCard.description}</p>
        </div>
        <div class="promo-card__pills">
          {promotionCard.categories.map((cat) => (
            <a
              href={`/arriendo/${cat.slug}`}
              class="promo-card__pill"
            >
              {cat.name}
            </a>
          ))}
        </div>
        <a href={promotionCard.ctaHref} class="promo-card__link">
          {promotionCard.ctaLabel}
          <Icon name="arrow-right" size={16} />
        </a>
      </div>
    </article>

    {/* Grid de categorías de rental — cards con panel deslizante */}
    <div class="category-showcase__grid">
      {RENTAL_CATEGORIES.map((category) => {
        const hasOverflow = category.subcategories.length > 6;
        return (
          <article class="category-card" tabindex="0" aria-label={`${category.name}: ${category.subcategories.length} subcategorías`}>
            {/* Imagen de fondo full-bleed */}
            <div class="category-card__bg">
              <img
                src={category.heroImage}
                alt=""
                aria-hidden="true"
                loading="lazy"
                decoding="async"
              />
            </div>

            {/* Panel deslizante desde abajo */}
            <div class="category-card__panel">
              {/* Indicador visual: punta/chevron en el borde superior */}
              <div class="category-card__handle" aria-hidden="true">
                <svg width="20" height="10" viewBox="0 0 20 10" fill="none">
                  <path d="M10 0L20 10H0L10 0Z" fill="currentColor"/>
                </svg>
              </div>

              {/* Pills de subcategorías — ocultos en reposo, aparecen en hover */}
              <div class="category-card__pills">
                {category.subcategories.map((sub) => (
                  <a
                    href={`/arriendo/${category.slug}/${sub.slug}`}
                    class="category-card__pill"
                  >
                    {sub.name}
                  </a>
                ))}
                {hasOverflow && (
                  <a
                    href={`/arriendo/${category.slug}`}
                    class="category-card__pill category-card__pill--all"
                  >
                    Ver todas
                  </a>
                )}
              </div>

              {/* Bloque inferior fijo: título + desc + CTA */}
              <div class="category-card__footer">
                <h3 class="category-card__title">{category.name}</h3>
                <p class="category-card__desc">{category.shortDesc}</p>
                <a href={`/arriendo/${category.slug}`} class="category-card__link">
                  Ver categoría
                  <Icon name="arrow-right" size={16} />
                </a>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  .category-showcase {
    padding-block-start: clamp(32px, 5vw, 56px);
    padding-block-end: clamp(56px, 8vw, 100px);
    background-color: var(--theme-bg);
    /* Subtle depth gradient — dark: graphite tonal; light: warm neutral */
    background-image:
      radial-gradient(ellipse 80% 50% at 50% 0%, rgba(48, 143, 64, 0.04) 0%, transparent 60%),
      radial-gradient(ellipse 60% 40% at 80% 100%, rgba(48, 143, 64, 0.03) 0%, transparent 50%);
  }

  [data-theme="light"] .category-showcase {
    background-image:
      radial-gradient(ellipse 80% 50% at 50% 0%, rgba(48, 143, 64, 0.05) 0%, transparent 60%),
      radial-gradient(ellipse 60% 40% at 80% 100%, rgba(48, 143, 64, 0.03) 0%, transparent 50%);
  }

  .category-showcase__container {
    max-width: var(--container-max-width, 1360px);
    margin-inline: auto;
    padding-inline: var(--container-padding, 20px);
  }

  .category-showcase__header {
    margin-bottom: 40px;
    text-align: center;
    display: flex;
    justify-content: space-between;
  }

  .category-showcase__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 16px;
    color: var(--theme-eyebrow);
  }

  .category-showcase__eyebrow::before {
    content: '';
    width: 42px;
    height: 2px;
    background: currentColor;
  }

  .category-showcase__title {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(1.8rem, 3.4vw, 2.8rem);
    letter-spacing: -0.02em;
    margin: 0 0 16px;
    color: var(--theme-heading);
  }

  .category-showcase__subtitle {
    font-size: 1.05rem;
    line-height: 1.5;
    max-width: 60ch;
    margin: 0 auto;
    color: var(--theme-text-muted);
  }

  /* ─────────────────────────────────────────────────────────────
     PROMO CARD — Banner visual con imagen de fondo + overlay
     Diseño: imagen de fondo con gradiente oscuro, contenido sobre
     la imagen con alto contraste. Compatible dark/light mode.
     Sin parallax JS (costo de rendimiento), solo CSS estático.
     ───────────────────────────────────────────────────────────── */
  .promo-card {
    position: relative;
    display: flex;
    align-items: stretch;
    border-radius: 16px;
    overflow: hidden;
    margin-bottom: 32px;
    min-height: 220px;
    transition: transform 0.3s var(--ease-out, ease), border-color 0.3s var(--ease-out, ease);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  [data-theme="light"] .promo-card {
    border-color: var(--color-line, #e2e4e5);
  }

  .promo-card:hover {
    transform: translateY(-3px);
    border-color: var(--color-brand, #308f40);
  }

  /* Imagen de fondo de la promo card */
  .promo-card__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .promo-card__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-out, ease);
  }

  .promo-card:hover .promo-card__bg img {
    transform: scale(1.03);
  }

  /* Overlay gradiente para legibilidad del contenido */
  .promo-card__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    /* Gradiente de izquierda a derecha: oscuro donde está el texto, más claro a la derecha */
    background: linear-gradient(
      100deg,
      rgba(13, 22, 17, 0.92) 0%,
      rgba(13, 22, 17, 0.82) 35%,
      rgba(13, 22, 17, 0.55) 65%,
      rgba(13, 22, 17, 0.35) 100%
    );
  }

  /* Patrón sutil de diagonales industriales — solo visible en hover */
  .promo-card__pattern {
    position: absolute;
    inset: 0;
    z-index: 2;
    opacity: 0;
    transition: opacity 0.4s var(--ease-out, ease);
    background-image: repeating-linear-gradient(
      -45deg,
      transparent,
      transparent 20px,
      rgba(48, 143, 64, 0.06) 20px,
      rgba(48, 143, 64, 0.06) 21px
    );
    pointer-events: none;
  }

  .promo-card:hover .promo-card__pattern {
    opacity: 1;
  }

  /* Badge PROMO */
  .promo-card__badge {
    position: absolute;
    top: 16px;
    left: 16px;
    z-index: 3;
    padding: 5px 14px;
    background-color: var(--color-brand, #308f40);
    color: var(--color-on-brand, #fff);
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    border-radius: 999px;
    text-transform: uppercase;
    /* Sutil glow para que destaque sobre la imagen */
    box-shadow: 0 2px 8px rgba(48, 143, 64, 0.35);
  }

  /* Contenido de la promo card */
  .promo-card__content {
    position: relative;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 28px 32px;
    flex: 1;
    min-width: 0;
  }

  .promo-card__text {
    flex: 1;
    min-width: 0;
  }

  .promo-card__title {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    letter-spacing: -0.01em;
    line-height: 1.2;
    margin: 0 0 6px;
    color: var(--color-on-dark, #f3f7f4);
  }

  .promo-card__desc {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.5;
    color: rgba(243, 247, 244, 0.82);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .promo-card__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    flex-shrink: 0;
  }

  .promo-card__pill {
    display: inline-block;
    padding: 6px 14px;
    background-color: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 999px;
    color: var(--color-on-dark, #f3f7f4);
    font-size: 0.78rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }

  .promo-card__pill:hover,
  .promo-card__pill:focus {
    background-color: var(--color-brand, #308f40);
    border-color: var(--color-brand, #308f40);
    color: var(--color-on-brand, #fff);
    transform: translateY(-1px);
  }

  .promo-card__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 22px;
    background-color: var(--color-brand, #308f40);
    border-radius: 999px;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.82rem;
    color: var(--color-on-brand, #fff);
    text-decoration: none;
    flex-shrink: 0;
    white-space: nowrap;
    transition: background 0.2s ease, gap 0.2s ease, transform 0.2s ease;
  }

  .promo-card__link:hover {
    background-color: var(--color-brand-600, #226f31);
    gap: 10px;
    transform: translateY(-1px);
  }

  .promo-card__link:focus-visible {
    outline: 2px solid var(--color-on-dark, #f3f7f4);
    outline-offset: 2px;
  }

  @media (max-width: 900px) {
    .promo-card__content {
      flex-wrap: wrap;
      gap: 12px;
      padding: 24px;
    }

    .promo-card__text {
      flex-basis: 100%;
    }

    .promo-card__desc {
      -webkit-line-clamp: 2;
    }
  }

  @media (max-width: 600px) {
    .promo-card {
      min-height: 280px;
    }

    /* En móvil, el gradiente se adapta: más oscuro abajo donde está el texto */
    .promo-card__overlay {
      background: linear-gradient(
        180deg,
        rgba(13, 22, 17, 0.3) 0%,
        rgba(13, 22, 17, 0.6) 40%,
        rgba(13, 22, 17, 0.92) 75%,
        rgba(13, 22, 17, 0.96) 100%
      );
    }

    .promo-card__content {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
      padding: 20px;
      z-index: 3;
    }

    .promo-card__text {
      flex-basis: auto;
    }

    .promo-card__badge {
      top: 12px;
      left: 12px;
    }
  }

  /* ─────────────────────────────────────────────────────────────
     CATEGORY CARDS — imagen de fondo + panel deslizante
     Estado inicial: franja inferior compacta con título, desc, CTA.
     Hover: panel sube cubriendo toda la card con fondo difuminado.
     ───────────────────────────────────────────────────────────── */
  .category-showcase__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  @media (max-width: 768px) {
    .category-showcase__grid {
      grid-template-columns: 1fr;
    }
  }

  .category-card {
    position: relative;
    min-height: 340px;
    border-radius: 14px;
    overflow: hidden;
    cursor: pointer;
    transition: border-color 0.3s var(--ease-out, ease);
    border: 1px solid var(--theme-border);
  }

  .category-card:hover,
  .category-card:focus-within {
    border-color: var(--color-brand, #308f40);
  }

  .category-card:focus-visible {
    outline: 2px solid var(--color-brand, #308f40);
    outline-offset: 2px;
  }

  /* Imagen de fondo full-bleed */
  .category-card__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-color: var(--color-graphite, #0d1611);
  }

  .category-card__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s var(--ease-out, ease);
  }

  .category-card:hover .category-card__bg img,
  .category-card:focus-within .category-card__bg img {
    transform: scale(1.05);
  }

  /* Panel deslizante — ocupa la card completa pero el contenido
     se ancla abajo. En reposo solo se ve la franja inferior. */
  .category-card__panel {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 16px;
    /* Estado colapsado: fondo oscuro solo en la franja inferior */
    background: linear-gradient(
      to top,
      rgba(13, 22, 17, 0.92) 0%,
      rgba(13, 22, 17, 0.88) 30%,
      rgba(13, 22, 17, 0.4) 55%,
      transparent 100%
    );
    transition: background 0.4s var(--ease-out, ease);
  }

  .category-card:hover .category-card__panel,
  .category-card:focus-within .category-card__panel {
    /* Estado expandido: fondo difuminado cubre toda la card */
    background: rgba(13, 22, 17, 0.72);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  [data-theme="light"] .category-card__panel {
    background: linear-gradient(
      to top,
      rgba(255, 255, 255, 0.94) 0%,
      rgba(255, 255, 255, 0.9) 30%,
      rgba(255, 255, 255, 0.5) 55%,
      transparent 100%
    );
  }

  [data-theme="light"] .category-card:hover .category-card__panel,
  [data-theme="light"] .category-card:focus-within .category-card__panel {
    background: rgba(255, 255, 255, 0.78);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  /* Handle / punta indicadora */
  .category-card__handle {
    position: absolute;
    top: 42%;
    left: 50%;
    transform: translateX(-50%);
    color: var(--color-on-dark, #f3f7f4);
    opacity: 0.7;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  [data-theme="light"] .category-card__handle {
    color: var(--color-ink, #242627);
  }

  .category-card:hover .category-card__handle,
  .category-card:focus-within .category-card__handle {
    opacity: 0;
    transform: translateX(-50%) translateY(-8px);
  }

  /* Pills — ocultos en estado colapsado, visibles en hover */
  .category-card__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 12px;
    opacity: 0;
    clip-path: inset(100% 0 0 0);
    transition: clip-path 0.4s var(--ease-out, ease), opacity 0.3s ease;
  }

  .category-card:hover .category-card__pills,
  .category-card:focus-within .category-card__pills {
    opacity: 1;
    clip-path: inset(0 0 0 0);
    overflow-y: auto;
  }

  /* Footer fijo: título + desc + CTA siempre al fondo */
  .category-card__footer {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .category-card__title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: -0.01em;
    line-height: 1.2;
    margin: 0;
    color: var(--color-on-dark, #f3f7f4);
  }

  [data-theme="light"] .category-card__title {
    color: var(--color-ink, #242627);
  }

  .category-card__desc {
    margin: 0 0 8px;
    font-size: 0.8rem;
    line-height: 1.4;
    color: rgba(243, 247, 244, 0.78);
  }

  [data-theme="light"] .category-card__desc {
    color: var(--color-ink-500, #6b7072);
  }

  .category-card__pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 5px 10px;
    background-color: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: var(--radius-sm, 0.5rem);
    color: var(--color-on-dark, #f3f7f4);
    font-size: 0.72rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }

  [data-theme="light"] .category-card__pill {
    background-color: rgba(0, 0, 0, 0.04);
    border-color: var(--color-line, #e2e4e5);
    color: var(--color-ink, #242627);
  }

  .category-card__pill:hover,
  .category-card__pill:focus {
    background-color: var(--color-brand, #308f40);
    border-color: var(--color-brand, #308f40);
    color: var(--color-on-brand, #fff);
  }

  .category-card__pill--all {
    background-color: var(--color-brand, #308f40);
    border-color: var(--color-brand, #308f40);
    color: var(--color-on-brand, #fff);
    font-weight: 600;
  }

  .category-card__pill--all:hover,
  .category-card__pill--all:focus {
    background-color: var(--color-brand-600, #226f31);
    border-color: var(--color-brand-600, #226f31);
  }

  /* CTA link */
  .category-card__link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.8rem;
    color: var(--color-brand-300, #62bb74);
    text-decoration: none;
    transition: gap 0.2s ease, color 0.2s ease;
  }

  [data-theme="light"] .category-card__link {
    color: var(--color-brand, #308f40);
  }

  .category-card__link:hover {
    gap: 9px;
    color: var(--color-on-dark, #f3f7f4);
  }

  [data-theme="light"] .category-card__link:hover {
    color: var(--color-brand-600, #226f31);
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .category-card__panel,
    .category-card__pills,
    .category-card__handle,
    .category-card__bg img {
      transition: none;
    }
  }
</style>
