---
// src/components/rental/CategoryShowcase.astro
// Grid visual de categorías de rental con card de Promociones destacada.
// Estructura: header centrado → banner Promociones full-width → grid 2×2 de categorías.

import { RENTAL_CATEGORIES } from '@/data/rental';
import { promotionCard } from '@/data/promotions';
import Icon from '@/components/ui/Icon.astro';

export interface Props {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  class?: string;
}

const {
  eyebrow = 'Nuestro catálogo',
  title = 'Equipos en arriendo para minería e industria',
  subtitle = '',
  class: className,
} = Astro.props;
---

<section class:list={['category-showcase', className]}>
  <div class="category-showcase__container">
    <div class="category-showcase__header">
      {eyebrow && <p class="category-showcase__eyebrow">{eyebrow}</p>}
      {title && <h2 class="category-showcase__title">{title}</h2>}
      {subtitle && <p class="category-showcase__subtitle">{subtitle}</p>}
    </div>

    {/* Card de Promociones — strip horizontal delgada */}
    <article class="promo-card">
      <div class="promo-card__image-wrapper">
        <img
          src={promotionCard.image}
          alt={promotionCard.imageAlt}
          class="promo-card__image"
          loading="lazy"
          decoding="async"
        />
        <span class="promo-card__badge" aria-hidden="true">PROMO</span>
      </div>
      <div class="promo-card__content">
        <div class="promo-card__text">
          <h3 class="promo-card__title">{promotionCard.title}</h3>
          <p class="promo-card__desc">{promotionCard.description}</p>
        </div>
        <div class="promo-card__pills">
          {promotionCard.categories.map((cat) => (
            <a
              href={`/arriendo/${cat.slug}`}
              class="promo-card__pill"
            >
              {cat.name}
            </a>
          ))}
        </div>
        <a href={promotionCard.ctaHref} class="promo-card__link">
          {promotionCard.ctaLabel}
          <Icon name="arrow-right" size={16} />
        </a>
      </div>
    </article>

    {/* Grid 2×2 de categorías de rental */}
    <div class="category-showcase__grid">
      {RENTAL_CATEGORIES.map((category) => (
        <article class="category-card">
          <div class="category-card__image-wrapper">
            <img
              src={category.heroImage}
              alt={category.name}
              class="category-card__image"
              loading="lazy"
            />
          </div>
          <div class="category-card__content">
            <h3 class="category-card__title">{category.name}</h3>
            <p class="category-card__desc">{category.shortDesc}</p>
            <div class="category-card__pills">
              {category.subcategories.slice(0, 4).map((sub) => (
                <a
                  href={`/arriendo/${category.slug}/${sub.slug}`}
                  class="category-card__pill"
                >
                  {sub.name}
                </a>
              ))}
              {category.subcategories.length > 4 && (
                <a
                  href={`/arriendo/${category.slug}`}
                  class="category-card__pill category-card__pill--more"
                >
                  +{category.subcategories.length - 4}
                </a>
              )}
            </div>
            <a href={`/arriendo/${category.slug}`} class="category-card__link">
              Ver categoría
              <Icon name="arrow-right" size={18} />
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .category-showcase {
    padding-block-start: clamp(32px, 5vw, 56px);
    padding-block-end: clamp(56px, 8vw, 100px);
    background-color: var(--theme-bg);
  }

  .category-showcase__container {
    max-width: var(--container-max-width, 1360px);
    margin-inline: auto;
    padding-inline: var(--container-padding, 20px);
  }

  .category-showcase__header {
    margin-bottom: 40px;
    text-align: center;
    display: flex;
    justify-content: space-between;
  }

  .category-showcase__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 16px;
    color: var(--theme-eyebrow);
  }

  .category-showcase__eyebrow::before {
    content: '';
    width: 42px;
    height: 2px;
    background: currentColor;
  }

  .category-showcase__title {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(1.8rem, 3.4vw, 2.8rem);
    letter-spacing: -0.02em;
    margin: 0 0 16px;
    color: var(--theme-heading);
  }

  .category-showcase__subtitle {
    font-size: 1.05rem;
    line-height: 1.5;
    max-width: 60ch;
    margin: 0 auto;
    color: var(--theme-text-muted);
  }

  /* ─────────────────────────────────────────────────────────────
     PROMO CARD — strip horizontal delgada y extendida
     ───────────────────────────────────────────────────────────── */
  .promo-card {
    display: flex;
    align-items: stretch;
    background-color: var(--theme-bg-elevated);
    border: 2px solid var(--color-brand, #308f40);
    border-radius: 14px;
    overflow: hidden;
    margin-bottom: 24px;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .promo-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.22);
  }

  .promo-card__image-wrapper {
    position: relative;
    flex-shrink: 0;
    width: clamp(120px, 18vw, 200px);
    overflow: hidden;
    background-color: var(--color-graphite, #0d1611);
  }

  .promo-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .promo-card:hover .promo-card__image {
    transform: scale(1.05);
  }

  .promo-card__badge {
    position: absolute;
    top: 10px;
    left: 10px;
    padding: 3px 10px;
    background-color: var(--color-brand, #308f40);
    color: var(--color-on-dark, #fff);
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    border-radius: 999px;
    text-transform: uppercase;
  }

  .promo-card__content {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 14px 20px;
    flex: 1;
    min-width: 0;
  }

  .promo-card__text {
    flex: 1;
    min-width: 0;
  }

  .promo-card__title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: -0.01em;
    line-height: 1.25;
    margin: 0 0 4px;
    color: var(--theme-text);
  }

  .promo-card__desc {
    margin: 0;
    font-size: 0.8rem;
    line-height: 1.4;
    color: var(--theme-text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .promo-card__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    flex-shrink: 0;
  }

  .promo-card__pill {
    display: inline-block;
    padding: 4px 10px;
    background-color: var(--theme-bg);
    border: 1px solid var(--theme-border);
    border-radius: 999px;
    color: var(--theme-text-subtle);
    font-size: 0.75rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }

  .promo-card__pill:hover,
  .promo-card__pill:focus {
    background-color: var(--color-brand, #308f40);
    border-color: var(--color-brand, #308f40);
    color: var(--color-on-dark);
  }

  .promo-card__link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.8rem;
    color: var(--color-brand, #308f40);
    text-decoration: none;
    flex-shrink: 0;
    white-space: nowrap;
    transition: gap 0.2s ease;
  }

  .promo-card__link:hover {
    gap: 9px;
  }

  @media (max-width: 900px) {
    .promo-card__content {
      flex-wrap: wrap;
      gap: 10px;
    }

    .promo-card__text {
      flex-basis: 100%;
    }

    .promo-card__desc {
      -webkit-line-clamp: 2;
    }
  }

  @media (max-width: 600px) {
    .promo-card {
      flex-direction: column;
    }

    .promo-card__image-wrapper {
      width: 100%;
      aspect-ratio: 16 / 5;
    }

    .promo-card__content {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
      padding: 12px 16px 14px;
    }

    .promo-card__text {
      flex-basis: auto;
    }
  }

  /* ─────────────────────────────────────────────────────────────
     CATEGORY CARDS — grid 2×2 compacto
     ───────────────────────────────────────────────────────────── */
  .category-showcase__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  @media (max-width: 768px) {
    .category-showcase__grid {
      grid-template-columns: 1fr;
    }
  }

  .category-card {
    display: flex;
    flex-direction: column;
    background-color: var(--theme-bg-elevated);
    border: 1px solid var(--theme-border);
    border-radius: 14px;
    overflow: hidden;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }

  .category-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.22);
    border-color: var(--color-brand, #308f40);
  }

  .category-card__image-wrapper {
    position: relative;
    aspect-ratio: 16 / 5;
    overflow: hidden;
    background-color: var(--color-graphite, #0d1611);
  }

  .category-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .category-card:hover .category-card__image {
    transform: scale(1.05);
  }

  .category-card__content {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 12px 14px 14px;
    flex: 1;
  }

  .category-card__title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: -0.01em;
    line-height: 1.25;
    margin: 0;
    color: var(--theme-text);
  }

  .category-card__desc {
    margin: 0;
    font-size: 0.8rem;
    line-height: 1.4;
    color: var(--theme-text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .category-card__pills {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 5px;
    margin-top: 4px;
  }

  .category-card__pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 4px 8px;
    background-color: var(--theme-bg);
    border: 1px solid var(--theme-border);
    border-radius: 999px;
    color: var(--theme-text-subtle);
    font-size: 0.72rem;
    font-weight: 500;
    text-decoration: none;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }

  .category-card__pill:hover,
  .category-card__pill:focus {
    background-color: var(--color-brand, #308f40);
    border-color: var(--color-brand, #308f40);
    color: var(--color-on-dark);
  }

  .category-card__pill--more {
    background-color: var(--color-brand, #308f40);
    border-color: var(--color-brand, #308f40);
    color: var(--color-on-dark);
    font-weight: 700;
  }

  .category-card__pill--more:hover,
  .category-card__pill--more:focus {
    background-color: var(--color-brand-dark, #157a3a);
    border-color: var(--color-brand-dark, #157a3a);
  }

  .category-card__link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.8rem;
    color: var(--theme-eyebrow);
    text-decoration: none;
    margin-top: 4px;
    transition: gap 0.2s ease;
  }

  .category-card__link:hover {
    gap: 9px;
  }
</style>
