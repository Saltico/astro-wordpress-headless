---
// src/components/rental/EquipmentSearch.astro
// Search bar client-side para encontrar equipos por nombre, categoría o subcategoría.
// Resultados en tree view con líneas conectoras (matching navbar submenu glassmorphic).

import Icon from '@/components/ui/Icon.astro';
import { RENTAL_CATEGORIES } from '@/data/rental';

export interface Props {
  placeholder?: string;
  class?: string;
}

const { placeholder = 'Grúa 100 toneladas...', class: className } = Astro.props;

// Build hierarchical search index at build time
interface SearchItem {
  name: string;
  category: string;
  categorySlug: string;
  subcategory: string;
  subcategorySlug: string;
  url: string;
  capacity?: string;
  level: 'category' | 'subcategory' | 'equipment';
}

const searchIndex: SearchItem[] = [];

RENTAL_CATEGORIES.forEach((category) => {
  searchIndex.push({
    name: category.name,
    category: category.name,
    categorySlug: category.slug,
    subcategory: '',
    subcategorySlug: '',
    url: `/arriendo/${category.slug}`,
    capacity: '',
    level: 'category',
  });

  category.subcategories.forEach((sub) => {
    searchIndex.push({
      name: sub.name,
      category: category.name,
      categorySlug: category.slug,
      subcategory: sub.name,
      subcategorySlug: sub.slug,
      url: `/arriendo/${category.slug}/${sub.slug}`,
      capacity: '',
      level: 'subcategory',
    });

    sub.catalog.forEach((equipment) => {
      searchIndex.push({
        name: equipment.name,
        category: category.name,
        categorySlug: category.slug,
        subcategory: sub.name,
        subcategorySlug: sub.slug,
        url: `/arriendo/${category.slug}/${sub.slug}`,
        capacity: equipment.capacity,
        level: 'equipment',
      });
    });
  });
});

const searchIndexJson = JSON.stringify(searchIndex);
---

<div class:list={['equipment-search', className]}>
  <div class="equipment-search__wrapper">
    <div class="equipment-search__input-container">
      <Icon name="search" size={20} class="equipment-search__icon" />
      <input
        type="text"
        class="equipment-search__input"
        placeholder={placeholder}
        aria-label="Buscar equipos"
        role="combobox"
        aria-expanded="false"
        aria-controls="equipment-search-results"
        aria-autocomplete="list"
      />
    </div>
    <div
      id="equipment-search-results"
      class="equipment-search__results"
      role="listbox"
      aria-label="Resultados de búsqueda"
      hidden
    ></div>
  </div>
</div>

<style>
  .equipment-search {
    width: 100%;
    max-width: 480px;
  }

  .equipment-search__wrapper {
    position: relative;
  }

  .equipment-search__input-container {
    position: relative;
    display: flex;
    align-items: center;
  }

  .equipment-search__input-container :global(.equipment-search__icon) {
    position: absolute;
    left: 14px;
    color: var(--color-ink-500, #6b7072);
    pointer-events: none;
    z-index: 1;
  }

  .equipment-search__input {
    width: 100%;
    padding: 12px 14px 12px 44px;
    background-color: rgba(255, 255, 255, 0.95);
    border: 2px solid transparent;
    border-radius: var(--radius-sm, 0.5rem);
    font-family: var(--font-body);
    font-size: var(--text-body);
    color: var(--color-graphite, #0d1611);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .equipment-search__input:focus {
    outline: none;
    border-color: var(--color-brand, #308f40);
    box-shadow: 0 0 0 3px rgba(48, 143, 64, 0.2);
  }

  .equipment-search__input::placeholder {
    color: var(--color-ink-500, #6b7072);
  }

  /* ── Results dropdown — glassmorphic dark (matches navbar submenu) ── */
  .equipment-search__results {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    right: 0;
    max-height: 440px;
    overflow-y: auto;
    background-color: rgba(13, 22, 17, 0.92);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-md, 0.75rem);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35);
    z-index: 100;
    padding: 8px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition: opacity 0.2s ease, visibility 0.2s ease, transform 0.2s ease;
  }

  .equipment-search__results:not([hidden]) {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .equipment-search__results[hidden] {
    display: none;
  }

  /* Scrollbar */
  .equipment-search__results::-webkit-scrollbar {
    width: 6px;
  }

  .equipment-search__results::-webkit-scrollbar-track {
    background: transparent;
  }

  .equipment-search__results::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.15);
    border-radius: var(--radius-xs, 0.25rem);
  }

  .equipment-search__results::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 255, 255, 0.25);
  }

  /* ── Category group (tree root) ── */
  :global(.equipment-search__group) {
    margin-bottom: 6px;
  }

  :global(.equipment-search__group):last-child {
    margin-bottom: 0;
  }

  /* ── Category header — parent label with brand accent ── */
  :global(.equipment-search__group-header) {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    font-family: var(--font-heading);
    font-size: var(--text-small);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-brand-300, #62bb74);
    cursor: default;
    user-select: none;
    background-color: rgba(48, 143, 64, 0.08);
    border-radius: var(--radius-sm, 0.5rem);
    margin-bottom: 2px;
  }

  :global(.equipment-search__group-header)::before {
    content: '';
    width: 6px;
    height: 6px;
    background-color: var(--color-brand, #308f40);
    border-radius: 50%;
    flex-shrink: 0;
  }

  /* ── Children container — vertical tree line ── */
  .equipment-search__children {
    position: relative;
    padding-left: 20px;
    margin-left: 17px;
    margin-top: 2px;
  }

  /* Vertical connector line */
  .equipment-search__children::before {
    content: '';
    position: absolute;
    left: 0;
    top: 4px;
    bottom: 12px;
    width: 1px;
    background-color: rgba(98, 187, 116, 0.25);
  }

  /* ── Subcategory sub-dropdown (visual container) ── */
  :global(.equipment-search__subcategory-group) {
    position: relative;
    margin-bottom: 4px;
    padding: 4px 0;
    background-color: rgba(48, 143, 64, 0.04);
    border-left: 2px solid rgba(98, 187, 116, 0.35);
    border-radius: var(--radius-sm, 0.5rem);
  }

  :global(.equipment-search__subcategory-group):last-child {
    margin-bottom: 0;
  }

  /* ── Equipment list inside subcategory ── */
  :global(.equipment-search__equipment-list) {
    margin-top: 2px;
    padding-left: 8px;
  }

  /* ── Expand indicator (count badge + chevron) ── */
  :global(.equipment-search__expand-indicator) {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    flex-shrink: 0;
    padding: 1px 6px;
    border-radius: 999px;
    background-color: rgba(98, 187, 116, 0.12);
    transition: background-color 0.15s ease;
  }

  :global(.equipment-search__expand-count) {
    font-family: var(--font-heading);
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--color-brand-300, #62bb74);
    line-height: 1;
  }

  /* ── Desktop: hide equipment list, show on hover ── */
  @media (hover: hover) and (pointer: fine) {
    :global(.equipment-search__equipment-list) {
      max-height: 0;
      overflow: hidden;
      opacity: 0;
      transition: max-height 0.25s ease, opacity 0.2s ease, margin-top 0.2s ease;
      margin-top: 0;
    }

    :global(.equipment-search__subcategory-group):hover :global(.equipment-search__equipment-list),
    :global(.equipment-search__subcategory-group).is-expanded :global(.equipment-search__equipment-list) {
      max-height: 500px;
      opacity: 1;
      margin-top: 2px;
    }

    :global(.equipment-search__subcategory-group):hover :global(.equipment-search__expand-indicator) {
      background-color: rgba(98, 187, 116, 0.2);
    }

    /* Rotate chevron on hover */
    :global(.equipment-search__subcategory-group):hover :global(.equipment-search__expand-indicator) svg {
      transform: rotate(180deg);
    }
  }

  /* ── Mobile/Tablet: always show equipment list ── */
  @media (hover: none), (pointer: coarse) {
    :global(.equipment-search__equipment-list) {
      max-height: 500px;
      opacity: 1;
    }

    /* Hide the expand indicator on touch devices — always expanded */
    :global(.equipment-search__expand-indicator) svg {
      transform: rotate(180deg);
    }
  }

  /* ── Category root link (first child, no tree line needed) ── */
  :global(.equipment-search__result-item--category) {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 7px 12px;
    text-decoration: none;
    color: var(--color-on-dark, #f3f7f4);
    font-family: var(--font-heading);
    font-size: var(--text-small);
    font-weight: 600;
    border-radius: var(--radius-sm, 0.5rem);
    transition: background-color 0.15s ease;
    margin-bottom: 2px;
  }

  :global(.equipment-search__result-item--category):hover,
  :global(.equipment-search__result-item--category):focus {
    background-color: rgba(255, 255, 255, 0.06);
    outline: none;
  }

  :global(.equipment-search__result-item--category)[aria-selected="true"] {
    background-color: rgba(48, 143, 64, 0.12);
  }

  /* ── Tree item (subcategory / equipment) ── */
  :global(.equipment-search__result-item) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 7px 12px;
    text-decoration: none;
    color: var(--color-on-dark, #f3f7f4);
    font-family: var(--font-body);
    font-size: var(--text-small);
    font-weight: 500;
    border-radius: var(--radius-sm, 0.5rem);
    transition: background-color 0.15s ease, color 0.15s ease;
    position: relative;
  }

  :global(.equipment-search__result-item):hover,
  :global(.equipment-search__result-item):focus {
    background-color: rgba(255, 255, 255, 0.08);
    color: var(--color-on-dark, #f3f7f4);
    outline: none;
  }

  :global(.equipment-search__result-item)[aria-selected="true"] {
    background-color: rgba(48, 143, 64, 0.15);
    color: var(--color-on-dark, #f3f7f4);
  }

  /* Horizontal branch connector from vertical line to item */
  :global(.equipment-search__result-item--subcategory)::before,
  :global(.equipment-search__result-item--equipment)::before {
    content: '';
    position: absolute;
    left: -20px;
    top: 50%;
    width: 16px;
    height: 1px;
    background-color: rgba(98, 187, 116, 0.25);
  }

  /* Subcategory — slightly muted vs category */
  :global(.equipment-search__result-item--subcategory) {
    color: rgba(243, 247, 244, 0.88);
  }

  /* Equipment — more muted, slightly smaller */
  :global(.equipment-search__result-item--equipment) {
    color: rgba(243, 247, 244, 0.75);
    font-size: 0.84rem;
  }

  :global(.equipment-search__result-item--equipment):hover,
  :global(.equipment-search__result-item--equipment):focus {
    color: var(--color-on-dark, #f3f7f4);
  }

  /* ── Content area ── */
  :global(.equipment-search__result-content) {
    display: flex;
    flex-direction: column;
    gap: 1px;
    flex: 1;
    min-width: 0;
  }

  :global(.equipment-search__result-name) {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: inherit;
    color: inherit;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.equipment-search__result-meta) {
    display: flex;
    gap: 6px;
    font-size: 0.75rem;
    color: var(--color-on-dark-muted, #9bab9f);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ── Capacity badge ── */
  :global(.equipment-search__result-badge) {
    display: inline-flex;
    align-items: center;
    padding: 2px 8px;
    background-color: var(--color-brand, #308f40);
    color: var(--color-on-brand, #ffffff);
    font-family: var(--font-heading);
    font-size: 0.7rem;
    font-weight: 600;
    border-radius: 999px;
    flex-shrink: 0;
    letter-spacing: 0.02em;
  }

  /* ── Level icons ── */
  :global(.equipment-search__level-icon) {
    width: 11px !important;
    height: 11px !important;
    flex-shrink: 0;
    opacity: 0.55;
  }

  :global(.equipment-search__level-icon--subcategory) {
    color: var(--color-brand-300, #62bb74);
  }

  :global(.equipment-search__level-icon--equipment) {
    color: var(--color-on-dark-muted, #9bab9f);
  }

  /* ── Category root icon ── */
  :global(.equipment-search__category-icon) {
    width: 13px !important;
    height: 13px !important;
    flex-shrink: 0;
    color: var(--color-brand-300, #62bb74);
    opacity: 0.7;
  }

  /* ── Chevron for expandable items ── */
  :global(.equipment-search__chevron) {
    width: 10px !important;
    height: 10px !important;
    color: rgba(255, 255, 255, 0.25);
    flex-shrink: 0;
    transition: color 0.15s ease;
  }

  :global(.equipment-search__result-item):hover :global(.equipment-search__chevron) {
    color: rgba(255, 255, 255, 0.5);
  }

  /* ── Empty state ── */
  :global(.equipment-search__empty) {
    padding: 24px 16px;
    text-align: center;
    color: var(--color-on-dark-muted, #9bab9f);
    font-family: var(--font-body);
    font-size: var(--text-small);
  }

  :global(.equipment-search__empty-link) {
    display: inline-block;
    margin-top: 10px;
    color: var(--color-brand-300, #62bb74);
    font-family: var(--font-heading);
    font-weight: 600;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  :global(.equipment-search__empty-link):hover {
    color: var(--color-brand-300, #62bb74);
    text-decoration: underline;
  }
</style>

<script define:vars={{ searchIndexJson }}>
  (function () {
    const searchIndex = JSON.parse(searchIndexJson);
    const input = document.querySelector('.equipment-search__input');
    const resultsContainer = document.querySelector('.equipment-search__results');

    if (!input || !resultsContainer) return;

    let selectedIndex = -1;
    let currentItems = [];

    function normalize(str) {
      return str
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '');
    }

    function escapeHtml(str) {
      const div = document.createElement('div');
      div.textContent = str;
      return div.innerHTML;
    }

    /**
     * Hierarchical search: returns a tree of category groups.
     * Each group: { name, url, children: [{ name, url, equipment: [...] }] }
     */
    function search(query) {
      const nq = normalize(query);

      const matchedCategorySlugs = new Set();
      const matchedSubKeys = new Set();
      const matchedEquipmentItems = [];

      searchIndex.forEach((item) => {
        if (!item.name || !normalize(item.name).includes(nq)) return;

        if (item.level === 'category') {
          matchedCategorySlugs.add(item.categorySlug);
        } else if (item.level === 'subcategory') {
          matchedCategorySlugs.add(item.categorySlug);
          matchedSubKeys.add(item.categorySlug + '/' + item.subcategorySlug);
        } else if (item.level === 'equipment') {
          matchedCategorySlugs.add(item.categorySlug);
          matchedEquipmentItems.push(item);
        }
      });

      // Category-level match: expand to show all subcategories
      if (matchedCategorySlugs.size > 0 && matchedSubKeys.size === 0 && matchedEquipmentItems.length === 0) {
        searchIndex.forEach((item) => {
          if (item.level === 'subcategory' && matchedCategorySlugs.has(item.categorySlug)) {
            matchedSubKeys.add(item.categorySlug + '/' + item.subcategorySlug);
          }
        });
      }

      // Subcategory-level match: expand to show all equipment within that subcategory
      matchedSubKeys.forEach((subKey) => {
        searchIndex.forEach((item) => {
          if (item.level === 'equipment') {
            const itemSubKey = item.categorySlug + '/' + item.subcategorySlug;
            if (itemSubKey === subKey) {
              // Check if already in matchedEquipmentItems to avoid duplicates
              const alreadyMatched = matchedEquipmentItems.some(
                (eq) => eq.categorySlug === item.categorySlug &&
                        eq.subcategorySlug === item.subcategorySlug &&
                        eq.name === item.name
              );
              if (!alreadyMatched) {
                matchedEquipmentItems.push(item);
              }
            }
          }
        });
      });

      // Build tree: category → subcategories → equipment
      const categoryMap = new Map();

      searchIndex.forEach((item) => {
        if (item.level === 'category' && matchedCategorySlugs.has(item.categorySlug)) {
          if (!categoryMap.has(item.categorySlug)) {
            categoryMap.set(item.categorySlug, {
              category: item,
              subcategoryMap: new Map(),
            });
          }
        }
      });

      searchIndex.forEach((item) => {
        if (item.level === 'subcategory') {
          const key = item.categorySlug + '/' + item.subcategorySlug;
          const catGroup = categoryMap.get(item.categorySlug);
          if (catGroup && matchedSubKeys.has(key)) {
            if (!catGroup.subcategoryMap.has(item.subcategorySlug)) {
              catGroup.subcategoryMap.set(item.subcategorySlug, {
                subcategory: item,
                equipment: [],
              });
            }
          }
        }
      });

      matchedEquipmentItems.forEach((item) => {
        const catGroup = categoryMap.get(item.categorySlug);
        if (!catGroup) return;
        const subGroup = catGroup.subcategoryMap.get(item.subcategorySlug);
        if (subGroup) {
          if (!subGroup.equipment.some((e) => e.name === item.name)) {
            subGroup.equipment.push(item);
          }
        } else if (matchedSubKeys.size === 0 || !matchedSubKeys.has(item.categorySlug + '/' + item.subcategorySlug)) {
          // Equipment matched but subcategory didn't explicitly — create bucket
          if (!catGroup.subcategoryMap.has(item.subcategorySlug)) {
            catGroup.subcategoryMap.set(item.subcategorySlug, {
              subcategory: {
                name: item.subcategory,
                categorySlug: item.categorySlug,
                subcategorySlug: item.subcategorySlug,
                url: item.url,
                category: item.category,
              },
              equipment: [item],
            });
          }
        }
      });

      // Convert to renderable tree
      const treeGroups = [];
      categoryMap.forEach((catGroup) => {
        const children = [];
        catGroup.subcategoryMap.forEach((subGroup) => {
          children.push({
            name: subGroup.subcategory.name,
            url: subGroup.subcategory.url,
            equipment: subGroup.equipment.map((eq) => ({
              name: eq.name,
              url: eq.url,
              capacity: eq.capacity,
              subcategory: eq.subcategory,
            })),
          });
        });

        treeGroups.push({
          name: catGroup.category.name,
          url: catGroup.category.url,
          children,
        });
      });

      return treeGroups;
    }

    // SVG icons — inline styles REQUIRED because Astro scoped CSS
    // does not apply to elements created dynamically via innerHTML.
    const ICONS = {
      category: '<svg style="width:13px;height:13px;flex-shrink:0;color:#62bb74;opacity:0.7" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1.5" y="1.5" width="3.5" height="3.5"/><rect x="7" y="1.5" width="3.5" height="3.5"/><rect x="7" y="7" width="3.5" height="3.5"/><rect x="1.5" y="7" width="3.5" height="3.5"/></svg>',
      subcategory: '<svg style="width:11px;height:11px;flex-shrink:0;color:#62bb74;opacity:0.6" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 9.5a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V2.5a1 1 0 0 1 1-1h2.5l1 1.5h4.5a1 1 0 0 1 1 1z"/></svg>',
      equipment: '<svg style="width:11px;height:11px;flex-shrink:0;color:#9bab9f;opacity:0.5" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.35 3.15a.5.5 0 0 0 0 .7l.8.8a.5.5 0 0 0 .7 0l1.885-1.885a3 3 0 0 1-3.97 3.97l-3.455 3.455a1.06 1.06 0 0 1-1.5-1.5l3.455-3.455a3 3 0 0 1 3.97-3.97L7.35 3.15z"/></svg>',
      chevron: '<svg style="width:10px;height:10px;flex-shrink:0;color:rgba(255,255,255,0.25)" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m4.5 9 3-3-3-3"/></svg>',
      // Chevron-down for expandable subcategories (with equipment count badge)
      chevronDown: '<svg style="width:10px;height:10px;flex-shrink:0;color:rgba(255,255,255,0.35);transition:transform 0.2s ease" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 4.5 3 3 3-3"/></svg>',
    };

    function renderItemHtml(url, name, level, indexRef, extra) {
      var cls = 'equipment-search__result-item equipment-search__result-item--' + level;
      var icon = level === 'subcategory' ? ICONS.subcategory : ICONS.equipment;
      var badge = extra && extra.capacity
        ? '<span class="equipment-search__result-badge">' + escapeHtml(extra.capacity) + '</span>'
        : '';
      var meta = extra && extra.subcategory && level === 'equipment'
        ? '<div class="equipment-search__result-meta"><span>' + escapeHtml(extra.subcategory) + '</span></div>'
        : '';
      // Expandable indicator for subcategories with equipment
      var expandIndicator = '';
      if (level === 'subcategory' && extra && extra.equipmentCount) {
        expandIndicator = '<span class="equipment-search__expand-indicator">'
          + '<span class="equipment-search__expand-count">' + extra.equipmentCount + '</span>'
          + ICONS.chevronDown
          + '</span>';
      }

      var idx = indexRef.value++;
      return '<a href="' + url + '" class="' + cls + '" role="option" aria-selected="false" data-index="' + idx + '">'
        + icon
        + '<div class="equipment-search__result-content">'
        + '<div class="equipment-search__result-name">' + escapeHtml(name) + '</div>'
        + meta
        + '</div>'
        + badge
        + expandIndicator
        + (level !== 'subcategory' ? ICONS.chevron : '')
        + '</a>';
    }

    function renderResults(treeGroups) {
      var query = input.value.trim();

      // Count total items for tracking
      var itemCount = 0;
      treeGroups.forEach(function (g) {
        itemCount++; // category itself
        g.children.forEach(function (sub) {
          itemCount++; // subcategory
          itemCount += sub.equipment.length;
        });
      });

      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({
        event: 'equipment_search',
        search_query: query,
        results_count: itemCount,
        search_type: itemCount > 0 ? 'hierarchical' : 'no_results',
      });

      if (treeGroups.length === 0) {
        resultsContainer.innerHTML = '<div class="equipment-search__empty">'
          + 'No se encontraron resultados para &quot;' + escapeHtml(query) + '&quot;.'
          + '<a href="/arriendo" class="equipment-search__empty-link">Ver catálogo completo →</a>'
          + '</div>';
        resultsContainer.hidden = false;
        input.setAttribute('aria-expanded', 'true');
        currentItems = [];
        selectedIndex = -1;
        return;
      }

      var html = '';
      var indexRef = { value: 0 };

      treeGroups.forEach(function (group) {
        // Category group container
        html += '<div class="equipment-search__group">';

        // Category header label
        html += '<div class="equipment-search__group-header">' + escapeHtml(group.name) + '</div>';

        // Category root link
        html += '<a href="' + group.url + '" class="equipment-search__result-item equipment-search__result-item--category" role="option" aria-selected="false" data-index="' + indexRef.value + '">'
          + ICONS.category
          + '<div class="equipment-search__result-content">'
          + '<div class="equipment-search__result-name">' + escapeHtml(group.name) + '</div>'
          + '</div>'
          + ICONS.chevron
          + '</a>';
        indexRef.value++;

        // Children container with vertical tree line
        if (group.children.length > 0) {
          html += '<div class="equipment-search__children">';

          group.children.forEach(function (sub) {
            // Subcategory group container (visual sub-dropdown)
            html += '<div class="equipment-search__subcategory-group">';
            
            // Subcategory item — pass equipment count for expand indicator
            html += renderItemHtml(sub.url, sub.name, 'subcategory', indexRef, {
              equipmentCount: sub.equipment.length > 0 ? sub.equipment.length : null,
            });

            // Equipment items nested under subcategory
            if (sub.equipment.length > 0) {
              html += '<div class="equipment-search__equipment-list">';
              sub.equipment.forEach(function (eq) {
                html += renderItemHtml(eq.url, eq.name, 'equipment', indexRef, {
                  capacity: eq.capacity,
                  subcategory: eq.subcategory,
                });
              });
              html += '</div>';
            }
            
            html += '</div>'; // close .equipment-search__subcategory-group
          });

          html += '</div>'; // close .equipment-search__children
        }

        html += '</div>'; // close .equipment-search__group
      });

      resultsContainer.innerHTML = html;
      resultsContainer.hidden = false;
      input.setAttribute('aria-expanded', 'true');

      // Collect all clickable items for keyboard nav
      currentItems = [];
      var allLinks = resultsContainer.querySelectorAll('.equipment-search__result-item');
      allLinks.forEach(function (link) {
        currentItems.push(link);
      });
      selectedIndex = -1;
    }

    function hideResults() {
      resultsContainer.hidden = true;
      input.setAttribute('aria-expanded', 'false');
      selectedIndex = -1;
      currentItems = [];
    }

    function updateSelection() {
      currentItems.forEach(function (item, index) {
        item.setAttribute('aria-selected', index === selectedIndex ? 'true' : 'false');
      });
      if (selectedIndex >= 0 && currentItems[selectedIndex]) {
        currentItems[selectedIndex].scrollIntoView({ block: 'nearest' });
      }
    }

    var debounceTimer;
    function debounce(fn, delay) {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(fn, delay);
    }

    input.addEventListener('input', function (e) {
      var query = e.target.value.trim();
      if (query.length < 2) {
        hideResults();
        return;
      }
      debounce(function () {
        var results = search(query);
        renderResults(results);
      }, 150);
    });

    input.addEventListener('keydown', function (e) {
      if (resultsContainer.hidden) return;
      var totalItems = currentItems.length;

      if (e.key === 'ArrowDown') {
        e.preventDefault();
        selectedIndex = Math.min(selectedIndex + 1, totalItems - 1);
        updateSelection();
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        selectedIndex = Math.max(selectedIndex - 1, -1);
        updateSelection();
      } else if (e.key === 'Enter' && selectedIndex >= 0) {
        e.preventDefault();
        if (currentItems[selectedIndex]) {
          currentItems[selectedIndex].click();
        }
      } else if (e.key === 'Escape') {
        hideResults();
        input.blur();
      }
    });

    document.addEventListener('click', function (e) {
      if (!e.target.closest('.equipment-search')) {
        hideResults();
      }
      var resultItem = e.target.closest('.equipment-search__result-item');
      if (resultItem) {
        var query = input.value.trim();
        var resultName = resultItem.querySelector('.equipment-search__result-name');
        var name = resultName ? resultName.textContent : '';
        var url = resultItem.getAttribute('href') || '';
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({
          event: 'equipment_search_select',
          result_name: name,
          result_url: url,
          result_type: 'equipment',
          search_query: query,
        });
      }
    });
  })();
</script>
