---
// src/components/rental/EquipmentSearch.astro
// Search bar client-side para encontrar equipos por nombre, categoría o subcategoría.
// Inspirado en "Encuentra tu máquina" de SK Rental.

import Icon from '@/components/ui/Icon.astro';
import { RENTAL_CATEGORIES } from '@/data/rental';

export interface Props {
  placeholder?: string;
  class?: string;
}

const { placeholder = 'Grúa 100 toneladas...', class: className } = Astro.props;

// Build flat search index at build time
interface SearchItem {
  name: string;
  category: string;
  subcategory: string;
  url: string;
  capacity?: string;
}

const searchIndex: SearchItem[] = [];

// Add categories
RENTAL_CATEGORIES.forEach((category) => {
  searchIndex.push({
    name: category.name,
    category: category.name,
    subcategory: '',
    url: `/arriendo/${category.slug}`,
    capacity: '',
  });

  // Add subcategories
  category.subcategories.forEach((sub) => {
    searchIndex.push({
      name: sub.name,
      category: category.name,
      subcategory: sub.name,
      url: `/arriendo/${category.slug}/${sub.slug}`,
      capacity: '',
    });

    // Add equipment
    sub.catalog.forEach((equipment) => {
      searchIndex.push({
        name: equipment.name,
        category: category.name,
        subcategory: sub.name,
        url: `/arriendo/${category.slug}/${sub.slug}`,
        capacity: equipment.capacity,
      });
    });
  });
});

// Serialize for client-side use
const searchIndexJson = JSON.stringify(searchIndex);
---

<div class:list={['equipment-search', className]}>
  <div class="equipment-search__wrapper">
    <div class="equipment-search__input-container">
      <Icon name="search" size={20} class="equipment-search__icon" />
      <input
        type="text"
        class="equipment-search__input"
        placeholder={placeholder}
        aria-label="Buscar equipos"
        role="combobox"
        aria-expanded="false"
        aria-controls="equipment-search-results"
        aria-autocomplete="list"
      />
    </div>
    <div
      id="equipment-search-results"
      class="equipment-search__results"
      role="listbox"
      aria-label="Resultados de búsqueda"
      hidden
    ></div>
  </div>
</div>

<style>
  .equipment-search {
    width: 100%;
    max-width: 480px;
  }

  .equipment-search__wrapper {
    position: relative;
  }

  .equipment-search__input-container {
    position: relative;
    display: flex;
    align-items: center;
  }

  .equipment-search__input-container :global(.equipment-search__icon) {
    position: absolute;
    left: 14px;
    color: var(--color-ink-500, #6b7072);
    pointer-events: none;
    z-index: 1;
  }

  .equipment-search__input {
    width: 100%;
    padding: 12px 14px 12px 44px;
    background-color: rgba(255, 255, 255, 0.95);
    border: 2px solid transparent;
    border-radius: var(--radius-sm, 0.5rem);
    font-family: var(--font-body);
    font-size: var(--text-body);
    color: var(--color-graphite, #0d1611);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .equipment-search__input:focus {
    outline: none;
    border-color: var(--color-brand, #308f40);
    box-shadow: 0 0 0 3px rgba(48, 143, 64, 0.2);
  }

  .equipment-search__input::placeholder {
    color: var(--color-ink-500, #6b7072);
  }

  .equipment-search__results {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    right: 0;
    max-height: 360px;
    overflow-y: auto;
    background-color: var(--theme-bg-elevated);
    border: 1px solid var(--theme-border);
    border-radius: var(--radius-md, 0.75rem);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
    z-index: 50;
  }

  .equipment-search__results[hidden] {
    display: none;
  }

  .equipment-search__result-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 14px;
    text-decoration: none;
    color: var(--theme-text);
    font-family: var(--font-body);
    transition: background-color 0.15s ease;
  }

  .equipment-search__result-item:hover,
  .equipment-search__result-item:focus {
    background-color: var(--theme-bg-alt);
    outline: none;
  }

  .equipment-search__result-item[aria-selected="true"] {
    background-color: var(--theme-bg-alt);
  }

  .equipment-search__result-content {
    display: flex;
    flex-direction: column;
    gap: 3px;
    flex: 1;
  }

  .equipment-search__result-name {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--theme-text);
  }

  .equipment-search__result-meta {
    display: flex;
    gap: 8px;
    font-family: var(--font-body);
    font-size: 0.8rem;
    color: var(--theme-text-muted);
  }

  .equipment-search__result-badge {
    display: inline-block;
    padding: 2px 8px;
    background-color: var(--color-brand, #308f40);
    color: var(--color-on-brand, #ffffff);
    font-family: var(--font-heading);
    font-size: 0.7rem;
    font-weight: 600;
    border-radius: 999px;
  }

  .equipment-search__empty {
    padding: 20px 14px;
    text-align: center;
    color: var(--theme-text-muted);
    font-family: var(--font-body);
    font-size: 0.9rem;
  }

  .equipment-search__empty-link {
    display: inline-block;
    margin-top: 8px;
    color: var(--color-brand-300, #62bb74);
    font-family: var(--font-heading);
    font-weight: 600;
    text-decoration: none;
  }

  .equipment-search__empty-link:hover {
    text-decoration: underline;
  }
</style>

<script define:vars={{ searchIndexJson }}>
  (function () {
    const searchIndex = JSON.parse(searchIndexJson);
    const input = document.querySelector('.equipment-search__input');
    const resultsContainer = document.querySelector('.equipment-search__results');

    if (!input || !resultsContainer) return;

    let selectedIndex = -1;
    let currentResults = [];

    // Normalize string for search (remove diacritics)
    function normalize(str) {
      return str
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '');
    }

    // Hierarchical search: returns only the most specific level of match
    // Priority: equipment name > subcategory > category
    function search(query) {
      const normalizedQuery = normalize(query);
      
      // Level 1: Search in equipment names (most specific)
      const equipmentMatches = searchIndex.filter((item) => {
        return item.name && normalize(item.name).includes(normalizedQuery);
      });
      
      if (equipmentMatches.length > 0) {
        return equipmentMatches;
      }
      
      // Level 2: Search in subcategory names
      const subcategoryMatches = searchIndex.filter((item) => {
        return item.subcategory && normalize(item.subcategory).includes(normalizedQuery);
      });
      
      if (subcategoryMatches.length > 0) {
        return subcategoryMatches;
      }
      
      // Level 3: Search in category names (least specific)
      return searchIndex.filter((item) => {
        return item.category && normalize(item.category).includes(normalizedQuery);
      });
    }

    // Render results
    function renderResults(results) {
      // Tracking: búsqueda realizada
      const query = input.value.trim();
      const searchType = results.length > 0
        ? (results[0].subcategory ? 'equipment' : results[0].category ? 'category' : 'unknown')
        : 'no_results';
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({
        event: 'equipment_search',
        search_query: query,
        results_count: results.length,
        search_type: searchType,
      });

      if (results.length === 0) {
        resultsContainer.innerHTML = `
          <div class="equipment-search__empty">
            No se encontraron equipos.
            <a href="/arriendo" class="equipment-search__empty-link">Ver catálogo completo →</a>
          </div>
        `;
      } else {
        resultsContainer.innerHTML = results
          .slice(0, 8)
          .map((item, index) => `
            <a
              href="${item.url}"
              class="equipment-search__result-item"
              role="option"
              aria-selected="${index === selectedIndex}"
              data-index="${index}"
            >
              <div class="equipment-search__result-content">
                <div class="equipment-search__result-name">${item.name}</div>
                <div class="equipment-search__result-meta">
                  <span>${item.category}</span>
                  ${item.subcategory ? `<span>› ${item.subcategory}</span>` : ''}
                </div>
              </div>
              ${item.capacity ? `<span class="equipment-search__result-badge">${item.capacity}</span>` : ''}
            </a>
          `)
          .join('');
      }
      resultsContainer.hidden = false;
      input.setAttribute('aria-expanded', 'true');
    }

    // Hide results
    function hideResults() {
      resultsContainer.hidden = true;
      input.setAttribute('aria-expanded', 'false');
      selectedIndex = -1;
    }

    // Update selected item
    function updateSelection() {
      const items = resultsContainer.querySelectorAll('.equipment-search__result-item');
      items.forEach((item, index) => {
        item.setAttribute('aria-selected', index === selectedIndex ? 'true' : 'false');
      });
    }

    // Debounce
    let debounceTimer;
    function debounce(fn, delay) {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(fn, delay);
    }

    // Event listeners
    input.addEventListener('input', (e) => {
      const query = e.target.value.trim();
      if (query.length < 2) {
        hideResults();
        return;
      }
      debounce(() => {
        currentResults = search(query);
        selectedIndex = -1;
        renderResults(currentResults);
      }, 200);
    });

    input.addEventListener('keydown', (e) => {
      if (resultsContainer.hidden) return;

      if (e.key === 'ArrowDown') {
        e.preventDefault();
        selectedIndex = Math.min(selectedIndex + 1, currentResults.length - 1);
        updateSelection();
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        selectedIndex = Math.max(selectedIndex - 1, -1);
        updateSelection();
      } else if (e.key === 'Enter' && selectedIndex >= 0) {
        e.preventDefault();
        const selectedItem = resultsContainer.querySelector(`[data-index="${selectedIndex}"]`);
        if (selectedItem) {
          selectedItem.click();
        }
      } else if (e.key === 'Escape') {
        hideResults();
      }
    });

    // Close on outside click
    document.addEventListener('click', (e) => {
      if (!e.target.closest('.equipment-search')) {
        hideResults();
      }
      // Tracking: selección de resultado de búsqueda
      const resultItem = e.target.closest('.equipment-search__result-item');
      if (resultItem) {
        const query = input.value.trim();
        const resultName = resultItem.querySelector('.equipment-search__result-name')?.textContent ?? '';
        const resultUrl = resultItem.getAttribute('href') ?? '';
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({
          event: 'equipment_search_select',
          result_name: resultName,
          result_url: resultUrl,
          result_type: 'equipment',
          search_query: query,
        });
      }
    });
  })();
</script>
