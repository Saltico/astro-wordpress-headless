---
// src/components/seo/MetaTags.astro
import type { MetaTagsProps } from '@/types/seo';

export interface Props extends MetaTagsProps {}

const {
  title,
  description,
  canonical,
  robots = 'index, follow, max-image-preview:large',
  ogImage,
  ogType = 'website',
  twitterCard = 'summary_large_image',
  hreflang,
  noindex = false,
} = Astro.props;

const finalRobots = noindex ? 'noindex, nofollow' : robots;
const ogImageUrl = ogImage ?? new URL('/og-default.jpg', canonical).toString();
---

<meta name="robots" content={finalRobots} />
<link rel="canonical" href={canonical} />

<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:locale" content="es_CL" />
<meta property="og:site_name" content="IP Proyectos Industriales" />

<meta name="twitter:card" content={twitterCard} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

{
  hreflang &&
    Object.entries(hreflang).map(([lang, url]) => (
      <link rel="alternate" hreflang={lang} href={url} />
    ))
}

<link rel="alternate" hreflang="x-default" href={canonical} />
