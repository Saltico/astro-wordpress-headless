---
// src/components/seo/Breadcrumbs.astro
import JsonLd from './JsonLd.astro';
import type { BreadcrumbsProps } from '@/types/seo';

export interface Props extends BreadcrumbsProps {
  variant?: 'default' | 'hero';
}

const { items, variant = 'default' } = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    item: item.url ? new URL(item.url, Astro.site).toString() : undefined,
  })),
};

const variantClass = variant === 'hero' ? 'breadcrumbs--hero' : '';
---

<nav aria-label="Breadcrumb" class:list={['breadcrumbs', variantClass]}>
  <ol class="breadcrumbs__list">
    {
      items.map((item, index) => (
        <li class="breadcrumbs__item">
          {item.url && index < items.length - 1 ? (
            <a href={item.url} class="breadcrumbs__link">
              {item.label}
            </a>
          ) : (
            <span class="breadcrumbs__current" aria-current="page">
              {item.label}
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<JsonLd data={schema} />

<style>
  .breadcrumbs {
    margin-bottom: var(--space-6);
  }

  .breadcrumbs__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-small);
    color: var(--theme-text-muted);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .breadcrumbs__item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .breadcrumbs__item:not(:last-child)::after {
    content: '/';
    color: var(--theme-border);
  }

  .breadcrumbs__link {
    color: var(--theme-text-subtle);
    text-decoration: none;
    transition: color var(--motion-base) var(--ease-out);
  }

  .breadcrumbs__link:hover,
  .breadcrumbs__link:focus {
    color: var(--color-brand);
  }

  .breadcrumbs__current {
    color: var(--theme-text);
    font-weight: 500;
  }

  /* Variant: hero (para usar sobre imágenes de fondo) */
  .breadcrumbs--hero {
    margin-bottom: var(--space-4);
  }

  .breadcrumbs--hero .breadcrumbs__list {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.7);
  }

  .breadcrumbs--hero .breadcrumbs__item:not(:last-child)::after {
    color: rgba(255, 255, 255, 0.4);
  }

  .breadcrumbs--hero .breadcrumbs__link {
    color: rgba(255, 255, 255, 0.85);
  }

  .breadcrumbs--hero .breadcrumbs__link:hover,
  .breadcrumbs--hero .breadcrumbs__link:focus {
    color: var(--color-on-dark);
  }

  .breadcrumbs--hero .breadcrumbs__current {
    color: rgba(255, 255, 255, 0.95);
  }
</style>
