---
// src/components/layout/Navigation.astro
import type { NavItem, NavigationProps } from '@/types/navigation';

export interface Props extends NavigationProps {
  variant?: 'default' | 'brand';
}

const {
  items,
  activePath = Astro.url.pathname,
  ariaLabel = 'Navegación principal',
  variant = 'brand',
} = Astro.props;
const navClassList = ['nav', variant === 'brand' && 'nav--brand'];

function isActive(item: NavItem): boolean {
  if (item.url === activePath) return true;
  if (item.children?.some((child) => child.url === activePath)) return true;
  return false;
}
---

<nav class:list={navClassList} aria-label={ariaLabel}>
  <button
    type="button"
    class="nav__toggle"
    aria-expanded="false"
    aria-controls="nav-dialog"
    aria-label="Abrir menú"
  >
    <span class="nav__hamburger" aria-hidden="true"></span>
    <span class="sr-only">Menú</span>
  </button>

  <ul class="nav__list nav__list--desktop">
    {
      items.map((item) => (
        <li class:list={['nav__item', item.children && 'nav__item--has-children', isActive(item) && 'is-active']}>
          <a href={item.url} class="nav__link" aria-current={isActive(item) ? 'page' : undefined}>
            {item.label}
            {item.children && (
              <svg class="nav__caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="m6 9 6 6 6-6"/>
              </svg>
            )}
          </a>
          {item.children && (
            <ul class="nav__submenu">
              {item.children.map((child) => (
                <li class="nav__subitem">
                  <a href={child.url} class="nav__sublink" aria-current={child.url === activePath ? 'page' : undefined}>
                    {child.label}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))
    }
  </ul>

  <dialog id="nav-dialog" class="nav__dialog" aria-label={ariaLabel}>
    <div class="nav__dialog-header">
      <span class="nav__dialog-title">Menú</span>
      <button type="button" class="nav__close" aria-label="Cerrar menú">
        <span aria-hidden="true">×</span>
      </button>
    </div>

    <ul class="nav__list nav__list--mobile">
      {
        items.map((item) => (
          <li class="nav__mobile-item">
            <a href={item.url} class="nav__mobile-link" aria-current={isActive(item) ? 'page' : undefined}>
              {item.label}
            </a>
            {item.children && (
              <ul class="nav__mobile-submenu">
                {item.children.map((child) => (
                  <li>
                    <a href={child.url} class="nav__mobile-sublink" aria-current={child.url === activePath ? 'page' : undefined}>
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ul>
  </dialog>
</nav>

<script>
  (function () {
    const toggle = document.querySelector('.nav__toggle');
    const dialog = document.getElementById('nav-dialog') as HTMLDialogElement | null;
    const closeBtn = document.querySelector('.nav__close');

    if (!toggle || !dialog) return;

    const openMenu = () => {
      dialog.showModal();
      toggle.setAttribute('aria-expanded', 'true');
    };

    const closeMenu = () => {
      dialog.close();
      toggle.setAttribute('aria-expanded', 'false');
      toggle.focus();
    };

    toggle.addEventListener('click', openMenu);
    closeBtn?.addEventListener('click', closeMenu);

    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) {
        closeMenu();
      }
    });

    dialog.addEventListener('close', () => {
      toggle.setAttribute('aria-expanded', 'false');
    });
  })();
</script>

<style>
  .nav {
    display: flex;
    align-items: center;
  }

  .nav__toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    background: transparent;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    color: var(--color-ink);
  }

  @media (min-width: 1024px) {
    .nav__toggle {
      display: none;
    }
  }

  .nav__hamburger {
    position: relative;
    display: block;
    width: 1.25rem;
    height: 2px;
    background-color: currentColor;
  }

  .nav__hamburger::before,
  .nav__hamburger::after {
    content: '';
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: currentColor;
  }

  .nav__hamburger::before {
    top: -6px;
  }

  .nav__hamburger::after {
    top: 6px;
  }

  .nav__list--desktop {
    display: none;
    align-items: center;
    gap: var(--space-6);
  }

  @media (min-width: 1024px) {
    .nav__list--desktop {
      display: flex;
    }
  }

  .nav__item {
    position: relative;
  }

  .nav__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-2);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-ink-700);
    transition: color var(--motion-base) var(--ease-out);
    border-bottom: 2px solid transparent;
  }

  @media (min-width: 1280px) {
    .nav__link {
      font-size: 0.9375rem;
    }
  }

  .nav__link:hover,
  .nav__link:focus,
  .nav__item.is-active > .nav__link {
    color: var(--color-brand);
    border-bottom-color: var(--color-brand);
  }

  .nav__item--has-children > .nav__link {
    cursor: pointer;
  }

  .nav__caret {
    width: 12px;
    height: 12px;
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .nav__item--has-children:hover > .nav__link .nav__caret,
  .nav__item--has-children:focus-within > .nav__link .nav__caret {
    transform: rotate(180deg);
  }

  .nav__submenu {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 220px;
    padding: var(--space-3);
    background-color: rgba(13, 22, 17, 0.92);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-md);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition: opacity var(--motion-base) var(--ease-out),
      visibility var(--motion-base) var(--ease-out),
      transform var(--motion-base) var(--ease-out);
    z-index: 100;
  }

  .nav__item--has-children:hover > .nav__submenu,
  .nav__item--has-children:focus-within > .nav__submenu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .nav__sublink {
    display: block;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    font-size: 0.875rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.9);
    transition: background-color var(--motion-base) var(--ease-out),
      color var(--motion-base) var(--ease-out);
  }

  @media (min-width: 1280px) {
    .nav__sublink {
      font-size: 0.9375rem;
    }
  }

  .nav__sublink:hover,
  .nav__sublink:focus,
  .nav__sublink[aria-current='page'] {
    background-color: rgba(255, 255, 255, 0.08);
    color: var(--color-on-dark);
  }

  .nav__dialog {
    width: min(85vw, 320px);
    height: 100vh;
    max-height: 100vh;
    margin: 0;
    margin-left: auto;
    padding: 0;
    border: none;
    border-radius: 0;
    background-color: var(--color-surface);
  }

  .nav__dialog::backdrop {
    background-color: rgba(0, 0, 0, 0.4);
  }

  .nav__dialog-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-4);
    border-bottom: 1px solid var(--color-line);
  }

  .nav__dialog-title {
    font-weight: 700;
    font-size: 1.125rem;
  }

  .nav__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    background: transparent;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    font-size: 1.5rem;
    line-height: 1;
    color: var(--color-ink);
  }

  .nav__list--mobile {
    padding: var(--space-4);
  }

  .nav__mobile-item {
    border-bottom: 1px solid var(--color-line);
  }

  .nav__mobile-link {
    display: block;
    padding: var(--space-4) 0;
    font-weight: 600;
    color: var(--color-ink);
  }

  .nav__mobile-link[aria-current='page'] {
    color: var(--color-brand);
  }

  .nav__mobile-submenu {
    padding-left: var(--space-4);
    padding-bottom: var(--space-4);
  }

  .nav__mobile-sublink {
    display: block;
    padding: var(--space-2) 0;
    color: var(--color-ink-700);
  }

  .nav__mobile-sublink[aria-current='page'] {
    color: var(--color-brand);
  }

  /* Variant: brand (header verde) */
  .nav--brand .nav__toggle {
    color: var(--color-on-brand);
    border-color: rgba(255, 255, 255, 0.4);
  }

  .nav--brand .nav__toggle:hover,
  .nav--brand .nav__toggle:focus {
    background-color: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.6);
  }

  .nav--brand .nav__link {
    color: rgba(255, 255, 255, 0.92);
    border-bottom-color: transparent;
  }

  .nav--brand .nav__link:hover,
  .nav--brand .nav__link:focus,
  .nav--brand .nav__item.is-active > .nav__link {
    color: var(--color-on-dark);
    border-bottom-color: var(--color-on-dark);
  }

  .nav--brand .nav__item--has-children > .nav__link .nav__caret {
    color: rgba(255, 255, 255, 0.7);
  }
</style>
