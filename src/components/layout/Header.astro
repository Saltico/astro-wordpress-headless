---
// src/components/layout/Header.astro
export interface Props {
  compact?: boolean;
}

const { compact = true } = Astro.props;
---

{compact && <div class="header__sentinel" aria-hidden="true"></div>}

<header class="header" role="banner">
  <div class="header__inner">
    <div class="header__logo">
      <slot name="logo">
        <a href="/" class="header__brand">IP Proyectos Industriales</a>
      </slot>
    </div>

    <div class="header__nav">
      <slot name="navigation" />
    </div>

    <div class="header__cta">
      <slot name="cta">
        <a href="/contacto" class="header__cta-button">Solicitar cotización</a>
      </slot>
    </div>
  </div>
</header>

{compact && (
  <script>
    (function () {
      const sentinel = document.querySelector('.header__sentinel');
      const header = document.querySelector('.header');
      if (!sentinel || !header) return;

      const observer = new IntersectionObserver(
        ([entry]) => {
          header.classList.toggle('is-compact', !entry.isIntersecting);
        },
        { threshold: [1] }
      );

      observer.observe(sentinel);
    })();
  </script>
)}

<style>
  .header__sentinel {
    position: absolute;
    top: 1px;
    left: 0;
    width: 100%;
    height: 1px;
    pointer-events: none;
  }

  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: var(--color-surface);
    border-bottom: 1px solid transparent;
    height: var(--header-height);
    transition: height var(--motion-base) var(--ease-out),
      box-shadow var(--motion-base) var(--ease-out),
      border-color var(--motion-base) var(--ease-out);
  }

  .header.is-compact {
    height: var(--header-compact-height);
    border-color: var(--color-line);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    max-width: var(--container-max-width);
    height: 100%;
    margin-inline: auto;
    padding-inline: var(--container-padding);
  }

  .header__logo {
    flex-shrink: 0;
  }

  .header__brand {
    display: inline-block;
    font-weight: 700;
    font-size: 1.125rem;
    color: var(--color-ink);
  }

  @media (min-width: 768px) {
    .header__brand {
      font-size: 1.25rem;
    }
  }

  .header__nav {
    flex: 1;
    display: flex;
    justify-content: flex-end;
  }

  @media (min-width: 1024px) {
    .header__nav {
      justify-content: center;
    }
  }

  .header__cta {
    display: none;
    flex-shrink: 0;
  }

  @media (min-width: 1024px) {
    .header__cta {
      display: block;
    }
  }

  .header__cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0.625rem 1.25rem;
    background-color: var(--color-brand);
    color: var(--color-on-brand);
    font-weight: 600;
    border-radius: var(--radius-sm);
    transition: background-color var(--motion-base) var(--ease-out),
      transform var(--motion-base) var(--ease-out);
  }

  .header__cta-button:hover,
  .header__cta-button:focus {
    background-color: var(--color-brand-600);
    transform: scale(1.02);
  }

  .header__cta-button:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
  }
</style>
