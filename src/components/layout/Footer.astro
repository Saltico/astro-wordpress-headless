---
// src/components/layout/Footer.astro
import type { FooterColumn, FooterLink, SocialLink } from '@/types/layout';
import Icon from '@/components/ui/Icon.astro';
import Button from '@/components/ui/Button.astro';
import type { IconName } from '@/lib/icons';

export interface Props {
  columns: FooterColumn[];
  legal: FooterLink[];
  brand: string;
  description?: string;
  phone?: string;
  email?: string;
  address?: string;
  schedule?: string;
  social?: SocialLink[];
  logoUrl?: string;
  logoAlt?: string;
  catalogUrl?: string;
  catalogLabel?: string;
  siteUrl?: string;
}

const {
  columns,
  legal,
  brand,
  description = '',
  phone,
  email,
  address,
  schedule,
  social = [],
  logoUrl,
  logoAlt = brand,
  catalogUrl,
  catalogLabel = 'Descargar catálogo',
  siteUrl,
} = Astro.props;

const socialIconMap: Record<SocialLink['platform'], IconName> = {
  linkedin: 'linkedin',
  instagram: 'instagram',
  facebook: 'facebook',
  whatsapp: 'whatsapp',
};
---

<footer class="footer" role="contentinfo">
  <div class="footer__main">
    <div class="footer__grid">
      <!-- Columna Brand -->
      <div class="footer__brand">
        {logoUrl ? (
          <img src={logoUrl} alt={logoAlt} class="footer__logo-img" loading="lazy" />
        ) : (
          <p class="footer__logo">{brand}</p>
        )}
        {description && <p class="footer__description">{description}</p>}
        {social.length > 0 && (
          <div class="footer__social">
            {social.map((link) => (
              <a
                href={link.url}
                class="footer__social-link"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={link.label || link.platform}
              >
                <Icon name={socialIconMap[link.platform]} size={18} />
              </a>
            ))}
          </div>
        )}
      </div>

      <!-- Columnas de Links -->
      {columns.map((column) => (
        <div class="footer__column">
          <h4 class="footer__title">{column.title}</h4>
          <ul class="footer__list">
            {column.links.map((link) => (
              <li>
                <a href={link.url} class="footer__link">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}

      <!-- Columna Contacto -->
      <div class="footer__column footer__column--contact">
        <h4 class="footer__title">Contacto</h4>
        <ul class="footer__contact-list">
          {address && (
            <li class="footer__contact-item">
              <Icon name="location" size={16} />
              <span>{address}</span>
            </li>
          )}
          {phone && (
            <li class="footer__contact-item">
              <Icon name="phone" size={16} />
              <span>
                <a href={`tel:${phone.replace(/\s/g, '')}`} class="footer__contact-link">{phone}</a>
              </span>
            </li>
          )}
          {email && (
            <li class="footer__contact-item">
              <Icon name="email" size={16} />
              <span>
                <a href={`mailto:${email}`} class="footer__contact-link">{email}</a>
              </span>
            </li>
          )}
          {schedule && (
            <li class="footer__contact-item">
              <Icon name="clock" size={16} />
              <span>{schedule}</span>
            </li>
          )}
        </ul>
        {catalogUrl && (
          <div class="footer__catalog-action">
            <Button
              href={catalogUrl}
              variant="primary"
              icon="download"
              target="_blank"
              download
            >
              {catalogLabel}
            </Button>
          </div>
        )}
      </div>
    </div>
  </div>

  <div class="footer__legal">
    <div class="footer__legal-inner">
      <p class="footer__copy">&copy; {new Date().getFullYear()} {brand}. Todos los derechos reservados.</p>
      {siteUrl && <span class="footer__site-url">{siteUrl}</span>}
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-graphite, #0d1611);
    color: rgba(255, 255, 255, 0.7);
  }

  .footer__main {
    max-width: var(--container-max-width);
    margin-inline: auto;
    padding: var(--space-12) var(--container-padding, 20px);
  }

  .footer__grid {
    display: grid;
    gap: var(--space-8);
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1024px) {
    .footer__grid {
      grid-template-columns: 1.5fr repeat(3, 1fr);
    }
  }

  /* Brand Column */
  .footer__brand {
    max-width: 300px;
  }

  .footer__logo-img {
    width: auto;
    height: 2.5rem;
    margin-bottom: var(--space-4);
  }

  .footer__logo {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-on-dark);
    margin-bottom: var(--space-3);
  }

  .footer__description {
    margin: 0 0 var(--space-5);
    line-height: 1.6;
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.6);
  }

  .footer__social {
    display: flex;
    gap: var(--space-3);
  }

  .footer__social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    color: rgba(255, 255, 255, 0.6);
    background: rgba(255, 255, 255, 0.08);
    border-radius: 50%;
    transition: color 0.2s ease, background 0.2s ease, transform 0.2s ease;
  }

  .footer__social-link:hover,
  .footer__social-link:focus {
    color: var(--color-brand-300, #4ade80);
    background: rgba(255, 255, 255, 0.15);
    transform: translateY(-2px);
  }

  /* Link Columns */
  .footer__column {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer__title {
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--color-on-dark);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 0 0 var(--space-2);
  }

  .footer__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer__link {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.6);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer__link:hover,
  .footer__link:focus {
    color: var(--color-brand-300, #4ade80);
  }

  /* Contact Column */
  .footer__contact-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer__contact-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.6);
  }

  .footer__contact-item :global(svg) {
    flex-shrink: 0;
    color: var(--color-brand-300, #4ade80);
    margin-top: 2px;
  }

  .footer__contact-link {
    color: rgba(255, 255, 255, 0.6);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer__contact-link:hover,
  .footer__contact-link:focus {
    color: var(--color-brand-300, #4ade80);
  }

  /* Wrapper del CTA de catálogo: el botón es el componente unificado
     <Button variant="primary">; aquí solo el espaciado de layout. */
  .footer__catalog-action {
    margin-top: var(--space-4);
  }

  /* Legal Bar */
  .footer__legal {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .footer__legal-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: var(--container-max-width);
    margin-inline: auto;
    padding: var(--space-4) var(--container-padding, 20px);
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.4);
  }

  @media (min-width: 768px) {
    .footer__legal-inner {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .footer__copy {
    margin: 0;
  }

  .footer__site-url {
    color: rgba(255, 255, 255, 0.4);
  }
</style>
