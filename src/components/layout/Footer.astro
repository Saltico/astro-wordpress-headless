---
// src/components/layout/Footer.astro
import type { FooterColumn, FooterLink } from '@/types/layout';

export interface Props {
  columns: FooterColumn[];
  legal: FooterLink[];
  brand: string;
  description?: string;
  phone?: string;
  email?: string;
}

const {
  columns,
  legal,
  brand,
  description = '',
  phone,
  email,
} = Astro.props;
---

<footer class="footer" role="contentinfo">
  <div class="footer__main">
    <div class="footer__grid">
      <div class="footer__brand">
        <p class="footer__logo">{brand}</p>
        {description && <p class="footer__description">{description}</p>}
        {(phone || email) && (
          <address class="footer__contact">
            {phone && (
              <a href={`tel:${phone.replace(/\s/g, '')}`} class="footer__contact-link">
                {phone}
              </a>
            )}
            {email && (
              <a href={`mailto:${email}`} class="footer__contact-link">
                {email}
              </a>
            )}
          </address>
        )}
      </div>

      {
        columns.map((column) => (
          <details class="footer__column" open>
            <summary class="footer__title">{column.title}</summary>
            <ul class="footer__list">
              {column.links.map((link) => (
                <li>
                  <a href={link.url} class="footer__link">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        ))
      }
    </div>
  </div>

  <div class="footer__legal">
    <div class="footer__legal-inner">
      <p class="footer__copy">© {new Date().getFullYear()} {brand}. Todos los derechos reservados.</p>
      <ul class="footer__legal-list">
        {
          legal.map((link) => (
            <li>
              <a href={link.url} class="footer__legal-link">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-surface-alt);
    border-top: 1px solid var(--color-line);
    color: var(--color-ink-700);
  }

  .footer__main {
    max-width: var(--container-max-width);
    margin-inline: auto;
    padding: var(--space-12) var(--container-padding);
  }

  .footer__grid {
    display: grid;
    gap: var(--space-8);
  }

  @media (min-width: 768px) {
    .footer__grid {
      grid-template-columns: 2fr repeat(auto-fit, minmax(140px, 1fr));
      gap: var(--space-8);
    }

    .footer__column {
      display: block;
    }

    .footer__column > summary {
      pointer-events: none;
      list-style: none;
    }

    .footer__column > summary::-webkit-details-marker {
      display: none;
    }
  }

  .footer__brand {
    max-width: 320px;
  }

  .footer__logo {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-ink);
    margin-bottom: var(--space-3);
  }

  .footer__description {
    margin-bottom: var(--space-4);
    line-height: 1.5;
  }

  .footer__contact {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-style: normal;
  }

  .footer__contact-link {
    color: var(--color-brand);
    transition: color var(--motion-base) var(--ease-out);
  }

  .footer__contact-link:hover,
  .footer__contact-link:focus {
    color: var(--color-brand-600);
  }

  .footer__column {
    border-bottom: 1px solid var(--color-line);
    padding-bottom: var(--space-4);
  }

  @media (min-width: 768px) {
    .footer__column {
      border-bottom: none;
      padding-bottom: 0;
    }
  }

  .footer__title {
    font-weight: 600;
    color: var(--color-ink);
    cursor: pointer;
    padding: var(--space-2) 0;
    list-style: none;
  }

  .footer__title::-webkit-details-marker {
    display: none;
  }

  .footer__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }

  .footer__link {
    transition: color var(--motion-base) var(--ease-out);
  }

  .footer__link:hover,
  .footer__link:focus {
    color: var(--color-brand);
  }

  .footer__legal {
    border-top: 1px solid var(--color-line);
    background-color: var(--color-surface);
  }

  .footer__legal-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: var(--container-max-width);
    margin-inline: auto;
    padding: var(--space-4) var(--container-padding);
    font-size: 0.875rem;
  }

  @media (min-width: 768px) {
    .footer__legal-inner {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .footer__legal-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .footer__legal-link:hover,
  .footer__legal-link:focus {
    color: var(--color-brand);
  }
</style>
