---
// src/components/layout/SkipLink.astro
export interface Props {
  targetId?: string;
  label?: string;
}

const { targetId = 'main-content', label = 'Saltar al contenido principal' } = Astro.props;
---

<a href={`#${targetId}`} class="skip-link">
  {label}
</a>

<style>
  .skip-link {
    position: absolute;
    top: -100%;
    left: var(--space-4);
    z-index: 9999;
    padding: var(--space-3) var(--space-4);
    background-color: var(--color-brand);
    color: var(--color-on-brand);
    border-radius: var(--radius-sm);
    font-weight: 600;
    transition: top var(--motion-base) var(--ease-out);
  }

  .skip-link:focus {
    top: var(--space-4);
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }
</style>
