---
// src/components/quote/QuoteReview.astro
// Paso 3 del wizard: resumen de equipos y datos de empresa, y acciones de envío.
//
// Jerarquía visual: encabezado de paso → grid con columna principal
// (equipos + notas) y columna lateral (empresa + totales destacados) →
// acciones finales. Edición contextual desde cada tarjeta.

import Button from '@/components/ui/Button.astro';
---

<section class="quote-review" aria-labelledby="quote-review-title">
  <div class="quote-review__grid">
    <div class="quote-review__main">
      <section class="quote-review__card" aria-labelledby="quote-review-lines-title">
        <div class="quote-review__card-head">
          <h3 id="quote-review-lines-title" class="quote-review__card-title">
            Equipos seleccionados
            <span class="quote-review__count" data-review-count>0</span>
          </h3>
          <Button variant="ghost" type="button" data-quote-wizard-step1>
            Editar equipos
          </Button>
        </div>
        <div class="quote-review__lines" data-review-lines aria-live="polite">
          {/* Renderizado desde cliente */}
        </div>
      </section>

      <section
        class="quote-review__notes-card"
        data-review-notes-card
        aria-labelledby="quote-review-notes-title"
        hidden
      >
        <h3 id="quote-review-notes-title" class="quote-review__card-title">Notas globales</h3>
        <p class="quote-review__notes" data-review-notes></p>
      </section>
    </div>

    <aside class="quote-review__side">
      <section class="quote-review__card" aria-labelledby="quote-review-company-title">
        <div class="quote-review__card-head">
          <h3 id="quote-review-company-title" class="quote-review__card-title">Datos de la empresa</h3>
          <Button icon="trash" variant="ghost" type="button" data-quote-wizard-prev="review">
          </Button>
        </div>
        <div class="quote-review__company" data-review-company>
          {/* Renderizado desde cliente */}
        </div>
      </section>

      <section
        class="quote-review__card quote-review__card--totals"
        aria-labelledby="quote-review-totals-title"
      >
        <h3 id="quote-review-totals-title" class="quote-review__card-title">Totales</h3>
        <dl class="quote-review__totals">
          <div class="quote-review__total">
            <dt>Equipos distintos</dt>
            <dd data-review-stat="unique">0</dd>
          </div>
          <div class="quote-review__total">
            <dt>Unidades totales</dt>
            <dd data-review-stat="units">0</dd>
          </div>
          <div class="quote-review__total">
            <dt>Días agregados</dt>
            <dd data-review-stat="days">0</dd>
          </div>
          <div class="quote-review__total">
            <dt>Mayor fecha de inicio</dt>
            <dd data-review-stat="earliest">—</dd>
          </div>
          <div class="quote-review__total">
            <dt>Final calculado</dt>
            <dd data-review-stat="latestEnd">—</dd>
          </div>
        </dl>
      </section>
    </aside>
  </div>

  <footer class="quote-review__actions">
    <p class="quote-review__hint">
      Al enviar se abre WhatsApp con el detalle completo de tu cotización.
    </p>
    <div class="quote-review__cta-group">
      <Button
        href="#"
        variant="ghost"
        icon="whatsapp"
        data-review-action="talk"
        target="_blank"
      >
        Hablar con ejecutivo
      </Button>
      <Button
        href="#"
        variant="primary"
        size="lg"
        icon="whatsapp"
        data-review-action="send"
        target="_blank"
      >
        Enviar cotización
      </Button>
    </div>
  </footer>
</section>

<script>
  import { getCart, subscribe } from '@/lib/quoteCart';
  import { getCompanyData, subscribeCompanyData } from '@/lib/quoteCompany';
  import { getGlobalNotes, subscribeGlobalNotes } from '@/lib/quoteGlobalNotes';
  import { buildWhatsAppUrl, buildWhatsAppTalkUrl, computeCartTotals, formatPeriodLabel } from '@/lib/quoteMessage';
  import { formatRut, normalizePhone } from '@/types/quoteCompany';
  import type { QuoteCartItem } from '@/types/quote';

  function escapeHtml(s: string): string {
    return s.replace(/[&<>"']/g, (ch) => {
      const map: Record<string, string> = {
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#39;',
      };
      return map[ch] ?? ch;
    });
  }

  function renderLine(item: QuoteCartItem): string {
    const c = item.customization;
    const transport =
      c.transport === 'si'
        ? c.transportAddress
          ? `Sí — ${escapeHtml(c.transportAddress)}`
          : 'Sí'
        : 'No';
    return `
      <article class="quote-review__line">
        <div class="quote-review__line-thumb-wrapper">
          <img src="${escapeHtml(item.image)}" alt="${escapeHtml(item.name)}" class="quote-review__line-thumb" loading="lazy" />
        </div>
        <div class="quote-review__line-content">
          <div class="quote-review__line-header">
            <h4 class="quote-review__line-name">${escapeHtml(item.name)}</h4>
            <p class="quote-review__line-specs">${escapeHtml([item.capacity, item.height].filter(Boolean).join(' · '))}</p>
          </div>
          <div class="quote-review__line-details">
            <div class="quote-review__line-detail">
              <span class="quote-review__line-detail-label">Cantidad</span>
              <span class="quote-review__line-detail-value quote-review__line-detail-value--highlight">${c.quantity}</span>
            </div>
            <div class="quote-review__line-detail">
              <span class="quote-review__line-detail-label">Período</span>
              <span class="quote-review__line-detail-value quote-review__line-detail-value--highlight">${formatPeriodLabel(c.periodType, c.periodCount)}</span>
            </div>
            <div class="quote-review__line-detail">
              <span class="quote-review__line-detail-label">Inicio</span>
              <span class="quote-review__line-detail-value">${c.startDate}</span>
            </div>
            <div class="quote-review__line-detail">
              <span class="quote-review__line-detail-label">Traslado</span>
              <span class="quote-review__line-detail-value">${transport}</span>
            </div>
          </div>
          ${c.notes ? `<p class="quote-review__line-notes">${escapeHtml(c.notes)}</p>` : ''}
        </div>
      </article>
    `;
  }

  function renderCompany(): string {
    const data = getCompanyData();
    if (!data.razonSocial && !data.rut) {
      return '<p class="quote-review__empty">Aún no has ingresado los datos de la empresa.</p>';
    }

    // Agrupar datos por categorías lógicas
    const sections: { title: string; fields: { label: string; value: string }[] }[] = [];

    // Identificación fiscal
    const fiscalFields: { label: string; value: string }[] = [];
    if (data.razonSocial) fiscalFields.push({ label: 'Razón social', value: escapeHtml(data.razonSocial) });
    if (data.rut) fiscalFields.push({ label: 'RUT', value: escapeHtml(formatRut(data.rut)) });
    if (data.nombreFantasia) fiscalFields.push({ label: 'Nombre fantasía', value: escapeHtml(data.nombreFantasia) });
    if (data.giro) fiscalFields.push({ label: 'Giro', value: escapeHtml(data.giro) });
    if (fiscalFields.length > 0) {
      sections.push({ title: 'Identificación', fields: fiscalFields });
    }

    // Ubicación
    const locationFields: { label: string; value: string }[] = [];
    if (data.direccion) locationFields.push({ label: 'Dirección', value: escapeHtml(data.direccion) });
    if (data.ciudad || data.comuna) {
      const location = [data.ciudad, data.comuna].filter(Boolean).join(', ');
      locationFields.push({ label: 'Ciudad / Comuna', value: escapeHtml(location) });
    }
    if (locationFields.length > 0) {
      sections.push({ title: 'Ubicación', fields: locationFields });
    }

    // Contacto
    const contactFields: { label: string; value: string }[] = [];
    if (data.nombreContacto) contactFields.push({ label: 'Contacto', value: escapeHtml(data.nombreContacto) });
    if (data.email) contactFields.push({ label: 'Email', value: `<a href="mailto:${escapeHtml(data.email)}">${escapeHtml(data.email)}</a>` });
    if (data.telefono) {
      const phoneDigits = normalizePhone(data.telefono);
      contactFields.push({ label: 'Teléfono', value: `<a href="tel:${phoneDigits}">${escapeHtml(data.telefono)}</a>` });
    }
    if (contactFields.length > 0) {
      sections.push({ title: 'Contacto', fields: contactFields });
    }

    // Renderizar secciones con formato horizontal label: value
    return sections.map((section) => `
      <div class="quote-review__company-section">
        <h4 class="quote-review__company-section-title">${section.title}</h4>
        <dl class="quote-review__company-fields">
          ${section.fields.map((field) => `
            <div class="quote-review__company-field">
              <dt>${field.label}</dt>
              <dd>${field.value}</dd>
            </div>
          `).join('')}
        </dl>
      </div>
    `).join('');
  }

  function setText(selector: string, value: string): void {
    const el = document.querySelector<HTMLElement>(`[data-review-stat="${selector}"]`);
    if (el) el.textContent = value;
  }

  function paint(): void {
    const cart = getCart();
    const company = getCompanyData();
    const globalNotes = getGlobalNotes();
    const totals = computeCartTotals(cart);

    const linesEl = document.querySelector<HTMLElement>('[data-review-lines]');
    if (linesEl) {
      if (cart.items.length === 0) {
        linesEl.innerHTML = '<p class="quote-review__empty">No hay equipos en el cotizador.</p>';
      } else {
        linesEl.innerHTML = cart.items.map((item) => renderLine(item)).join('');
      }
    }

    const countEl = document.querySelector<HTMLElement>('[data-review-count]');
    if (countEl) countEl.textContent = String(totals.uniqueItems);

    const companyEl = document.querySelector<HTMLElement>('[data-review-company]');
    if (companyEl) companyEl.innerHTML = renderCompany();

    setText('unique', String(totals.uniqueItems));
    setText('units', String(totals.totalUnits));
    setText('days', String(totals.totalDays));
    setText('earliest', totals.earliestStart ?? '—');
    setText('latestEnd', totals.latestEnd ?? '—');

    const notesCard = document.querySelector<HTMLElement>('[data-review-notes-card]');
    const notesEl = document.querySelector<HTMLElement>('[data-review-notes]');
    if (notesCard && notesEl) {
      if (globalNotes.trim()) {
        notesCard.hidden = false;
        notesEl.textContent = globalNotes;
      } else {
        notesCard.hidden = true;
      }
    }

    const sendBtn = document.querySelector<HTMLAnchorElement>('[data-review-action="send"]');
    if (sendBtn) {
      if (cart.items.length === 0) {
        sendBtn.setAttribute('aria-disabled', 'true');
        sendBtn.classList.add('is-disabled');
      } else {
        sendBtn.removeAttribute('aria-disabled');
        sendBtn.classList.remove('is-disabled');
        sendBtn.href = buildWhatsAppUrl(cart, { company, globalNotes });
      }
    }

    const talkBtn = document.querySelector<HTMLAnchorElement>('[data-review-action="talk"]');
    if (talkBtn) talkBtn.href = buildWhatsAppTalkUrl();
  }

  function dispatchNavigate(direction: 'next' | 'prev' | number): void {
    const detail = typeof direction === 'number' ? { step: direction } : { direction };
    window.dispatchEvent(new CustomEvent('quote-wizard-navigate', { detail }));
  }

  document.addEventListener('DOMContentLoaded', () => {
    paint();
    subscribe(paint);
    subscribeCompanyData(paint);
    subscribeGlobalNotes(paint);

    document.querySelector<HTMLButtonElement>('[data-quote-wizard-prev="review"]')?.addEventListener('click', () => {
      dispatchNavigate('prev');
    });
    document.querySelector<HTMLButtonElement>('[data-quote-wizard-step1]')?.addEventListener('click', () => {
      dispatchNavigate(1);
    });
  });
</script>

<style>
  .quote-review {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  /* ── Encabezado de paso ── */
  .quote-review__head {
    max-width: 60ch;
  }

  .quote-review__eyebrow {
    margin: 0 0 var(--space-2);
    font-family: var(--font-heading);
    font-size: var(--text-small);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--theme-eyebrow);
  }

  .quote-review__title {
    margin: 0 0 var(--space-2);
    font-family: var(--font-heading);
    font-size: var(--text-h4);
    font-weight: 700;
    color: var(--theme-heading);
  }

  .quote-review__lead {
    margin: 0;
    color: var(--theme-text-muted);
    font-size: var(--text-small);
    line-height: 1.6;
  }

  /* ── Grid principal ── */
  .quote-review__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    align-items: start;
  }

  @media (min-width: 1024px) {
    .quote-review__grid {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.65fr);
      gap: var(--space-8);
    }
  }

  .quote-review__main,
  .quote-review__side {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    min-width: 0;
  }

  /* ── Tarjetas ── */
  .quote-review__card {
    background-color: var(--theme-surface);
    border: 1px solid var(--theme-border);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .quote-review__card {
      padding: var(--space-6);
      gap: var(--space-5);
    }
  }

  .quote-review__card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--theme-border);
  }

  .quote-review__card-title {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--theme-text);
  }

  .quote-review__count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.5rem;
    height: 1.5rem;
    padding-inline: var(--space-1);
    background-color: var(--color-brand);
    color: var(--color-on-brand);
    font-size: var(--text-small);
    font-weight: 700;
    border-radius: var(--radius-sm);
    font-variant-numeric: tabular-nums;
  }

  /* ── Líneas de equipos: layout horizontal 1:3 ── */
  .quote-review__lines {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  :global(.quote-review__empty) {
    margin: 0;
    color: var(--theme-text-muted);
    font-size: var(--text-small);
  }

  :global(.quote-review__line) {
    display: flex;
    flex-direction: row;
    gap: var(--space-6);
    padding: var(--space-6) 0;
    border-bottom: 1px solid var(--theme-border);
    align-items: center;
  }

  :global(.quote-review__line:first-child) {
    padding-top: 0;
  }

  :global(.quote-review__line:last-child) {
    border-bottom: none;
    padding-bottom: 0;
  }

  @media (min-width: 640px) {
    :global(.quote-review__line) {
      gap: var(--space-7);
      padding: var(--space-7) 0;
    }
  }

  :global(.quote-review__line-thumb-wrapper) {
    flex-shrink: 0;
    width: 25%;
    max-width: 180px;
    aspect-ratio: 1 / 1;
    margin: 1rem;
    border-radius: var(--radius-md);
    overflow: hidden;
    background-color: var(--theme-bg-alt);
  }

  :global(.quote-review__line-thumb) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  :global(.quote-review__line-content) {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  :global(.quote-review__line-header) {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  :global(.quote-review__line-name) {
    margin: 0;
    font-family: var(--font-heading);
    font-size: var(--text-h4);
    font-weight: 700;
    line-height: 1.3;
    color: var(--theme-text);
  }

  @media (min-width: 640px) {
    :global(.quote-review__line-name) {
      font-size: var(--text-h4);
    }
  }

  :global(.quote-review__line-specs) {
    margin: 0;
    font-size: var(--text-small);
    color: var(--theme-text-muted);
    line-height: 1.4;
  }

  @media (min-width: 640px) {
    :global(.quote-review__line-specs) {
      font-size: var(--text-small);
    }
  }

  /* ─ Detalles de cotización: grid horizontal ── */
  :global(.quote-review__line-details) {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  @media (min-width: 640px) {
    :global(.quote-review__line-details) {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-3) var(--space-4);
    }
  }

  :global(.quote-review__line-detail) {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-width: 0;
  }

  :global(.quote-review__line-detail-label) {
    font-size: var(--text-small);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--theme-text-muted);
    line-height: 1.3;
  }

  :global(.quote-review__line-detail-value) {
    font-size: var(--text-small);
    font-weight: 600;
    color: var(--theme-text);
    overflow-wrap: anywhere;
    line-height: 1.3;
  }

  @media (min-width: 640px) {
    :global(.quote-review__line-detail-value) {
      font-size: var(--text-body);
    }
  }

  :global(.quote-review__line-detail-value--highlight) {
    color: var(--color-brand);
    font-weight: 700;
  }

  :global(.quote-review__line-notes) {
    margin: var(--space-1) 0 0;
    padding: var(--space-2) var(--space-3);
    background-color: color-mix(in srgb, var(--color-brand) 6%, var(--theme-bg-alt));
    border: 1px solid color-mix(in srgb, var(--color-brand) 15%, var(--theme-border));
    border-radius: var(--radius-sm);
    font-size: var(--text-small);
    line-height: 1.6;
    color: var(--theme-text-muted);
    white-space: pre-wrap;
  }

  @media (min-width: 640px) {
    :global(.quote-review__line-notes) {
      font-size: var(--text-small);
    }
  }

  /* ── Datos de empresa: formato reporte horizontal ─ */
  :global(.quote-review__company) {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    margin: 0;
  }

  :global(.quote-review__company-section) {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  :global(.quote-review__company-section + .quote-review__company-section) {
    padding-top: var(--space-5);
    border-top: 1px solid var(--theme-border);
  }

  :global(.quote-review__company-section-title) {
    margin: 0;
    font-family: var(--font-heading);
    font-size: var(--text-small);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--theme-eyebrow);
  }

  :global(.quote-review__company-fields) {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: 0;
  }

  :global(.quote-review__company-field) {
    display: grid;
    grid-template-columns: minmax(7rem, auto) 1fr;
    align-items: baseline;
    gap: var(--space-4);
    min-width: 0;
    line-height: 1.6;
    padding-block: var(--space-2);
  }

  :global(.quote-review__company-field dt) {
    font-size: var(--text-small);
    font-weight: 600;
    color: var(--theme-text-muted);
    white-space: nowrap;
  }

  :global(.quote-review__company-field dd) {
    margin: 0;
    font-size: var(--text-small);
    font-weight: 600;
    color: var(--theme-text);
    overflow-wrap: anywhere;
    min-width: 0;
  }

  :global(.quote-review__company-field a) {
    color: var(--color-brand);
    text-decoration: none;
    transition: color 0.15s var(--ease-out);
  }

  :global(.quote-review__company-field a:hover),
  :global(.quote-review__company-field a:focus-visible) {
    color: var(--color-brand-600);
    text-decoration: underline;
  }

  /* ── Tarjeta de totales: énfasis visual ── */
  .quote-review__card--totals {
    background-color: var(--theme-bg-elevated);
    border-color: color-mix(in srgb, var(--color-brand) 30%, var(--theme-border));
  }

  .quote-review__totals {
    display: flex;
    flex-direction: column;
    margin: 0;
  }

  .quote-review__total {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-2);
  }

  .quote-review__total + .quote-review__total {
    border-top: 1px dashed color-mix(in srgb, var(--color-brand) 20%, var(--theme-border));
  }

  .quote-review__total dt {
    font-size: var(--text-small);
    color: var(--theme-text-muted);
  }

  .quote-review__total dd {
    margin: 0;
    font-family: var(--font-heading);
    font-size: var(--text-h4);
    font-weight: 700;
    color: var(--color-brand);
    font-variant-numeric: tabular-nums;
  }

  @media (min-width: 640px) {
    .quote-review__total dd {
      font-size: var(--text-h5);
    }
  }

  /* ── Tarjeta de notas globales ── */
  .quote-review__notes-card {
    background-color: color-mix(in srgb, var(--color-brand) 5%, var(--theme-bg-alt));
    border: 1px solid color-mix(in srgb, var(--color-brand) 15%, var(--theme-border));
    border-radius: var(--radius-md);
    padding: var(--space-4) var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .quote-review__notes-card[hidden] {
    display: none;
  }

  .quote-review__notes {
    margin: 0;
    color: var(--theme-text-muted);
    font-size: var(--text-small);
    line-height: 1.6;
    white-space: pre-wrap;
  }

  /* ── Acciones finales ── */
  .quote-review__actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-4);
    padding-top: var(--space-5);
    border-top: 1px solid var(--theme-border);
  }

  .quote-review__hint {
    margin: 0;
    font-size: var(--text-small);
