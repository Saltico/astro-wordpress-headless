---
// src/components/quote/QuoteReview.astro
// Paso 3 del wizard: resumen de equipos y datos de empresa, y acciones de envío.
//
// Jerarquía visual: encabezado de paso → grid con columna principal
// (equipos + notas) y columna lateral (empresa + totales destacados) →
// acciones finales. Edición contextual desde cada tarjeta.

import Button from '@/components/ui/Button.astro';
---

<section class="quote-review" aria-labelledby="quote-review-title">
  <header class="quote-review__head">
    <p class="quote-review__eyebrow">Paso 3 de 3</p>
    <h2 id="quote-review-title" class="quote-review__title">Revisa y envía tu cotización</h2>
    <p class="quote-review__lead">
      Confirma que los equipos y tus datos estén correctos. Puedes editar cualquier
      sección desde su tarjeta antes de enviar.
    </p>
  </header>

  <div class="quote-review__grid">
    <div class="quote-review__main">
      <section class="quote-review__card" aria-labelledby="quote-review-lines-title">
        <div class="quote-review__card-head">
          <h3 id="quote-review-lines-title" class="quote-review__card-title">
            Equipos seleccionados
            <span class="quote-review__count" data-review-count>0</span>
          </h3>
          <Button variant="ghost" type="button" data-quote-wizard-step1>
            Editar equipos
          </Button>
        </div>
        <div class="quote-review__lines" data-review-lines aria-live="polite">
          {/* Renderizado desde cliente */}
        </div>
      </section>

      <section
        class="quote-review__notes-card"
        data-review-notes-card
        aria-labelledby="quote-review-notes-title"
        hidden
      >
        <h3 id="quote-review-notes-title" class="quote-review__card-title">Notas globales</h3>
        <p class="quote-review__notes" data-review-notes></p>
      </section>
    </div>

    <aside class="quote-review__side">
      <section class="quote-review__card" aria-labelledby="quote-review-company-title">
        <div class="quote-review__card-head">
          <h3 id="quote-review-company-title" class="quote-review__card-title">Datos de la empresa</h3>
          <Button variant="ghost" type="button" data-quote-wizard-prev="review">
            Editar datos
          </Button>
        </div>
        <dl class="quote-review__company" data-review-company>
          {/* Renderizado desde cliente */}
        </dl>
      </section>

      <section
        class="quote-review__card quote-review__card--totals"
        aria-labelledby="quote-review-totals-title"
      >
        <h3 id="quote-review-totals-title" class="quote-review__card-title">Totales</h3>
        <dl class="quote-review__totals">
          <div class="quote-review__total">
            <dt>Equipos distintos</dt>
            <dd data-review-stat="unique">0</dd>
          </div>
          <div class="quote-review__total">
            <dt>Unidades totales</dt>
            <dd data-review-stat="units">0</dd>
          </div>
          <div class="quote-review__total">
            <dt>Días agregados</dt>
            <dd data-review-stat="days">0</dd>
          </div>
          <div class="quote-review__total">
            <dt>Mayor fecha de inicio</dt>
            <dd data-review-stat="earliest">—</dd>
          </div>
          <div class="quote-review__total">
            <dt>Final calculado</dt>
            <dd data-review-stat="latestEnd">—</dd>
          </div>
        </dl>
      </section>
    </aside>
  </div>

  <footer class="quote-review__actions">
    <p class="quote-review__hint">
      Al enviar se abre WhatsApp con el detalle completo de tu cotización.
    </p>
    <div class="quote-review__cta-group">
      <Button
        href="#"
        variant="ghost"
        icon="whatsapp"
        data-review-action="talk"
        target="_blank"
      >
        Hablar con ejecutivo
      </Button>
      <Button
        href="#"
        variant="primary"
        size="lg"
        icon="whatsapp"
        data-review-action="send"
        target="_blank"
      >
        Enviar cotización
      </Button>
    </div>
  </footer>
</section>

<script>
  import { getCart, subscribe } from '@/lib/quoteCart';
  import { getCompanyData, subscribeCompanyData } from '@/lib/quoteCompany';
  import { getGlobalNotes, subscribeGlobalNotes } from '@/lib/quoteGlobalNotes';
  import { buildWhatsAppUrl, buildWhatsAppTalkUrl, computeCartTotals, formatPeriodLabel } from '@/lib/quoteMessage';
  import { formatRut, normalizePhone } from '@/types/quoteCompany';
  import type { QuoteCartItem } from '@/types/quote';

  function escapeHtml(s: string): string {
    return s.replace(/[&<>"']/g, (ch) => {
      const map: Record<string, string> = {
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#39;',
      };
      return map[ch] ?? ch;
    });
  }

  function renderChip(label: string, value: string): string {
    return `
      <li class="quote-review__chip">
        <span class="quote-review__chip-label">${label}</span>
        <span class="quote-review__chip-value">${value}</span>
      </li>
    `;
  }

  function renderLine(item: QuoteCartItem): string {
    const c = item.customization;
    const transport =
      c.transport === 'si'
        ? c.transportAddress
          ? `Sí — ${escapeHtml(c.transportAddress)}`
          : 'Sí'
        : 'No';
    return `
      <article class="quote-review__line">
        <img src="${escapeHtml(item.image)}" alt="${escapeHtml(item.name)}" class="quote-review__line-thumb" loading="lazy" />
        <div class="quote-review__line-content">
          <div class="quote-review__line-head">
            <h4 class="quote-review__line-name">${escapeHtml(item.name)}</h4>
            <p class="quote-review__line-meta">${escapeHtml([item.capacity, item.height].filter(Boolean).join(' · '))}</p>
          </div>
          <ul class="quote-review__chips">
            ${renderChip('Cantidad', String(c.quantity))}
            ${renderChip('Período', formatPeriodLabel(c.periodType, c.periodCount))}
            ${renderChip('Inicio', c.startDate)}
            ${renderChip('Traslado', transport)}
          </ul>
          ${c.notes ? `<p class="quote-review__line-notes">${escapeHtml(c.notes)}</p>` : ''}
        </div>
      </article>
    `;
  }

  function renderCompany(): string {
    const data = getCompanyData();
    if (!data.razonSocial && !data.rut) {
      return '<p class="quote-review__empty">Aún no has ingresado los datos de la empresa.</p>';
    }
    const rows: string[] = [];
    const cell = (label: string, valueHtml: string) =>
      `<div class="quote-review__company-cell"><dt>${label}</dt><dd>${valueHtml}</dd></div>`;
    if (data.razonSocial) rows.push(cell('Razón social', escapeHtml(data.razonSocial)));
    if (data.rut) rows.push(cell('RUT', escapeHtml(formatRut(data.rut))));
    if (data.nombreFantasia) rows.push(cell('Nombre de fantasía', escapeHtml(data.nombreFantasia)));
    if (data.giro) rows.push(cell('Giro', escapeHtml(data.giro)));
    if (data.direccion) rows.push(cell('Dirección', escapeHtml(data.direccion)));
    if (data.ciudad || data.comuna) {
      const location = [data.ciudad, data.comuna].filter(Boolean).join(', ');
      rows.push(cell('Ciudad / Comuna', escapeHtml(location)));
    }
    if (data.nombreContacto) rows.push(cell('Contacto', escapeHtml(data.nombreContacto)));
    if (data.email) rows.push(cell('Email', escapeHtml(data.email)));
    if (data.telefono) {
      const phoneDigits = normalizePhone(data.telefono);
      rows.push(cell('Teléfono', `<a href="tel:${phoneDigits}">${escapeHtml(data.telefono)}</a>`));
    }
    return rows.join('');
  }

  function setText(selector: string, value: string): void {
    const el = document.querySelector<HTMLElement>(`[data-review-stat="${selector}"]`);
    if (el) el.textContent = value;
  }

  function paint(): void {
    const cart = getCart();
    const company = getCompanyData();
    const globalNotes = getGlobalNotes();
    const totals = computeCartTotals(cart);

    const linesEl = document.querySelector<HTMLElement>('[data-review-lines]');
    if (linesEl) {
      if (cart.items.length === 0) {
        linesEl.innerHTML = '<p class="quote-review__empty">No hay equipos en el cotizador.</p>';
      } else {
        linesEl.innerHTML = cart.items.map((item) => renderLine(item)).join('');
      }
    }

    const countEl = document.querySelector<HTMLElement>('[data-review-count]');
    if (countEl) countEl.textContent = String(totals.uniqueItems);

    const companyEl = document.querySelector<HTMLElement>('[data-review-company]');
    if (companyEl) companyEl.innerHTML = renderCompany();

    setText('unique', String(totals.uniqueItems));
    setText('units', String(totals.totalUnits));
    setText('days', String(totals.totalDays));
    setText('earliest', totals.earliestStart ?? '—');
    setText('latestEnd', totals.latestEnd ?? '—');

    const notesCard = document.querySelector<HTMLElement>('[data-review-notes-card]');
    const notesEl = document.querySelector<HTMLElement>('[data-review-notes]');
    if (notesCard && notesEl) {
      if (globalNotes.trim()) {
        notesCard.hidden = false;
        notesEl.textContent = globalNotes;
      } else {
        notesCard.hidden = true;
      }
    }

    const sendBtn = document.querySelector<HTMLAnchorElement>('[data-review-action="send"]');
    if (sendBtn) {
      if (cart.items.length === 0) {
        sendBtn.setAttribute('aria-disabled', 'true');
        sendBtn.classList.add('is-disabled');
      } else {
        sendBtn.removeAttribute('aria-disabled');
        sendBtn.classList.remove('is-disabled');
        sendBtn.href = buildWhatsAppUrl(cart, { company, globalNotes });
      }
    }

    const talkBtn = document.querySelector<HTMLAnchorElement>('[data-review-action="talk"]');
    if (talkBtn) talkBtn.href = buildWhatsAppTalkUrl();
  }

  function dispatchNavigate(direction: 'next' | 'prev' | number): void {
    const detail = typeof direction === 'number' ? { step: direction } : { direction };
    window.dispatchEvent(new CustomEvent('quote-wizard-navigate', { detail }));
  }

  document.addEventListener('DOMContentLoaded', () => {
    paint();
    subscribe(paint);
    subscribeCompanyData(paint);
    subscribeGlobalNotes(paint);

    document.querySelector<HTMLButtonElement>('[data-quote-wizard-prev="review"]')?.addEventListener('click', () => {
      dispatchNavigate('prev');
    });
    document.querySelector<HTMLButtonElement>('[data-quote-wizard-step1]')?.addEventListener('click', () => {
      dispatchNavigate(1);
    });
  });
</script>

<style>
  .quote-review {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  /* ── Encabezado de paso ── */
  .quote-review__head {
    max-width: 60ch;
  }

  .quote-review__eyebrow {
    margin: 0 0 var(--space-2);
    font-family: var(--font-heading);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-brand);
  }

  .quote-review__title {
    margin: 0 0 var(--space-2);
    font-family: var(--font-heading);
    font-size: var(--text-h4);
    font-weight: 800;
    color: var(--color-ink);
  }

  .quote-review__lead {
    margin: 0;
    color: var(--color-ink-700);
    font-size: var(--text-small);
    line-height: 1.55;
  }

  /* ── Grid principal ── */
  .quote-review__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    align-items: start;
  }

  @media (min-width: 1024px) {
    .quote-review__grid {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.65fr);
      gap: var(--space-8);
    }
  }

  .quote-review__main,
  .quote-review__side {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    min-width: 0;
  }

  /* ── Tarjetas ── */
  .quote-review__card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: 16px;
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .quote-review__card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-line);
  }

  .quote-review__card-title {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    color: var(--color-ink);
  }

  .quote-review__count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.5rem;
    height: 1.5rem;
    padding-inline: var(--space-1);
    background-color: var(--color-brand-050);
    color: var(--color-brand);
    font-size: 0.8rem;
    font-weight: 800;
    border-radius: var(--radius-pill);
    font-variant-numeric: tabular-nums;
  }

  /* ── Líneas de equipos: grid de 2 columnas tipo picker ── */
  .quote-review__lines {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .quote-review__lines {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .quote-review__empty {
    margin: 0;
    color: var(--color-ink-500);
    font-size: var(--text-small);
  }

  .quote-review__line {
    display: flex;
    flex-direction: column;
    background-color: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: 12px;
    overflow: hidden;
    transition: border-color 0.15s var(--ease-out), box-shadow 0.15s var(--ease-out);
  }

  .quote-review__line:hover {
    border-color: rgba(52, 143, 65, 0.35);
    box-shadow: 0 4px 12px rgba(36, 38, 39, 0.06);
  }

  /* Remove the dashed border between lines (now cards) */
  .quote-review__line + .quote-review__line {
    border-top: none;
  }

  .quote-review__line-thumb {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 0;
    background-color: var(--color-graphite);
    flex-shrink: 0;
  }

  .quote-review__line-content {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-3);
  }

  .quote-review__line-name {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.25;
    color: var(--color-ink);
  }

  .quote-review__line-meta {
    margin: 0;
    font-size: 0.78rem;
    color: var(--color-ink-500);
  }

  /* Chips: 2 columns on mobile, 4 on wider screens */
  .quote-review__chips {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2) var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 640px) {
    .quote-review__chips {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .quote-review__chip {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .quote-review__chip-label {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-ink-500);
  }

  .quote-review__chip-value {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-ink);
    overflow-wrap: anywhere;
  }

  .quote-review__line-notes {
    margin: 0;
    padding: var(--space-2) var(--space-3);
    background-color: var(--color-surface-alt);
    border-left: 3px solid var(--color-brand);
    border-radius: var(--radius-xs);
    font-size: var(--text-small);
    line-height: 1.5;
    color: var(--color-ink-700);
    white-space: pre-wrap;
  }

  /* ── Datos de empresa ── */
  .quote-review__company {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin: 0;
  }

  .quote-review__company-cell {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--color-line);
    min-width: 0;
  }

  .quote-review__company-cell:first-child {
    padding-top: 0;
  }

  .quote-review__company-cell:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .quote-review__company-cell dt {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-ink-500);
  }

  .quote-review__company-cell dd {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-ink);
    overflow-wrap: anywhere;
  }

  .quote-review__company-cell a {
    color: var(--color-brand);
    text-decoration: none;
  }

  .quote-review__company-cell a:hover,
  .quote-review__company-cell a:focus-visible {
    text-decoration: underline;
  }

  /* ── Tarjeta de totales: énfasis visual ── */
  .quote-review__card--totals {
    background-color: var(--color-brand-050);
    border-color: color-mix(in srgb, var(--color-brand) 25%, transparent);
  }

  .quote-review__totals {
    display: flex;
    flex-direction: column;
    margin: 0;
  }

  .quote-review__total {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-2);
  }

  .quote-review__total + .quote-review__total {
    border-top: 1px dashed color-mix(in srgb, var(--color-brand) 22%, transparent);
  }

  .quote-review__total dt {
    font-size: var(--text-small);
    color: var(--color-ink-700);
  }

  .quote-review__total dd {
    margin: 0;
    font-family: var(--font-heading);
    font-size: var(--text-h5);
    font-weight: 800;
    color: var(--color-brand-700);
    font-variant-numeric: tabular-nums;
  }

  /* ── Tarjeta de notas globales ── */
  .quote-review__notes-card {
    background-color: var(--color-surface-alt);
    border: 1px solid var(--color-line);
    border-left: 4px solid var(--color-brand);
    border-radius: 16px;
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .quote-review__notes-card[hidden] {
    display: none;
  }

  .quote-review__notes {
    margin: 0;
    color: var(--color-ink-700);
    font-size: var(--text-small);
    line-height: 1.55;
    white-space: pre-wrap;
  }

  /* ── Acciones finales ── */
  .quote-review__actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-4);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-line);
  }

  .quote-review__hint {
    margin: 0;
    font-size: var(--text-small);
    color: var(--color-ink-500);
    max-width: 40ch;
  }

  .quote-review__cta-group {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  @media (max-width: 767.98px) {
    .quote-review__actions {
      flex-direction: column;
      align-items: stretch;
    }

    .quote-review__cta-group {
      flex-direction: column;
    }

    .quote-review__cta-group :global(.btn) {
      width: 100%;
    }
  }
</style>
