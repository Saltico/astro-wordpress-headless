---
// src/components/quote/QuoteCartLine.astro
// Tarjeta de una línea del cotizador implementada como acordeón.
//
// Header (siempre visible):
//   - Thumb 48×48
//   - Nombre + descripción corta del equipo
//   - Botón toggle (chevron que rota 180°)
//   - Botón eliminar (X)
// Panel (colapsable):
//   - Customización completa (cantidad, periodo, fecha, notas, traslado)
//
// Por defecto el panel está cerrado para reducir el ruido visual. La
// accesibilidad se gestiona con aria-expanded + aria-controls + el atributo
// `hidden` nativo en el panel.
//
// El render real del carrito ocurre en el cliente (datos en localStorage)
// vía renderLine() en /cotizador.astro, que genera el mismo HTML para
// mantener una sola fuente de verdad visual. Este componente queda
// disponible para un futuro render SSR (ej. cotización guardada en WP).

import Icon from '@/components/ui/Icon.astro';
import type { QuoteCartItem } from '@/types/quote';

export interface Props {
  item: QuoteCartItem;
  /** Descripción corta del equipo. Si no se pasa, se muestra capacity + height. */
  shortDesc?: string;
}

const { item, shortDesc } = Astro.props;
const c = item.customization;
const panelId = `line-panel-${item.lineId}`;
const toggleId = `line-toggle-${item.lineId}`;

const today = new Date();
today.setDate(today.getDate() + 1);
const minStart = (() => {
  const yyyy = today.getFullYear();
  const mm = String(today.getMonth() + 1).padStart(2, '0');
  const dd = String(today.getDate()).padStart(2, '0');
  return `${yyyy}-${mm}-${dd}`;
})();

const description = shortDesc ?? [item.capacity, item.height].filter(Boolean).join(' · ');
---

<article class="quote-line" data-line-id={item.lineId}>
  <header class="quote-line__head">
    <img src={item.image} alt={item.name} class="quote-line__thumb" loading="lazy" />
    <div class="quote-line__heading">
      <h3 class="quote-line__name">{item.name}</h3>
      <p class="quote-line__desc">{description}</p>
    </div>
    <div class="quote-line__head-actions">
      <button
        id={toggleId}
        type="button"
        class="quote-line__toggle"
        data-line-action="toggle"
        aria-expanded="false"
        aria-controls={panelId}
        aria-label={`Ver detalles de ${item.name}`}
      >
        <Icon name="chevron-down" size={16} />
      </button>
      <button
        type="button"
        class="quote-line__remove"
        data-line-action="remove"
        data-line-id={item.lineId}
        aria-label={`Quitar ${item.name} del cotizador`}
      >
        <Icon name="close" size={14} />
      </button>
    </div>
  </header>

  <div class="quote-line__panel" id={panelId} role="region" aria-labelledby={toggleId} hidden>
    <div class="quote-line__panel-inner">
      <div class="quote-line__grid">
        <div class="quote-line__field">
          <label for={`qty-${item.lineId}`}>Cantidad</label>
          <div class="quote-line__stepper">
            <button
              type="button"
              class="quote-line__step"
              data-line-action="dec"
              data-line-id={item.lineId}
              aria-label="Disminuir cantidad"
            >
              −
            </button>
            <input
              id={`qty-${item.lineId}`}
              type="number"
              min="1"
              max="50"
              step="1"
              value={c.quantity}
              data-line-action="qty"
              data-line-id={item.lineId}
              inputmode="numeric"
            />
            <button
              type="button"
              class="quote-line__step"
              data-line-action="inc"
              data-line-id={item.lineId}
              aria-label="Aumentar cantidad"
            >
              +
            </button>
          </div>
        </div>

        <div class="quote-line__field">
          <label for={`period-${item.lineId}`}>Tipo de periodo</label>
          <select
            id={`period-${item.lineId}`}
            data-line-action="periodType"
            data-line-id={item.lineId}
          >
            <option value="diario" selected={c.periodType === 'diario'}>Diario</option>
            <option value="semanal" selected={c.periodType === 'semanal'}>Semanal</option>
            <option value="mensual" selected={c.periodType === 'mensual'}>Mensual</option>
          </select>
        </div>

        <div class="quote-line__field">
          <label for={`periodCount-${item.lineId}`}>Cantidad de periodos</label>
          <input
            id={`periodCount-${item.lineId}`}
            type="number"
            min="1"
            max="365"
            step="1"
            value={c.periodCount}
            data-line-action="periodCount"
            data-line-id={item.lineId}
            inputmode="numeric"
          />
        </div>

        <div class="quote-line__field">
          <label for={`start-${item.lineId}`}>Fecha de inicio</label>
          <input
            id={`start-${item.lineId}`}
            type="date"
            min={minStart}
            value={c.startDate}
            data-line-action="startDate"
            data-line-id={item.lineId}
          />
        </div>

        <div class="quote-line__field quote-line__field--full">
          <label for={`notes-${item.lineId}`}>Notas del equipo (opcional)</label>
          <textarea
            id={`notes-${item.lineId}`}
            rows="2"
            maxlength="280"
            placeholder="Información específica de este equipo…"
            data-line-action="notes"
            data-line-id={item.lineId}
          >{c.notes ?? ''}</textarea>
        </div>

        <div class="quote-line__field quote-line__field--full quote-line__transport">
          <fieldset class="quote-line__transport-group">
            <legend>Traslado a la faena</legend>
            <div class="quote-line__radio-row">
              <label class="quote-line__radio">
                <input
                  type="radio"
                  name={`transport-${item.lineId}`}
                  value="no"
                  checked={c.transport === 'no'}
                  data-line-action="transport"
                  data-line-id={item.lineId}
                />
                <span>No</span>
              </label>
              <label class="quote-line__radio">
                <input
                  type="radio"
                  name={`transport-${item.lineId}`}
                  value="si"
                  checked={c.transport === 'si'}
                  data-line-action="transport"
                  data-line-id={item.lineId}
                />
                <span>Sí</span>
              </label>
            </div>
          </fieldset>
          <label class="quote-line__address-label" for={`address-${item.lineId}`}>
            Dirección de entrega
          </label>
          <input
            id={`address-${item.lineId}`}
            type="text"
            placeholder="Ej: Ruta 5 km 12, Caldera"
            value={c.transportAddress ?? ''}
            data-line-action="transportAddress"
            data-line-id={item.lineId}
            disabled={c.transport !== 'si'}
          />
        </div>
      </div>
    </div>
  </div>
</article>

<style>
  .quote-line {
    background-color: var(--color-surface, #fff);
    border: 1px solid var(--color-line, #e2e4e5);
    border-radius: 14px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: border-color 0.15s var(--ease-out, ease),
      box-shadow 0.15s var(--ease-out, ease);
  }

  .quote-line:hover {
    border-color: rgba(52, 143, 65, 0.35);
  }

  /* ── Header (siempre visible) ── */
  .quote-line__head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px 10px 14px;
  }

  .quote-line__thumb {
    width: 48px;
    height: 48px;
    object-fit: cover;
    border-radius: 8px;
    background-color: var(--color-graphite, #0d1611);
    flex-shrink: 0;
  }

  .quote-line__heading {
    flex: 1;
    min-width: 0;
  }

  .quote-line__name {
    margin: 0;
    font-family: var(--font-heading, 'Plateia', 'Arial Narrow', sans-serif);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-ink, #242627);
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .quote-line__desc {
    margin: 2px 0 0;
    font-size: 0.78rem;
    color: var(--color-ink-700, #3a3d3e);
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .quote-line__head-actions {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
  }

  .quote-line__toggle,
  .quote-line__remove {
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    border: 1px solid var(--color-line, #e2e4e5);
    background-color: transparent;
    color: var(--color-ink-700, #3a3d3e);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
    transition: background-color 0.15s var(--ease-out, ease),
      color 0.15s var(--ease-out, ease),
      border-color 0.15s var(--ease-out, ease),
      transform 0.2s var(--ease-out, ease);
  }

  .quote-line__toggle :global(svg),
  .quote-line__remove :global(svg) {
    transition: transform 0.2s var(--ease-out, ease);
  }

  .quote-line__toggle:hover,
  .quote-line__toggle:focus-visible {
    color: var(--color-brand, #348f41);
    border-color: var(--color-brand, #348f41);
  }

  .quote-line__toggle[aria-expanded='true'] {
    color: var(--color-brand, #348f41);
    border-color: var(--color-brand, #348f41);
    background-color: rgba(52, 143, 65, 0.08);
  }

  .quote-line__toggle[aria-expanded='true'] :global(svg) {
    transform: rotate(180deg);
  }

  .quote-line__toggle:focus-visible,
  .quote-line__remove:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  .quote-line__remove:hover,
  .quote-line__remove:focus-visible {
    color: #fff;
    background-color: var(--color-danger, #c0392b);
    border-color: var(--color-danger, #c0392b);
  }

  /* ── Panel colapsable ── */
  .quote-line__panel[hidden] {
    display: none;
  }

  .quote-line__panel-inner {
    padding: 4px 16px 18px;
    border-top: 1px solid var(--color-line, #e2e4e5);
    background-color: var(--color-surface-alt, #f6f7f8);
  }

  .quote-line__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.875rem;
    padding-top: 14px;
  }

  @media (min-width: 640px) {
    .quote-line__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .quote-line__field {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .quote-line__field--full {
    grid-column: 1 / -1;
  }

  .quote-line__field label,
  .quote-line__address-label,
  .quote-line__transport-group legend {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-ink-700, #3a3d3e);
  }

  .quote-line__field input,
  .quote-line__field select,
  .quote-line__field textarea {
    font-family: var(--font-body, 'Bliss Pro', sans-serif);
    font-size: 0.95rem;
    color: var(--color-ink, #242627);
    background-color: var(--color-surface, #fff);
    border: 1px solid var(--color-line, #e2e4e5);
    border-radius: 8px;
    padding: 0.55rem 0.625rem;
  }

  .quote-line__field input:focus,
  .quote-line__field select:focus,
  .quote-line__field textarea:focus {
    outline: 2px solid var(--color-brand, #348f41);
    outline-offset: 2px;
    border-color: var(--color-brand, #348f41);
  }

  .quote-line__field input:disabled {
    background-color: var(--color-surface-alt, #f6f7f8);
    color: var(--color-ink-500, #6b7072);
  }

  .quote-line__stepper {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.25rem;
  }

  .quote-line__step {
    width: 2.25rem;
    height: 2.25rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-surface, #fff);
    color: var(--color-ink, #242627);
    border: 1px solid var(--color-line, #e2e4e5);
    border-radius: 8px;
    cursor: pointer;
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1;
  }

  .quote-line__step:hover,
  .quote-line__step:focus-visible {
    background-color: var(--color-brand, #348f41);
    color: #fff;
    border-color: var(--color-brand, #348f41);
  }

  .quote-line__stepper input {
    width: 3.5rem;
    text-align: center;
    border: none;
    background-color: transparent;
    padding: 0;
    font-weight: 700;
  }

  .quote-line__stepper input:focus {
    outline: 2px solid var(--color-brand, #348f41);
    border-radius: 4px;
  }

  .quote-line__transport-group {
    border: none;
    padding: 0;
    margin: 0 0 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .quote-line__radio-row {
    display: inline-flex;
    gap: 0.75rem;
  }

  .quote-line__radio {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    cursor: pointer;
    font-size: 0.95rem;
    color: var(--color-ink, #242627);
  }

  .quote-line__radio input {
    accent-color: var(--color-brand, #348f41);
  }

  .quote-line__address-label {
    margin-top: 0.5rem;
  }
</style>
