---
// src/components/quote/QuoteCartSummary.astro
// Resumen + notas globales + acciones finales (Limpiar / WhatsApp / Continuar).
// La data se hidrata en cliente desde getCart().

import Button from '@/components/ui/Button.astro';

export interface Props {
  variant?: 'default' | 'wizard';
}

const { variant = 'default' } = Astro.props;
const isWizard = variant === 'wizard';
---

<section class="quote-summary" data-quote-summary aria-live="polite" data-summary-variant={variant}>
  <h2 class="quote-summary__title">Resumen</h2>
  <dl class="quote-summary__list">
    <div class="quote-summary__row">
      <dt>Equipos distintos</dt>
      <dd data-quote-stat="unique">0</dd>
    </div>
    <div class="quote-summary__row">
      <dt>Unidades totales</dt>
      <dd data-quote-stat="units">0</dd>
    </div>
    <div class="quote-summary__row">
      <dt>Total días agregados</dt>
      <dd data-quote-stat="days">0</dd>
    </div>
    <div class="quote-summary__row">
      <dt>Mayor fecha de inicio</dt>
      <dd data-quote-stat="earliest">—</dd>
    </div>
    <div class="quote-summary__row">
      <dt>Final calculado</dt>
      <dd data-quote-stat="latestEnd">—</dd>
    </div>
  </dl>

  <div class="quote-summary__notes">
    <label for="quote-global-notes">Notas globales (opcional)</label>
    <textarea
      id="quote-global-notes"
      rows="3"
      maxlength="500"
      placeholder="Información que aplique a toda la cotización…"
      data-quote-global-notes
    ></textarea>
  </div>

  <div class="quote-summary__actions">
    <Button
      type="button"
      variant="ghost"
      icon="close"
      data-quote-action="clear"
    >
      Limpiar cotizador
    </Button>
    {!isWizard && (
      <Button
        href="#"
        variant="primary"
        icon="whatsapp"
        data-quote-action="whatsapp"
        target="_blank"
      >
        Enviar por WhatsApp
      </Button>
    )}
    {isWizard && (
      <Button
        type="button"
        variant="primary"
        icon="arrow-right"
        iconPosition="right"
        data-quote-wizard-next
        disabled
      >
        Continuar
      </Button>
    )}
  </div>
</section>

<script>
  import { clearCart, getCart, subscribe } from '@/lib/quoteCart';
  import { buildWhatsAppUrl, computeCartTotals } from '@/lib/quoteMessage';
  import {
    getGlobalNotes,
    setGlobalNotes,
    subscribeGlobalNotes,
    initGlobalNotesStorageSync,
  } from '@/lib/quoteGlobalNotes';

  function setText(selector: string, value: string): void {
    const el = document.querySelector<HTMLElement>(`[data-quote-stat="${selector}"]`);
    if (el) el.textContent = value;
  }

  function paint(): void {
    const cart = getCart();
    const totals = computeCartTotals(cart);
    setText('unique', String(totals.uniqueItems));
    setText('units', String(totals.totalUnits));
    setText('days', String(totals.totalDays));
    setText('earliest', totals.earliestStart ?? '—');
    setText('latestEnd', totals.latestEnd ?? '—');

    const wa = document.querySelector<HTMLAnchorElement>('[data-quote-action="whatsapp"]');
    if (wa) {
      if (cart.items.length === 0) {
        wa.setAttribute('aria-disabled', 'true');
        wa.classList.add('is-disabled');
      } else {
        wa.removeAttribute('aria-disabled');
        wa.classList.remove('is-disabled');
        wa.href = buildWhatsAppUrl(cart);
      }
    }

    const nextBtn = document.querySelector<HTMLButtonElement>('[data-quote-wizard-next]');
    if (nextBtn) {
      const hasItems = cart.items.length > 0;
      nextBtn.disabled = !hasItems;
      nextBtn.setAttribute('aria-disabled', String(!hasItems));
    }
  }

  function handleClear(): void {
    if (!confirm('¿Vaciar todo el cotizador? Esta acción no se puede deshacer.')) return;
    clearCart();
  }

  document.addEventListener('DOMContentLoaded', () => {
    initGlobalNotesStorageSync();
    paint();
    subscribe(paint);

    const clearBtn = document.querySelector<HTMLButtonElement>('[data-quote-action="clear"]');
    clearBtn?.addEventListener('click', handleClear);

    const notesEl = document.querySelector<HTMLTextAreaElement>('[data-quote-global-notes]');
    if (notesEl) {
      notesEl.value = getGlobalNotes();
      notesEl.addEventListener('input', () => {
        setGlobalNotes(notesEl.value);
      });
      subscribeGlobalNotes((notes) => {
        if (notesEl.value !== notes) notesEl.value = notes;
      });
    }

    const nextBtn = document.querySelector<HTMLButtonElement>('[data-quote-wizard-next]');
    nextBtn?.addEventListener('click', () => {
      window.dispatchEvent(
        new CustomEvent('quote-wizard-navigate', { detail: { direction: 'next' } })
      );
    });
  });
</script>

<style>
  .quote-summary {
    background-color: var(--color-surface, #fff);
    border: 1px solid var(--color-line, #e2e4e5);
    border-radius: 16px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .quote-summary__title {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-ink, #242627);
  }

  .quote-summary__list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0;
  }

  .quote-summary__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.25rem;
    border-bottom: 1px dashed var(--color-line, #e2e4e5);
  }

  .quote-summary__row:last-child {
    border-bottom: none;
  }

  .quote-summary__row dt {
    font-size: 0.9rem;
    color: var(--color-ink-700, #3a3d3e);
    margin: 0;
  }

  .quote-summary__row dd {
    margin: 0;
    font-weight: 700;
    color: var(--color-ink, #242627);
    font-size: 0.95rem;
  }

  .quote-summary__notes {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .quote-summary__notes label {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-ink-700, #3a3d3e);
  }

  .quote-summary__notes textarea {
    font-family: var(--font-body);
    font-size: 0.95rem;
    border: 1px solid var(--color-line, #e2e4e5);
    border-radius: 8px;
    padding: 0.625rem;
    color: var(--color-ink, #242627);
    background-color: var(--color-surface, #fff);
    resize: vertical;
  }

  .quote-summary__notes textarea:focus {
    outline: 2px solid var(--color-brand, #348f41);
    border-color: var(--color-brand, #348f41);
  }

  .quote-summary__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3, 0.75rem);
  }
</style>
