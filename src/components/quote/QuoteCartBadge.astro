---
// src/components/quote/QuoteCartBadge.astro
// Botón CTA del cotizador con badge de conteo de equipos.
// Sigue el estilo del botón primario del design system (Button.astro)
// y muestra el conteo de equipos seleccionados. Se sincroniza con
// el CustomEvent 'ip-quote-cart-change'.
---

<a
  href="/cotizador"
  class="quote-cta"
  data-quote-badge
  aria-label="Abrir cotizador"
>
  <span class="quote-cta__label">Cotizador</span>
  <span class="quote-cta__count" data-quote-badge-count aria-live="polite" aria-atomic="true" hidden>0</span>
</a>

<script>
  import { getItemCount, subscribe } from '@/lib/quoteCart';

  function paint(): void {
    const link = document.querySelector<HTMLElement>('[data-quote-badge]');
    const counter = document.querySelector<HTMLElement>('[data-quote-badge-count]');
    if (!link || !counter) return;
    const count = getItemCount();
    if (count === 0) {
      counter.hidden = true;
      counter.textContent = '0';
      link.setAttribute('aria-label', 'Abrir cotizador');
    } else {
      counter.hidden = false;
      counter.textContent = String(count);
      link.setAttribute('aria-label', `Abrir cotizador con ${count} ${count === 1 ? 'equipo' : 'equipos'}`);
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    paint();
    subscribe(paint);
  });
</script>

<style>
  .quote-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--text-body);
    line-height: 1;
    white-space: nowrap;
    padding: 14px 26px;
    border: 1.5px solid transparent;
    border-radius: var(--radius-pill);
    cursor: pointer;
    user-select: none;
    text-decoration: none;
    background-color: var(--color-brand);
    color: var(--color-on-brand);
    transition:
      transform var(--motion-base) var(--ease-out),
      background-color var(--motion-base) var(--ease-out);
  }

  .quote-cta:hover {
    background-color: var(--color-brand-600);
    transform: translateY(-2px);
  }

  .quote-cta:active {
    transform: translateY(1px) scale(0.99);
  }

  .quote-cta:focus-visible {
    outline: 2px solid var(--color-brand);
    outline-offset: 3px;
  }

  .quote-cta__label {
    display: inline-flex;
    align-items: center;
    line-height: 1.1;
  }

  .quote-cta__count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.5rem;
    height: 1.5rem;
    padding: 0 0.4rem;
    background-color: var(--color-on-brand);
    color: var(--color-brand);
    font-size: var(--text-small);
    font-weight: 700;
    border-radius: 999px;
    line-height: 1;
  }
</style>
