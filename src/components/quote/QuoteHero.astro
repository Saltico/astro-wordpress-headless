---
// src/components/quote/QuoteHero.astro
// Hero compacto y utility-focused de la página Cotizador.
//
// Esta página es una herramienta de aplicación, no una landing SEO: el hero
// se limita a orientar (qué es esto) y ofrecer UNA acción primaria útil en
// cualquier paso del wizard (descargar el catálogo).
//
// Layout: título y CTA en la misma línea horizontal cuando el espacio lo
// permite (desktop); se apilan en mobile. Mantiene el lenguaje visual del
// sitio: imagen + overlay grafito, eyebrow brand-300, tipografía Plateia.

import Button from '@/components/ui/Button.astro';

export interface Props {
  image: string;
  imageAlt?: string;
  eyebrow?: string;
  title: string;
  /** Una sola línea de apoyo. Opcional y breve por diseño. */
  note?: string;
  /** Acción primaria única del hero. */
  cta?: {
    href: string;
    label: string;
    download?: boolean;
  };
}

const {
  image,
  imageAlt = '',
  eyebrow = 'Cotización en línea',
  title,
  note,
  cta,
} = Astro.props;
---

<section class="quote-hero" aria-labelledby="quote-hero-title">
  <img
    src={image}
    alt={imageAlt}
    class="quote-hero__bg"
    loading="eager"
    fetchpriority="high"
  />
  <div class="quote-hero__overlay" aria-hidden="true"></div>

  <div class="quote-hero__container">
    <div class="quote-hero__intro">
      {eyebrow && <p class="quote-hero__eyebrow">{eyebrow}</p>}
      <h1 id="quote-hero-title" class="quote-hero__title">{title}</h1>
      {note && <p class="quote-hero__note">{note}</p>}
    </div>

    {cta && (
      <div class="quote-hero__action">
        <Button
          href={cta.href}
          variant="primary"
          size="lg"
          icon="download"
          download={cta.download}
          target="_blank"
        >
          {cta.label}
        </Button>
      </div>
    )}
  </div>
</section>

<style>
  .quote-hero {
    position: relative;
    /* Sube el hero bajo el topbar + header (transparentes) para que el
       texto blanco del header quede superpuesto al fondo oscuro. */
    margin-top: calc(-1 * (var(--topbar-height, 40px) + var(--header-height, 80px)));
    color: var(--color-on-dark);
    isolation: isolate;
    overflow: hidden;
  }

  .quote-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .quote-hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      180deg,
      rgba(13, 22, 17, 0.45) 0%,
      rgba(13, 22, 17, 0.62) 55%,
      rgba(13, 22, 17, 0.88) 100%
    );
  }

  .quote-hero__container {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: var(--container-max-width, 1360px);
    margin-inline: auto;
    padding: calc(var(--topbar-height, 40px) + var(--header-height, 80px) + var(--space-8))
      var(--container-padding, 20px) var(--space-8);
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-5) var(--space-8);
  }

  .quote-hero__intro {
    flex: 1 1 320px;
    min-width: 0;
  }

  .quote-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-brand-300, #62bb74);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--text-small);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin: 0 0 var(--space-3);
  }

  .quote-hero__eyebrow::before {
    content: '';
    width: 32px;
    height: 2px;
    background: var(--color-brand, #308f40);
  }

  .quote-hero__title {
    margin: 0;
    color: var(--color-on-dark);
    font-family: var(--font-heading);
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -0.02em;
    font-size: clamp(1.75rem, 3.4vw, 2.5rem);
    max-width: 22ch;
  }

  .quote-hero__note {
    margin: var(--space-2) 0 0;
    color: rgba(255, 255, 255, 0.88);
    font-size: var(--text-small);
    line-height: 1.6;
    max-width: 56ch;
  }

  .quote-hero__action {
    flex: 0 0 auto;
    /* Alinea el CTA con la línea base del bloque del título en desktop. */
    padding-bottom: 2px;
  }

  /* ── Mobile: apilar intro arriba, CTA a ancho completo debajo ── */
  @media (max-width: 767.98px) {
    .quote-hero__container {
      flex-direction: column;
      align-items: stretch;
    }

    .quote-hero__action {
      padding-bottom: 0;
    }

    .quote-hero__action :global(.btn) {
      width: 100%;
    }
  }
</style>
