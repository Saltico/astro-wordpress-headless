---
// src/components/quote/QuoteCompanyForm.astro
// Paso 2 del wizard: formulario de datos de la empresa + dirección de
// entrega condicional (solo cuando el usuario indica envío a faena).

import Button from '@/components/ui/Button.astro';
import Input from '@/components/ui/Input.astro';
import AddressAutocomplete from './AddressAutocomplete.astro';
import { CHILEAN_REGIONS, getCommunesByRegionCode } from '@/data/chile';

const apiKey = import.meta.env.PUBLIC_GOOGLE_MAPS_API_KEY ?? 'YOUR_GOOGLE_MAPS_API_KEY';
---

<section class="quote-company" aria-labelledby="quote-company-title">
  <div class="quote-company__head">
    <h2 id="quote-company-title" class="quote-company__title">Datos de la empresa</h2>
    <p class="quote-company__lead">
      Completa los datos para que nuestro ejecutivo pueda contactarte.
    </p>
  </div>

  <form class="quote-company__form" data-quote-company-form novalidate>
    <Input
      name="rut"
      label="RUT"
      type="text"
      placeholder="12.345.678-9"
      autocomplete="organization"
      data-field="rut"
      required
      class="quote-company__field"
    >
      <p class="quote-company__error" data-error="rut" role="alert" aria-live="polite"></p>
    </Input>

    <Input
      name="giro"
      label="Giro"
      type="text"
      placeholder="Ej: Arriendo de maquinaria"
      data-field="giro"
      required
      class="quote-company__field"
    >
      <p class="quote-company__error" data-error="giro" role="alert" aria-live="polite"></p>
    </Input>

    <Input
      name="razonSocial"
      label="Razón social"
      type="text"
      placeholder="Ej: Constructora SpA"
      autocomplete="organization"
      data-field="razonSocial"
      required
      class="quote-company__field"
    >
      <p class="quote-company__error" data-error="razonSocial" role="alert" aria-live="polite"></p>
    </Input>

    <Input
      name="nombreFantasia"
      label="Nombre de fantasía"
      type="text"
      placeholder="Ej: IP Grúas"
      data-field="nombreFantasia"
      required
      class="quote-company__field"
    >
      <p class="quote-company__error" data-error="nombreFantasia" role="alert" aria-live="polite"></p>
    </Input>

    <Input
      name="direccion"
      label="Dirección"
      type="text"
      placeholder="Ej: Av. Apoquindo 1234, Oficina 101"
      autocomplete="street-address"
      data-field="direccion"
      required
      class="quote-company__field"
    >
      <p class="quote-company__error" data-error="direccion" role="alert" aria-live="polite"></p>
    </Input>

    <Input
      name="ciudad"
      label="Ciudad"
      type="text"
      placeholder="Ej: Santiago"
      autocomplete="address-level2"
      data-field="ciudad"
      required
      class="quote-company__field"
    >
      <p class="quote-company__error" data-error="ciudad" role="alert" aria-live="polite"></p>
    </Input>

    <Input
      name="comuna"
      label="Comuna"
      type="text"
      placeholder="Ej: Las Condes"
      autocomplete="address-level1"
      data-field="comuna"
      required
      class="quote-company__field"
    >
      <p class="quote-company__error" data-error="comuna" role="alert" aria-live="polite"></p>
    </Input>

    <Input
      name="nombreContacto"
      label="Nombre de contacto"
      type="text"
      placeholder="Ej: Juan Pérez"
      autocomplete="name"
      data-field="nombreContacto"
      class="quote-company__field"
    >
      <p class="quote-company__error" data-error="nombreContacto" role="alert" aria-live="polite"></p>
    </Input>

    <Input
      name="email"
      label="Email"
      type="email"
      placeholder="ejemplo@empresa.cl"
      autocomplete="email"
      data-field="email"
      required
      class="quote-company__field"
    >
      <p class="quote-company__error" data-error="email" role="alert" aria-live="polite"></p>
    </Input>

    <Input
      name="telefono"
      label="Teléfono / WhatsApp"
      type="tel"
      placeholder="+56 9 1234 5678"
      autocomplete="tel"
      data-field="telefono"
      required
      class="quote-company__field"
    >
      <p class="quote-company__error" data-error="telefono" role="alert" aria-live="polite"></p>
    </Input>

    {/* ── Sección de envío a faena (condicional) ── */}
    <fieldset class="quote-company__delivery-section" data-delivery-section>
      <legend class="quote-company__delivery-legend">Envío a faena</legend>
      <p class="quote-company__delivery-hint">
        ¿Los equipos deben enviarse directamente a una faena o sitio de obra?
      </p>
      <div class="quote-company__delivery-options">
        <label class="quote-company__radio-label">
          <input
            type="radio"
            name="requiresSiteDelivery"
            value="si"
            data-field="requiresSiteDelivery-yes"
          />
          <span>Sí, enviar a faena</span>
        </label>
        <label class="quote-company__radio-label">
          <input
            type="radio"
            name="requiresSiteDelivery"
            value="no"
            data-field="requiresSiteDelivery-no"
            checked
          />
          <span>No, retiro en bodega</span>
        </label>
      </div>
      <p class="quote-company__error" data-error="deliveryAddress" role="alert" aria-live="polite"></p>
    </fieldset>

    <div class="quote-company__delivery-address" data-delivery-address-container hidden>
      <div class="quote-company__location-grid">
        <label class="quote-company__field">
          <span>Región</span>
          <select name="deliveryRegion" data-field="deliveryRegion">
            <option value="">Selecciona una región</option>
            {CHILEAN_REGIONS.map((r) => (
              <option value={r.code}>{r.name}</option>
            ))}
          </select>
          <p class="quote-company__error" data-error="deliveryRegion" role="alert" aria-live="polite"></p>
        </label>

        <label class="quote-company__field">
          <span>Comuna</span>
          <select name="deliveryCommune" data-field="deliveryCommune">
            <option value="">Selecciona una comuna</option>
          </select>
          <p class="quote-company__error" data-error="deliveryCommune" role="alert" aria-live="polite"></p>
        </label>
      </div>

      <AddressAutocomplete
        apiKey={apiKey}
        placeholder="Busca la dirección de la faena"
      />
    </div>

    <p class="quote-company__form-error" data-form-error role="alert" aria-live="assertive"></p>

    <div class="quote-company__actions">
      <Button
        type="button"
        variant="ghost"
        icon="arrow-left"
        data-quote-wizard-prev="company"
      >
        Volver
      </Button>
      <Button type="submit" variant="primary" icon="arrow-right" iconPosition="right">
        Continuar
      </Button>
    </div>
  </form>
</section>

<script>
  import {
    getCompanyData,
    setCompanyData,
    subscribeCompanyData,
    initCompanyStorageSync,
  } from '@/lib/quoteCompany';
  import {
    type QuoteCompanyData,
    type DeliveryAddress,
    validateCompanyData,
    formatRut,
  } from '@/types/quoteCompany';
  import { CHILEAN_REGIONS, getCommunesByRegionCode } from '@/data/chile';

  const FIELD_NAMES: Array<keyof QuoteCompanyData> = [
    'rut',
    'giro',
    'razonSocial',
    'nombreFantasia',
    'direccion',
    'ciudad',
    'comuna',
    'nombreContacto',
    'email',
    'telefono',
  ];

  function getFormData(form: HTMLFormElement): QuoteCompanyData {
    const data = {} as QuoteCompanyData;
    for (const name of FIELD_NAMES) {
      const input = form.querySelector<HTMLInputElement>(`[name="${name}"]`);
      data[name] = input?.value ?? '';
    }
    // Radio de envío a faena.
    const radioYes = form.querySelector<HTMLInputElement>('[data-field="requiresSiteDelivery-yes"]');
    data.requiresSiteDelivery = radioYes?.checked ?? false;
    // deliveryAddress se maneja por el componente AddressAutocomplete y los selects.
    const existing = getCompanyData();
    if (data.requiresSiteDelivery) {
      // Leer región y comuna de los selects.
      const regionSelect = form.querySelector<HTMLSelectElement>('[data-field="deliveryRegion"]');
      const communeSelect = form.querySelector<HTMLSelectElement>('[data-field="deliveryCommune"]');
      const selectedRegion = regionSelect?.value ?? '';
      const selectedCommune = communeSelect?.value ?? '';

      // Si ya existe un deliveryAddress confirmado, actualizarlo con los selects.
      if (existing.deliveryAddress?.confirmed) {
        data.deliveryAddress = {
          ...existing.deliveryAddress,
          region: getRegionNameByCode(selectedRegion) || existing.deliveryAddress.region,
          commune: selectedCommune || existing.deliveryAddress.commune,
        };
      } else {
        // Leer el texto escrito en el input de dirección.
        const addressInput = form.querySelector<HTMLInputElement>('[data-address-input]');
        const typedAddress = addressInput?.value.trim() ?? '';

        if (typedAddress) {
          // Si el usuario escribió una dirección, aceptarla como manual confirmada.
          data.deliveryAddress = {
            formattedAddress: typedAddress,
            region: getRegionNameByCode(selectedRegion),
            commune: selectedCommune,
            source: 'manual',
            confirmed: true,
          };
        } else if (selectedRegion || selectedCommune) {
          // Solo región/comuna sin dirección → no confirmar aún.
          data.deliveryAddress = {
            formattedAddress: '',
            region: getRegionNameByCode(selectedRegion),
            commune: selectedCommune,
            source: 'manual',
            confirmed: false,
          };
        }
      }
    }
    return data;
  }

  function getRegionNameByCode(code: string): string {
    const region = CHILEAN_REGIONS.find((r) => r.code === code);
    return region?.name ?? '';
  }

  function getRegionCodeByName(name: string): string {
    const region = CHILEAN_REGIONS.find((r) => r.name === name);
    return region?.code ?? '';
  }

  function setFormData(form: HTMLFormElement, data: QuoteCompanyData): void {
    for (const name of FIELD_NAMES) {
      const input = form.querySelector<HTMLInputElement>(`[name="${name}"]`);
      if (input) input.value = data[name] ?? '';
    }
    // Radio de envío a faena.
    const radioYes = form.querySelector<HTMLInputElement>('[data-field="requiresSiteDelivery-yes"]');
    const radioNo = form.querySelector<HTMLInputElement>('[data-field="requiresSiteDelivery-no"]');
    if (radioYes && radioNo) {
      if (data.requiresSiteDelivery) {
        radioYes.checked = true;
        radioNo.checked = false;
      } else {
        radioYes.checked = false;
        radioNo.checked = true;
      }
    }

    // Restaurar región y comuna de la dirección de entrega.
    const regionSelect = form.querySelector<HTMLSelectElement>('[data-field="deliveryRegion"]');
    const communeSelect = form.querySelector<HTMLSelectElement>('[data-field="deliveryCommune"]');
    if (regionSelect && data.deliveryAddress?.region) {
      const regionCode = getRegionCodeByName(data.deliveryAddress.region);
      if (regionCode) {
        regionSelect.value = regionCode;
        // Repoblar comunas según la región.
        const communes = getCommunesByRegionCode(regionCode);
        if (communeSelect) {
          communeSelect.innerHTML =
            '<option value="">Selecciona una comuna</option>' +
            communes.map((c) => `<option value="${c}"${c === data.deliveryAddress?.commune ? ' selected' : ''}>${c}</option>`).join('');
        }
      }
    } else if (communeSelect) {
      communeSelect.innerHTML = '<option value="">Selecciona una comuna</option>';
    }
  }

  function clearFieldError(form: HTMLFormElement, field: string): void {
    const input = form.querySelector<HTMLInputElement>(`[data-field="${field}"]`);
    const error = form.querySelector<HTMLElement>(`[data-error="${field}"]`);
    if (input) {
      input.setAttribute('aria-invalid', 'false');
      input.classList.remove('is-invalid');
    }
    if (error) error.textContent = '';
  }

  function showFieldError(form: HTMLFormElement, field: string, message: string): void {
    const input = form.querySelector<HTMLInputElement>(`[data-field="${field}"]`);
    const error = form.querySelector<HTMLElement>(`[data-error="${field}"]`);
    if (input) {
      input.setAttribute('aria-invalid', 'true');
      input.classList.add('is-invalid');
    }
    if (error) error.textContent = message;
  }

  function clearAllErrors(form: HTMLFormElement): void {
    for (const name of FIELD_NAMES) clearFieldError(form, name);
    clearFieldError(form, 'deliveryAddress');
    const formError = form.querySelector<HTMLElement>('[data-form-error]');
    if (formError) formError.textContent = '';
  }

  function validateAndShow(form: HTMLFormElement, showAll = false): boolean {
    const data = getFormData(form);
    const result = validateCompanyData(data);
    if (showAll) {
      clearAllErrors(form);
      for (const [field, message] of Object.entries(result.errors)) {
        showFieldError(form, field, message);
      }
    } else {
      // En validación en tiempo real solo mostramos/ocultamos el campo que cambió.
    }
    return result.valid;
  }

  function dispatchNavigate(direction: 'next' | 'prev' | number): void {
    const detail = typeof direction === 'number' ? { step: direction } : { direction };
    window.dispatchEvent(new CustomEvent('quote-wizard-navigate', { detail }));
  }

  document.addEventListener('DOMContentLoaded', () => {
    initCompanyStorageSync();
    const form = document.querySelector<HTMLFormElement>('[data-quote-company-form]');
    if (!form) return;

    const deliveryContainer = form.querySelector<HTMLElement>('[data-delivery-address-container]');
    const radioYes = form.querySelector<HTMLInputElement>('[data-field="requiresSiteDelivery-yes"]');
    const radioNo = form.querySelector<HTMLInputElement>('[data-field="requiresSiteDelivery-no"]');

    // Poblar formulario desde localStorage.
    const savedData = getCompanyData();
    setFormData(form, savedData);

    // Mostrar/ocultar la sección de dirección según el valor guardado.
    if (deliveryContainer) {
      deliveryContainer.hidden = !savedData.requiresSiteDelivery;
    }

    // Formatear RUT al perder el foco.
    const rutInput = form.querySelector<HTMLInputElement>('[data-field="rut"]');
    rutInput?.addEventListener('blur', () => {
      if (rutInput.value.trim()) {
        rutInput.value = formatRut(rutInput.value);
      }
    });

    // Persistir y validar en tiempo real.
    FIELD_NAMES.forEach((name) => {
      const input = form.querySelector<HTMLInputElement>(`[data-field="${name}"]`);
      if (!input) return;
      input.addEventListener('input', () => {
        const data = getFormData(form);
        setCompanyData(data);
        const result = validateCompanyData(data);
        if (result.errors[name]) {
          showFieldError(form, name, result.errors[name]);
        } else {
          clearFieldError(form, name);
        }
      });
    });

    // Toggle de la sección de dirección de entrega.
    function handleDeliveryToggle(): void {
      const isYes = radioYes?.checked ?? false;
      if (deliveryContainer) deliveryContainer.hidden = !isYes;

      // Si cambia a "No", limpiar la dirección guardada.
      if (!isYes) {
        const data = getFormData(form);
        data.requiresSiteDelivery = false;
        delete data.deliveryAddress;
        setCompanyData(data);
        clearFieldError(form, 'deliveryAddress');
      } else {
        const data = getFormData(form);
        data.requiresSiteDelivery = true;
        setCompanyData(data);
      }
    }

    radioYes?.addEventListener('change', handleDeliveryToggle);
    radioNo?.addEventListener('change', handleDeliveryToggle);

    // Event listeners para región y comuna de entrega.
    const deliveryRegion = form.querySelector<HTMLSelectElement>('[data-field="deliveryRegion"]');
    const deliveryCommune = form.querySelector<HTMLSelectElement>('[data-field="deliveryCommune"]');

    if (deliveryRegion) {
      deliveryRegion.addEventListener('change', () => {
        const regionCode = deliveryRegion.value;
        // Repoblar comunas según la región seleccionada.
        if (deliveryCommune) {
          const communes = regionCode ? getCommunesByRegionCode(regionCode) : [];
          deliveryCommune.innerHTML =
            '<option value="">Selecciona una comuna</option>' +
            communes.map((c) => `<option value="${c}">${c}</option>`).join('');
        }
        // Actualizar datos.
        const data = getFormData(form);
        setCompanyData(data);
        clearFieldError(form, 'deliveryRegion');
        clearFieldError(form, 'deliveryCommune');
      });
    }

    if (deliveryCommune) {
      deliveryCommune.addEventListener('change', () => {
        const data = getFormData(form);
        setCompanyData(data);
        clearFieldError(form, 'deliveryCommune');
      });
    }

    // Escuchar eventos del AddressAutocomplete.
    deliveryContainer?.addEventListener('address-selected', ((event: Event) => {
      const e = event as CustomEvent<DeliveryAddress>;
      const data = getFormData(form);
      data.requiresSiteDelivery = true;
      data.deliveryAddress = e.detail;
      setCompanyData(data);
      clearFieldError(form, 'deliveryAddress');
      clearFieldError(form, 'deliveryRegion');
      clearFieldError(form, 'deliveryCommune');

      // Auto-popular selects de región y comuna si Google extrajo esos datos.
      const deliveryRegion = form.querySelector<HTMLSelectElement>('[data-field="deliveryRegion"]');
      const deliveryCommune = form.querySelector<HTMLSelectElement>('[data-field="deliveryCommune"]');
      if (e.detail.region && deliveryRegion) {
        const regionCode = getRegionCodeByName(e.detail.region);
        if (regionCode) {
          deliveryRegion.value = regionCode;
          // Repoblar comunas.
          if (deliveryCommune) {
            const communes = getCommunesByRegionCode(regionCode);
            deliveryCommune.innerHTML =
              '<option value="">Selecciona una comuna</option>' +
              communes.map((c) => `<option value="${c}"${c === e.detail.commune ? ' selected' : ''}>${c}</option>`).join('');
          }
        }
      }
    }) as EventListener);

    deliveryContainer?.addEventListener('address-cleared', () => {
      const data = getFormData(form);
      data.requiresSiteDelivery = true;
      delete data.deliveryAddress;
      setCompanyData(data);
    });

    // Sincronizar cambios de otras pestañas.
    subscribeCompanyData((data) => {
      if (document.activeElement?.closest('[data-quote-company-form]')) {
        // No sobrescribir mientras el usuario escribe.
        return;
      }
      setFormData(form, data);
      if (deliveryContainer) deliveryContainer.hidden = !data.requiresSiteDelivery;
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const data = getFormData(form);
      setCompanyData(data);
      const isValid = validateAndShow(form, true);
      if (isValid) {
        dispatchNavigate('next');
      } else {
        const formError = form.querySelector<HTMLElement>('[data-form-error]');
        if (formError) {
          formError.textContent = 'Revisa los campos marcados antes de continuar.';
        }
        // Focus al primer campo con error.
        const firstInvalid = form.querySelector<HTMLInputElement>('[aria-invalid="true"]');
        if (firstInvalid) {
          firstInvalid.focus();
        } else {
          // Si el error está en deliveryAddress, hacer scroll a la sección.
          const deliveryError = form.querySelector<HTMLElement>('[data-error="deliveryAddress"]');
          if (deliveryError?.textContent) {
            deliveryError.scrollIntoView({ behavior: 'smooth', block: 'center' });
          }
        }
      }
    });

    form.querySelector<HTMLButtonElement>('[data-quote-wizard-prev="company"]')?.addEventListener('click', () => {
      dispatchNavigate('prev');
    });
  });
</script>

<style>
  .quote-company {
    background-color: var(--theme-surface);
    border: 1px solid var(--theme-border);
    border-radius: var(--radius-md);
    padding: var(--space-6);
  }

  .quote-company__head {
    margin-bottom: var(--space-6);
  }

  .quote-company__title {
    margin: 0 0 0.5rem;
    font-family: var(--font-heading);
    font-size: var(--text-h4);
    font-weight: 700;
    color: var(--theme-heading);
  }

  .quote-company__lead {
    margin: 0;
    color: var(--theme-text-muted);
    font-size: var(--text-body);
    line-height: 1.6;
  }

  .quote-company__form {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .quote-company__form {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .quote-company__field {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .quote-company__field label {
    font-size: var(--text-small);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--theme-text-muted);
  }

  .quote-company__field input {
    font-family: var(--font-body);
    font-size: var(--text-body);
    color: var(--theme-text);
    background-color: var(--theme-bg-elevated);
    border: 1px solid var(--theme-border);
    border-radius: var(--radius-sm);
    padding: 0.625rem 0.75rem;
    transition: border-color 0.15s var(--ease-out, ease),
      box-shadow 0.15s var(--ease-out, ease);
  }

  .quote-company__field input:focus {
    outline: 2px solid var(--color-brand, #308f40);
    outline-offset: 2px;
    border-color: var(--color-brand, #308f40);
  }

  .quote-company__field input.is-invalid {
    border-color: var(--color-danger, #c0392b);
    background-color: color-mix(in srgb, var(--color-danger) 4%, transparent);
  }

  .quote-company__field input.is-invalid:focus {
    outline-color: var(--color-danger, #c0392b);
  }

  .quote-company__error {
    margin: 0;
    font-size: var(--text-small);
    color: var(--color-danger, #c0392b);
    min-height: 1.2em;
  }

  .quote-company__form-error {
    grid-column: 1 / -1;
    margin: 0;
    padding: 0.75rem;
    background-color: color-mix(in srgb, var(--color-danger) 8%, transparent);
    border: 1px solid var(--color-danger, #c0392b);
    border-radius: var(--radius-sm);
    color: var(--color-danger, #c0392b);
    font-size: var(--text-small);
    font-weight: 700;
  }

  .quote-company__form-error:empty {
    display: none;
  }

  .quote-company__actions {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3, 0.75rem);
    margin-top: var(--space-2, 0.5rem);
  }

  @media (max-width: 639.98px) {
    .quote-company__actions :global(.btn) {
      width: 100%;
    }
  }

  /* ── Sección de envío a faena ── */
  .quote-company__delivery-section {
    grid-column: 1 / -1;
    border: 0;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-4);
    border-top: 1px solid var(--theme-border);
  }

  .quote-company__delivery-legend {
    font-size: var(--text-small);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--theme-text-muted);
    padding: 0;
    margin-bottom: var(--space-1);
  }

  .quote-company__delivery-hint {
    margin: 0;
    font-size: var(--text-body);
    color: var(--theme-text);
    line-height: 1.5;
  }

  .quote-company__delivery-options {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-1);
  }

  .quote-company__radio-label {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-body);
    color: var(--theme-text);
    cursor: pointer;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--theme-border);
    border-radius: var(--radius-sm);
    transition:
