---
// src/components/ui/HeroVideo.astro
// Hero section con video de fondo, overlay gradient y contenido alineado abajo.
// Estructura basada en la referencia IP-Sitio-Web (d-hero).
// Soporta layout "full" (video de fondo completo) y "split" (video a la derecha, texto a la izquierda).

import Container from './Container.astro';
import Button from './Button.astro';
import Eyebrow from './Eyebrow.astro';

export interface Props {
  videoSrc: string;
  poster?: string;
  eyebrow?: string;
  title: string;
  titleHighlight?: string; // Texto que se resaltará en verde
  subtitle?: string;
  ctaPrimary?: {
    label: string;
    href: string;
  };
  ctaSecondary?: {
    label: string;
    href: string;
    external?: boolean;
  };
  minHeight?: 'sm' | 'md' | 'lg';
  layout?: 'full' | 'split';
  /** Ancho intrínseco del video (evita CLS). Default: 1920 */
  videoWidth?: number;
  /** Alto intrínseco del video (evita CLS). Default: 1080 */
  videoHeight?: number;
}

const {
  videoSrc,
  poster,
  eyebrow,
  title,
  titleHighlight,
  subtitle,
  ctaPrimary,
  ctaSecondary,
  minHeight = 'lg',
  layout = 'full',
  videoWidth = 1920,
  videoHeight = 1080,
} = Astro.props;

const minHeightClasses = {
  sm: 'hero-video--sm',
  md: 'hero-video--md',
  lg: 'hero-video--lg',
};

const layoutClass = layout === 'split' ? 'hero-video--split' : '';

// Función para resaltar texto en el título
function renderTitle(fullTitle: string, highlight?: string): string {
  if (!highlight) return fullTitle;
  return fullTitle.replace(highlight, `<b>${highlight}</b>`);
}

// Asegurar que la ruta del video sea absoluta
const resolvedVideoSrc = videoSrc ? (videoSrc.startsWith('/') ? videoSrc : `/${videoSrc}`) : '';
// El poster puede venir de un asset de Astro (/_astro/...) o de una ruta estática
// No modificar si ya empieza con / o _
const resolvedPoster = poster && !poster.startsWith('/') && !poster.startsWith('_') 
  ? `/${poster}` 
  : poster;
---

<section class={`hero-video ${minHeightClasses[minHeight]} ${layoutClass}`.trim()}>
  {layout === 'full' ? (
    <>
      <video
        muted
        loop
        playsinline
        preload="none"
        width={videoWidth}
        height={videoHeight}
        poster={resolvedPoster}
        data-hero-video
      >
        <source src={resolvedVideoSrc} type="video/mp4" />
      </video>
      
      <div class="hero-video__overlay" aria-hidden="true"></div>
      
      <Container class="hero-video__container">
        <div class="hero-video__content">
          {eyebrow && <Eyebrow text={eyebrow} />}
          
          <h1 class="hero-video__title" set:html={renderTitle(title, titleHighlight)}></h1>
          
          {subtitle && <p class="hero-video__subtitle">{subtitle}</p>}
          
          {(ctaPrimary || ctaSecondary) && (
            <div class="hero-video__actions">
              {ctaPrimary && (
                <Button href={ctaPrimary.href} variant="primary" size="lg">
                  {ctaPrimary.label}
                </Button>
              )}
              {ctaSecondary && (
                <Button 
                  href={ctaSecondary.href} 
                  variant="ghost" 
                  onDark 
                  size="lg"
                  target={ctaSecondary.external ? '_blank' : undefined}
                  rel={ctaSecondary.external ? 'noopener noreferrer' : undefined}
                >
                  {ctaSecondary.label}
                </Button>
              )}
            </div>
          )}
        </div>
      </Container>
      
      <div class="hero-video__scroll" aria-hidden="true">
        <span></span>
        Scroll
      </div>
    </>
  ) : (
    <>
      <div class="hero-video__media">
        <video
          muted
          loop
          playsinline
          preload="none"
          width={videoWidth}
          height={videoHeight}
          poster={resolvedPoster}
          data-hero-video
        >
          <source src={resolvedVideoSrc} type="video/mp4" />
        </video>
      </div>
      
      <Container class="hero-video__container-split">
        <div class="hero-video__content-split">
          {eyebrow && <Eyebrow text={eyebrow} />}
          
          <h1 class="hero-video__title" set:html={renderTitle(title, titleHighlight)}></h1>
          
          {subtitle && <p class="hero-video__subtitle">{subtitle}</p>}
          
          {(ctaPrimary || ctaSecondary) && (
            <div class="hero-video__actions">
              {ctaPrimary && (
                <Button href={ctaPrimary.href} variant="primary" size="lg">
                  {ctaPrimary.label}
                </Button>
              )}
              {ctaSecondary && (
                <Button 
                  href={ctaSecondary.href} 
                  variant="ghost" 
                  onDark 
                  size="lg"
                  target={ctaSecondary.external ? '_blank' : undefined}
                  rel={ctaSecondary.external ? 'noopener noreferrer' : undefined}
                >
                  {ctaSecondary.label}
                </Button>
              )}
            </div>
          )}
        </div>
      </Container>
    </>
  )}
</section>

<script>
  /**
   * Hero Video — carga diferida con IntersectionObserver.
   *
   * Estrategia de rendimiento:
   * 1. El <video> nace con preload="none" → no descarga bytes hasta que sea necesario.
   * 2. IntersectionObserver detecta cuando el hero entra al viewport.
   * 3. En ese momento se inyecta el <source>, se carga y se reproduce.
   * 4. Cuando el hero sale del viewport, se pausa para ahorrar CPU/batería.
   * 5. Si el usuario prefiere movimiento reducido, se muestra solo el poster.
   */
  document.addEventListener('DOMContentLoaded', () => {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const videos = document.querySelectorAll<HTMLVideoElement>('[data-hero-video]');

    if (prefersReducedMotion) {
      // No cargar ni reproducir video — el poster queda visible como fallback estático.
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const video = entry.target as HTMLVideoElement;

          if (entry.isIntersecting) {
            // Si el source aún no se ha inyectado, hacerlo ahora (lazy load).
            if (!video.dataset.loaded) {
              const source = video.querySelector('source');
              if (source) {
                // El src ya está en el HTML pero con preload="none" no se descarga.
                // Forzar la carga cambiando preload a "auto".
                video.preload = 'auto';
                video.load();
              }
              video.dataset.loaded = 'true';
            }

            // Intentar reproducir.
            video.play().catch(() => {
              // Si el navegador bloquea autoplay, reintentar en la primera interacción.
              const resume = () => {
                video.play().catch(() => {});
                document.removeEventListener('click', resume);
                document.removeEventListener('scroll', resume);
                document.removeEventListener('keydown', resume);
              };
              document.addEventListener('click', resume, { once: true });
              document.addEventListener('scroll', resume, { once: true });
              document.addEventListener('keydown', resume, { once: true });
            });
          } else {
            // Pausar cuando el hero no es visible — ahorra CPU y batería.
            if (video.dataset.loaded && !video.paused) {
              video.pause();
            }
          }
        }
      },
      { threshold: 0.15 }
    );

    videos.forEach((video) => observer.observe(video));
  });
</script>

<style>
  .hero-video {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background-color: var(--color-graphite);
  }

  /* Modo inmersivo: hero sube detrás del header */
  :global(body.immersive-hero) .hero-video {
    margin-top: calc(-1 * (var(--topbar-height, 40px) + var(--header-height, 80px)));
    padding-top: calc(var(--topbar-height, 40px) + var(--header-height, 80px));
  }

  .hero-video--sm {
    min-height: calc(50svh + var(--topbar-height, 40px) + var(--header-height, 80px));
  }

  .hero-video--md {
    min-height: calc(65svh + var(--topbar-height, 40px) + var(--header-height, 80px));
  }

  .hero-video--lg {
    min-height: calc(75svh + var(--topbar-height, 40px) + var(--header-height, 80px));
  }

  @media (max-width: 1180px) {
    .hero-video--lg {
      min-height: calc(65svh + var(--topbar-height, 40px) + var(--header-height, 80px));
    }
  }

  .hero-video video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
    contain: strict;
    background-color: var(--color-graphite);
  }

  .hero-video__overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
    background: linear-gradient(
      180deg,
      rgba(13, 22, 17, 0.6) 0%,
      rgba(13, 22, 17, 0.4) 50%,
      rgba(13, 22, 17, 0.7) 100%
    );
  }

  .hero-video__container {
    position: relative;
    z-index: 10;
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .hero-video__content {
    position: relative;
    z-index: 11;
    text-align: center;
    max-width: 900px;
  }

  .hero-video__title {
    color: var(--color-on-dark);
    font-family: var(--font-heading);
    font-weight: 900;
    line-height: 0.98;
    letter-spacing: -0.03em;
    font-size: clamp(2.4rem, 6vw, 5.4rem);
    text-wrap: balance;
    margin: 0;
  }

  :global(.hero-video__title b) {
    color: var(--color-brand-300);
    font-weight: 900;
  }

  .hero-video__subtitle {
    color: rgba(255, 255, 255, 0.86);
    font-size: clamp(1.05rem, 1.5vw, 1.3rem);
    max-width: 54ch;
    margin: 24px auto 28px;
    line-height: 1.55;
  }

  .hero-video__actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
  }

  .hero-video__scroll {
    position: absolute;
    left: 50%;
    bottom: 18px;
    transform: translateX(-50%);
    z-index: 3;
    color: rgba(255, 255, 255, 0.55);
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .hero-video__scroll span {
    width: 1px;
    height: 30px;
    background: linear-gradient(rgba(255, 255, 255, 0.55), transparent);
  }

  /* ═══════════════════════════════════════════════════════════════════════════════
     LAYOUT SPLIT: Video a la derecha (46%), texto a la izquierda sobre fondo graphite
     Basado en la referencia IP-Sitio-Web/arriendos.html
     ═══════════════════════════════════════════════════════════════════════════════ */
  
  .hero-video--split {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .hero-video--split.hero-video--sm {
    min-height: calc(60vh + var(--topbar-height, 40px) + var(--header-height, 80px));
  }

  .hero-video--split.hero-video--md {
    min-height: calc(70vh + var(--topbar-height, 40px) + var(--header-height, 80px));
  }

  .hero-video--split.hero-video--lg {
    min-height: calc(80vh + var(--topbar-height, 40px) + var(--header-height, 80px));
  }

  .hero-video__media {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 46%;
    z-index: 0;
  }

  .hero-video__media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.9;
    contain: strict;
    background-color: var(--color-graphite);
  }

  .hero-video__media::after {
    content: "";
    position: absolute;
    inset: 0;
    background: 
      linear-gradient(90deg, var(--color-graphite) 0%, rgba(13, 22, 17, 0.55) 16%, rgba(13, 22, 17, 0) 46%),
      linear-gradient(180deg, rgba(13, 22, 17, 0) 60%, rgba(13, 22, 17, 0.5) 100%);
  }

  .hero-video__container-split {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: var(--container-max-width, 1360px);
    margin-inline: auto;
    padding-block: clamp(32px, 4.5vh, 64px) clamp(26px, 3.5vh, 46px);
    padding-inline: var(--container-padding, 20px);
  }

  .hero-video__content-split {
    max-width: 34rem;
  }

  .hero-video__content-split .hero-video__title {
    text-align: left;
    font-size: clamp(1.9rem, 4.4vw, 3.4rem);
  }

  .hero-video__content-split .hero-video__subtitle {
    text-align: left;
    margin: 20px 0 0;
  }

  .hero-video__content-split .hero-video__actions {
    justify-content: flex-start;
    margin-top: 28px;
  }

  @media (max-width: 880px) {
    .hero-video--split {
      min-height: auto;
      display: flex;
      flex-direction: column;
    }

    .hero-video__media {
      position: relative;
      width: 100%;
      height: 50vh;
      order: 1;
    }

    .hero-video__media::after {
      background: linear-gradient(180deg, rgba(13, 22, 17, 0) 60%, rgba(13, 22, 17, 0.5) 100%);
    }

    .hero-video__container-split {
      order: 2;
      position: relative;
      z-index: 2;
    }

    .hero-video__content-split {
      max-width: 100%;
    }

    .hero-video__content-split .hero-video__title,
    .hero-video__content-split .hero-video__subtitle {
      text-align: center;
    }

    .hero-video__content-split .hero-video__actions {
      justify-content: center;
    }
  }
</style>
