---
// src/components/ui/NewsGrid.astro
// Grid de noticias / blog posts.
// Header con eyebrow + H2 + subtitle, siguiendo el patrón unificado del sitio
// (mismo eyebrow decorado con línea, H2 con la tipografía del design system,
// subtítulo en tono medio, alineación que se ajusta a la variante light/dark).
// Card alineada con la maqueta IP-Sitio-Web (image + date + title + link).
// Accesibilidad: la `<section>` se referencia con `aria-labelledby` al H2
// para que lectores de pantalla anuncien la sección por su título visible.

import type { NewsCard } from '@/lib/news';

export interface Props {
  items: NewsCard[];
  eyebrow?: string;                  // ej. "Blog" / "Actualidad" / "Sigue leyendo"
  title?: string;                    // ej. "Novedades" / "Noticias relacionadas"
  subtitle?: string;                 // descripción debajo del H2
  columns?: 2 | 3 | 4;
  variant?: 'light' | 'dark';
  showCategory?: boolean;
  className?: string;
  /** id estable para `aria-labelledby` en la `<section>`. Útil cuando hay varias en la misma página. */
  headingId?: string;
}

const {
  items,
  eyebrow,
  title,
  subtitle,
  columns = 3,
  variant = 'dark',
  showCategory = true,
  className = '',
  headingId,
} = Astro.props;

const columnsClass = `news-grid--cols-${columns}`;
const variantClass = `news-grid--${variant}`;

// Generamos un id estable si no se pasa, para soportar `aria-labelledby` sin
// requerir configuración manual en cada llamada.
const resolvedHeadingId =
  headingId ?? `news-grid-title-${Math.random().toString(36).slice(2, 9)}`;
const hasHeader = Boolean(eyebrow || title || subtitle);

function formatDate(iso: string): string {
  return new Date(iso).toLocaleDateString('es-CL', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<section
  class:list={['news-grid', variantClass, columnsClass, className]}
  aria-labelledby={hasHeader && title ? resolvedHeadingId : undefined}
>
  <div class="news-grid__container">
    {hasHeader && (
      <header class="news-grid__header">
        {eyebrow && <p class="news-grid__eyebrow">{eyebrow}</p>}
        {title && (
          <h2 id={resolvedHeadingId} class="news-grid__title">{title}</h2>
        )}
        {subtitle && <p class="news-grid__subtitle">{subtitle}</p>}
      </header>
    )}

    <ul class="news-grid__items" role="list">
      {items.map((item) => (
        <li>
          <article class="news-card">
            <a
              href={`/noticias/${item.slug}`}
              class="news-card__link"
              aria-label={`Leer: ${item.title}`}
            >
              <div class="news-card__image">
                <img
                  src={item.image}
                  alt={item.imageAlt}
                  loading="lazy"
                  decoding="async"
                  width="800"
                  height="500"
                />
              </div>
              <div class="news-card__body">
                <time datetime={item.date} class="news-card__date">
                  {formatDate(item.date)}
                </time>
                <h3 class="news-card__title">{item.title}</h3>
                <span class="news-card__link-cta" aria-hidden="true">
                  Leer artículo
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M5 12h14M13 5l7 7-7 7"/>
                  </svg>
                </span>
              </div>
            </a>
          </article>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* ── Sección ─────────────────────────────────────────────────── */
  .news-grid {
    padding-block: clamp(56px, 8vw, 100px);
  }

  .news-grid--light {
    background-color: var(--theme-bg-alt);
  }

  .news-grid--dark {
    background-color: var(--theme-bg);
  }

  .news-grid__container {
    max-width: 1360px;
    margin-inline: auto;
    padding-inline: var(--container-padding, 20px);
  }

  .news-grid__header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: clamp(28px, 4vw, 48px);
  }

  /* Cuando la sección va en una página de detalle (noticias/[post]),
     el layout flex-end mantiene la coherencia con los split-sections. */
  @media (min-width: 768px) {
    .news-grid__header {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
      flex-wrap: wrap;
    }
  }

  /* Eyebrow — mismo patrón que el resto del sitio: línea decorativa
     ::before, color de acento, mayúsculas, tracking amplio,
     tipografía del design system. */
  .news-grid__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin: 0;
  }

  .news-grid--light .news-grid__eyebrow {
    color: var(--theme-eyebrow);
  }

  .news-grid--dark .news-grid__eyebrow {
    color: var(--theme-eyebrow);
  }

  .news-grid__eyebrow::before {
    content: '';
    width: 42px;
    height: 2px;
    background: currentColor;
  }

  .news-grid__title {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(1.7rem, 3.2vw, 2.6rem);
    letter-spacing: -0.02em;
    line-height: 1.12;
    margin: 0;
    text-wrap: balance;
  }

  .news-grid--light .news-grid__title { color: var(--theme-heading); }
  .news-grid--dark .news-grid__title { color: var(--theme-heading); }

  .news-grid__subtitle {
    margin: 0;
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.55;
    color: var(--theme-text-muted);
    max-width: 46ch;
  }

  .news-grid__items {
    display: grid;
    gap: 20px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .news-grid--cols-2 .news-grid__items { grid-template-columns: repeat(2, 1fr); }
  .news-grid--cols-3 .news-grid__items { grid-template-columns: repeat(3, 1fr); }
  .news-grid--cols-4 .news-grid__items { grid-template-columns: repeat(4, 1fr); }

  @media (max-width: 900px) {
    .news-grid--cols-3 .news-grid__items,
    .news-grid--cols-4 .news-grid__items {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .news-grid--cols-2 .news-grid__items,
    .news-grid--cols-3 .news-grid__items,
    .news-grid--cols-4 .news-grid__items {
      grid-template-columns: 1fr;
    }
  }

  /* ── Card ────────────────────────────────────────────────────── */
  .news-card {
    background: var(--theme-bg-elevated);
    border: 1px solid var(--theme-border);
    border-radius: 14px;
    overflow: hidden;
    height: 100%;
    transition: transform 0.25s var(--ease-out, ease),
      border-color 0.25s var(--ease-out, ease);
  }

  .news-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-brand, #348f41);
  }

  .news-card__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  .news-card__link:focus-visible {
    outline: 2px solid var(--color-brand, #348f41);
    outline-offset: 4px;
    border-radius: 14px;
  }

  .news-card__image {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background-color: var(--theme-bg);
  }

  .news-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s var(--ease-out, ease);
  }

  .news-card:hover .news-card__image img {
    transform: scale(1.05);
  }

  .news-card__body {
    padding: 20px 22px 22px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
  }

  /* Fecha: verde claro, mayúscula, tracking — patrón del card IP-Sitio-Web */
  .news-card__date {
    color: var(--theme-eyebrow);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  /* Título */
  .news-card__title {
    color: var(--theme-text);
    font-family: var(--font-heading);
    font-size: 1.06rem;
    line-height: 1.25;
    font-weight: 700;
    margin: 4px 0 12px;
    letter-spacing: -0.005em;
  }

  /* CTA inline: verde claro, con flecha que se desplaza en hover */
  .news-card__link-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: auto;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--theme-eyebrow);
    transition: color 0.2s var(--ease-out, ease);
  }

  .news-card__link-cta svg {
    transition: transform 0.2s var(--ease-out, ease);
  }

  .news-card:hover .news-card__link-cta svg {
    transform: translateX(4px);
  }
</style>
