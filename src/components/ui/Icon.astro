---
// src/components/ui/Icon.astro
import type { IconName } from '@/lib/icons';

export interface Props {
  name: IconName;
  size?: number;
  class?: string;
  ariaLabel?: string;
}

const { name, size = 24, class: className, ariaLabel } = Astro.props;

// Carga todos los SVGs como strings en build time via Vite
const svgs = import.meta.glob<string>('../../assets/icons/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});

const key = Object.keys(svgs).find((path) => path.endsWith(`/${name}.svg`));
const svg = key ? svgs[key] : null;

if (!svg) {
  throw new Error(`Icono no encontrado: ${name}. Verifica que exista src/assets/icons/${name}.svg`);
}

const isInformative = Boolean(ariaLabel);
---

<span
  class:list={['icon', className]}
  style={`width:${size}px;height:${size}px;`}
  aria-hidden={isInformative ? 'false' : 'true'}
  role={isInformative ? 'img' : undefined}
  aria-label={ariaLabel}
  set:html={svg}
/>

<style>
  .icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .icon :global(svg) {
    width: 100%;
    height: 100%;
  }
</style>
