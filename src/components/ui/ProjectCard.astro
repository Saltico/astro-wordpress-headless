---
// src/components/ui/ProjectCard.astro
// Card de proyecto reutilizable con imagen, hover effect y metadata

export interface ProjectData {
  slug: string;
  title: string;
  client?: string;
  location?: string;
  category?: string;
  image?: string;
  description?: string;
  year?: number;
  result?: string;
}

export interface Props {
  project: ProjectData;
  variant?: 'default' | 'compact' | 'featured';
  showImage?: boolean;
  showCategory?: boolean;
  linkTarget?: string;
}

const {
  project,
  variant = 'default',
  showImage = true,
  showCategory = true,
  linkTarget,
} = Astro.props;

const href = linkTarget || `/proyectos/${project.slug}`;

const variantClasses = {
  default: 'project-card--default',
  compact: 'project-card--compact',
  featured: 'project-card--featured',
};
---

<article class={`project-card ${variantClasses[variant]}`.trim()}>
  {showImage && project.image && (
    <div class="project-card__image-wrapper">
      <img
        class="project-card__image"
        src={project.image}
        alt={project.title}
        loading="lazy"
        decoding="async"
      />
      <div class="project-card__overlay">
        <span class="project-card__view-more">
          Ver proyecto
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </span>
      </div>
    </div>
  )}

  <div class="project-card__content">
    {showCategory && project.category && (
      <span class="project-card__category">{project.category}</span>
    )}

    <h3 class="project-card__title">
      <a href={href} class="project-card__link">
        {project.title}
      </a>
    </h3>

    <div class="project-card__meta">
      {project.client && (
        <span class="project-card__client">{project.client}</span>
      )}
      {project.location && (
        <span class="project-card__separator" aria-hidden="true">·</span>
      )}
      {project.location && (
        <span class="project-card__location">{project.location}</span>
      )}
    </div>

    {project.description && variant === 'featured' && (
      <p class="project-card__description">{project.description}</p>
    )}

    {project.result && variant === 'compact' && (
      <p class="project-card__result">{project.result}</p>
    )}
  </div>
</article>

<style>
  .project-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background-color: var(--color-surface);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition:
      transform var(--motion-base) var(--ease-out),
      box-shadow var(--motion-base) var(--ease-out);
  }

  .project-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  /* Image wrapper */
  .project-card__image-wrapper {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background-color: var(--color-surface-alt);
  }

  .project-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s var(--ease-out);
  }

  .project-card:hover .project-card__image {
    transform: scale(1.05);
  }

  .project-card__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(
      to bottom,
      rgba(10, 22, 13, 0) 0%,
      rgba(10, 22, 13, 0.7) 100%
    );
    opacity: 0;
    transition: opacity 0.3s var(--ease-out);
  }

  .project-card:hover .project-card__overlay {
    opacity: 1;
  }

  .project-card__view-more {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-5);
    background-color: var(--color-brand);
    color: var(--color-on-brand);
    font-weight: 600;
    font-size: var(--text-small);
    border-radius: var(--radius-sm);
    transform: translateY(10px);
    transition: transform 0.3s var(--ease-out);
  }

  .project-card:hover .project-card__view-more {
    transform: translateY(0);
  }

  /* Content */
  .project-card__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
  }

  .project-card__category {
    display: inline-block;
    padding: var(--space-1) var(--space-3);
    background-color: var(--color-brand-050);
    color: var(--color-brand);
    font-size: var(--text-xsmall);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    border-radius: var(--radius-sm);
    width: fit-content;
  }

  .project-card__title {
    margin: 0;
    font-size: var(--text-h4);
    line-height: 1.3;
  }

  .project-card__link {
    color: inherit;
    text-decoration: none;
  }

  .project-card__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .project-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-small);
    color: var(--color-ink-500);
  }

  .project-card__separator {
    color: var(--color-ink-300);
  }

  .project-card__description,
  .project-card__result {
    margin: 0;
    font-size: var(--text-small);
    color: var(--color-ink-500);
    line-height: 1.5;
  }

  /* Variant: Compact */
  .project-card--compact {
    flex-direction: row;
    align-items: center;
  }

  .project-card--compact .project-card__image-wrapper {
    width: 120px;
    aspect-ratio: 1;
    flex-shrink: 0;
  }

  .project-card--compact .project-card__content {
    flex: 1;
    padding: var(--space-4);
  }

  .project-card--compact .project-card__title {
    font-size: var(--text-body);
  }

  /* Variant: Featured */
  .project-card--featured .project-card__image-wrapper {
    aspect-ratio: 16 / 9;
  }

  .project-card--featured .project-card__content {
    padding: var(--space-6);
  }

  .project-card--featured .project-card__title {
    font-size: var(--text-h3);
  }

  .project-card--featured .project-card__description {
    margin-top: var(--space-2);
  }

  /* Variant: Default (sin imagen) */
  .project-card--default:not(:has(.project-card__image-wrapper)) {
    border: 1px solid var(--color-border);
  }

  .project-card--default:not(:has(.project-card__image-wrapper)) .project-card__content {
    padding: var(--space-6);
  }

  @media (max-width: 480px) {
    .project-card--compact {
      flex-direction: column;
    }

    .project-card--compact .project-card__image-wrapper {
      width: 100%;
      aspect-ratio: 16 / 9;
    }
  }
</style>
