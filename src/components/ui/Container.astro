---
// src/components/ui/Container.astro
export interface Props {
  class?: string;
  as?: 'div' | 'section' | 'header' | 'footer' | 'article' | 'main';
  wide?: boolean;
}

const { as: Tag = 'div', class: className, wide = false } = Astro.props;
---

<Tag class:list={['app-container', wide && 'app-container--wide', className]}>
  <slot />
</Tag>

<style>
  .app-container {
    width: 100%;
    max-width: var(--container-max-width);
    margin-inline: auto;
    padding-inline: var(--container-padding);
  }

  .app-container--wide {
    max-width: 1360px;
  }

/*  TODO: VERIFICAR TAMAÑOS EN MOBILE 
    @media (min-width: 768px) {
    .app-container {
      padding-inline: 1.5rem;
    }
  }

  @media (min-width: 1280px) {
    .app-container {
      padding-inline: 2rem;
    }
  } */
</style>
