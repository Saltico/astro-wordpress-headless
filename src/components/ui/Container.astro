---
// src/components/ui/Container.astro
export interface Props {
  class?: string;
  as?: 'div' | 'section' | 'header' | 'footer' | 'article' | 'main';
}

const { as: Tag = 'div', class: className } = Astro.props;
---

<Tag class:list={['app-container', className]}>
  <slot />
</Tag>

<style>
  .app-container {
    width: 100%;
    max-width: var(--container-max-width);
    margin-inline: auto;
    padding-inline: var(--container-padding);
  }

  @media (min-width: 768px) {
    .app-container {
      padding-inline: 1.5rem;
    }
  }

  @media (min-width: 1280px) {
    .app-container {
      padding-inline: 2rem;
    }
  }
</style>
