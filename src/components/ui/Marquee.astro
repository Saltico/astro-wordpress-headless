---
// src/components/ui/Marquee.astro
// Texto en movimiento continuo (marquee/ticker)
// Altamente configurable para reutilización en plantillas

export interface MarqueeItem {
  text: string;
  separator?: string;
}

export interface Props {
  items: MarqueeItem[];
  speed?: 'slow' | 'normal' | 'fast';
  backgroundColor?: string;
  textColor?: string;
  separatorColor?: string;
  pauseOnHover?: boolean;
  className?: string;
}

const {
  items,
  speed = 'normal',
  backgroundColor,
  textColor,
  separatorColor,
  pauseOnHover = true,
  className = '',
} = Astro.props;

const speedDurations = {
  slow: '45s',
  normal: '32s',
  fast: '20s',
};

const duration = speedDurations[speed];
---

<div
  class={`marquee ${pauseOnHover ? 'marquee--pause-hover' : ''} ${className}`.trim()}
  style={backgroundColor ? `background-color: ${backgroundColor};` : ''}
  aria-hidden="true"
>
  <div
    class="marquee__track"
    style={`animation-duration: ${duration};`}
  >
    <!-- Duplicado para loop continuo -->
    <div class="marquee__group">
      {items.map((item, i) => (
        <>
          <span style={textColor ? `color: ${textColor};` : ''}>{item.text}</span>
          {i < items.length - 1 && (
            <i style={separatorColor ? `color: ${separatorColor};` : ''}>
              {item.separator || '◆'}
            </i>
          )}
        </>
      ))}
      <!-- Último separador -->
      <i style={separatorColor ? `color: ${separatorColor};` : ''}>
        {items[items.length - 1]?.separator || '◆'}
      </i>
    </div>
    <!-- Duplicado para seamless loop -->
    <div class="marquee__group">
      {items.map((item, i) => (
        <>
          <span style={textColor ? `color: ${textColor};` : ''}>{item.text}</span>
          {i < items.length - 1 && (
            <i style={separatorColor ? `color: ${separatorColor};` : ''}>
              {item.separator || '◆'}
            </i>
          )}
        </>
      ))}
      <i style={separatorColor ? `color: ${separatorColor};` : ''}>
        {items[items.length - 1]?.separator || '◆'}
      </i>
    </div>
  </div>
</div>

<style>
  .marquee {
    overflow: hidden;
    padding: 20px 0;
    border-block: 1px solid rgba(0, 0, 0, 0.12);
    background-color: var(--color-brand, #1a9c4a);
  }

  .marquee--pause-hover:hover .marquee__track {
    animation-play-state: paused;
  }

  .marquee__track {
    display: flex;
    width: max-content;
    animation: marquee-scroll linear infinite;
  }

  @keyframes marquee-scroll {
    to {
      transform: translateX(-50%);
    }
  }

  .marquee__group {
    display: flex;
    align-items: center;
    gap: 34px;
    padding-right: 34px;
  }

  .marquee__group span {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(1.3rem, 2.6vw, 2.1rem);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: #fff;
    white-space: nowrap;
  }

  .marquee__group i {
    color: rgba(255, 255, 255, 0.55);
    font-style: normal;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee__track {
      animation: none;
    }
  }
</style>
