---
// src/components/ui/TrustBand.astro
// Carrusel infinito de logos de clientes (escala de grises, movimiento left-to-right).
// Usa dos copias del track para loop continuo y respeta prefers-reduced-motion.

export interface Logo {
  src: string;
  alt: string;
  width?: number;
  height?: number;
}

export interface Props {
  title?: string;
  logos: Logo[];
}

const { title = 'Empresas que confían en nosotros', logos } = Astro.props;

const defaultWidth = 160;
const defaultHeight = 48;

// Duplicamos los logos para crear el efecto de loop infinito
const trackLogos = [...logos, ...logos];
---

<section class="trust-band" aria-labelledby="trust-title">
  <div class="app-container trust-band__inner">
    {title && <h2 id="trust-title" class="trust-band__title">{title}</h2>}

    <div class="trust-band__viewport" role="region" aria-roledescription="carrusel" aria-label={title}>
      <ul class="trust-band__track">
        {
          trackLogos.map((logo, index) => (
            <li class="trust-band__item" aria-hidden={index >= logos.length ? 'true' : undefined}>
              <img
                src={logo.src}
                alt={logo.alt}
                width={logo.width ?? defaultWidth}
                height={logo.height ?? defaultHeight}
                loading="lazy"
                decoding="async"
              />
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .trust-band {
    padding-block: var(--space-12);
    background-color: var(--color-surface);
    border-block: 1px solid var(--color-border);
  }

  .trust-band__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
  }

  .trust-band__title {
    margin: 0;
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
    text-align: center;
  }

  .trust-band__viewport {
    width: 100%;
    overflow: hidden;
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 8%,
      black 92%,
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 8%,
      black 92%,
      transparent 100%
    );
  }

  .trust-band__track {
    display: flex;
    align-items: center;
    gap: var(--space-10);
    width: max-content;
    list-style: none;
    padding: 0;
    margin: 0;
    animation: scroll-logos 40s linear infinite;
    will-change: transform;
  }

  .trust-band__viewport:hover .trust-band__track,
  .trust-band__viewport:focus-within .trust-band__track {
    animation-play-state: paused;
  }

  .trust-band__item {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    height: 3rem;
    padding-inline: var(--space-4);
  }

  .trust-band__item img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: 100%;
    object-fit: contain;
    filter: grayscale(100%);
    opacity: 0.72;
    transition:
      filter var(--motion-base) var(--ease-out),
      opacity var(--motion-base) var(--ease-out);
  }

  .trust-band__item:hover img,
  .trust-band__item:focus-within img {
    filter: grayscale(0%);
    opacity: 1;
  }

  @keyframes scroll-logos {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  /* Fallback accesible: sin movimiento, grid estatico */
  @media (prefers-reduced-motion: reduce) {
    .trust-band__track {
      animation: none;
      width: 100%;
      flex-wrap: wrap;
      justify-content: center;
    }

    .trust-band__item img {
      filter: grayscale(100%);
      opacity: 0.8;
    }
  }
</style>
