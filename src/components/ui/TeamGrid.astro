---
// src/components/ui/TeamGrid.astro
// Grid de miembros del equipo
// Inspirado en la sección de equipo de Tecnisud

import Container from './Container.astro';
import Icon from './Icon.astro';

export interface TeamMember {
  name: string;
  role: string;
  image?: string;
  bio?: string;
  email?: string;
  linkedin?: string;
}

export interface Props {
  members: TeamMember[];
  title?: string;
  subtitle?: string;
  columns?: 2 | 3 | 4;
}

const {
  members,
  title,
  subtitle,
  columns = 4,
} = Astro.props;

const columnsClass = `team-grid--cols-${columns}`;
---

<section class="team-grid-section">
  <Container>
    {(title || subtitle) && (
      <div class="team-grid-section__header">
        {title && <h2 class="team-grid-section__title">{title}</h2>}
        {subtitle && <p class="team-grid-section__subtitle">{subtitle}</p>}
      </div>
    )}

    <div class={`team-grid ${columnsClass}`}>
      {members.map((member) => (
        <article class="team-card">
          <div class="team-card__image-wrapper">
            {member.image ? (
              <img
                src={member.image}
                alt={member.name}
                class="team-card__image"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <div class="team-card__placeholder">
                <Icon name="user" size={48} />
              </div>
            )}
          </div>
          <div class="team-card__content">
            <h3 class="team-card__name">{member.name}</h3>
            <p class="team-card__role">{member.role}</p>
            {member.bio && <p class="team-card__bio">{member.bio}</p>}
            {(member.email || member.linkedin) && (
              <div class="team-card__social">
                {member.email && (
                  <a href={`mailto:${member.email}`} class="team-card__social-link" aria-label={`Email de ${member.name}`}>
                    <Icon name="email" size={18} />
                  </a>
                )}
                {member.linkedin && (
                  <a href={member.linkedin} class="team-card__social-link" target="_blank" rel="noopener noreferrer" aria-label={`LinkedIn de ${member.name}`}>
                    <Icon name="linkedin" size={18} />
                  </a>
                )}
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  </Container>
</section>

<style>
  .team-grid-section {
    padding: var(--space-16) 0;
  }

  .team-grid-section__header {
    text-align: center;
    margin-bottom: var(--space-10);
    max-width: 60ch;
    margin-inline: auto;
  }

  .team-grid-section__title {
    margin: 0 0 var(--space-4);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
  }

  .team-grid-section__subtitle {
    font-size: var(--text-lead);
    color: var(--color-ink-500);
    margin: 0;
    line-height: 1.6;
  }

  /* Grid */
  .team-grid {
    display: grid;
    gap: var(--space-6);
  }

  .team-grid--cols-2 {
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .team-grid--cols-2 {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .team-grid--cols-3 {
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .team-grid--cols-3 {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .team-grid--cols-3 {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .team-grid--cols-4 {
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .team-grid--cols-4 {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .team-grid--cols-4 {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* Card */
  .team-card {
    display: flex;
    flex-direction: column;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition:
      box-shadow var(--motion-base) var(--ease-out),
      transform var(--motion-base) var(--ease-out);
  }

  .team-card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-4px);
  }

  .team-card__image-wrapper {
    aspect-ratio: 1;
    overflow: hidden;
    background-color: var(--color-surface-alt);
  }

  .team-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s var(--ease-out);
  }

  .team-card:hover .team-card__image {
    transform: scale(1.05);
  }

  .team-card__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-ink-300);
    background-color: var(--color-surface-alt);
  }

  .team-card__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
  }

  .team-card__name {
    margin: 0;
    font-size: var(--text-h4);
    font-weight: 600;
  }

  .team-card__role {
    margin: 0;
    font-size: var(--text-small);
    color: var(--color-brand);
    font-weight: 600;
  }

  .team-card__bio {
    margin: 0;
    font-size: var(--text-small);
    color: var(--color-ink-500);
    line-height: 1.5;
  }

  .team-card__social {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .team-card__social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    color: var(--color-ink-500);
    background-color: var(--color-surface-alt);
    border-radius: var(--radius-sm);
    transition:
      color var(--motion-base) var(--ease-out),
      background-color var(--motion-base) var(--ease-out);
  }

  .team-card__social-link:hover {
    color: var(--color-brand);
    background-color: var(--color-brand-050);
  }
</style>
