---
// src/components/ui/Input.astro
// Input reutilizable del design system.
//
// Una sola fuente de verdad para todos los inputs de texto del sitio.
// Soporta label, placeholder, required, disabled, error y todos los tipos.
//
// Ejemplos:
//   <Input name="email" type="email" label="Email" placeholder="tu@email.com" required />
//   <Input name="phone" type="tel" label="Teléfono" error="Teléfono inválido" />
//   <Input name="search" type="text" placeholder="Buscar..." />

export interface Props {
  type?: 'text' | 'email' | 'tel' | 'number' | 'password' | 'search' | 'url';
  name: string;
  label?: string;
  placeholder?: string;
  value?: string;
  required?: boolean;
  disabled?: boolean;
  error?: string;
  autocomplete?: string;
  id?: string;
  class?: string;
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  [attr: string]: any;
}

const {
  type = 'text',
  name,
  label,
  placeholder,
  value,
  required = false,
  disabled = false,
  error,
  autocomplete,
  id,
  class: className,
  ...rest
} = Astro.props;

const inputId = id ?? `input-${name}`;
const errorId = error ? `${inputId}-error` : undefined;
---

<div class:list={['input-wrapper', error && 'input-wrapper--error', className]}>
  {label && (
    <label for={inputId} class="input-wrapper__label">
      {label}
      {required && <span class="input-wrapper__required" aria-hidden="true">*</span>}
    </label>
  )}
  <input
    type={type}
    id={inputId}
    name={name}
    placeholder={placeholder}
    value={value}
    required={required}
    disabled={disabled}
    autocomplete={autocomplete}
    class="input-wrapper__input"
    aria-describedby={errorId}
    aria-invalid={error ? 'true' : undefined}
    {...rest}
  />
  {error && <span class="input-wrapper__error" id={errorId} role="alert">{error}</span>}
  <slot />
</div>

<style>
  .input-wrapper {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .input-wrapper__label {
    font-family: var(--font-heading);
    font-size: var(--text-small);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--theme-text-muted);
  }

  .input-wrapper__required {
    color: var(--color-danger);
    margin-left: 0.15em;
  }

  .input-wrapper__input {
    font-family: var(--font-body);
    font-size: var(--text-body);
    color: var(--theme-text);
    background-color: var(--theme-bg-elevated);
    border: 1px solid var(--theme-border);
    border-radius: var(--radius-sm);
    padding: 0.625rem 0.75rem;
    transition:
      border-color var(--motion-base) var(--ease-out),
      box-shadow var(--motion-base) var(--ease-out);
  }

  .input-wrapper__input::placeholder {
    color: var(--theme-text-subtle);
  }

  .input-wrapper__input:focus {
    outline: 2px solid var(--color-brand);
    outline-offset: 2px;
    border-color: var(--color-brand);
  }

  .input-wrapper__input:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .input-wrapper--error .input-wrapper__input {
    border-color: var(--color-danger);
    background-color: color-mix(in srgb, var(--color-danger) 4%, transparent);
  }

  .input-wrapper--error .input-wrapper__input:focus {
    outline-color: var(--color-danger);
  }

  .input-wrapper__error {
    font-size: var(--text-small);
    color: var(--color-danger);
    font-weight: 600;
  }
</style>
