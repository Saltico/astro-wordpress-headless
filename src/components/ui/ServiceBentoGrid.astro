---
// src/components/ui/ServiceBentoGrid.astro
// Grid de servicios con layout bento asimétrico.
// Estructura basada en la referencia IP-Sitio-Web (svc-bento--feat).

import Container from './Container.astro';
import Eyebrow from './Eyebrow.astro';
import Icon from './Icon.astro';

export interface ServiceCard {
  category: string;
  title: string;
  description: string;
  image: string;
  imageAlt: string;
  url: string;
  linkLabel?: string;
}

export interface FeaturedServiceCard extends ServiceCard {
  featured: true;
}

export interface Props {
  eyebrow?: string;
  title: string;
  services: ServiceCard[];
  featuredService?: FeaturedServiceCard;
}

const {
  eyebrow,
  title,
  services,
  featuredService,
} = Astro.props;
---

<section class="service-bento-section">
  <Container>
    {eyebrow && <Eyebrow text={eyebrow} />}
    <h2 class="service-bento-section__title">{title}</h2>
    
    <div class="svc-bento">
      {services.map((service) => (
        <article class="svc-card reveal">
          <div class="svc-card__img">
            <img src={service.image} alt={service.imageAlt} loading="lazy" decoding="async" />
          </div>
          <div class="svc-card__body">
            <span class="svc-card__cat">{service.category}</span>
            <h3 class="svc-card__title">{service.title}</h3>
            <p class="svc-card__desc">{service.description}</p>
            <a class="svc-card__link" href={service.url}>
              {service.linkLabel || 'Conocer'}
              <Icon name="arrow-right" size={16} />
            </a>
          </div>
        </article>
      ))}
      
      {featuredService && (
        <article class="svc-card svc-card--feat reveal">
          <div class="svc-card__img">
            <img src={featuredService.image} alt={featuredService.imageAlt} loading="lazy" decoding="async" />
          </div>
          <div class="svc-card__body">
            <span class="svc-card__cat">{featuredService.category}</span>
            <h3 class="svc-card__title">{featuredService.title}</h3>
            <p class="svc-card__desc">{featuredService.description}</p>
            <a 
              class="svc-card__link" 
              href={featuredService.url}
              target={featuredService.url.startsWith('http') ? '_blank' : undefined}
              rel={featuredService.url.startsWith('http') ? 'noopener noreferrer' : undefined}
            >
              {featuredService.linkLabel || 'Ver flota'}
              <Icon name="arrow-right" size={16} />
            </a>
          </div>
        </article>
      )}
    </div>
  </Container>
</section>

<style>
  .service-bento-section {
    background: var(--theme-bg-alt);
    border-block: 1px solid var(--theme-border);
    padding-block: clamp(56px, 8vw, 100px);
  }

  .service-bento-section__title {
    color: var(--theme-heading);
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(1.8rem, 3.4vw, 2.8rem);
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-6);
  }

  .svc-bento {
    display: grid;
    grid-template-columns: 1fr 1fr 1.12fr;
    gap: var(--space-4);
  }

  .svc-card--feat {
    grid-column: 3;
    grid-row: 1 / 3;
  }

  @media (max-width: 860px) {
    .svc-bento {
      grid-template-columns: 1fr 1fr;
    }
    .svc-card--feat {
      grid-column: 1 / -1;
      grid-row: auto;
    }
  }

  @media (max-width: 560px) {
    .svc-bento {
      grid-template-columns: 1fr;
    }
    .svc-card--feat {
      grid-column: auto;
    }
  }

  .svc-card {
    display: flex;
    flex-direction: column;
    background: var(--theme-bg-elevated);
    border: 1px solid var(--theme-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: transform var(--motion-base) var(--ease-out),
                border-color var(--motion-base) var(--ease-out);
  }

  .svc-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-brand);
  }

  .svc-card__img {
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .svc-card__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--motion-slow) var(--ease-out);
  }

  .svc-card:hover .svc-card__img img {
    transform: scale(1.05);
  }

  .svc-card__body {
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex: 1;
  }

  .svc-card__cat {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--text-small);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--theme-eyebrow);
  }

  .svc-card__title {
    font-family: var(--font-heading);
    font-size: var(--text-h5);
    line-height: 1.25;
    font-weight: 700;
    margin: 0;
    color: var(--theme-text);
  }

  .svc-card__desc {
    color: var(--theme-text-muted);
    font-size: var(--text-small);
    line-height: 1.5;
    margin: 0;
  }

  .svc-card__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: auto;
    padding-top: var(--space-3);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--text-small);
    color: var(--theme-eyebrow);
    text-decoration: none;
    transition: gap var(--motion-base) var(--ease-out);
  }

  .svc-card__link:hover {
    gap: var(--space-3);
  }
</style>
