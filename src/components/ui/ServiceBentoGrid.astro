---
// src/components/ui/ServiceBentoGrid.astro
// Grid de servicios compacto con layout visual atractivo.
// Diseño inspirado en tarjetas compactas con jerarquía visual clara.

import Container from './Container.astro';
import Eyebrow from './Eyebrow.astro';
import Icon from './Icon.astro';

export interface ServiceCard {
  category: string;
  title: string;
  description: string;
  image: string;
  imageAlt: string;
  url: string;
  linkLabel?: string;
}

export interface FeaturedServiceCard extends ServiceCard {
  featured: true;
}

export interface Props {
  eyebrow?: string;
  title: string;
  services: ServiceCard[];
  featuredService?: FeaturedServiceCard;
}

const {
  eyebrow,
  title,
  services,
  featuredService,
} = Astro.props;
---

<section class="svc-compact-section" aria-labelledby="svc-compact-heading">
  <Container>
    {eyebrow && <Eyebrow text={eyebrow} />}
    <h2 id="svc-compact-heading" class="svc-compact-section__title reveal-up">{title}</h2>
    
    <div class="svc-compact-grid reveal-stagger">
      {services.map((service, index) => (
        <article class="svc-compact-card" style={`--card-index: ${index}`}>
          <a href={service.url} class="svc-compact-card__link" aria-label={`${service.category}: ${service.title}`}>
            <div class="svc-compact-card__img">
              <img src={service.image} alt={service.imageAlt} loading="lazy" decoding="async" />
            </div>
            <div class="svc-compact-card__content">
              <span class="svc-compact-card__cat">{service.category}</span>
              <h3 class="svc-compact-card__title">{service.title}</h3>
              <p class="svc-compact-card__desc">{service.description}</p>
              <span class="svc-compact-card__cta">
                {service.linkLabel || 'Conocer más'}
                <Icon name="arrow-right" size={14} />
              </span>
            </div>
          </a>
        </article>
      ))}
      
      {featuredService && (
        <article class="svc-compact-card svc-compact-card--featured">
          <a href={featuredService.url} class="svc-compact-card__link" aria-label={`${featuredService.category}: ${featuredService.title}`} target={featuredService.url.startsWith('http') ? '_blank' : undefined} rel={featuredService.url.startsWith('http') ? 'noopener noreferrer' : undefined}>
            <div class="svc-compact-card__img">
              <img src={featuredService.image} alt={featuredService.imageAlt} loading="lazy" decoding="async" />
            </div>
            <div class="svc-compact-card__content">
              <span class="svc-compact-card__cat">{featuredService.category}</span>
              <h3 class="svc-compact-card__title">{featuredService.title}</h3>
              <p class="svc-compact-card__desc">{featuredService.description}</p>
              <span class="svc-compact-card__cta">
                {featuredService.linkLabel || 'Ver flota'}
                <Icon name="arrow-right" size={14} />
              </span>
            </div>
          </a>
        </article>
      )}
    </div>
  </Container>
</section>

<style>
  .svc-compact-section {
    background: var(--theme-bg-alt);
    border-block: 1px solid var(--theme-border);
    padding-block: clamp(48px, 7vw, 88px);
  }

  .svc-compact-section__title {
    color: var(--theme-heading);
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-8);
    text-wrap: balance;
  }

  /* Grid layout: 4 columnas en desktop, 2 en tablet, 1 en mobile */
  .svc-compact-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
  }

  /* Card compacta */
  .svc-compact-card {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--theme-bg-elevated);
    border: 1px solid var(--theme-border);
    transition: transform var(--motion-base) var(--ease-out),
                box-shadow var(--motion-base) var(--ease-out),
                border-color var(--motion-base) var(--ease-out);
  }

  .svc-compact-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 24px -8px rgba(0, 0, 0, 0.15);
    border-color: var(--color-brand);
  }

  /* Link que cubre toda la card */
  .svc-compact-card__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  /* Imagen compacta */
  .svc-compact-card__img {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    position: relative;
  }

  .svc-compact-card__img::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 50%, rgba(0, 0, 0, 0.08) 100%);
    pointer-events: none;
  }

  .svc-compact-card__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--motion-slow) var(--ease-out);
  }

  .svc-compact-card:hover .svc-compact-card__img img {
    transform: scale(1.04);
  }

  /* Contenido */
  .svc-compact-card__content {
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    flex: 1;
  }

  /* Categoría */
  .svc-compact-card__cat {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--theme-eyebrow);
    margin-bottom: var(--space-1);
  }

  /* Título */
  .svc-compact-card__title {
    font-family: var(--font-heading);
    font-size: 1rem;
    line-height: 1.3;
    font-weight: 700;
    margin: 0;
    color: var(--theme-heading);
  }

  /* Descripción */
  .svc-compact-card__desc {
    color: var(--theme-text-muted);
    font-size: 0.8125rem;
    line-height: 1.5;
    margin: 0;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* CTA */
  .svc-compact-card__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    margin-top: var(--space-2);
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.75rem;
    color: var(--theme-eyebrow);
    transition: gap var(--motion-base) var(--ease-out);
  }

  .svc-compact-card:hover .svc-compact-card__cta {
    gap: var(--space-2);
  }

  /* Featured card - más grande */
  .svc-compact-card--featured {
    grid-column: span 2;
    grid-row: span 2;
  }

  .svc-compact-card--featured .svc-compact-card__img {
    aspect-ratio: 16 / 10;
  }

  .svc-compact-card--featured .svc-compact-card__content {
    padding: var(--space-5);
  }

  .svc-compact-card--featured .svc-compact-card__title {
    font-size: 1.25rem;
  }

  .svc-compact-card--featured .svc-compact-card__desc {
    font-size: 0.875rem;
    -webkit-line-clamp: 4;
  }

  /* Responsive: tablet */
  @media (max-width: 1024px) {
    .svc-compact-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .svc-compact-card--featured {
      grid-column: span 2;
      grid-row: span 1;
    }

    .svc-compact-card--featured .svc-compact-card__img {
      aspect-ratio: 16 / 7;
    }
  }

  /* Responsive: mobile */
  @media (max-width: 640px) {
    .svc-compact-grid {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }

    .svc-compact-card--featured {
      grid-column: auto;
      grid-row: auto;
    }

    .svc-compact-card--featured .svc-compact-card__img {
      aspect-ratio: 16 / 9;
    }

    .svc-compact-card__content {
      padding: var(--space-3);
    }
  }

  /* Focus visible para accesibilidad */
  .svc-compact-card__link:focus-visible {
    outline: 2px solid var(--color-brand);
    outline-offset: 2px;
    border-radius: var(--radius-md);
  }

  /* Respetar prefers-reduced-motion */
  @media (prefers-reduced-motion: reduce) {
    .svc-compact-card,
    .svc-compact-card__img img,
    .svc-compact-card__cta {
      transition: none;
    }

    .svc-compact-card:hover {
      transform: none;
    }

    .svc-compact-card:hover .svc-compact-card__img img {
      transform: none;
    }
  }
</style>
