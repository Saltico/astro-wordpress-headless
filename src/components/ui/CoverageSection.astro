---
// src/components/ui/CoverageSection.astro
// Sección de cobertura geográfica en el norte de Chile para SEO.
// Muestra las zonas de disponibilidad con keywords SEO.

import { coverageZones } from '@/data/site';
import Icon from '@/components/ui/Icon.astro';

export interface Props {
  eyebrow?: string;
  title?: string;
  class?: string;
}

const {
  eyebrow = 'Cobertura',
  title = 'Disponibilidad en el norte de Chile',
  class: className,
} = Astro.props;
---

<section class:list={['coverage-section', className]}>
  <div class="coverage-section__container">
    <div class="coverage-section__header">
      {eyebrow && <p class="coverage-section__eyebrow">{eyebrow}</p>}
      {title && <h2 class="coverage-section__title">{title}</h2>}
    </div>

    <div class="coverage-section__zones">
      {coverageZones.map((zone) => (
        <div class="coverage-zone">
          <div class="coverage-zone__header">
            <Icon name="map-pin" size={20} class="coverage-zone__icon" />
            <h3 class="coverage-zone__region">{zone.region}</h3>
          </div>
          <p class="coverage-zone__cities">
            Arriendo de maquinaria y equipos en {zone.cities.join(', ')}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .coverage-section {
    padding-block: clamp(40px, 6vw, 60px);
    background-color: var(--theme-bg);
    border-block: 1px solid var(--theme-border);
  }

  .coverage-section__container {
    max-width: var(--container-max-width, 1360px);
    margin-inline: auto;
    padding-inline: var(--container-padding, 20px);
  }

  .coverage-section__header {
    margin-bottom: 32px;
    text-align: center;
  }

  .coverage-section__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 12px;
    color: var(--theme-eyebrow);
  }

  .coverage-section__eyebrow::before {
    content: '';
    width: 42px;
    height: 2px;
    background: currentColor;
  }

  .coverage-section__title {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    letter-spacing: -0.02em;
    margin: 0;
    color: var(--theme-heading);
  }

  .coverage-section__zones {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  @media (max-width: 768px) {
    .coverage-section__zones {
      grid-template-columns: 1fr;
    }
  }

  .coverage-zone {
    padding: 20px;
    background-color: var(--theme-bg-elevated);
    border: 1px solid var(--theme-border);
    border-radius: 12px;
    transition: border-color 0.2s ease;
  }

  .coverage-zone:hover {
    border-color: var(--color-brand, #1a9c4a);
  }

  .coverage-zone__header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
  }

  .coverage-zone__icon {
    color: var(--color-brand, #1a9c4a);
    flex-shrink: 0;
  }

  .coverage-zone__region {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--theme-heading);
    margin: 0;
  }

  .coverage-zone__cities {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--theme-text-muted);
  }
</style>
