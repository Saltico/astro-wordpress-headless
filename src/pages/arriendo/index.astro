---
// src/pages/arriendo/index.astro
// Página de Rental de equipos / Arriendos
// Diseño basado en la referencia HTML de IP-Sitio-Web/arriendos.html

export const prerender = true;

import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/ui/PageHero.astro';
import Button from '@/components/ui/Button.astro';
import StatsCounter from '@/components/ui/StatsCounter.astro';
import SplitSection from '@/components/ui/SplitSection.astro';
import ServiceBentoGrid from '@/components/ui/ServiceBentoGrid.astro';
import CTABand from '@/components/ui/CTABand.astro';
import FleetTable from '@/components/ui/FleetTable.astro';
import Container from '@/components/ui/Container.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import type { StatItem } from '@/components/ui/StatsCounter.astro';
import { siteContact, IPRENTAL_URL } from '@/data/site';

import arriendoHero from '@/assets/imgs/hero/arriendo/arriendo.avif';
import gruas from '@/assets/imgs/gruas.jpg';
import izaje from '@/assets/imgs/izaje.jpg';
import apoyo from '@/assets/imgs/apoyo.jpg';
import faenaIzaje from '@/assets/imgs/faena-izaje.jpg';

const title = 'Arriendo de grúas de alto tonelaje | IP Proyectos Industriales — División Arriendos';
const description = 'Arriendo de grúas de alto tonelaje hasta 400 toneladas para faenas mineras e industriales en Atacama y Coquimbo. Operadores certificados e ingeniería de izaje.';

const breadcrumbs = [
  { label: 'Empresa', url: '/' },
  { label: 'Rental de equipos', url: '/arriendo' },
];

// Stats de arriendos
const stats: StatItem[] = [
  { value: 400, label: 'Capacidad máxima de izaje', suffix: 'Tons', suffixPosition: 'after' },
  { value: 100, label: 'Operadores certificados', suffix: '%', suffixPosition: 'after' },
  { value: 25, label: 'Años de experiencia', prefix: '+', prefixPosition: 'before' },
  { value: 2, label: 'Sucursales en III y IV región' },
];

// Flota de grúas Todo Terreno
const fleetAT = [
  { model: 'Grove GMK 6400', capacity: '400 t', year: 2021, boom: '15,4 – 60 m' },
  { model: 'Grove GMK 5250L', capacity: '250 t', year: 2018, boom: '13,3 – 70 m' },
  { model: 'Grove GMK 5250 XL-1', capacity: '250 t', year: 2025, boom: '13,4 – 78,5 m' },
  { model: 'Demag Terex AC-160-5', capacity: '160 t', year: 2020, boom: '12,4 – 68 m' },
  { model: 'Demag Terex AC-160', capacity: '160 t', year: 2023, boom: '12,4 – 68 m' },
  { model: 'Grove GMK 4100', capacity: '100 t', year: 2012, boom: '11,3 – 52 m' },
  { model: 'Grove GMK 8700', capacity: '700 t', year: 2028, boom: '+80 m', highlight: true, badge: 'Próximamente' },
];

// Flota de grúas Rough Terrain
const fleetRT = [
  { model: 'Tadano GR 1300 XL', capacity: '130 t', year: 2023, boom: '12,2 – 56 m' },
  { model: 'Tadano GR 1200 XL', capacity: '120 t', year: 2025, boom: '12 – 56 m' },
  { model: 'Tadano GR 1000 XL', capacity: '100 t', year: 2024, boom: '12 – 47 m' },
  { model: 'Terex RT 780', capacity: '80 t', year: 2015, boom: '12 – 47 m' },
  { model: 'Grove RT 765E', capacity: '60 t', year: 2015, boom: '11 – 33,5 m' },
];

// Categorías de equipos para el bento grid
const categories = [
  {
    category: 'Izaje',
    title: 'Grúas y altura',
    description: 'Grúas de alto tonelaje (AT / RT), alza-hombre hasta 43 m, camión pluma 7–26 t, manipulador telescópico y grúa horquilla 3–16 t.',
    image: gruas.src,
    imageAlt: 'Grúas de alto tonelaje',
    url: '/arriendo/izaje',
  },
  {
    category: 'Movimiento de Tierra',
    title: 'Maquinaria pesada',
    description: 'Camiones tolva, cargadores frontales, excavadoras, retroexcavadoras, minicargadores, rodillos compactadores y aljibes.',
    image: apoyo.src,
    imageAlt: 'Maquinaria pesada para movimiento de tierra',
    url: '/arriendo/movimiento-de-tierra',
  },
  {
    category: 'Transporte',
    title: 'Punto a punto',
    description: 'Rampla seca, cama baja y carga sobredimensionada. Hasta 120 t y 24 m de largo, con servicio de escolta.',
    image: izaje.src,
    imageAlt: 'Equipos de transporte',
    url: '/arriendo/transporte',
  },
  {
    category: 'Equipos Especiales',
    title: 'Apoyo a faena',
    description: 'Torres de iluminación, generadores, compresores, buses y minibuses, camión 3/4, camioneta y petroleador, canastillos, bombas de hormigón y termofusión.',
    image: faenaIzaje.src,
    imageAlt: 'Equipos especiales para faena',
    url: '/arriendo/equipos-especiales',
  },
];
---

<BaseLayout title={title} description={description} breadcrumbs={breadcrumbs}>
  <!-- §1: HERO -->
  <PageHero
    image={arriendoHero.src}
    imageAlt="Grúas de alto tonelaje IP Proyectos Industriales"
    imageWidth={arriendoHero.width}
    imageHeight={arriendoHero.height}
    eyebrow="División Arriendos · Atacama y Coquimbo"
    title="Arriendo de grúas de alto tonelaje"
    subtitle="Flota propia para izajes seguros y de precisión, con capacidad hasta 400 toneladas. Operadores certificados, ingeniería de izaje y disponibilidad para faenas mineras e industriales."
    minHeight="sm"
  >
    <div slot="actions" class="hero-actions">
      <Button href={`${IPRENTAL_URL}/cotizador`} variant="primary" size="lg" target="_blank" rel="noopener noreferrer">
        Cotizar
      </Button>
      <Button href="/contacto" variant="ghost" onDark size="lg">
        Contactar
      </Button>
    </div>
  </PageHero>

  <!-- §2: STATS -->
  <StatsCounter
    stats={stats}
    variant="dark"
    layout="grid"
    columns={4}
    animated={true}
    showDividers={true}
  />

  <!-- §3: NUESTRA FLOTA -->
  <section class="section">
    <Container>
      <div class="head-2col reveal">
        <div>
          <Eyebrow text="Nuestra flota" />
          <h2 class="h-section">Grúas para cada exigencia de izaje</h2>
        </div>
        <p class="muted">Capacidad en expansión para responder a las maniobras más demandantes de la minería y la industria. Selecciona la categoría y te asesoramos con la grúa adecuada para tu carga.</p>
      </div>
      <div class="svc-grid">
        <article class="svc reveal">
          <div class="svc__img"><img src={gruas.src} alt="Grúa de gran capacidad" loading="lazy" /></div>
          <div class="svc__body">
            <span class="post__date">Alto tonelaje</span>
            <h3 class="svc__title">Grúas hasta 400 t</h3>
            <a class="svc__link" href={IPRENTAL_URL} target="_blank" rel="noopener">
              Cotizar
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
          </div>
        </article>
        <article class="svc reveal">
          <div class="svc__img"><img src={izaje.src} alt="Grúa de capacidad media" loading="lazy" /></div>
          <div class="svc__body">
            <span class="post__date">Capacidad media</span>
            <h3 class="svc__title">Grúas todo terreno</h3>
            <a class="svc__link" href={IPRENTAL_URL} target="_blank" rel="noopener">
              Cotizar
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
          </div>
        </article>
        <article class="svc reveal">
          <div class="svc__img"><img src={apoyo.src} alt="Equipos de apoyo" loading="lazy" /></div>
          <div class="svc__body">
            <span class="post__date">Apoyo a faena</span>
            <h3 class="svc__title">Equipos de apoyo</h3>
            <a class="svc__link" href={IPRENTAL_URL} target="_blank" rel="noopener">
              Cotizar
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
          </div>
        </article>
      </div>
      <p class="form__note reveal" style="margin-top:18px;">
        ¿No estás seguro de qué grúa necesitas? 
        <a href={IPRENTAL_URL} target="_blank" rel="noopener" style="color:var(--color-brand-300);font-weight:600;">Cotiza en iprental.cl</a> 
        y te recomendamos el equipo adecuado para tu faena.
      </p>
    </Container>
  </section>

  <!-- §4: FLOTA DETALLADA -->
  <section class="section section--alt">
    <Container>
      <div class="head-2col reveal">
        <div>
          <Eyebrow text="Flota detallada" />
          <h2 class="h-section">+100 equipos propios, certificados y asegurados</h2>
        </div>
        <p class="muted">Certificación vigente, seguro y operadores certificados. Grúas de alto tonelaje más una flota completa para cada etapa de tu faena.</p>
      </div>

      <div class="fleet-cols">
        <FleetTable
          title="Grúas Todo Terreno (AT)"
          capacityRange="100 – 700 t"
          items={fleetAT}
        />
        <FleetTable
          title="Grúas Rough Terrain (RT)"
          capacityRange="60 – 130 t"
          items={fleetRT}
        />
      </div>

      <h3 class="fleet-subhead reveal">Categorías de equipos</h3>
    </Container>
  </section>

  <!-- §5: CATEGORÍAS -->
  <ServiceBentoGrid
    title=""
    services={categories}
  />

  <!-- §6: POR QUÉ IP -->
  <SplitSection
    eyebrow="Por qué IP"
    title="Más que arrendar una grúa: izajes bien planificados"
    description="No solo entregamos el equipo. Detrás de cada maniobra hay ingeniería de izaje, mantenimiento riguroso y un equipo que conoce las exigencias de la minería."
    image={faenaIzaje.src}
    imageAlt="Izaje seguro en faena minera"
    imageWidth={faenaIzaje.width}
    imageHeight={faenaIzaje.height}
    features={[
      {
        icon: 'check-circle',
        title: 'Ingeniería de izaje',
        description: 'y estudios de carga antes de cada maniobra.',
      },
      {
        icon: 'check-circle',
        title: 'Operadores certificados',
        description: 'y protocolos de seguridad reforzados.',
      },
      {
        icon: 'check-circle',
        title: 'Mantenimiento riguroso',
        description: 'que asegura disponibilidad y confiabilidad.',
      },
      {
        icon: 'check-circle',
        title: 'Respaldo integral',
        description: 'de una empresa con ingeniería, construcción y montaje.',
      },
    ]}
    cta={{ label: 'Cotizar en iprental.cl', href: IPRENTAL_URL }}
    variant="reversed"
    background="light"
  />

  <!-- §7: CTA COTIZA ONLINE -->
  <CTABand
    eyebrow="Cotiza online"
    title="Encuentra el equipo perfecto en iprental.cl"
    subtitle="Explora nuestro catálogo completo de grúas, equipos de izaje, movimiento de tierra y más. Cotiza en minutos con nuestro sistema online."
    buttons={[
      { label: 'Ir a iprental.cl', href: IPRENTAL_URL, variant: 'primary', icon: 'arrow-right', external: true, ariaLabel: 'Ir a iprental.cl' },
      { label: 'Contactar', href: '/contacto', variant: 'outline' },
    ]}
    contentAlign="center"
    minHeight="md"
  />

  <!-- §8: CTA HABLEMOS -->
  <CTABand
    eyebrow="Hablemos"
    title="Conversemos sobre tu próximo izaje"
    subtitle="Cuéntanos sobre tu faena, sus requerimientos y ubicación. Un encargado te responderá por WhatsApp, teléfono o correo."
    buttons={[
      { 
        label: 'Hablemos', 
        href: `https://wa.me/${siteContact.whatsappNumber}?text=Hola%2C%20quisiera%20conversar%20sobre%20el%20arriendo%20de%20una%20gr%C3%BAa.`, 
        variant: 'primary', 
        icon: 'whatsapp',
        external: true 
      },
      { label: 'Contactar', href: '/contacto', variant: 'outline' },
    ]}
    contentAlign="center"
    minHeight="md"
  />
</BaseLayout>

<style>
  .section {
    padding-block: clamp(56px, 8vw, 100px);
  }

  .section--alt {
    background: var(--theme-bg-alt);
  }

  .head-2col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-8);
    margin-bottom: var(--space-10);
    align-items: end;
  }

  .head-2col .muted {
    color: var(--theme-muted);
    font-size: 1.0625rem;
    line-height: 1.6;
    max-width: 50ch;
    margin: 0;
  }

  .h-section {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(1.8rem, 3.4vw, 2.8rem);
    letter-spacing: -0.02em;
    color: var(--theme-heading);
    margin: var(--space-3) 0 0;
  }

  .svc-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .svc {
    background: var(--theme-bg);
    border: 1px solid var(--theme-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: transform 0.3s var(--ease-out), box-shadow 0.3s var(--ease-out);
  }

  .svc:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.12);
  }

  .svc__img {
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .svc__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s var(--ease-out);
  }

  .svc:hover .svc__img img {
    transform: scale(1.05);
  }

  .svc__body {
    padding: var(--space-5);
  }

  .post__date {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-brand-300);
    margin-bottom: var(--space-2);
  }

  .svc__title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.25rem;
    color: var(--theme-heading);
    margin: 0 0 var(--space-3);
  }

  .svc__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 600;
    color: var(--color-brand-300);
    text-decoration: none;
    transition: gap 0.2s var(--ease-out);
  }

  .svc__link:hover {
    gap: var(--space-3);
  }

  .svc__link svg {
    width: 16px;
    height: 16px;
  }

  .form__note {
    color: var(--theme-muted);
    font-size: 0.9375rem;
    text-align: center;
  }

  .fleet-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
    margin-bottom: var(--space-10);
  }

  .fleet-subhead {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.5rem;
    color: var(--theme-heading);
    margin: var(--space-8) 0 var(--space-6);
    text-align: center;
  }

  @media (max-width: 1024px) {
    .head-2col {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    .svc-grid {
      grid-template-columns: 1fr 1fr;
    }

    .fleet-cols {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .svc-grid {
      grid-template-columns: 1fr;
    }
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
</style>
