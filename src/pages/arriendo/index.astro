---
// src/pages/arriendo/index.astro
// Hub principal del catálogo de arriendo con cards visuales.

import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import Breadcrumbs from '@/components/seo/Breadcrumbs.astro';
import StatsCounter from '@/components/ui/StatsCounter.astro';
import CTABand from '@/components/ui/CTABand.astro';
import PageHero from '@/components/ui/PageHero.astro';
import Icon from '@/components/ui/Icon.astro';
import Button from '@/components/ui/Button.astro';
import type { StatItem } from '@/components/ui/StatsCounter.astro';
import gruasImg from '@/assets/imgs/hero/arriendo/izaje/gruas/gruas.avif';
import rentalImg from '@/assets/imgs/hero/arriendo/arriendo.avif';
import { RENTAL_CATEGORIES } from '@/data/rental';
import { collectionPageSchema, breadcrumbSchema, combineSchemas } from '@/lib/seo';

const title = 'Arriendo de Maquinaria y Equipos para Minería | IP Proyectos Industriales';
const description = 'Arriendo de grúas, izaje, movimiento de tierra, transporte y equipos especiales para minería e industria en Chile. Cotiza online.';

const breadcrumbs = [
  { label: 'Inicio', url: '/' },
  { label: 'Arriendo de Equipos', url: '/arriendo' },
];

const jsonLd = combineSchemas(
  collectionPageSchema('Arriendo de Equipos', '/arriendo'),
  breadcrumbSchema(breadcrumbs)
);

const stats: StatItem[] = [
  { value: 400, label: 'Toneladas capacidad', suffix: 'Tons', suffixPosition: 'after' },
  { value: 100, prefix: '+', label: 'Equipos propios', prefixPosition: 'before' },
  { value: 24, label: 'Disponibilidad', suffix: '/7', suffixPosition: 'after' },
  { value: 15, prefix: '+', label: 'Años de experiencia', prefixPosition: 'before' },
];
---

<BaseLayout
  title={title}
  description={description}
  breadcrumbs={breadcrumbs}
  jsonLd={jsonLd}
>
  <PageHero
    image={rentalImg.src}
    imageAlt="Grúa de alto tonelaje de la flota de arriendo de IP Proyectos Industriales"
    imageWidth={rentalImg.width}
    imageHeight={rentalImg.height}
    eyebrow="Rental de equipos"
    title="Arriendo de maquinaria pesada para minería e industria"
    subtitle="Grúas, izaje, movimiento de tierra, transporte y equipos especiales con operadores certificados. Disponibilidad 24/7 en zona norte de Chile."
    minHeight="sm"
  >
    <Breadcrumbs slot="breadcrumbs" items={breadcrumbs} variant="hero" />
    <Fragment slot="actions">
      <Button href="#cotizar" variant="primary" size="lg" icon="arrow-right" iconPosition="right">
        Cotizar
      </Button>
      <Button href="/catalogo.pdf" variant="ghost" onDark size="lg" icon="download" download>
        Descargar catálogo
      </Button>
    </Fragment>
  </PageHero>

  <StatsCounter
    stats={stats}
    variant="dark"
    layout="horizontal"
    columns={4}
    animated={true}
  />

  <section class="cat-grid">
    <Container>
      <div class="cat-grid__header">
        <p class="cat-grid__eyebrow">Nuestro catálogo</p>
        <h2 class="cat-grid__title">Equipos en arriendo para minería e industria</h2>
      </div>
      <div class="cat-grid__items">
        {RENTAL_CATEGORIES.map((category) => (
          <article class="cat-card">
            <div class="cat-card__image-wrapper">
              <img
                src={category.heroImage}
                alt={category.name}
                class="cat-card__image"
                loading="lazy"
              />
            </div>
            <div class="cat-card__content">
              <h3 class="cat-card__title">{category.name}</h3>
              <p class="cat-card__desc">{category.shortDesc}</p>
              <div class="cat-card__pills">
                {category.subcategories.map((sub) => (
                  <a
                    href={`/arriendo/${category.slug}/${sub.slug}`}
                    class="cat-card__pill"
                  >
                    {sub.name}
                  </a>
                ))}
              </div>
              <a href={`/arriendo/${category.slug}`} class="cat-card__link">
                Ver categoría
                <Icon name="arrow-right" size={18} />
              </a>
            </div>
          </article>
        ))}
      </div>
    </Container>
  </section>

  <div id="cotizar">
  <CTABand
    eyebrow="Cotiza tu equipo ahora"
    title="¿Necesitas arrendar maquinaria? Cotiza en minutos"
    backgroundImage={gruasImg.src}
    backgroundAlt="Grúas de alto tonelaje en faena minera"
    backgroundWidth={gruasImg.width}
    backgroundHeight={gruasImg.height}
    buttons={[
      { label: 'Ir al cotizador', href: '/cotizador', variant: 'primary', icon: 'arrow-right', ariaLabel: 'Ir al cotizador en línea' },
      { label: 'Hablar por WhatsApp', href: 'https://wa.me/56965593202?text=Hola%20IP%20Proyectos%20Industriales%2C%20quisiera%20solicitar%20una%20cotizaci%C3%B3n%20de%20arriendo%20de%20equipos.', variant: 'outline', external: true, icon: 'whatsapp' },
    ]}
    contentAlign="center"
    minHeight="md"
  />
  </div>
</BaseLayout>

<style>
  /* Acciones del hero: en mobile se apilan a ancho completo */
  @media (max-width: 480px) {
    .page-hero__actions {
      flex-direction: column;
      align-items: stretch;
    }
    .page-hero__actions :global(.btn) {
      justify-content: center;
    }
  }

  .cat-grid {
    background-color: var(--theme-bg);
    padding-block: clamp(40px, 6vw, 80px);
  }

  .cat-grid__header {
    margin-bottom: 40px;
    text-align: center;
  }

  .cat-grid__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 16px;
    color: var(--theme-eyebrow);
  }

  .cat-grid__eyebrow::before {
    content: '';
    width: 42px;
    height: 2px;
    background: currentColor;
  }

  .cat-grid__title {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(1.8rem, 3.4vw, 2.8rem);
    letter-spacing: -0.02em;
    margin: 0;
    color: var(--theme-heading);
  }

  .cat-grid__items {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  @media (max-width: 768px) {
    .cat-grid__items {
      grid-template-columns: 1fr;
    }
  }

  .cat-card {
    display: flex;
    flex-direction: column;
    background-color: var(--theme-bg-elevated);
    border: 1px solid var(--theme-border);
    border-radius: 16px;
    overflow: hidden;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }

  .cat-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.25);
    border-color: var(--color-brand, #1a9c4a);
  }

  .cat-card__image-wrapper {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: var(--color-graphite, #0d1611);
  }

  .cat-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .cat-card:hover .cat-card__image {
    transform: scale(1.05);
  }

  .cat-card__content {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 20px 22px 22px;
    flex: 1;
  }

  .cat-card__title {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1.4rem;
    letter-spacing: -0.01em;
    line-height: 1.2;
    margin: 0;
    color: var(--theme-text);
  }

  .cat-card__desc {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--theme-text-muted);
  }

  .cat-card__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 4px;
  }

  .cat-card__pill {
    display: inline-block;
    padding: 6px 14px;
    background-color: var(--theme-bg);
    border: 1px solid var(--theme-border);
    border-radius: 999px;
    color: var(--theme-text-subtle);
    font-size: 0.875rem;
    text-decoration: none;
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }

  .cat-card__pill:hover,
  .cat-card__pill:focus {
    background-color: var(--color-brand, #1a9c4a);
    border-color: var(--color-brand, #1a9c4a);
    color: var(--color-on-dark);
  }

  .cat-card__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--theme-eyebrow);
    text-decoration: none;
    margin-top: 8px;
    transition: gap 0.2s ease;
  }

  .cat-card__link:hover {
    gap: 12px;
  }
</style>
