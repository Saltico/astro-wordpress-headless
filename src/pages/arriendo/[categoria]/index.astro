---
// src/pages/arriendo/[categoria]/index.astro
// Hub de cada categoría (izaje, movimiento-de-tierra, transporte, equipos-especiales)

export const prerender = true;

import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import Icon from '@/components/ui/Icon.astro';
import CTABand from '@/components/ui/CTABand.astro';
import CategoryHero from '@/components/rental/CategoryHero.astro';
import { RENTAL_CATEGORIES } from '@/data/rental';
import { serviceSchema, breadcrumbSchema, combineSchemas } from '@/lib/seo';
import edificio from '@/assets/imgs/edificio.jpg';

export function getStaticPaths() {
  return RENTAL_CATEGORIES.map((category) => ({
    params: { categoria: category.slug },
    props: { category },
  }));
}

const { category } = Astro.props;

const subcatalogSubtitle = `${category.subcategories.length} tipos de equipo · ${category.subcategories.reduce((acc, s) => acc + s.catalog.length, 0)} modelos en total`;

// Pills de navegación entre categorías hermanas
const categoryOptions = RENTAL_CATEGORIES.map((cat) => ({
  name: cat.name,
  slug: cat.slug,
  href: `/arriendo/${cat.slug}`,
  subcategoryCount: cat.subcategories.length,
}));

const breadcrumbs = [
  { label: 'Inicio', url: '/' },
  { label: 'Arriendo de Equipos', url: '/arriendo' },
  { label: category.name, url: `/arriendo/${category.slug}` },
];

const jsonLd = combineSchemas(
  serviceSchema(category.name, category.description, Astro.url.pathname, undefined, {
    serviceType: 'Arriendo de equipos',
    areaServed: ['CL-II', 'CL-III', 'CL-IV'],
  }),
  breadcrumbSchema(breadcrumbs)
);
---

<BaseLayout
  title={category.seoTitle}
  description={category.seoDescription}
  breadcrumbs={breadcrumbs}
  jsonLd={jsonLd}
>
  <CategoryHero
    heroImage={category.heroImage}
    heroImageAlt={`Arriendo de equipos de ${category.name.toLowerCase()} para minería, construcción e industria en Chile — IP Proyectos Industriales`}
    title={category.name}
    description={category.description}
    categories={categoryOptions}
    currentCategorySlug={category.slug}
    breadcrumbs={breadcrumbs}
  />

  <section class="subcatalog">
    <Container>
      <header class="subcatalog__header">
        <h2 class="subcatalog__title">{category.name} disponibles</h2>
        <p class="subcatalog__subtitle">{subcatalogSubtitle}</p>
      </header>
      <div class="subcatalog__grid">
        {category.subcategories.map((sub) => (
          <a href={`/arriendo/${category.slug}/${sub.slug}`} class="subcard">
            <div class="subcard__image-wrapper">
              <img
                src={sub.catalog[0].image}
                alt={sub.catalog[0].name}
                class="subcard__image"
                loading="lazy"
              />
              <span class="subcard__badge">{sub.catalog.length} {sub.catalog.length === 1 ? 'modelo' : 'modelos'}</span>
            </div>
            <div class="subcard__body">
              <h3 class="subcard__title">{sub.name}</h3>
              <p class="subcard__desc">{sub.shortDesc}</p>
              <ul class="subcard__features">
                {sub.specs.slice(0, 3).map((s) => (
                  <li class="subcard__feature">
                    <Icon name="check" size={14} />
                    <span><strong>{s.label}:</strong> {s.value}</span>
                  </li>
                ))}
              </ul>
              <span class="subcard__cta">
                Ver {sub.name.toLowerCase()}
                <Icon name="arrow-right" size={16} />
              </span>
            </div>
          </a>
        ))}
      </div>
    </Container>
  </section>

  <CTABand
    eyebrow="Cotización rápida"
    title="Tu próximo proyecto empieza con una conversación"
    backgroundImage={edificio.src}
    backgroundAlt="Edificio corporativo de IP Proyectos Industriales en Chile"
    backgroundWidth={edificio.width}
    backgroundHeight={edificio.height}
    buttons={[
      { label: 'Ir al cotizador', href: '/cotizador', variant: 'primary', icon: 'arrow-right', ariaLabel: 'Ir al cotizador en línea' },
      { label: 'Hablar por WhatsApp', href: 'https://wa.me/56956594144?text=Hola%20IP%20Proyectos%20Industriales%2C%20quisiera%20solicitar%20una%20cotizaci%C3%B3n.', variant: 'outline', external: true, icon: 'whatsapp' },
    ]}
    contentAlign="center"
    minHeight="md"
  />
</BaseLayout>

<style>
  .subcatalog {
    background-color: var(--theme-bg);
    padding-block: clamp(32px, 4vw, 56px);
  }

  .subcatalog__header {
    margin-bottom: clamp(20px, 3vw, 32px);
  }

  .subcatalog__title {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(1.375rem, 2.5vw, 1.75rem);
    letter-spacing: -0.02em;
    margin: 0 0 8px;
    line-height: 1.15;
    color: var(--theme-heading);
  }

  .subcatalog__subtitle {
    margin: 0;
    font-size: 0.95rem;
    color: var(--theme-text-muted);
  }

  .subcatalog__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(16px, 2vw, 24px);
  }

  @media (max-width: 1023px) {
    .subcatalog__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 639px) {
    .subcatalog__grid {
      grid-template-columns: 1fr;
    }
  }

  .subcard {
    display: flex;
    flex-direction: column;
    background-color: var(--theme-bg-elevated);
    border: 1px solid var(--theme-border);
    border-radius: 14px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }

  .subcard:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.25);
    border-color: var(--color-brand, #308f40);
  }

  .subcard__image-wrapper {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background-color: var(--color-graphite, #0d1611);
  }

  .subcard__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .subcard:hover .subcard__image {
    transform: scale(1.05);
  }

  .subcard__badge {
    position: absolute;
    top: 10px;
    left: 10px;
    padding: 5px 10px;
    background-color: var(--color-brand, #308f40);
    color: var(--color-on-dark);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.75rem;
    border-radius: 999px;
    letter-spacing: 0.02em;
  }

  .subcard__body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 14px 16px 16px;
    flex: 1;
  }

  .subcard__title {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
    line-height: 1.2;
    margin: 0;
    color: var(--theme-text);
  }

  .subcard__desc {
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.45;
    color: var(--theme-text-muted);
  }

  .subcard__features {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1;
  }

  .subcard__feature {
    display: flex;
    align-items: flex-start;
    gap: 6px;
    font-size: 0.8rem;
    line-height: 1.35;
    color: var(--theme-text-muted);
  }

  .subcard__feature :global(svg) {
    flex-shrink: 0;
    color: var(--color-brand, #1a9c4a);
    margin-top: 2px;
  }

  .subcard__feature strong {
    color: var(--theme-eyebrow);
    font-weight: 700;
  }

  .subcard__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.875rem;
    color: var(--theme-eyebrow);
    margin-top: 4px;
    transition: gap 0.2s ease;
  }

  .subcard:hover .subcard__cta {
    gap: 12px;
  }
</style>
