---
// src/pages/cotizador.astro
// Página del cotizador. Estática: el contenido se hidrata con <script>.
// Usa <QuoteHero>, un hero compacto y específico (no reutiliza <PageHero>)
// con layout horizontal en desktop y apilado en mobile.

import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import SectionLayout from '@/components/ui/SectionLayout.astro';
import QuoteHero from '@/components/quote/QuoteHero.astro';
import Icon from '@/components/ui/Icon.astro';
import QuoteCartLine from '@/components/quote/QuoteCartLine.astro';
import QuoteCartSummary from '@/components/quote/QuoteCartSummary.astro';
import EquipmentPicker from '@/components/quote/EquipmentPicker.astro';
import { getSiteUrl } from '@/lib/seo';
import { siteContact } from '@/data/site';
import heroImg from '@/assets/imgs/hero.jpg';

const title = 'Tu Cotizador | IP Proyectos Industriales';
const description =
  'Revisa los equipos seleccionados y envía tu cotización por WhatsApp.';
const canonical = getSiteUrl('/cotizador');
const heroSubtitle =
  'Gestiona los equipos que agregaste y envía tu cotización por WhatsApp cuando estés listo.';
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  noindex={true}
>
  <QuoteHero
    image={heroImg.src}
    imageAlt="Operador revisando maquinaria en faena minera"
    eyebrow="Cotización en línea"
    title="Tu Cotizador"
    subtitle={heroSubtitle}
    catalogUrl={siteContact.catalogUrl}
  />

  <SectionLayout spacing="md" alt>
    <Container>
      <div class="quote-page__columns">
        <aside class="quote-page__col quote-page__col--picker" aria-label="Buscador de equipos">
          <EquipmentPicker />
        </aside>

        <div class="quote-page__col quote-page__col--cart">
          <div class="quote-page__empty" data-quote-empty hidden>
            <span class="quote-page__empty-icon" aria-hidden="true">
              <Icon name="cart" size={40} />
            </span>
            <h2>Tu cotizador está vacío</h2>
            <p>
              Usa el buscador de la izquierda para descubrir y agregar equipos al cotizador.
            </p>
          </div>

          <div class="quote-page__lines" data-quote-lines hidden>
            {/* Hydrated from localStorage on the client */}
          </div>

          <div class="quote-page__summary" data-quote-summary-wrapper hidden>
            <QuoteCartSummary />
          </div>
        </div>
      </div>
    </Container>
  </SectionLayout>
</BaseLayout>

<script>
  import { getCart, subscribe, updateItem, removeItem, clearCart, initStorageSync } from '@/lib/quoteCart';
  import { QUOTE_ITEM_MAX_QUANTITY, QUOTE_PERIOD_MAX_COUNT, type QuoteCartItem } from '@/types/quote';
  import { RENTAL_CATEGORIES } from '@/data/rental';

  const linesEl = document.querySelector<HTMLElement>('[data-quote-lines]');
  const emptyEl = document.querySelector<HTMLElement>('[data-quote-empty]');
  const summaryWrapper = document.querySelector<HTMLElement>('[data-quote-summary-wrapper]');

  // Chevron-down inline (replica de assets/icons/chevron-down.svg) — el Icon
  // component usa import.meta.glob con `?raw` y no es invocable desde un
  // template string generado en cliente.
  const CHEVRON_DOWN_SVG =
    '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>';

  // Mapa slug → shortDesc construido una sola vez al cargar el script.
  const SHORT_DESC_BY_SLUG = new Map<string, string>();
  for (const cat of RENTAL_CATEGORIES) {
    for (const sub of cat.subcategories) {
      for (const eq of sub.catalog) {
        SHORT_DESC_BY_SLUG.set(eq.slug, eq.shortDesc);
      }
    }
  }

  function findShortDesc(slug: string, fallback: string): string {
    return SHORT_DESC_BY_SLUG.get(slug) ?? fallback;
  }

  function todayIso(): string {
    const d = new Date();
    d.setDate(d.getDate() + 1);
    const yyyy = d.getFullYear();
    const mm = String(d.getMonth() + 1).padStart(2, '0');
    const dd = String(d.getDate()).padStart(2, '0');
    return `${yyyy}-${mm}-${dd}`;
  }

  function escapeHtml(s: string): string {
    return s.replace(/[&<>"']/g, (ch) => {
      const map: Record<string, string> = {
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#39;',
      };
      return map[ch] ?? ch;
    });
  }

  function debounce<T extends (...args: never[]) => void>(fn: T, ms: number): T {
    let t: ReturnType<typeof setTimeout> | null = null;
    return ((...args: Parameters<T>) => {
      if (t) clearTimeout(t);
      t = setTimeout(() => fn(...args), ms);
    }) as T;
  }

  function clamp(value: number, min: number, max: number): number {
    if (Number.isNaN(value)) return min;
    return Math.max(min, Math.min(max, value));
  }

  function renderLine(item: QuoteCartItem): string {
    const c = item.customization;
    const safeId = escapeHtml(item.lineId);
    const safeName = escapeHtml(item.name);
    const meta = [item.capacity, item.height].filter(Boolean).join(' · ');
    const safeDesc = escapeHtml(findShortDesc(item.equipmentSlug, meta));
    const safeNotes = escapeHtml(c.notes ?? '');
    const safeAddress = escapeHtml(c.transportAddress ?? '');
    const minStart = todayIso();
    const panelId = `line-panel-${safeId}`;
    const toggleId = `line-toggle-${safeId}`;
    return `
      <article class="quote-line" data-line-id="${safeId}">
        <header class="quote-line__head">
          <img src="${escapeHtml(item.image)}" alt="${safeName}" class="quote-line__thumb" loading="lazy" />
          <div class="quote-line__heading">
            <h3 class="quote-line__name">${safeName}</h3>
            <p class="quote-line__desc">${safeDesc}</p>
          </div>
          <div class="quote-line__head-actions">
            <button
              id="${toggleId}"
              type="button"
              class="quote-line__toggle"
              data-line-action="toggle"
              data-line-id="${safeId}"
              aria-expanded="false"
              aria-controls="${panelId}"
              aria-label="Ver detalles de ${safeName}"
            >${CHEVRON_DOWN_SVG}</button>
            <button
              type="button"
              class="quote-line__remove"
              data-line-action="remove"
              data-line-id="${safeId}"
              aria-label="Quitar ${safeName} del cotizador"
            ><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg></button>
          </div>
        </header>
        <div class="quote-line__panel" id="${panelId}" role="region" aria-labelledby="${toggleId}" hidden>
          <div class="quote-line__panel-inner">
            <div class="quote-line__grid">
              <div class="quote-line__field">
                <label>Cantidad</label>
                <div class="quote-line__stepper">
                  <button type="button" class="quote-line__step" data-line-action="dec" data-line-id="${safeId}" aria-label="Disminuir cantidad">−</button>
                  <input type="number" min="1" max="50" step="1" value="${c.quantity}" data-line-action="qty" data-line-id="${safeId}" inputmode="numeric" />
                  <button type="button" class="quote-line__step" data-line-action="inc" data-line-id="${safeId}" aria-label="Aumentar cantidad">+</button>
                </div>
              </div>
              <div class="quote-line__field">
                <label>Tipo de periodo</label>
                <select data-line-action="periodType" data-line-id="${safeId}">
                  <option value="diario" ${c.periodType === 'diario' ? 'selected' : ''}>Diario</option>
                  <option value="semanal" ${c.periodType === 'semanal' ? 'selected' : ''}>Semanal</option>
                  <option value="mensual" ${c.periodType === 'mensual' ? 'selected' : ''}>Mensual</option>
                </select>
              </div>
              <div class="quote-line__field">
                <label>Cantidad de periodos</label>
                <input type="number" min="1" max="365" step="1" value="${c.periodCount}" data-line-action="periodCount" data-line-id="${safeId}" inputmode="numeric" />
              </div>
              <div class="quote-line__field">
                <label>Fecha de inicio</label>
                <input type="date" min="${minStart}" value="${c.startDate}" data-line-action="startDate" data-line-id="${safeId}" />
              </div>
              <div class="quote-line__field quote-line__field--full">
                <label>Notas del equipo (opcional)</label>
                <textarea rows="2" maxlength="280" placeholder="Información específica de este equipo…" data-line-action="notes" data-line-id="${safeId}">${safeNotes}</textarea>
              </div>
              <div class="quote-line__field quote-line__field--full">
                <fieldset class="quote-line__transport-group">
                  <legend>Traslado a la faena</legend>
                  <div class="quote-line__radio-row">
                    <label class="quote-line__radio">
                      <input type="radio" name="transport-${safeId}" value="no" ${c.transport === 'no' ? 'checked' : ''} data-line-action="transport" data-line-id="${safeId}" />
                      <span>No</span>
                    </label>
                    <label class="quote-line__radio">
                      <input type="radio" name="transport-${safeId}" value="si" ${c.transport === 'si' ? 'checked' : ''} data-line-action="transport" data-line-id="${safeId}" />
                      <span>Sí</span>
                    </label>
                  </div>
                </fieldset>
                <input type="text" placeholder="Dirección de entrega" value="${safeAddress}" data-line-action="transportAddress" data-line-id="${safeId}" ${c.transport === 'si' ? '' : 'disabled'} />
              </div>
            </div>
          </div>
        </div>
      </article>
    `;
  }

  function render(): void {
    if (!linesEl || !emptyEl || !summaryWrapper) return;
    const cart = getCart();
    const empty = cart.items.length === 0;
    emptyEl.hidden = !empty;
    linesEl.hidden = empty;
    summaryWrapper.hidden = empty;
    const topbarClear = document.querySelector<HTMLButtonElement>('[data-quote-clear-top]');
    if (topbarClear) topbarClear.hidden = empty;
    if (empty) {
      linesEl.innerHTML = '';
      return;
    }
    linesEl.innerHTML = cart.items.map((item) => renderLine(item)).join('');
    // Re-attach directo de listeners. Es más predecible que la delegación
    // al document: el click sobre el <svg>/<path> del icono ya no es un
    // problema porque el listener vive en el propio <button>.
    linesEl.querySelectorAll<HTMLElement>('[data-line-id]').forEach(attachLineHandlers);
  }

  function attachLineHandlers(article: HTMLElement): void {
    const lineId = article.dataset.lineId;
    if (!lineId) return;
    const panel = article.querySelector<HTMLElement>(`#line-panel-${lineId}`);
    const nameEl = article.querySelector<HTMLElement>('.quote-line__name');
    const nameText = () => nameEl?.textContent?.trim() || 'este equipo';

    // Toggle acordeón
    const toggleBtn = article.querySelector<HTMLButtonElement>('[data-line-action="toggle"]');
    if (toggleBtn && panel) {
      toggleBtn.addEventListener('click', (e) => {
        e.preventDefault();
        const isOpen = !panel.hasAttribute('hidden');
        if (isOpen) {
          panel.setAttribute('hidden', '');
          toggleBtn.setAttribute('aria-expanded', 'false');
          toggleBtn.setAttribute('aria-label', `Ver detalles de ${nameText()}`);
        } else {
          panel.removeAttribute('hidden');
          toggleBtn.setAttribute('aria-expanded', 'true');
          toggleBtn.setAttribute('aria-label', `Ocultar detalles de ${nameText()}`);
        }
      });
    }

    // Eliminar equipo (sin confirm: se elimina directo)
    const removeBtn = article.querySelector<HTMLButtonElement>('[data-line-action="remove"]');
    if (removeBtn) {
      removeBtn.addEventListener('click', (e) => {
        e.preventDefault();
        removeItem(lineId);
      });
    }

    // Steppers +/-
    const qtyInput = article.querySelector<HTMLInputElement>('[data-line-action="qty"]');
    const setQty = (next: number) => {
      const clamped = clamp(next, 1, QUOTE_ITEM_MAX_QUANTITY);
      if (qtyInput) qtyInput.value = String(clamped);
      updateItem(lineId, { quantity: clamped });
    };
    article.querySelector<HTMLButtonElement>('[data-line-action="inc"]')?.addEventListener('click', (e) => {
      e.preventDefault();
      setQty((Number(qtyInput?.value) || 1) + 1);
    });
    article.querySelector<HTMLButtonElement>('[data-line-action="dec"]')?.addEventListener('click', (e) => {
      e.preventDefault();
      setQty((Number(qtyInput?.value) || 1) - 1);
    });
    if (qtyInput) {
      qtyInput.addEventListener('input', () => setQty(Number(qtyInput.value)));
    }

    // periodType
    const periodType = article.querySelector<HTMLSelectElement>('[data-line-action="periodType"]');
    if (periodType) {
      periodType.addEventListener('change', () => {
        const v = periodType.value;
        if (v === 'diario' || v === 'semanal' || v === 'mensual') {
          updateItem(lineId, { periodType: v });
        }
      });
    }

    // periodCount
    const periodCount = article.querySelector<HTMLInputElement>('[data-line-action="periodCount"]');
    if (periodCount) {
      const apply = (v: number) => {
        const clamped = clamp(v, 1, QUOTE_PERIOD_MAX_COUNT);
        if (String(clamped) !== periodCount.value) periodCount.value = String(clamped);
        updateItem(lineId, { periodCount: clamped });
      };
      periodCount.addEventListener('input', () => apply(Number(periodCount.value)));
    }

    // startDate
    const startDate = article.querySelector<HTMLInputElement>('[data-line-action="startDate"]');
    if (startDate) {
      startDate.addEventListener('change', () => {
        updateItem(lineId, { startDate: startDate.value });
      });
    }

    // notes (debounced)
    const notes = article.querySelector<HTMLTextAreaElement>('[data-line-action="notes"]');
    if (notes) {
      const apply = debounce((v: string) => updateItem(lineId, { notes: v }), 200);
      notes.addEventListener('input', () => apply(notes.value));
    }

    // transport radios
    article.querySelectorAll<HTMLInputElement>('[data-line-action="transport"]').forEach((radio) => {
      radio.addEventListener('change', () => {
        const v = radio.value;
        if (v === 'si' || v === 'no') {
          const addressInput = article.querySelector<HTMLInputElement>('[data-line-action="transportAddress"]');
          if (addressInput) addressInput.disabled = v !== 'si';
          updateItem(lineId, { transport: v });
        }
      });
    });

    // transportAddress (debounced)
    const transportAddress = article.querySelector<HTMLInputElement>('[data-line-action="transportAddress"]');
    if (transportAddress) {
      const apply = debounce((v: string) => updateItem(lineId, { transportAddress: v }), 200);
      transportAddress.addEventListener('input', () => apply(transportAddress.value));
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    initStorageSync();
    render();
    subscribe(render);

    // Topbar "Limpiar cotizador" (HTML estático, vive fuera del render del cart)
    const topbarClear = document.querySelector<HTMLButtonElement>('[data-quote-clear-top]');
    if (topbarClear) {
      topbarClear.addEventListener('click', (e) => {
        e.preventDefault();
        if (!confirm('¿Vaciar todo el cotizador? Esta acción no se puede deshacer.')) return;
        clearCart();
      });
    }
  });
</script>

<style>
  /* ── Layout 2 columnas: izquierda = buscador, derecha = cotizador ── */
  .quote-page__columns {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    align-items: start;
  }

  @media (min-width: 1024px) {
    .quote-page__columns {
      grid-template-columns: minmax(0, 1fr) clamp(320px, 32vw, 420px);
      gap: 2rem;
    }
  }

  .quote-page__col {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .quote-page__col--cart {
    position: sticky;
    /* Compensa la altura del header (topbar se oculta al hacer scroll
       y el header sube a top: 0). Se usa la misma variable CSS que
       Header.astro para mantener una sola fuente de verdad. */
    top: calc(var(--header-height, 5rem) + 1rem);
    max-height: calc(100vh - var(--header-height, 5rem) - 2rem);
    overflow-y: auto;
  }

  .quote-page__col--cart::-webkit-scrollbar {
    width: 8px;
  }

  .quote-page__col--cart::-webkit-scrollbar-thumb {
    background-color: var(--color-line, #e2e4e5);
    border-radius: 999px;
  }

  @media (max-width: 1023.98px) {
    .quote-page__col--cart {
      position: static;
      max-height: none;
      overflow: visible;
    }
  }

  .quote-page__empty {
    text-align: center;
    padding: 2rem 1rem;
    background-color: var(--color-surface, #fff);
    border: 1px solid var(--color-line, #e2e4e5);
    border-radius: 16px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  /* El atributo [hidden] por defecto aplica display:none, pero la regla
     .quote-page__empty con display:flex lo sobreescribe. Forzamos aquí. */
  .quote-page__empty[hidden] {
    display: none;
  }

  .quote-page__empty-icon {
    display: inline-flex;
    color: var(--color-brand, #348f41);
  }

  .quote-page__empty h2 {
    margin: 0;
    font-family: var(--font-heading, 'Plateia', 'Arial Narrow', sans-serif);
    font-size: 1.25rem;
    color: var(--color-ink, #242627);
  }

  .quote-page__empty p {
    margin: 0;
    color: var(--color-ink-700, #3a3d3e);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .quote-page__lines {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .quote-page__summary {
    margin-top: 1.5rem;
  }

  /* Estilos globales para los items renderizados dinámicamente desde JS.
     Mantienen paridad con <QuoteCartLine.astro>. */
  :global(.quote-line) {
    background-color: var(--color-surface, #fff);
    border: 1px solid var(--color-line, #e2e4e5);
    border-radius: 14px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: border-color 0.15s var(--ease-out, ease),
      box-shadow 0.15s var(--ease-out, ease);
  }

  :global(.quote-line:hover) {
    border-color: rgba(52, 143, 65, 0.35);
  }

  :global(.quote-line__head) {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px 10px 14px;
  }

  :global(.quote-line__thumb) {
    width: 48px;
    height: 48px;
    object-fit: cover;
    border-radius: 8px;
    background-color: var(--color-graphite, #0d1611);
    flex-shrink: 0;
  }

  :global(.quote-line__heading) {
    flex: 1;
    min-width: 0;
  }

  :global(.quote-line__name) {
    margin: 0;
    font-family: var(--font-heading, 'Plateia', 'Arial Narrow', sans-serif);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-ink, #242627);
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.quote-line__desc) {
    margin: 2px 0 0;
    font-size: 0.78rem;
    color: var(--color-ink-700, #3a3d3e);
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  :global(.quote-line__head-actions) {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
  }

  :global(.quote-line__toggle),
  :global(.quote-line__remove) {
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    border: 1px solid var(--color-line, #e2e4e5);
    background-color: transparent;
    color: var(--color-ink-700, #3a3d3e);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
    padding: 0;
    transition: background-color 0.15s var(--ease-out, ease),
      color 0.15s var(--ease-out, ease),
      border-color 0.15s var(--ease-out, ease);
  }

  :global(.quote-line__toggle svg),
  :global(.quote-line__remove svg) {
    transition: transform 0.2s var(--ease-out, ease);
  }

  :global(.quote-line__toggle:hover),
  :global(.quote-line__toggle:focus-visible) {
    color: var(--color-brand, #348f41);
    border-color: var(--color-brand, #348f41);
  }

  :global(.quote-line__toggle[aria-expanded='true']) {
    color: var(--color-brand, #348f41);
    border-color: var(--color-brand, #348f41);
    background-color: rgba(52, 143, 65, 0.08);
  }

  :global(.quote-line__toggle[aria-expanded='true'] svg) {
    transform: rotate(180deg);
  }

  :global(.quote-line__toggle:focus-visible),
  :global(.quote-line__remove:focus-visible) {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  :global(.quote-line__remove:hover),
  :global(.quote-line__remove:focus-visible) {
    color: #fff;
    background-color: var(--color-danger, #c0392b);
    border-color: var(--color-danger, #c0392b);
  }

  :global(.quote-line__panel[hidden]) {
    display: none;
  }

  :global(.quote-line__panel-inner) {
    padding: 4px 16px 18px;
    border-top: 1px solid var(--color-line, #e2e4e5);
    background-color: var(--color-surface-alt, #f6f7f8);
  }

  :global(.quote-line__grid) {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.875rem;
    padding-top: 14px;
  }

  @media (min-width: 640px) {
    :global(.quote-line__grid) {
      grid-template-columns: 1fr 1fr;
    }
  }

  :global(.quote-line__field) {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  :global(.quote-line__field--full) {
    grid-column: 1 / -1;
  }

  :global(.quote-line__field label),
  :global(.quote-line__address-label),
  :global(.quote-line__transport-group legend) {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-ink-700, #3a3d3e);
  }

  :global(.quote-line__field input),
  :global(.quote-line__field select),
  :global(.quote-line__field textarea) {
    font-family: var(--font-body, 'Bliss Pro', sans-serif);
    font-size: 0.95rem;
    color: var(--color-ink, #242627);
    background-color: var(--color-surface, #fff);
    border: 1px solid var(--color-line, #e2e4e5);
    border-radius: 8px;
    padding: 0.55rem 0.625rem;
  }

  :global(.quote-line__field input:focus),
  :global(.quote-line__field select:focus),
  :global(.quote-line__field textarea:focus) {
    outline: 2px solid var(--color-brand, #348f41);
    outline-offset: 2px;
    border-color: var(--color-brand, #348f41);
  }

