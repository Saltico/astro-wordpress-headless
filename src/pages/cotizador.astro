---
// src/pages/cotizador.astro
// Página del cotizador convertida en wizard de 3 pasos.
// El hero se retiró: la superficie compacta del wizard + header brand
// estabilizan el navbar sin competir visualmente con el contenido.

import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import SectionLayout from '@/components/ui/SectionLayout.astro';
import QuoteWizard from '@/components/quote/QuoteWizard.astro';
import QuoteStepSelect from '@/components/quote/QuoteStepSelect.astro';
import QuoteCompanyForm from '@/components/quote/QuoteCompanyForm.astro';
import QuoteReview from '@/components/quote/QuoteReview.astro';
import { getSiteUrl } from '@/lib/seo';

const title = 'Cotizador en línea | IP Proyectos Industriales';
const description =
  'Cotiza equipos industriales en 3 pasos: selecciona equipos, ingresa los datos de tu empresa y envía tu cotización por WhatsApp.';
const canonical = getSiteUrl('/cotizador');
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  noindex={true}
  headerVariant="brand"
  pageType="quote_wizard"
  pageCategory="cotizador"
  siteSection="quote"
>
  <SectionLayout spacing="md" alt>
    <Container wide>
      <QuoteWizard>
        <QuoteStepSelect slot="step-1" />
        <QuoteCompanyForm slot="step-2" />
        <QuoteReview slot="step-3" />
      </QuoteWizard>
    </Container>
  </SectionLayout>
</BaseLayout>
