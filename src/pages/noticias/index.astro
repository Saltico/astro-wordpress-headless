---
// src/pages/noticias/index.astro
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import SectionLayout from '@/components/ui/SectionLayout.astro';
import { collectionPageSchema } from '@/lib/seo';
import { getSiteUrl } from '@/lib/seo';

const title = 'Noticias | IP Proyectos Industriales';
const description =
  'Últimas noticias, proyectos y novedades de IP Proyectos Industriales.';

const breadcrumbs = [
  { label: 'Inicio', url: '/' },
  { label: 'Noticias' },
];
---

<BaseLayout
  title={title}
  description={description}
  breadcrumbs={breadcrumbs}
  jsonLd={collectionPageSchema('Noticias', getSiteUrl('/noticias'))}
>
  <SectionLayout spacing="lg">
    <Container>
      <h1>Noticias</h1>
      <p>Hub de noticias y comunicaciones.</p>
      <ul>
        <li><a href="/noticias/nuevo-proyecto-minera">Nuevo proyecto en minería</a></li>
      </ul>
    </Container>
  </SectionLayout>
</BaseLayout>

<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  a {
    color: var(--color-brand);
    font-weight: 500;
  }

  a:hover,
  a:focus {
    text-decoration: underline;
  }
</style>
