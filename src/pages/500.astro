---
// src/pages/500.astro
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import SectionLayout from '@/components/ui/SectionLayout.astro';
import Button from '@/components/ui/Button.astro';

// TODO: cuando se configure el adapter SSR (Fase 3), cambiar a prerender = false
// export const prerender = false;

const title = 'Error del servidor | IP Proyectos Industriales';
const description = 'Ha ocurrido un error inesperado. Por favor, inténtalo de nuevo más tarde.';
---

<BaseLayout title={title} description={description} noindex>
  <SectionLayout spacing="lg">
    <Container>
      <h1>500 — Error del servidor</h1>
      <p>Ha ocurrido un error inesperado. Por favor, inténtalo de nuevo más tarde.</p>
      <div class="error-page__action">
        <Button href="/" variant="primary">Volver al inicio</Button>
      </div>
    </Container>
  </SectionLayout>
</BaseLayout>

<style>
  .error-page__action {
    margin-top: var(--space-6);
  }
</style>
