---
// src/pages/seguridad.astro
// Página de Seguridad/HSEC

import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import SplitSection from '@/components/ui/SplitSection.astro';
import Breadcrumbs from '@/components/seo/Breadcrumbs.astro';
import Icon from '@/components/ui/Icon.astro';
import StatsCounter from '@/components/ui/StatsCounter.astro';
import Button from '@/components/ui/Button.astro';
import type { StatItem } from '@/components/ui/StatsCounter.astro';
import montajesImg from '@/assets/imgs/montajes.jpg';
import edificioImg from '@/assets/imgs/edificio.jpg';

const title = 'Seguridad | HSEC — IP Proyectos Industriales';
const description = 'Seguridad, salud y medio ambiente. El cuidado de las personas es nuestro primer estándar.';

const miniStats: StatItem[] = [
  { value: 460000, label: 'Horas hombre trabajadas', prefix: '+', prefixPosition: 'before' },
  { value: '0,93%', label: 'Tasa de cotización (R12)' },
  { value: 'Bajo', label: 'Riesgo psicosocial' },
];

const pilares = [
  {
    icon: 'shield',
    title: 'Seguridad',
    description: 'Protocolos reforzados, EPP certificado y capacitación continua para cada faena.',
  },
  {
    icon: 'certificate',
    title: 'Salud',
    description: 'Vigilancia médica preventiva y programas de bienestar para nuestros colaboradores.',
  },
  {
    icon: 'check',
    title: 'Medio Ambiente',
    description: 'Gestión responsable de residuos, emisiones y recursos naturales en cada proyecto.',
  },
  {
    icon: 'warning',
    title: 'Calidad',
    description: 'Sistemas de gestión integrados con mejora continua y auditorías periódicas.',
  },
];

const breadcrumbs = [
  { label: 'Empresa', url: '/' },
  { label: 'Seguridad', url: '/seguridad' },
];
---

<BaseLayout
  title={title}
  description={description}
  breadcrumbs={breadcrumbs}
  pageType="contact"
  pageCategory="seguridad"
  siteSection="safety"
>
  <!-- Hero con breadcrumbs integrados -->
  <section class="safety-hero">
    <img
      src={montajesImg.src}
      alt="Operación minera con estándares de seguridad y EPP, sistema HSEC de IP Proyectos Industriales"
      class="safety-hero__bg"
      width={montajesImg.width}
      height={montajesImg.height}
      loading="eager"
      fetchpriority="high"
    />
    <div class="safety-hero__overlay"></div>
    <div class="safety-hero__container">
      <Breadcrumbs items={breadcrumbs} variant="hero" />
      <p class="safety-hero__eyebrow">Seguridad, salud y medio ambiente</p>
      <h1 class="safety-hero__title">El cuidado de las personas es nuestro primer estándar</h1>
      <p class="safety-hero__subtitle">Contamos con un Departamento de Prevención de Riesgos y Medio Ambiente propio, y un Sistema de Gestión HSEC que respalda cada faena.</p>
    </div>
  </section>

  <!-- Mini Stats -->
  <StatsCounter
    stats={miniStats}
    variant="dark"
    layout="horizontal"
    columns={3}
    animated={true}
    showDividers={true}
  />

  <!-- Pilares -->
  <section class="safety-pillars">
    <Container>
      <div class="safety-pillars__header">
        <p class="safety-pillars__eyebrow">Nuestros pilares</p>
        <h2 class="safety-pillars__title">Un sistema integral de gestión</h2>
        <p class="safety-pillars__subtitle">Cada proyecto se ejecuta bajo un marco riguroso que prioriza la seguridad de las personas, la salud de nuestros colaboradores y el cuidado del medio ambiente.</p>
      </div>

      <div class="safety-pillars__grid">
        {pilares.map((pilar) => (
          <article class="pillar-card">
            <div class="pillar-card__icon">
              <Icon name={pilar.icon as any} size={32} />
            </div>
            <h3 class="pillar-card__title">{pilar.title}</h3>
            <p class="pillar-card__description">{pilar.description}</p>
          </article>
        ))}
      </div>
    </Container>
  </section>

  <!-- Split Section -->
  <SplitSection
    eyebrow="Cultura de seguridad"
    title="Formación continua y liderazgo visible"
    description="Nuestro equipo participa en capacitaciones semanales, charlas de 5 minutos y simulacros periódicos. El liderazgo visible en terreno es un pilar fundamental de nuestra cultura HSEC."
    image={edificioImg.src}
    imageAlt="Equipo de IP Proyectos Industriales en formación de seguridad HSEC"
    imageWidth={edificioImg.width}
    imageHeight={edificioImg.height}
    variant="default"
    background="dark"
  />

  <!-- Formulario de contacto -->
  <section class="safety-form-section">
    <!-- Background image -->
    <img
      src={edificioImg.src}
      alt="Sistema de gestión HSEC de IP Proyectos Industriales"
      class="safety-form-section__bg"
      width={edificioImg.width}
      height={edificioImg.height}
      loading="lazy"
      decoding="async"
    />
    <div class="safety-form-section__overlay"></div>
    
    <Container>
      <div class="safety-form-wrapper">
        <!-- Texto informativo -->
        <div class="safety-form-info">
          <p class="safety-form-info__eyebrow">¿Quieres saber más?</p>
          <h2 class="safety-form-info__title">Conoce nuestro sistema de gestión</h2>
          <p class="safety-form-info__subtitle">
            Contamos con un Departamento de Prevención de Riesgos y Medio Ambiente propio, y un Sistema de Gestión HSEC que respalda cada faena. Nuestro compromiso es con la seguridad de las personas y el cuidado del medio ambiente.
          </p>
          <div class="safety-form-info__features">
            <div class="safety-info-feature">
              <Icon name="shield" size={24} />
              <span>Seguridad certificada</span>
            </div>
            <div class="safety-info-feature">
              <Icon name="check" size={24} />
              <span>Gestión responsable</span>
            </div>
            <div class="safety-info-feature">
              <Icon name="certificate" size={24} />
              <span>Cumplimiento normativo</span>
            </div>
          </div>
        </div>

        <!-- Formulario en card con animación -->
        <div class="safety-form-card" data-animate-slide>
          <form class="safety-contact-form" action="/api/contact" method="POST" id="safetyContactForm" novalidate>
            <div class="safety-form-field">
              <label for="safety-name">Nombre *</label>
              <input type="text" id="safety-name" name="name" placeholder="Tu nombre completo" required>
            </div>

            <div class="safety-form-row">
              <div class="safety-form-field">
                <label for="safety-email">E-mail *</label>
                <input type="email" id="safety-email" name="email" placeholder="tu@correo.cl" required>
              </div>

              <div class="safety-form-field">
                <label for="safety-phone">Teléfono *</label>
                <input type="tel" id="safety-phone" name="phone" placeholder="+56 9 ..." required>
              </div>
            </div>

            <div class="safety-form-field">
              <label for="safety-reason">Motivo *</label>
              <input type="text" id="safety-reason" name="reason" placeholder="Ej: Consulta sobre política HSEC, denuncia, certificación..." required>
            </div>

            <div class="safety-form-field">
              <label for="safety-message">Consulta *</label>
              <textarea id="safety-message" name="message" rows="4" placeholder="Cuéntanos en qué podemos ayudarte..." required></textarea>
            </div>

            <!-- Feedback message -->
            <div class="safety-form-feedback" id="safetyFormFeedback" role="alert" aria-live="polite" hidden></div>

            <div class="safety-form-actions">
              <Button type="submit" variant="primary" size="lg" id="safetySubmitBtn">
                <span id="safetySubmitText">Enviar mensaje</span>
                <span id="safetySubmitLoading" hidden>Enviando...</span>
              </Button>
            </div>
          </form>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .safety-hero {
    position: relative;
    margin-top: calc(-1 * (var(--topbar-height, 40px) + var(--header-height, 80px)));
    min-height: calc(320px + var(--topbar-height, 40px) + var(--header-height, 80px));
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }

  .safety-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .safety-hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      180deg,
      rgba(13, 22, 17, 0.3) 0%,
      rgba(13, 22, 17, 0.7) 60%,
      rgba(13, 22, 17, 0.95) 100%
    );
  }

  .safety-hero__container {
    position: relative;
    z-index: 2;
    max-width: var(--container-max-width);
    width: 100%;
    margin-inline: auto;
    padding: calc(var(--topbar-height, 40px) + var(--header-height, 80px) + 32px)
    var(--container-padding, 20px) 56px;
  }

  .safety-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--color-brand-300, #4ade80);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 16px;
  }

  .safety-hero__eyebrow::before {
    content: '';
    width: 42px;
    height: 2px;
    background: var(--color-brand, #1a9c4a);
  }

  .safety-hero__title {
    color: var(--color-on-dark);
    font-family: var(--font-heading);
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -0.02em;
    font-size: clamp(2rem, 5vw, 3.5rem);
    max-width: 18ch;
    margin: 0 0 16px;
  }

  .safety-hero__subtitle {
    color: rgba(255, 255, 255, 0.85);
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    max-width: 60ch;
    margin: 0;
    line-height: 1.5;
  }

  /* Pillars */
  .safety-pillars {
    background-color: var(--theme-bg);
    padding-block: clamp(60px, 8vw, 100px);
  }

  .safety-pillars__header {
    text-align: center;
    max-width: 60ch;
    margin: 0 auto 50px;
  }

  .safety-pillars__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--theme-eyebrow);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 16px;
    justify-content: center;
  }

  .safety-pillars__eyebrow::before {
    content: '';
    width: 42px;
    height: 2px;
    background: var(--color-brand, #1a9c4a);
  }

  .safety-pillars__title {
    color: var(--theme-heading);
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(1.8rem, 3.4vw, 2.8rem);
    letter-spacing: -0.02em;
    margin: 0 0 16px;
  }

  .safety-pillars__subtitle {
    color: var(--theme-text-muted);
    font-size: 1.05rem;
    line-height: 1.6;
    margin: 0;
  }

  .safety-pillars__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  @media (max-width: 900px) {
    .safety-pillars__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .safety-pillars__grid {
      grid-template-columns: 1fr;
    }
  }

  .pillar-card {
    background: var(--theme-bg-elevated);
    border: 1px solid var(--theme-border);
    border-radius: 12px;
    padding: 30px 24px;
    text-align: center;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .pillar-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-brand-700, #15803d);
  }

  .pillar-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 60px;
    height: 60px;
    background: var(--theme-bg-alt);
    border-radius: 50%;
    color: var(--theme-eyebrow);
    margin-bottom: 20px;
  }

  .pillar-card__title {
    color: var(--theme-text);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.2rem;
    margin: 0 0 12px;
  }

  .pillar-card__description {
    color: var(--theme-text-muted);
    font-size: 0.95rem;
    line-height: 1.5;
    margin: 0;
  }

  /* Form Section */
  .safety-form-section {
    position: relative;
    padding-block: clamp(80px, 10vw, 120px);
    overflow: hidden;
  }

  .safety-form-section__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .safety-form-section__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      135deg,
      rgba(13, 22, 17, 0.92) 0%,
      rgba(13, 22, 17, 0.85) 50%,
      rgba(13, 22, 17, 0.78) 100%
    );
  }

  .safety-form-wrapper {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .safety-form-wrapper {
      grid-template-columns: 1fr 1fr;
      gap: 60px;
    }
  }

  /* Info Panel (texto informativo) */
  .safety-form-info {
    color: var(--color-on-dark);
  }

  .safety-form-info__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--color-brand-300, #62bb74);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 16px;
  }

  .safety-form-info__eyebrow::before {
    content: '';
    width: 42px;
    height: 2px;
    background: currentColor;
  }

  .safety-form-info__title {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    letter-spacing: -0.02em;
    color: var(--color-on-dark);
    margin: 0 0 20px;
    line-height: 1.15;
  }

  .safety-form-info__subtitle {
    margin: 0 0 32px;
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.6;
  }

  .safety-form-info__features {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .safety-info-feature {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--color-on-dark);
    font-size: 1rem;
    font-weight: 500;
  }

  .safety-info-feature :global(svg) {
    color: var(--color-brand-300, #62bb74);
    flex-shrink: 0;
  }

  /* Form Card (con animación) */
  .safety-form-card {
    background: var(--color-graphite, #0d1611);
    border: 1px solid var(--theme-border);
    border-radius: 18px;
    padding: clamp(28px, 4vw, 44px);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
    
    /* Animación inicial: oculto */
    opacity: 0;
    transform: translateX(60px);
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .safety-form-card.is-visible {
    opacity: 1;
    transform: translateX(0);
  }

  /* Contact Form */
  .safety-contact-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .safety-form-field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .safety-form-field label {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--color-on-dark);
  }

  .safety-form-field input,
  .safety-form-field textarea,
  .safety-form-field select {
    padding: 12px 16px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 8px;
    color: var(--color-on-dark);
    font-family: var(--font-body);
    font-size: 1rem;
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .safety-form-field input::placeholder,
  .safety-form-field textarea::placeholder {
    color: rgba(255, 255, 255, 0.4);
  }

  .safety-form-field input:focus,
  .safety-form-field textarea:focus,
  .safety-form-field select:focus {
    outline: none;
    border-color: var(--color-brand, #308f40);
    background: rgba(255, 255, 255, 0.08);
  }

  .safety-form-field textarea {
    resize: vertical;
    min-height: 100px;
  }

  .safety-form-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }

  @media (min-width: 640px) {
    .safety-form-row {
      grid-template-columns: 1fr 1fr;
    }
  }

  .safety-form-actions {
    display: flex;
    gap: 16px;
    margin-top: 8px;
  }

  /* Feedback message */
  .safety-form-feedback {
    padding: 14px 18px;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 500;
    line-height: 1.5;
    display: none;
  }

  .safety-form-feedback[hidden] {
    display: none;
  }

  .safety-form-feedback:not([hidden]) {
    display: block;
  }

  .safety-form-feedback--success {
    background: rgba(26, 156, 74, 0.15);
    border: 1px solid rgba(26, 156, 74, 0.4);
    color: #62bb74;
  }

  .safety-form-feedback--error {
    background: rgba(220, 38, 38, 0.12);
    border: 1px solid rgba(220, 38, 38, 0.35);
    color: #f87171;
  }

  /* Submit button loading state */
  .safety-form-actions button:disabled {
    opacity: 0.65;
    cursor: not-allowed;
  }
</style>

<script>
  // ─────────────────────────────────────────────────────────────
  // Animación de entrada del formulario
  // ─────────────────────────────────────────────────────────────
  document.addEventListener('DOMContentLoaded', () => {
    const formCard = document.querySelector('[data-animate-slide]');
    if (formCard) {
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (prefersReducedMotion) {
        formCard.classList.add('is-visible');
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                setTimeout(() => formCard.classList.add('is-visible'), 200);
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.2, rootMargin: '0px 0px -100px 0px' }
        );
        observer.observe(formCard);
      }
    }

    // ─────────────────────────────────────────────────────────
    // AJAX form submission
    // ─────────────────────────────────────────────────────────
    const form = document.getElementById('safetyContactForm') as HTMLFormElement | null;
    if (!form) return;

    const feedback = document.getElementById('safetyFormFeedback') as HTMLDivElement | null;
    const submitBtn = document.getElementById('safetySubmitBtn') as HTMLButtonElement | null;
    const submitText = document.getElementById('safetySubmitText') as HTMLSpanElement | null;
    const submitLoading = document.getElementById('safetySubmitLoading') as HTMLSpanElement | null;

    /** Muestra un mensaje de feedback con la variante indicada. */
    function showFeedback(message: string, variant: 'success' | 'error'): void {
      if (!feedback) return;
      feedback.textContent = message;
      feedback.className = `safety-form-feedback safety-form-feedback--${variant}`;
      feedback.removeAttribute('hidden');
    }

    /** Oculta el mensaje de feedback. */
    function hideFeedback(): void {
      if (!feedback) return;
      feedback.setAttribute('hidden', '');
      feedback.className = 'safety-form-feedback';
    }

    /** Activa/desactiva el estado de carga del botón. */
    function setLoading(loading: boolean): void {
      if (!submitBtn || !submitText || !submitLoading) return;
      submitBtn.disabled = loading;
      submitText.hidden = loading;
      submitLoading.hidden = !loading;
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      hideFeedback();

      // Validación básica del lado cliente
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      // Tracking: intento de envío de formulario de contacto
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({
        event: 'contact_form_submit',
        form_id: 'safety_contact',
        page_url: location.pathname,
      });

      setLoading(true);

      try {
        const formData = new FormData(form);
        const data = Object.fromEntries(formData.entries());

        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });

        const result = await response.json();

        if (response.ok && result.success) {
          // Tracking: éxito de formulario de contacto (conversión secundaria)
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({
            event: 'contact_form_success',
            form_id: 'safety_contact',
          });
          showFeedback(result.message || 'Mensaje enviado correctamente. Te contactaremos pronto.', 'success');
          form.reset();
        } else {
          // Tracking: error de API en formulario de contacto
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({
            event: 'contact_form_error',
            form_id: 'safety_contact',
            error_type: 'api_error',
          });
          const errorMsg = result.errors
            ? Object.values(result.errors).join(' ')
            : result.message || 'Error al enviar el mensaje. Por favor intenta nuevamente.';
          showFeedback(errorMsg, 'error');
        }
      } catch {
        // Tracking: error de red en formulario de contacto
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({
          event: 'contact_form_error',
          form_id: 'safety_contact',
          error_type: 'network_error',
        });
        showFeedback('Error de conexión. Por favor verifica tu internet e intenta nuevamente.', 'error');
      } finally {
        setLoading(false);
      }
    });
  });
</script>
