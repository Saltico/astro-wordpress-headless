---

<BaseLayout
  title={title}
  description={description}
  breadcrumbs={[
    { label: 'Inicio', url: '/' },
    { label: 'Proyectos', url: '/proyectos' },
  ]}
>
  <!-- Hero -->
  <HeroSection
    title="Construyendo el futuro, un proyecto a la vez"
    subtitle="Descubrí nuestras obras más emblemáticas y cómo transformamos ideas en realidades con ingeniería de excelencia."
    backgroundImage={heroImg.src}
    eyebrow="Nuestros proyectos"
    variant="left"
    minHeight="md"
  />

  <!-- Projects Grid con filtros -->
  <ProjectGrid
    projects={allProjects}
    categories={categories}
    title="Conocé nuestros proyectos"
    subtitle="Explorá nuestras obras organizadas por categoría."
    showFilters={true}
    showLoadMore={true}
    initialCount={9}
    loadMoreLabel="Ver más proyectos"
    columns={3}
  />

  <!-- CTA Contacto -->
  <ContactSection
    title="¿Tenés un proyecto en mente?"
    subtitle="Contanos los requerimientos de tu faena. Nuestro equipo técnico responderá en menos de 24 horas hábiles con una propuesta ajustada."
    contactInfo={{
      address: 'Región de Coquimbo, Chile',
      phone: '+56 9 0000 0000',
      email: 'contacto@ipproyectosindustriales.cl',
      schedule: 'Lunes a Viernes, 08:00 - 18:00',
    }}
    submitLabel="Solicitar cotización"
    background="alt"
  />
</BaseLayout>
