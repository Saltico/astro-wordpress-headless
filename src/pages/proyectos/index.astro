---
// src/pages/proyectos/index.astro
// Página Proyectos replicando estructura de Tecnisud
// Secciones: Hero → Filtros → Grid de proyectos → CTA contacto

import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroSection from '@/components/ui/HeroSection.astro';
import ProjectGrid from '@/components/ui/ProjectGrid.astro';
import ContactSection from '@/components/ui/ContactSection.astro';
import type { ProjectData } from '@/components/ui/ProjectCard.astro';

import heroImg from '@/assets/imgs/hero.jpg';

const title = 'Proyectos · IP Proyectos Industriales';
const description = 'Conoce nuestros proyectos de ingeniería industrial, montaje y arriendo de maquinaria para la gran minería.';

const categories = [
  'Montaje Industrial',
  'Obras Civiles',
  'Izaje Especializado',
  'Arriendo de Maquinaria',
  'Energía',
  'Infraestructura',
];

const allProjects: ProjectData[] = [
  {
    slug: 'montaje-estructura-metalica',
    title: 'Montaje de Estructura Metálica > 200t',
    client: 'Minera del Valle',
    location: 'Región de Coquimbo',
    category: 'Montaje Industrial',
    image: heroImg.src,
  },
  {
    slug: 'izaje-aerogeneradores',
    title: 'Izaje de 8 Aerogeneradores',
    client: 'Parque Eólico Norte',
    location: 'Región de Coquimbo',
    category: 'Izaje Especializado',
    image: heroImg.src,
  },
  {
    slug: 'desmontaje-molino',
    title: 'Desmontaje y Traslado de Molino',
    client: 'Planta Concentradora',
    location: 'Región de Atacama',
    category: 'Montaje Industrial',
    image: heroImg.src,
  },
  {
    slug: 'montaje-planta-proceso',
    title: 'Montaje de Planta de Proceso',
    client: 'Minera Los Pelambres',
    location: 'Región de Coquimbo',
    category: 'Montaje Industrial',
    image: heroImg.src,
  },
  {
    slug: 'izaje-transformadores',
    title: 'Izaje de Transformadores 150t',
    client: 'Subestación Eléctrica',
    location: 'Región de Atacama',
    category: 'Izaje Especializado',
    image: heroImg.src,
  },
  {
    slug: 'obras-civiles-faena',
    title: 'Obras Civiles en Faena Minera',
    client: 'Minera Carmen de Andacollo',
    location: 'Región de Coquimbo',
    category: 'Obras Civiles',
    image: heroImg.src,
  },
  {
    slug: 'arriendo-grua-500t',
    title: 'Arriendo Grúa Todo Terreno 500t',
    client: 'Constructora ABC',
    location: 'Región de Coquimbo',
    category: 'Arriendo de Maquinaria',
    image: heroImg.src,
  },
  {
    slug: 'montaje-correa-transportadora',
    title: 'Montaje de Correa Transportadora',
    client: 'Minera El Romero',
    location: 'Región de Atacama',
    category: 'Montaje Industrial',
    image: heroImg.src,
  },
  {
    slug: 'obras-civiles-subestacion',
    title: 'Obras Civiles Subestación Eléctrica',
    client: 'Enel Green Power',
    location: 'Región de Coquimbo',
    category: 'Infraestructura',
    image: heroImg.src,
  },
  {
    slug: 'izaje-modulos-mineros',
    title: 'Izaje de Módulos Mineros',
    client: 'Mantención Minera SpA',
    location: 'Región de Coquimbo',
    category: 'Izaje Especializado',
    image: heroImg.src,
  },
  {
    slug: 'arriendo-manipulador-telescopico',
    title: 'Arriendo Manipulador Telescópico',
    client: 'Obras Portuarias',
    location: 'Región de Valparaíso',
    category: 'Arriendo de Maquinaria',
    image: heroImg.src,
  },
  {
    slug: 'montaje-parque-eolico',
