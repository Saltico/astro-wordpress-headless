---
// src/pages/arriendo-maquinaria/[categoria].astro
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import SectionLayout from '@/components/ui/SectionLayout.astro';
import { serviceSchema } from '@/lib/seo';

export function getStaticPaths() {
  return [
    {
      params: { categoria: 'gruas-alto-tonelaje' },
      props: {
        title: 'Grúas Alto Tonelaje en Arriendo | IP Proyectos Industriales',
        description:
          'Arriendo de grúas alto tonelaje para minería. Equipos certificados con operador incluido.',
      },
    },
    {
      params: { categoria: 'equipos-de-izaje' },
      props: {
        title: 'Equipos de Izaje en Arriendo | IP Proyectos Industriales',
        description:
          'Arriendo de equipos de izaje para faenas mineras e industriales.',
      },
    },
  ];
}

const { categoria } = Astro.params;
const { title, description } = Astro.props;

const breadcrumbs = [
  { label: 'Inicio', url: '/' },
  { label: 'Arriendo Maquinaria', url: '/arriendo-maquinaria' },
  { label: categoria as string },
];

const jsonLd = serviceSchema(title.replace(' | IP Proyectos Industriales', ''), description, Astro.url.pathname);
---

<BaseLayout title={title} description={description} breadcrumbs={breadcrumbs} jsonLd={jsonLd}>
  <SectionLayout spacing="lg">
    <Container>
      <h1>{title.replace(' | IP Proyectos Industriales', '')}</h1>
      <p>{description}</p>
      {categoria === 'gruas-alto-tonelaje' && (
        <ul>
          <li><a href="/arriendo-maquinaria/gruas-alto-tonelaje/gruas-grove-gmk">Grúas Grove GMK</a></li>
        </ul>
      )}
    </Container>
  </SectionLayout>
</BaseLayout>

<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  a {
    color: var(--color-brand);
    font-weight: 500;
  }

  a:hover,
  a:focus {
    text-decoration: underline;
  }
</style>
