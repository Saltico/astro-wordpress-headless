---
// src/pages/index.astro
// Homepage B2B para IP Proyectos Industriales.
// Enfasis en conversion: hero con valor claro, carrusel de clientes,
// servicios escaneables, HSEQ, proyectos y CTA de contacto.

import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import SectionLayout from '@/components/ui/SectionLayout.astro';
import TrustBand from '@/components/ui/TrustBand.astro';
import Icon from '@/components/ui/Icon.astro';
import type { IconName } from '@/lib/icons';

import heroImg from '@/assets/imgs/hero.jpg';
import logoCap from '@/assets/logos/logo-cap.svg';
import logoKomatsu from '@/assets/logos/logo-komatsu.svg';
import logoMutual from '@/assets/logos/logo-mutual.svg';
import logoCodelco from '@/assets/logos/logo-codelco.svg';
import logoAdv from '@/assets/logos/logo-adv.png';
import logoMecamin from '@/assets/logos/logo_mecamin.png';

const title = 'IP Proyectos Industriales · Ingeniería e Izaje para la Gran Minería';
const description =
  'Especialistas en obras civiles, montaje industrial y arriendo de maquinaria de alto tonelaje para la gran minería en la Región de Coquimbo. Solicita tu cotización.';

const clientLogos = [
  { src: logoCap.src, alt: 'CAP Minería', width: 140, height: 42 },
  { src: logoKomatsu.src, alt: 'Komatsu', width: 160, height: 42 },
  { src: logoMutual.src, alt: 'Mutual de Seguridad', width: 160, height: 42 },
  { src: logoCodelco.src, alt: 'Codelco', width: 160, height: 42 },
  { src: logoAdv.src, alt: 'ADV', width: 120, height: 42 },
  { src: logoMecamin.src, alt: 'Mecamin', width: 140, height: 42 },
];

const services = [
  {
    icon: 'crane',
    title: 'Montaje Industrial',
    description:
      'Desmontaje, traslado y montaje de equipos críticos para plantas concentradoras, faenas mineras y parques eólicos.',
    link: '/servicios-industriales/montaje-industrial',
  },
  {
    icon: 'shield',
    title: 'Obras Civiles',
    description:
      'Ejecución de obras civiles industriales con altos estándares HSEQ, plazos garantizados y control de costos.',
    link: '/servicios-industriales/obras-civiles',
  },
  {
    icon: 'weight',
    title: 'Arriendo e Izaje',
    description:
      'Grúas de alto tonelaje, manipuladores telescópicos y equipos especializados con operadores certificados.',
    link: '/arriendo-maquinaria',
  },
];

const hseqItems = [
  {
    icon: 'certificate',
    title: 'Certificaciones',
    description: 'Sistemas de gestión validados que respaldan cada proceso de obra.',
  },
  {
    icon: 'shield',
    title: 'Cultura HSEQ',
    description: 'Liderazgo visible, capacitación continua y reporte proactivo de riesgos.',
  },
  {
    icon: 'check',
    title: 'Cumplimiento Legal',
    description: 'Alineación total con normativa minera, seguridad y medioambiente.',
  },
];

const projects = [
  {
    client: 'Minera del Valle',
    location: 'Región de Coquimbo',
    result: 'Montaje de estructura metálica > 200 t',
    link: '/proyectos',
  },
  {
    client: 'Parque Eólico Norte',
    location: 'Región de Coquimbo',
    result: 'Izaje de 8 aerogeneradores',
    link: '/proyectos',
  },
  {
    client: 'Planta Concentradora',
    location: 'Región de Atacama',
    result: 'Desmontaje y traslado de molino',
    link: '/proyectos',
  },
];
---

<BaseLayout title={title} description={description}>
  <!-- Hero -->
  <section class="hero hero--media">
    <div class="hero__media" aria-hidden="true">
      <img
        class="hero__img"
        src={heroImg.src}
        alt="Equipo de IP Proyectos Industriales ejecutando izaje en faena minera"
        width={heroImg.width}
        height={heroImg.height}
        loading="eager"
        fetchpriority="high"
      />
      <div class="hero__overlay"></div>
    </div>
    <div class="hero__inner">
      <Container>
        <div class="hero__grid">
        <div class="hero__content">
          <p class="hero__eyebrow">Especialistas en minería e industria</p>
          <h1 style={{color: 'white'}}>Ingeniería, montaje y arriendo de equipos para la gran minería</h1>
          <p class="hero__lead">
            Empresa chilena con base en la Región de Coquimbo. Ejecutamos obras civiles,
            montaje industrial y arriendo de maquinaria de alto tonelaje con estándares
            HSEQ que la gran minería exige.
          </p>
          <div class="hero__actions">
            <a href="/contacto" class="button button--primary">
              Solicitar cotización
              <Icon name="arrow-right" size={18} />
            </a>
            <a href="/servicios-industriales" class="button button--secondary">Ver servicios</a>
          </div>
          <div class="hero__stats">
            <div class="stat">
              <span class="stat__value">+15</span>
              <span class="stat__label">años de experiencia</span>
            </div>
            <div class="stat">
              <span class="stat__value">+200</span>
              <span class="stat__label">proyectos ejecutados</span>
            </div>

          </div>
        </div>
        <div class="hero__visual" aria-hidden="true">
          <div class="hero__shape hero__shape--1"></div>
          <div class="hero__shape hero__shape--2"></div>
          <div class="hero__shape hero__shape--3"></div>
        </div>
      </div>
    </Container>
    </div>
  </section>

  <!-- Trust band -->
  <TrustBand title="Empresas que confían en nuestro trabajo" logos={clientLogos} />

  <!-- Servicios -->
  <SectionLayout spacing="lg">
    <Container>
      <div class="section-header">
        <p class="section-header__eyebrow">Nuestros servicios</p>
        <h2>Soluciones integrales para faenas mineras e industriales</h2>
        <p class="section-header__lead">
          Unimos ingeniería, equipamiento y gestión HSEQ para entregar resultados
          confiables en cada etapa del proyecto.
        </p>
      </div>

      <div class="service-grid">
        {
          services.map((service) => (
            <article class="service-card">
              <div class="service-card__icon">
                <Icon name={service.icon as IconName} size={32} />
              </div>
              <h3 class="service-card__title">
                <a href={service.link}>{service.title}</a>
              </h3>
              <p class="service-card__description">{service.description}</p>
              <a href={service.link} class="service-card__link">
                Conocer más <Icon name="arrow-right" size={16} />
              </a>
            </article>
          ))
        }
      </div>
    </Container>
  </SectionLayout>

  <!-- Arriendo destacado -->
  <SectionLayout alt spacing="lg">
    <Container>
      <div class="rental-grid">
        <div class="rental__content">
          <p class="section-header__eyebrow">Arriendo de maquinaria</p>
          <h2>Equipos de alto tonelaje con operadores certificados</h2>
          <p class="rental__lead">
            Disponemos de grúas todo terreno, grúas sobre orugas, manipuladores telescópicos
            y equipos de izaje para operaciones críticas en minería e industria.
          </p>
          <ul class="checklist">
            <li>
              <Icon name="check" size={20} /> Mantención preventiva certificada
            </li>
            <li>
              <Icon name="check" size={20} /> Operadores con licencia vigente
            </li>
            <li>
              <Icon name="check" size={20} /> Disponibilidad en terreno 24/7
            </li>
            <li>
              <Icon name="check" size={20} /> Planes de izaje y permisos de trabajo
            </li>
          </ul>
          <div class="rental__actions">
            <a href="/arriendo-maquinaria" class="button button--primary">
              Ver equipos disponibles
              <Icon name="arrow-right" size={18} />
            </a>
            <a href="/contacto" class="button button--secondary">Cotizar arriendo</a>
          </div>
        </div>
        <div class="rental__visual" aria-hidden="true">
          <div class="rental__card">
            <Icon name="crane" size={64} />
            <span class="rental__card-label">Grúas hasta 500 t</span>
          </div>
          <div class="rental__card rental__card--alt">
            <Icon name="weight" size={64} />
            <span class="rental__card-label">Izajes certificados</span>
          </div>
        </div>
      </div>
    </Container>
  </SectionLayout>

  <!-- HSEQ -->
  <SectionLayout spacing="lg">
    <Container>
      <div class="section-header section-header--centered">
        <p class="section-header__eyebrow">HSEQ & Compliance</p>
        <h2>Seguridad, calidad y medioambiente en cada operación</h2>
        <p class="section-header__lead">
          Nuestro compromiso es operar sin incidentes, cumpliendo la normativa y generando
          confianza a nuestros clientes y colaboradores.
        </p>
      </div>

      <div class="hseq-grid">
        {
          hseqItems.map((item) => (
            <article class="hseq-card">
              <div class="hseq-card__icon">
                <Icon name={item.icon as IconName} size={32} />
              </div>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </article>
          ))
        }
      </div>

      <div class="hseq-banner">
        <div class="hseq-banner__stat">
          <span class="hseq-banner__value">0</span>
          <span class="hseq-banner__label">fatalidades</span>
        </div>
        <div class="hseq-banner__divider" aria-hidden="true"></div>
        <div class="hseq-banner__stat">
          <span class="hseq-banner__value">100%</span>
          <span class="hseq-banner__label">personal capacitado</span>
        </div>
        <div class="hseq-banner__divider" aria-hidden="true"></div>
        <div class="hseq-banner__stat">
          <span class="hseq-banner__value">ISO</span>
          <span class="hseq-banner__label">gestión integrada</span>
        </div>
      </div>
    </Container>
  </SectionLayout>

  <!-- Proyectos destacados -->
  <SectionLayout alt spacing="lg">
    <Container>
      <div class="section-header">
        <p class="section-header__eyebrow">Proyectos destacados</p>
        <h2>Resultados concretos para la industria</h2>
      </div>

      <div class="project-grid">
        {
          projects.map((project) => (
            <article class="project-card">
              <div class="project-card__body">
                <p class="project-card__meta">
                  {project.client} · {project.location}
                </p>
                <h3 class="project-card__title">
                  <a href={project.link}>{project.result}</a>
                </h3>
              </div>
              <a href={project.link} class="project-card__link" aria-label={`Ver proyecto ${project.result}`}>
                <Icon name="arrow-right" size={20} />
              </a>
            </article>
          ))
        }
      </div>

      <div class="project-cta">
        <a href="/proyectos" class="button button--secondary button--large">Ver todos los proyectos</a>
      </div>
    </Container>
  </SectionLayout>

  <!-- CTA contacto -->
  <SectionLayout class="cta-section" spacing="lg">
    <Container>
      <div class="cta-box">
        <div class="cta-box__content">
          <h2>Hablemos de tu próximo proyecto</h2>
          <p class="cta-box__lead">
            Cuéntanos los requerimientos de tu faena. Nuestro equipo técnico responderá
            en menos de 24 horas hábiles con una propuesta ajustada.
          </p>
        </div>
        <div class="cta-box__actions">
          <a href="/contacto" class="button button--primary button--large">
            Solicitar cotización ahora
            <Icon name="arrow-right" size={18} />
          </a>
          <div class="cta-box__contact">
            <a href="tel:+56900000000" class="cta-box__channel">
              <Icon name="phone" size={18} />
              <span>+56 9 0000 0000</span>
            </a>
            <a href="mailto:contacto@ipproyectosindustriales.cl" class="cta-box__channel">
              <Icon name="email" size={18} />
              <span>contacto@ipproyectosindustriales.cl</span>
            </a>
          </div>
        </div>
      </div>
    </Container>
  </SectionLayout>

  <script>
    (function () {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      const counters = document.querySelectorAll<HTMLElement>('.stat__value');
      if (!counters.length) return;

      const DURATION = 2000;
      const EASE_OUT_QUART = (t: number) => 1 - Math.pow(1 - t, 4);

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const el = entry.target as HTMLElement;
            const originalText = el.textContent || '';
            const match = originalText.match(/[\d.,]+/);
            if (!match) {
              observer.unobserve(el);
              return;
            }

            const targetValue = parseFloat(match[0].replace(',', '.'));
            const prefix = originalText.substring(0, match.index ?? 0);
            const suffix = originalText.substring((match.index ?? 0) + match[0].length);
            const isInteger = Number.isInteger(targetValue);
            const startTime = performance.now();

            const update = (currentTime: number) => {
              const elapsed = currentTime - startTime;
              const progress = Math.min(elapsed / DURATION, 1);
              const current = targetValue * EASE_OUT_QUART(progress);
              const displayValue = isInteger ? Math.floor(current).toString() : current.toFixed(1);
              el.textContent = prefix + displayValue + suffix;

              if (progress < 1) {
                requestAnimationFrame(update);
              } else {
                el.textContent = originalText;
              }
            };

            requestAnimationFrame(update);
            observer.unobserve(el);
          });
        },
        { threshold: 0.5 }
      );

      counters.forEach((counter) => observer.observe(counter));
    })();
  </script>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    position: relative;
    overflow: hidden;
    background: linear-gradient(135deg, var(--color-surface-alt) 0%, #ffffff 100%);
  }

  .hero--media {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: clamp(42rem, 80vh, 52rem);
    padding-top: calc(var(--header-height) + var(--space-10));
    padding-bottom: var(--space-12);
    color: var(--color-on-brand);
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      180deg,
      rgba(10, 22, 13, 0.7) 0%,
      rgba(10, 22, 13, 0.55) 50%,
      rgba(10, 22, 13, 0.78) 100%
    );
  }

  @media (min-width: 768px) {
    .hero__overlay {
      background: linear-gradient(
        95deg,
        rgba(10, 22, 13, 0.82) 0%,
        rgba(10, 22, 13, 0.55) 45%,
        rgba(10, 22, 13, 0.3) 100%
      );
    }
  }

  .hero__inner {
    position: relative;
    z-index: 2;
  }

  .hero__grid {
    display: grid;
    gap: var(--space-8);
    align-items: center;
  }

  @media (min-width: 1024px) {
    .hero__grid {
      grid-template-columns: 1.1fr 0.9fr;
      gap: var(--space-12);
    }
  }

  .hero__eyebrow {
    display: inline-block;
    margin: 0 0 var(--space-3);
    font-size: var(--text-small);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #a8d6ae;
  }

  .hero h1 {
    margin: 0 0 var(--space-5);
    max-width: 20ch;
    color: var(--color-on-brand);
  }

  .hero--media .hero__lead {
    font-size: var(--text-lead);
    color: rgba(255, 255, 255, 0.88);
    max-width: 60ch;
    margin: 0 0 var(--space-8);
    line-height: 1.55;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-bottom: var(--space-10);
  }

  .hero__stats {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    max-width: 36rem;
  }

  @media (min-width: 480px) {
    .hero__stats {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .stat__value {
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    color: rgba(255, 255, 255, 0.8);
    line-height: 1;
  }

  .stat__label {
    font-size: var(--text-small);
    color: rgba(255, 255, 255, 0.8);
  }

  .hero__visual {
    display: none;
  }

  @media (min-width: 1024px) {
    .hero__visual {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 22rem;
    }
  }

  .hero__shape {
    position: absolute;
    border-radius: var(--radius-lg);
    opacity: 0.12;
  }

  .hero__shape--1 {
    width: 20rem;
    height: 20rem;
    background: var(--color-brand);
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) rotate(15deg);
  }

  .hero__shape--2 {
    width: 14rem;
    height: 14rem;
    background: var(--color-ink-700);
    top: 35%;
    left: 60%;
    transform: translate(-50%, -50%) rotate(-10deg);
  }

  .hero__shape--3 {
    width: 8rem;
    height: 8rem;
    background: var(--color-brand-600);
    bottom: 15%;
    left: 25%;
  }

  .hero__crane {
    position: relative;
    z-index: 1;
    color: rgba(255, 255, 255, 0.85);
    opacity: 0.9;
  }

  /* Buttons */
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    padding: 0.625rem 1.25rem;
    font-weight: 600;
    border-radius: var(--radius-sm);
    transition:
      background-color var(--motion-base) var(--ease-out),
      transform var(--motion-base) var(--ease-out),
      box-shadow var(--motion-base) var(--ease-out);
  }

  .button--large {
    min-height: 3.25rem;
    padding: 0.875rem 1.75rem;
    font-size: var(--text-body);
  }

  .button:hover,
  .button:focus {
    transform: translateY(-2px);
  }

  .button--primary {
    background-color: var(--color-brand);
    color: var(--color-on-brand);
    box-shadow: var(--shadow-sm);
  }

  .button--primary:hover,
  .button--primary:focus {
    background-color: var(--color-brand-600);
    box-shadow: var(--shadow-md);
  }

  .button--secondary {
    background-color: transparent;
    color: var(--color-brand);
    border: 1.5px solid currentColor;
  }

  .button--secondary:hover,
  .button--secondary:focus {
    background-color: var(--color-brand-050);
  }

  /* Section headers */
  .section-header {
    max-width: 60ch;
    margin-bottom: var(--space-10);
  }

  .section-header--centered {
    margin-inline: auto;
    text-align: center;
  }

  .section-header__eyebrow {
    margin: 0 0 var(--space-3);
    font-size: var(--text-small);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-brand);
  }

  .section-header h2 {
    margin: 0 0 var(--space-4);
  }

  .section-header__lead {
    font-size: var(--text-lead);
    color: var(--color-ink-500);
    margin: 0;
    line-height: 1.55;
  }

  /* Service grid */
  .service-grid {
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .service-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .service-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition:
      border-color var(--motion-base) var(--ease-out),
      box-shadow var(--motion-base) var(--ease-out),
      transform var(--motion-base) var(--ease-out);
  }

  .service-card:hover {
    border-color: var(--color-brand-050);
    box-shadow: var(--shadow-lg);
    transform: translateY(-4px);
  }

  .service-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.5rem;
    height: 3.5rem;
    color: var(--color-brand);
    background-color: var(--color-brand-050);
    border-radius: var(--radius-md);
  }

  .service-card__title {
    margin: 0;
    font-size: var(--text-h4);
  }

  .service-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .service-card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .service-card__description {
    color: var(--color-ink-500);
    margin: 0;
    line-height: 1.6;
  }

  .service-card__link {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: auto;
    font-weight: 600;
    color: var(--color-brand);
    text-decoration: none;
  }

  .service-card {
    position: relative;
  }

  /* Rental */
  .rental-grid {
    display: grid;
    gap: var(--space-10);
    align-items: center;
  }

  @media (min-width: 1024px) {
    .rental-grid {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }

  .rental__content h2 {
    margin: 0 0 var(--space-4);
  }

  .rental__lead {
    font-size: var(--text-lead);
    color: var(--color-ink-500);
    margin: 0 0 var(--space-6);
    line-height: 1.55;
  }

  .checklist {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin: 0 0 var(--space-8);
    padding: 0;
    list-style: none;
  }

  .checklist li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-ink-700);
  }

  .checklist li :global(svg) {
    flex-shrink: 0;
    color: var(--color-brand);
  }

  .rental__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .rental__visual {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }

  .rental__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    padding: var(--space-8) var(--space-6);
