---
// src/pages/index.astro
// Homepage rental-first con hero split, stats, servicios con imágenes, catálogo y CTA.

import BaseLayout from '@/layouts/BaseLayout.astro';
import StatsCounter from '@/components/ui/StatsCounter.astro';
import LogoCarousel from '@/components/ui/LogoCarousel.astro';
import CTABand from '@/components/ui/CTABand.astro';
import EquipmentSearch from '@/components/rental/EquipmentSearch.astro';
import CategoryShowcase from '@/components/rental/CategoryShowcase.astro';
// import FeaturedEquipment from '@/components/rental/FeaturedEquipment.astro';
// import CoverageSection from '@/components/ui/CoverageSection.astro';
import type { StatItem } from '@/components/ui/StatsCounter.astro';
import { localBusinessSchema } from '@/lib/seo';
import { siteBrand, siteContact } from '@/data/site';
import Icon from '@/components/ui/Icon.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';

import rentalHero from '@/assets/imgs/hero/arriendo/arriendo.avif';
import servIngenieria from '@/assets/imgs/serv-ingenieria.jpg';
import servConstruccion from '@/assets/imgs/serv-construccion.jpg';
import servMontajes from '@/assets/imgs/serv-montajes.jpg';
import portuaria from '@/assets/imgs/portuaria.jpg';

const title = 'Arriendo de Maquinaria Pesada en el Norte de Chile | IP Proyectos Industriales';
const description = 'Arriendo de grúas, movimiento de tierra, transporte y equipos especiales para minería e industria. Disponibilidad 24/7 en Atacama, Coquimbo y Antofagasta. Cotiza online.';

const jsonLd = localBusinessSchema({
  name: siteBrand.name,
  address: siteContact.address,
  phone: siteContact.phoneMobile,
  email: siteContact.email,
  areaServed: ['Atacama', 'Coquimbo', 'Antofagasta'],
});

// Stats rental-focused
const stats: StatItem[] = [
  {
    value: 25,
    label: 'Años de experiencia',
    prefix: '+',
    prefixPosition: 'before'
  },
  {
    value: 100,
    label: 'Equipos propios',
    prefix: '+',
    prefixPosition: 'before'
  },
  {
    value: 400,
    label: 'Capacidad máxima',
    suffix: 'Tons',
    suffixPosition: 'after'
  },
  {
    value: 24,
    label: 'Disponibilidad',
    suffix: '/7',
    suffixPosition: 'after'
  },
];

// Servicios con imágenes (estilo news cards)
const services = [
  {
    title: 'Ingeniería',
    description: 'Diseño y gestión de proyectos',
    seoText: 'Diseño, planificación y gestión integral de proyectos de ingeniería industrial y minera. Soluciones técnicas a medida con estándares de seguridad y eficiencia para la gran minería del norte de Chile.',
    image: servIngenieria.src,
    imageAlt: 'Equipo de ingeniería industrial en planta minera del norte de Chile',
    url: '/servicios/ingenieria',
  },
  {
    title: 'Construcción',
    description: 'Obras civiles e industriales',
    seoText: 'Ejecución de obras civiles e industriales para los sectores minero, energético e infraestructura. Desde cimentaciones hasta estructuras complejas con altos estándares de calidad y plazos garantizados.',
    image: servConstruccion.src,
    imageAlt: 'Obras civiles e industriales en faena minera',
    url: '/servicios/construccion',
  },
  {
    title: 'Montajes',
    description: 'Electromecánico y estructural',
    seoText: 'Montajes electromecánicos y estructurales para plantas industriales y faenas mineras. Instalación de equipos pesados, tuberías y estructuras de acero con personal certificado.',
    image: servMontajes.src,
    imageAlt: 'Montaje electromecánico de equipos pesados en faena',
    url: '/servicios/montajes',
  },
  {
    title: 'Infraestructura portuaria',
    description: 'Obras marítimas y muelles',
    seoText: 'Construcción y mantención de infraestructura portuaria, muelles y obras marítimas. Experiencia en terminales de embarque, amarres y obras costeras en el norte de Chile.',
    image: portuaria.src,
    imageAlt: 'Infraestructura portuaria y obras marítimas en el norte de Chile',
    url: '/servicios/infraestructura-portuaria',
  },
];

// Clientes
const clientLogos = [
  { src: 'https://ipproyectosindustriales.cl/wp-content/uploads/2025/08/barrick.jpg', alt: 'Barrick' },
  { src: 'https://ipproyectosindustriales.cl/wp-content/uploads/2025/08/cmpchile_logo.jpeg', alt: 'CMP' },
  { src: 'https://ipproyectosindustriales.cl/wp-content/uploads/2024/12/aura.png', alt: 'Aura Minerals' },
  { src: 'https://ipproyectosindustriales.cl/wp-content/uploads/2024/12/minerals.png', alt: 'Minerals' },
  { src: 'https://ipproyectosindustriales.cl/wp-content/uploads/2024/12/aguasvalle.jpg', alt: 'Aguas del Valle' },
  { src: 'https://ipproyectosindustriales.cl/wp-content/uploads/2025/08/cummnins.jpg', alt: 'Cummins' },
  { src: 'https://ipproyectosindustriales.cl/wp-content/uploads/2025/08/famesa.jpg', alt: 'Famesa' },
  { src: 'https://ipproyectosindustriales.cl/wp-content/uploads/2024/12/23.jpg', alt: 'Cliente' },
  { src: 'https://ipproyectosindustriales.cl/wp-content/uploads/2024/12/22.jpg', alt: 'Cliente' },
  { src: 'https://ipproyectosindustriales.cl/wp-content/uploads/2024/12/21.jpg', alt: 'Cliente' },
  { src: 'https://ipproyectosindustriales.cl/wp-content/uploads/2024/12/20.jpg', alt: 'Cliente' },
  { src: 'https://ipproyectosindustriales.cl/wp-content/uploads/2024/12/19.jpg', alt: 'Cliente' },
];
---

<BaseLayout
  title={title}
  description={description}
  jsonLd={jsonLd}
>
  <link slot="head" rel="preload" as="image" href={rentalHero.src} fetchpriority="high" />

  <!-- §1: HERO SPLIT — full-bleed image, text fades into image -->
  <section class="d-hero">
    <!-- Full-bleed background image -->
    <img
      src={rentalHero.src}
      alt="Arriendo de maquinaria pesada para minería e industria en el norte de Chile"
      class="d-hero__bg"
      width={rentalHero.width}
      height={rentalHero.height}
      fetchpriority="high"
      decoding="async"
    />
    <!-- Gradient overlay: dark left → transparent right -->
    <div class="d-hero__overlay" aria-hidden="true"></div>
    
    <div class="d-hero__grid">
      <!-- Lado izquierdo: Texto SEO (se difumina hacia la imagen) -->
      <div class="d-hero__text">
        <h1 class="d-hero__title">Arriendo de equipos y maquinaria para <span>construcción y minería</span></h1>
        <p class="d-hero__subtitle">Grúas de hasta 400 toneladas, movimiento de tierra, transporte y equipos especiales. Disponibilidad 24/7 en Atacama, Coquimbo y Antofagasta.</p>
      </div>
      
      <!-- Lado derecho: Panel de búsqueda -->
      <div class="d-hero__search">
        <div class="d-hero__search-content">
          <p class="d-hero__search-title">Encuentra tu máquina</p>
          <EquipmentSearch />
          <p class="d-hero__search-cta">
            ¿Prefieres cotizar directamente? - 
            <a href="/cotizador" class="d-hero__search-link">
              Ir al cotizador
              <Icon name="arrow-right" size={14} />
            </a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- §2: STATS COUNTER -->
  <StatsCounter
    stats={stats}
    variant="dark"
    layout="horizontal"
    columns={4}
    animated={true}
    duration={1500}
  />

  <!-- §3: SERVICIOS (con imágenes) -->
  <section class="services-section">
    <div class="services-section__container">
      <header class="services-section__header">
        <Eyebrow text="También hacemos" />
        <h2 class="services-section__title">Ingeniería, construcción y montajes industriales</h2>
      </header>
      <div class="services-section__grid">
        {services.map((service) => (
          <a href={service.url} class="service-card">
            <div class="service-card__image">
              <img
                src={service.image}
                alt={service.imageAlt}
                loading="lazy"
                decoding="async"
                width="800"
                height="500"
              />
            </div>
            <div class="service-card__body">
              <h3 class="service-card__title">{service.title}</h3>
              <p class="service-card__seo-text">{service.seoText}</p>
              <span class="service-card__link-cta" aria-hidden="true">
                Conocer más
                <Icon name="arrow-right" size={14} />
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- §4: CLIENT LOGOS -->
  <LogoCarousel
    logos={clientLogos}
    eyebrow="Confían en nosotros"
    title="Empresas que confían en nuestra flota"
    speed="normal"
    backgroundVariant="dark"
    pauseOnHover={true}
  />

  <!-- §5: CATEGORY SHOWCASE -->
  <CategoryShowcase />

  <!-- §6: CTA BAND -->
  <CTABand
    eyebrow="Cotiza tu equipo ahora"
    title="¿Necesitas arrendar maquinaria? Cotiza en minutos"
    backgroundImage={rentalHero.src}
    backgroundAlt="Arriendo de maquinaria pesada para minería e industria"
    backgroundWidth={rentalHero.width}
    backgroundHeight={rentalHero.height}
    buttons={[
      { label: 'Ir al cotizador', href: '/cotizador', variant: 'primary', icon: 'arrow-right', ariaLabel: 'Ir al cotizador en línea' },
      { label: 'Hablar por WhatsApp', href: 'https://wa.me/56965593202?text=Hola%20IP%20Proyectos%20Industriales%2C%20quisiera%20solicitar%20una%20cotizaci%C3%B3n%20de%20arriendo%20de%20equipos.', variant: 'outline', external: true, icon: 'whatsapp' },
    ]}
    contentAlign="center"
    minHeight="md"
  />

  <!-- Secciones comentadas para mantener en el código pero no visibles -->
  <!-- 
  <FeaturedEquipment />
  <CoverageSection />
  -->
</BaseLayout>

<style>
  /* ===== HERO SPLIT — full-bleed image, text fades into image ===== */
  .d-hero {
    position: relative;
    min-height: calc(70svh + var(--topbar-height, 40px) + var(--header-height, 80px));
    margin-top: calc(-1 * (var(--topbar-height, 40px) + var(--header-height, 80px)));
    display: flex;
    align-items: center;
    overflow: visible;
    background-color: var(--color-graphite, #0d1611);
  }

  @media (max-width: 1024px) {
    .d-hero {
      min-height: auto;
      padding-block: calc(var(--topbar-height, 40px) + var(--header-height, 80px) + 40px) 60px;
    }
  }

  /* Full-bleed background image */
  .d-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  /* Gradient overlay: dark left → transparent right (creates the diffusion) */
  .d-hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      90deg,
      rgba(13, 22, 17, 1) 0%,
      rgba(13, 22, 17, 0.97) 25%,
      rgba(13, 22, 17, 0.85) 45%,
      rgba(13, 22, 17, 0.5) 65%,
      rgba(13, 22, 17, 0.15) 85%,
      rgba(13, 22, 17, 0) 100%
    );
  }

  @media (max-width: 1024px) {
    .d-hero__overlay {
      background: linear-gradient(
        180deg,
        rgba(13, 22, 17, 0.4) 0%,
        rgba(13, 22, 17, 0.92) 60%,
        rgba(13, 22, 17, 1) 100%
      );
    }
  }

  /* Grid container for text + search */
  .d-hero__grid {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    max-width: var(--container-max-width, 1360px);
    width: 100%;
    margin-inline: auto;
    min-height: calc(70svh + var(--topbar-height, 40px) + var(--header-height, 80px));
    align-items: center;
  }

  @media (max-width: 1024px) {
    .d-hero__grid {
      grid-template-columns: 1fr;
      min-height: auto;
      gap: 32px;
    }
  }

  /* Left: SEO text - always fully visible */
  .d-hero__text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 80px 0 80px clamp(20px, 3vw, 60px);
  }

  @media (max-width: 1024px) {
    .d-hero__text {
      padding: 40px 20px 0;
    }
  }

  .d-hero__title {
    color: var(--color-on-dark);
    font-family: var(--font-heading);
    font-weight: 900;
    line-height: 0.98;
    letter-spacing: -0.03em;
    font-size: clamp(2.2rem, 5vw, 4.5rem);
    max-width: 18ch;
    text-wrap: balance;
    margin: 0 0 24px;
  }

  .d-hero__title span {
    color: var(--color-brand-300, #62bb74);
    font-weight: 900;
  }

  .d-hero__subtitle {
    color: rgba(255, 255, 255, 0.9);
    font-size: var(--text-lead);
    max-width: 48ch;
    margin: 0;
    line-height: 1.55;
  }

  /* Right: Search panel floating over image */
  .d-hero__search {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px clamp(20px, 3vw, 60px) 40px 0;
  }

  @media (max-width: 1024px) {
    .d-hero__search {
      padding: 0 20px 40px;
    }
  }

  .d-hero__search-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    padding: 32px;
    max-width: 520px;
    width: 100%;
    background: rgba(13, 22, 17, 0.6);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-panel);
  }

  @media (max-width: 1024px) {
    .d-hero__search-content {
      padding: 24px 20px;
      max-width: 100%;
    }
  }

  .d-hero__search-title {
    color: var(--color-on-dark);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: 0.02em;
    margin: 0;
    text-align: center;
  }

  .d-hero__search-cta {
    color: rgba(255, 255, 255, 0.82);
    font-size: var(--text-small);
    margin: 0;
    text-align: center;
    line-height: 1.5;
  }

  .d-hero__search-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--color-brand-300, #62bb74);
    font-weight: 600;
    text-decoration: none;
    transition: gap 0.2s ease;
  }

  .d-hero__search-link:hover {
    gap: 10px;
  }

  /* ===== SERVICIOS (news-card style: image + title + CTA) ===== */
  .services-section {
    padding-block: clamp(56px, 8vw, 100px);
    background-color: var(--theme-bg);
  }

  .services-section__container {
    max-width: var(--container-max-width, 1360px);
    margin-inline: auto;
    padding-inline: var(--container-padding, 20px);
  }

  .services-section__header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: clamp(28px, 4vw, 48px);
  }

  .services-section__title {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: var(--text-h2);
    letter-spacing: -0.02em;
    line-height: 1.12;
    margin: 0;
    color: var(--theme-heading);
    text-wrap: balance;
  }

  .services-section__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  @media (max-width: 1024px) {
    .services-section__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .services-section__grid {
      grid-template-columns: 1fr;
    }
  }

  /* News-card style: entire card is clickable link */
  .service-card {
    display: flex;
    flex-direction: column;
    background: var(--theme-bg-elevated);
    border: 1px solid var(--theme-border);
    border-radius: var(--radius-card);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: transform 0.25s var(--ease-out, ease),
      border-color 0.25s var(--ease-out, ease),
      box-shadow 0.25s var(--ease-out, ease);
  }

  .service-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-brand, #308f40);
    box-shadow: var(--shadow-lg);
  }

  .service-card:focus-visible {
    outline: 2px solid var(--color-brand, #308f40);
    outline-offset: 4px;
  }

  .service-card__image {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background-color: var(--theme-bg);
  }

  .service-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s var(--ease-out, ease);
  }

  .service-card:hover .service-card__image img {
    transform: scale(1.05);
  }

  .service-card__body {
    padding: 18px 20px 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
  }

  .service-card__title {
    color: var(--theme-text);
    font-family: var(--font-heading);
    font-size: var(--text-h5);
    line-height: 1.25;
    font-weight: 700;
    margin: 0;
    letter-spacing: -0.005em;
  }

  .service-card__seo-text {
    color: var(--theme-text-muted, var(--color-ink-600));
    font-size: var(--text-small);
    line-height: 1.55;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .service-card__link-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: auto;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--text-small);
    color: var(--theme-eyebrow);
    transition: color 0.2s var(--ease-out, ease);
  }

  .service-card__link-cta svg {
    transition: transform 0.2s var(--ease-out, ease);
  }

  .service-card:hover .service-card__link-cta svg {
    transform: translateX(4px);
  }
</style>
