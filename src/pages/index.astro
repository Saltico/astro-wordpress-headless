---
// src/pages/index.astro
// Homepage rental-first con search, categorías, featured equipment y cobertura geográfica.

import BaseLayout from '@/layouts/BaseLayout.astro';
import StatsCounter from '@/components/ui/StatsCounter.astro';
import LogoCarousel from '@/components/ui/LogoCarousel.astro';
import CTABand from '@/components/ui/CTABand.astro';
import HeroMedia from '@/components/ui/HeroMedia.astro';
import EquipmentSearch from '@/components/rental/EquipmentSearch.astro';
import CategoryShowcase from '@/components/rental/CategoryShowcase.astro';
import FeaturedEquipment from '@/components/rental/FeaturedEquipment.astro';
import CoverageSection from '@/components/ui/CoverageSection.astro';
import ServicesCompact from '@/components/ui/ServicesCompact.astro';
import type { StatItem } from '@/components/ui/StatsCounter.astro';
import { localBusinessSchema, combineSchemas, organizationSchema, websiteSchema } from '@/lib/seo';
import { siteBrand, siteContact } from '@/data/site';

import rentalHero from '@/assets/imgs/hero/arriendo/arriendo.avif';

const title = 'Arriendo de Maquinaria Pesada en el Norte de Chile | IP Proyectos Industriales';
const description = 'Arriendo de grúas, movimiento de tierra, transporte y equipos especiales para minería e industria. Disponibilidad 24/7 en Atacama, Coquimbo y Antofagasta. Cotiza online.';

const jsonLd = combineSchemas(
  organizationSchema(),
  websiteSchema(),
  localBusinessSchema({
    name: siteBrand.name,
    address: siteContact.address,
    phone: siteContact.phoneMobile,
    email: siteContact.email,
    areaServed: ['Atacama', 'Coquimbo', 'Antofagasta'],
  })
);

// Stats rental-focused
const stats: StatItem[] = [
  {
    value: 25,
    label: 'Años de experiencia',
    prefix: '+',
    prefixPosition: 'before'
  },
  {
    value: 100,
    label: 'Equipos propios',
    prefix: '+',
    prefixPosition: 'before'
  },
  {
    value: 400,
    label: 'Capacidad máxima',
    suffix: 'Tons',
    suffixPosition: 'after'
  },
  {
    value: 24,
    label: 'Disponibilidad',
    suffix: '/7',
    suffixPosition: 'after'
  },
];

// Clientes
const clientLogos = [
  { src: 'https://ipproyectosindustriales.cl/wp-content/uploads/2025/08/barrick.jpg', alt: 'Barrick' },
  { src: 'https://ipproyectosindustriales.cl/wp-content/uploads/2025/08/cmpchile_logo.jpeg', alt: 'CMP' },
  { src: 'https://ipproyectosindustriales.cl/wp-content/uploads/2024/12/aura.png', alt: 'Aura Minerals' },
  { src: 'https://ipproyectosindustriales.cl/wp-content/uploads/2024/12/minerals.png', alt: 'Minerals' },
  { src: 'https://ipproyectosindustriales.cl/wp-content/uploads/2024/12/aguasvalle.jpg', alt: 'Aguas del Valle' },
  { src: 'https://ipproyectosindustriales.cl/wp-content/uploads/2025/08/cummnins.jpg', alt: 'Cummins' },
  { src: 'https://ipproyectosindustriales.cl/wp-content/uploads/2025/08/famesa.jpg', alt: 'Famesa' },
  { src: 'https://ipproyectosindustriales.cl/wp-content/uploads/2024/12/23.jpg', alt: 'Cliente' },
  { src: 'https://ipproyectosindustriales.cl/wp-content/uploads/2024/12/22.jpg', alt: 'Cliente' },
  { src: 'https://ipproyectosindustriales.cl/wp-content/uploads/2024/12/21.jpg', alt: 'Cliente' },
  { src: 'https://ipproyectosindustriales.cl/wp-content/uploads/2024/12/20.jpg', alt: 'Cliente' },
  { src: 'https://ipproyectosindustriales.cl/wp-content/uploads/2024/12/19.jpg', alt: 'Cliente' },
];
---

<BaseLayout
  title={title}
  description={description}
  jsonLd={jsonLd}
>
  <link slot="head" rel="preload" as="image" href={rentalHero.src} fetchpriority="high" />

  <!-- §1: HERO + SEARCH -->
  <section class="d-hero">
    <HeroMedia
      fallbackImage={rentalHero.src}
      fallbackAlt="Arriendo de maquinaria pesada para minería e industria en el norte de Chile"
      fallbackWidth={rentalHero.width}
      fallbackHeight={rentalHero.height}
      class="d-hero__media"
    />
    <div class="d-hero__overlay"></div>
    <div class="d-hero__container">
      <div class="d-hero__content">
        <p class="d-hero__eyebrow">Arriendo de maquinaria pesada para minería e industria</p>
        <h1 class="d-hero__title">Arriendo de equipos y maquinaria para <span>construcción y minería</span></h1>
        <p class="d-hero__subtitle">Grúas de hasta 400 toneladas, movimiento de tierra, transporte y equipos especiales. Disponibilidad 24/7 en Atacama, Coquimbo y Antofagasta.</p>
        <EquipmentSearch />
      </div>
    </div>
  </section>

  <!-- §2: CATEGORY SHOWCASE -->
  <CategoryShowcase />

  <!-- §3: FEATURED EQUIPMENT -->
  <FeaturedEquipment />

  <!-- §4: STATS COUNTER -->
  <StatsCounter
    stats={stats}
    variant="dark"
    layout="horizontal"
    columns={4}
    animated={true}
    duration={1500}
  />

  <!-- §5: COVERAGE SECTION -->
  <CoverageSection />

  <!-- §6: CLIENT LOGOS -->
  <LogoCarousel
    logos={clientLogos}
    eyebrow="Confían en nosotros"
    title="Empresas que confían en nuestra flota"
    speed="normal"
    backgroundVariant="dark"
    pauseOnHover={true}
  />

  <!-- §7: SERVICES COMPACT -->
  <ServicesCompact />

  <!-- §8: CTA BAND -->
  <CTABand
    eyebrow="Cotiza tu equipo ahora"
    title="¿Necesitas arrendar maquinaria? Cotiza en minutos"
    backgroundImage={rentalHero.src}
    backgroundAlt="Arriendo de maquinaria pesada para minería e industria"
    backgroundWidth={rentalHero.width}
    backgroundHeight={rentalHero.height}
    buttons={[
      { label: 'Ir al cotizador', href: '/cotizador', variant: 'primary', icon: 'arrow-right', ariaLabel: 'Ir al cotizador en línea' },
      { label: 'Hablar por WhatsApp', href: 'https://wa.me/56965593202?text=Hola%20IP%20Proyectos%20Industriales%2C%20quisiera%20solicitar%20una%20cotizaci%C3%B3n%20de%20arriendo%20de%20equipos.', variant: 'outline', external: true, icon: 'whatsapp' },
    ]}
    contentAlign="center"
    minHeight="md"
  />
</BaseLayout>

<style>
  /* ===== HERO ===== */
  .d-hero {
    position: relative;
    min-height: calc(65svh + var(--topbar-height, 40px) + var(--header-height, 80px));
    margin-top: calc(-1 * (var(--topbar-height, 40px) + var(--header-height, 80px)));
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }

  @media (max-width: 1180px) {
    .d-hero {
      min-height: calc(100svh + var(--topbar-height, 40px) + var(--header-height, 72px));
    }
  }

  .d-hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      180deg,
      rgba(13, 22, 17, 0.5) 0%,
      rgba(13, 22, 17, 0.12) 30%,
      rgba(13, 22, 17, 0.5) 60%,
      rgba(13, 22, 17, 0.96) 100%
    );
  }

  .d-hero__container {
    position: relative;
    z-index: 2;
    max-width: var(--container-max-width);
    width: 100%;
    margin-inline: auto;
    padding: 60px var(--container-padding, 20px) clamp(40px, 7vh, 90px);
  }

  .d-hero__content {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .d-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--color-brand-300, #4ade80);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 0;
  }

  .d-hero__eyebrow::before {
    content: '';
    width: 42px;
    height: 2px;
    background: var(--color-brand, #1a9c4a);
  }

  .d-hero__title {
    color: var(--color-on-dark);
    font-family: var(--font-heading);
    font-weight: 900;
    line-height: 0.98;
    letter-spacing: -0.03em;
    font-size: clamp(2.4rem, 6vw, 5.4rem);
    max-width: 16ch;
    text-wrap: balance;
    margin: 0;
  }

  .d-hero__title span {
    color: var(--color-brand-300, #4ade80);
    font-weight: 900;
  }

  .d-hero__subtitle {
    color: rgba(255, 255, 255, 0.86);
    font-size: clamp(1.05rem, 1.5vw, 1.3rem);
    max-width: 54ch;
    margin: 0;
    line-height: 1.55;
  }
</style>
