---
// src/pages/index.astro
// Homepage corporativa de IP Proyectos Industriales.
// Usa los componentes del design system: HeroSection, SplitSection, NewsGrid, etc.

import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroSection from '@/components/ui/HeroSection.astro';
import SplitSection from '@/components/ui/SplitSection.astro';
import StatsCounter from '@/components/ui/StatsCounter.astro';
import LogoCarousel from '@/components/ui/LogoCarousel.astro';
import CTABand from '@/components/ui/CTABand.astro';
import NewsGrid from '@/components/ui/NewsGrid.astro';
import Container from '@/components/ui/Container.astro';
import SectionLayout from '@/components/ui/SectionLayout.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import type { StatItem } from '@/components/ui/StatsCounter.astro';
import { localBusinessSchema } from '@/lib/seo';
import { siteBrand, siteContact, IPRENTAL_URL } from '@/data/site';
import { getLatestNews } from '@/lib/news';

import servIngenieria from '@/assets/imgs/serv-ingenieria.jpg';
import servConstruccion from '@/assets/imgs/serv-construccion.jpg';
import servMontajes from '@/assets/imgs/serv-montajes.jpg';
import portuaria from '@/assets/imgs/portuaria.jpg';
import servIzaje from '@/assets/imgs/serv-izaje.jpg';
import faenaIzaje from '@/assets/imgs/faena-izaje.jpg';
import montajes from '@/assets/imgs/montajes.jpg';
import edificio from '@/assets/imgs/edificio.jpg';

const title = 'IP Proyectos Industriales | Ingeniería, montajes y grúas de alto tonelaje para la minería';
const description = 'IP Proyectos Industriales: ingeniería, construcción, montajes e izajes de alto tonelaje (hasta 400 t) para la gran minería en Atacama y Coquimbo. Conoce nuestra experiencia y contáctanos.';

const jsonLd = localBusinessSchema({
  name: siteBrand.name,
  description: siteBrand.description,
  telephone: siteContact.phoneMobile,
  email: siteContact.email,
  address: {
    streetAddress: siteContact.address,
    addressLocality: 'La Serena',
    addressRegion: 'Coquimbo',
    addressCountry: 'CL',
  },
  areaServed: ['Atacama', 'Coquimbo', 'Antofagasta'],
  url: siteBrand.siteUrl,
});

// Stats corporativos
const stats: StatItem[] = [
  { value: 25, label: 'Años de experiencia', prefix: '+', prefixPosition: 'before' },
  { value: 100, label: 'Equipos propios', prefix: '+', prefixPosition: 'before' },
  { value: 400, label: 'Capacidad de izaje', suffix: 'Tons', suffixPosition: 'after' },
  { value: 5, label: 'Líneas de servicio' },
];

// Servicios para el bento grid
const services = [
  {
    category: 'Ingeniería',
    title: 'Con foco en constructibilidad',
    description: 'Diseño e ingeniería de detalle y gestión integral de proyectos, compras y contratos.',
    image: servIngenieria.src,
    imageAlt: 'Equipo de ingeniería industrial en planta minera',
    url: '/servicios/ingenieria',
  },
  {
    category: 'Construcción',
    title: 'Obras civiles e industriales',
    description: 'Control de calidad en cada etapa: contratos EPC, prefabricados y pinturas especiales.',
    image: servConstruccion.src,
    imageAlt: 'Obras civiles e industriales en faena minera',
    url: '/servicios/construccion',
  },
  {
    category: 'Montajes',
    title: 'Mineros e industriales',
    description: 'Montaje electromecánico y estructural en faena, con foco en seguridad.',
    image: servMontajes.src,
    imageAlt: 'Montaje electromecánico de equipos pesados en faena',
    url: '/servicios/montajes',
  },
  {
    category: 'Infraestructura portuaria',
    title: 'Puertos y terminales',
    description: 'Obras marítimas: muelles, defensas e impermeabilización de piscinas y tranques.',
    image: portuaria.src,
    imageAlt: 'Infraestructura portuaria y obras marítimas en el norte de Chile',
    url: '/servicios/infraestructura-portuaria',
  },
];

// Clientes
const clientLogos = [
  { src: 'https://ipproyectosindustriales.cl/wp-content/uploads/2025/08/barrick.jpg', alt: 'Barrick' },
  { src: 'https://ipproyectosindustriales.cl/wp-content/uploads/2025/08/cmpchile_logo.jpeg', alt: 'CMP' },
  { src: 'https://ipproyectosindustriales.cl/wp-content/uploads/2024/12/aura.png', alt: 'Aura Minerals' },
  { src: 'https://ipproyectosindustriales.cl/wp-content/uploads/2024/12/minerals.png', alt: 'Minerals' },
  { src: 'https://ipproyectosindustriales.cl/wp-content/uploads/2024/12/aguasvalle.jpg', alt: 'Aguas del Valle' },
  { src: 'https://ipproyectosindustriales.cl/wp-content/uploads/2025/08/cummnins.jpg', alt: 'Cummins' },
  { src: 'https://ipproyectosindustriales.cl/wp-content/uploads/2025/08/famesa.jpg', alt: 'Famesa' },
  { src: 'https://ipproyectosindustriales.cl/wp-content/uploads/2024/12/23.jpg', alt: 'Cliente' },
  { src: 'https://ipproyectosindustriales.cl/wp-content/uploads/2024/12/22.jpg', alt: 'Cliente' },
  { src: 'https://ipproyectosindustriales.cl/wp-content/uploads/2024/12/21.jpg', alt: 'Cliente' },
  { src: 'https://ipproyectosindustriales.cl/wp-content/uploads/2024/12/20.jpg', alt: 'Cliente' },
  { src: 'https://ipproyectosindustriales.cl/wp-content/uploads/2024/12/19.jpg', alt: 'Cliente' },
];

// Mini stats HSEC
const hsecStats = [
  { value: '460.000', label: 'Horas hombre trabajadas' },
  { value: '0,93%', label: 'Tasa de cotización (R12)' },
  { value: 'Bajo', label: 'Riesgo psicosocial' },
];

// Obtener noticias (async)
const latestNews = await getLatestNews(3);
---

<BaseLayout
  title={title}
  description={description}
  jsonLd={jsonLd}
>
  <!-- §1: HERO CORPORATIVO -->
  <HeroSection
    title="La pasión y el valor por un trabajo bien hecho"
    subtitle="Ingeniería, construcción, montajes y Rental de equipos. Todo de principio a fin, con una sola empresa."
    backgroundImage={faenaIzaje.src}
    backgroundAlt="Izaje en tándem con grúas de alto tonelaje en faena minera"
    eyebrow="Desde el año 2000 junto a la Gran Minería"
    variant="left"
    minHeight="lg"
    ctaPrimary={{ label: 'Contactar', href: '/contacto' }}
    ctaSecondary={{ label: 'WhatsApp', href: `https://wa.me/${siteContact.whatsappNumber}?text=Hola%20IP%20Proyectos%20Industriales%2C%20quisiera%20conversar%20sobre%20un%20proyecto.` }}
  />

  <!-- §2: STATS COUNTER -->
  <StatsCounter
    stats={stats}
    variant="dark"
    layout="horizontal"
    columns={4}
    animated={true}
    duration={1500}
  />

  <!-- §3: MARQUEE DE SERVICIOS -->
  <div class="service-marquee" aria-hidden="true">
    <div class="service-marquee__track">
      <div class="service-marquee__group">
        <span>Ingeniería</span><i>◆</i>
        <span>Construcción</span><i>◆</i>
        <span>Montajes mineros e industriales</span><i>◆</i>
        <span>Rental de equipos</span><i>◆</i>
      </div>
      <div class="service-marquee__group">
        <span>Ingeniería</span><i>◆</i>
        <span>Construcción</span><i>◆</i>
        <span>Montajes mineros e industriales</span><i>◆</i>
        <span>Rental de equipos</span><i>◆</i>
      </div>
    </div>
  </div>

  <!-- §4: QUIÉNES SOMOS -->
  <SplitSection
    eyebrow="Quiénes somos"
    title="En el corazón de los proyectos industriales más desafiantes"
    description="IP Proyectos Industriales se posiciona como referente en izajes seguros y eficientes, combinando tecnología de vanguardia con un equipo humano de alto nivel. Más de 25 años apoyando a la gran minería de Chile."
    image={faenaIzaje.src}
    imageAlt="Izaje en tándem con grúas de alto tonelaje en faena minera"
    imageWidth={faenaIzaje.width}
    imageHeight={faenaIzaje.height}
    cta={{ label: 'Conocer nuestros servicios', href: '/servicios' }}
    variant="default"
    background="dark"
    ghostText="IP"
  />

  <!-- §5: SERVICIOS (Bento Grid) -->
  <SectionLayout spacing="lg" alt>
    <Container>
      <Eyebrow text="Lo que hacemos" />
      <h2 class="services-heading">Una sola empresa para todo el ciclo de tu proyecto</h2>
      <div class="services-bento">
        {services.map((service) => (
          <article class="service-card reveal">
            <div class="service-card__img">
              <img src={service.image} alt={service.imageAlt} loading="lazy" decoding="async" />
            </div>
            <div class="service-card__body">
              <span class="service-card__cat">{service.category}</span>
              <h3 class="service-card__title">{service.title}</h3>
              <p class="service-card__desc">{service.description}</p>
              <a class="service-card__link" href={service.url}>
                Conocer
                <Icon name="arrow-right" size={16} />
              </a>
            </div>
          </article>
        ))}
        <!-- Tarjeta destacada: Rental de equipos -->
        <article class="service-card service-card--feat reveal">
          <div class="service-card__img">
            <img src={servIzaje.src} alt="Grúas de alto tonelaje en faena minera" loading="lazy" decoding="async" />
          </div>
          <div class="service-card__body">
            <span class="service-card__cat">Rental de equipos</span>
            <h3 class="service-card__title">Grúas de alto tonelaje</h3>
            <p class="service-card__desc">Hasta 400 toneladas. Grúas AT/RT, alza-hombre, camión pluma y manipuladores, con operadores certificados. Más movimiento de tierra, transporte y equipos especiales.</p>
            <a class="service-card__link" href={`${IPRENTAL_URL}/arriendo`} target="_blank" rel="noopener noreferrer">
              Ver flota
              <Icon name="arrow-right" size={16} />
            </a>
          </div>
        </article>
      </div>
    </Container>
  </SectionLayout>

  <!-- §6: SEGURIDAD / HSEC -->
  <SplitSection
    eyebrow="Seguridad, salud y medio ambiente"
    title="El cuidado de las personas es nuestro primer estándar"
    description="Contamos con un Departamento de Prevención de Riesgos y Medio Ambiente propio, y un Sistema de Gestión HSEC que respalda cada faena."
    image={montajes.src}
    imageAlt="Trabajo seguro en faena con EPP"
    imageWidth={montajes.width}
    imageHeight={montajes.height}
    miniStats={hsecStats}
    cta={{ label: 'Conocer Seguridad', href: '/seguridad' }}
    variant="reversed"
    background="dark"
    ghostText="HSEC"
  />

  <!-- §7: CLIENTES -->
  <LogoCarousel
    logos={clientLogos}
    eyebrow="Confían en nosotros"
    title="Empresas líderes de la gran minería"
    subtitle="Más de 25 años apoyando a las empresas más exigentes del sector minero e industrial de Chile."
    speed="normal"
    backgroundVariant="dark"
    pauseOnHover={true}
  />

  <!-- §8: CTA BAND -->
  <CTABand
    eyebrow="Hablemos"
    title="Tu próximo proyecto empieza con una conversación"
    backgroundImage={edificio.src}
    backgroundAlt="Edificio corporativo IP Proyectos Industriales"
    backgroundWidth={edificio.width}
    backgroundHeight={edificio.height}
    buttons={[
      { label: 'Contactar', href: '/contacto', variant: 'primary', icon: 'arrow-right', ariaLabel: 'Ir al formulario de contacto' },
      { label: 'WhatsApp', href: `https://wa.me/${siteContact.whatsappNumber}?text=Hola%20IP%20Proyectos%20Industriales%2C%20quisiera%20conversar%20sobre%20un%20proyecto.`, variant: 'outline', external: true, icon: 'whatsapp' },
    ]}
    contentAlign="center"
    minHeight="md"
  />

  <!-- §9: NOTICIAS -->
  <NewsGrid
    items={latestNews}
    eyebrow="Últimas noticias"
    title="Novedades"
    subtitle="Operaciones, seguridad y crecimiento de nuestra flota. Síguenos para conocer nuestros proyectos más recientes."
    columns={3}
    variant="dark"
  />
</BaseLayout>

<style>
  /* ===== MARQUEE DE SERVICIOS ===== */
  .service-marquee {
    background: var(--color-brand);
    overflow: hidden;
    padding: var(--space-5) 0;
    border-block: 1px solid rgba(0, 0, 0, 0.12);
  }

  .service-marquee__track {
    display: flex;
    width: max-content;
    animation: marquee-scroll 32s linear infinite;
  }

  .service-marquee:hover .service-marquee__track {
    animation-play-state: paused;
  }

  @keyframes marquee-scroll {
    to { transform: translateX(-50%); }
  }

  .service-marquee__group {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    padding-right: var(--space-8);
  }

  .service-marquee__group span {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(1.3rem, 2.6vw, 2.1rem);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-on-brand);
    white-space: nowrap;
  }

  .service-marquee__group i {
    color: rgba(255, 255, 255, 0.55);
    font-style: normal;
  }

  @media (prefers-reduced-motion: reduce) {
    .service-marquee__track { animation: none; }
  }

  /* ===== SERVICIOS (Bento Grid) ===== */
  .services-heading {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: var(--text-h2);
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-6);
    color: var(--theme-heading);
  }

  .services-bento {
    display: grid;
    grid-template-columns: 1fr 1fr 1.12fr;
    gap: var(--space-4);
  }

  .service-card--feat {
    grid-column: 3;
    grid-row: 1 / 3;
  }

  @media (max-width: 860px) {
    .services-bento {
      grid-template-columns: 1fr 1fr;
    }
    .service-card--feat {
      grid-column: 1 / -1;
      grid-row: auto;
    }
  }

  @media (max-width: 560px) {
    .services-bento {
      grid-template-columns: 1fr;
    }
    .service-card--feat {
      grid-column: auto;
    }
  }

  .service-card {
    display: flex;
    flex-direction: column;
    background: var(--theme-bg-elevated);
    border: 1px solid var(--theme-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: transform var(--motion-base) var(--ease-out),
                border-color var(--motion-base) var(--ease-out);
  }

  .service-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-brand);
  }

  .service-card__img {
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .service-card__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--motion-slow) var(--ease-out);
  }

  .service-card:hover .service-card__img img {
    transform: scale(1.05);
  }

  .service-card__body {
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex: 1;
  }

  .service-card__cat {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--text-small);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--theme-eyebrow);
  }

  .service-card__title {
    font-family: var(--font-heading);
    font-size: var(--text-h5);
    line-height: 1.25;
    font-weight: 700;
    margin: 0;
    color: var(--theme-text);
  }

  .service-card__desc {
    color: var(--theme-text-muted);
    font-size: var(--text-small);
    line-height: 1.5;
    margin: 0;
  }

  .service-card__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: auto;
    padding-top: var(--space-3);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--text-small);
    color: var(--theme-eyebrow);
    text-decoration: none;
    transition: gap var(--motion-base) var(--ease-out);
  }

  .service-card__link:hover {
    gap: var(--space-3);
  }
</style>
