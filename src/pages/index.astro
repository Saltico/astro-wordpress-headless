---
// src/pages/index.astro
// Home replicando estructura exacta del diseño final
// https://cute-banoffee-cf39a5.netlify.app/

import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import StatsCounter from '@/components/ui/StatsCounter.astro';
import LogoCarousel from '@/components/ui/LogoCarousel.astro';
import SplitSection from '@/components/ui/SplitSection.astro';
import ServicesGrid from '@/components/ui/ServicesGrid.astro';
import CTABand from '@/components/ui/CTABand.astro';
import NewsGrid from '@/components/ui/NewsGrid.astro';
import HeroMedia from '@/components/ui/HeroMedia.astro';
import Icon from '@/components/ui/Icon.astro';
import type { StatItem } from '@/components/ui/StatsCounter.astro';
import type { ServiceItem } from '@/components/ui/ServicesGrid.astro';
import { getLatestNews } from '@/lib/news';
import { videoSchema } from '@/lib/seo';

import heroVideo from '@/assets/videos/servicios.mp4';
import heroPoster from '@/assets/videos/servicios-poster.jpg';
import servIngenieria from '@/assets/imgs/serv-ingenieria.jpg';
import servConstruccion from '@/assets/imgs/serv-construccion.jpg';
import servMontajes from '@/assets/imgs/serv-montajes.jpg';
import portuaria from '@/assets/imgs/portuaria.jpg';
import servIzaje from '@/assets/imgs/serv-izaje.jpg';
import faenaIzaje from '@/assets/imgs/faena-izaje.jpg';
import edificio from '@/assets/imgs/edificio.jpg';
import montajesImg from '@/assets/imgs/montajes.jpg';

// En Vite/Astro, los videos importados son string URL directa (no objeto { src }).
// Las imágenes, en cambio, devuelven un objeto con { src, width, height }.
const heroVideoUrl = new URL(heroVideo, Astro.site).toString();
const heroPosterUrl = new URL(heroPoster.src, Astro.site).toString();
const heroPosterLocal = heroPoster.src; // ruta procesada por Vite para <link rel="preload">

const title = 'IP Proyectos Industriales | Ingeniería, montajes y grúas de alto tonelaje para la minería';
const description = 'IP Proyectos Industriales: ingeniería, construcción, montajes e izajes de alto tonelaje (hasta 400 t) para la gran minería en Atacama y Coquimbo. Cotiza fácil.';

const videoJsonLd = videoSchema({
  name: 'IP Proyectos Industriales — Servicios de ingeniería y grúas de alto tonelaje',
  description: 'Video institucional de IP Proyectos Industriales mostrando servicios de ingeniería, montajes electromecánicos y arriendo de grúas de alto tonelaje para la gran minería en Chile.',
  thumbnailUrl: heroPosterUrl,
  contentUrl: heroVideoUrl,
  duration: 'PT15.8S',
  width: 1920,
  height: 1080,
});

const ogVideo = {
  url: heroVideoUrl,
  type: 'video/mp4',
  width: 1920,
  height: 1080,
  secureUrl: heroVideoUrl,
};

// Stats configurables como en el diseño final
const stats: StatItem[] = [
  {
    value: 25,
    label: 'Años de experiencia',
    prefix: '+',
    prefixPosition: 'before'
  },
  {
    value: 100,
    label: 'Equipos propios',
    prefix: '+',
    prefixPosition: 'before'
  },
  {
    value: 400,
    label: 'Capacidad de izaje',
    suffix: 'Tons',
    suffixPosition: 'after'
  },
  {
    value: 5,
    label: 'Líneas de servicio'
  },
];

// Servicios en layout bento — imágenes específicas por sección
const services: ServiceItem[] = [
  {
    category: 'Ingeniería',
    title: 'Con foco en constructibilidad',
    subtitle: '',
    description: 'Diseño e ingeniería de detalle y gestión integral de proyectos, compras y contratos.',
    image: servIngenieria.src,
    link: '/servicios/ingenieria',
    linkLabel: 'Conocer',
  },
  {
    category: 'Construcción',
    title: 'Obras civiles e industriales',
    subtitle: '',
    description: 'Control de calidad en cada etapa: contratos EPC, prefabricados y pinturas especiales.',
    image: servConstruccion.src,
    link: '/servicios/construccion',
    linkLabel: 'Conocer',
  },
  {
    category: 'Montajes',
    title: 'Mineros e industriales',
    subtitle: '',
    description: 'Montaje electromecánico y estructural en faena, con foco en seguridad.',
    image: servMontajes.src,
    link: '/servicios/montajes',
    linkLabel: 'Conocer',
  },
  {
    category: 'Infraestructura portuaria',
    title: 'Puertos y terminales',
    subtitle: '',
    description: 'Obras marítimas: muelles, defensas e impermeabilización de piscinas y tranques.',
    image: portuaria.src,
    link: '/servicios/infraestructura-portuaria',
    linkLabel: 'Conocer',
  },
  {
    category: 'Rental de equipos',
    title: 'Grúas de alto tonelaje',
    subtitle: '',
    description: 'Hasta 400 toneladas. Grúas AT/RT, alza-hombre, camión pluma y manipuladores, con operadores certificados. Más movimiento de tierra, transporte y equipos especiales.',
    image: servIzaje.src,
    link: '/arriendo',
    linkLabel: 'Ver flota',
    featured: true,
  },
];

// Clientes
const clientLogos = [
  { src: 'https://ipproyectosindustriales.cl/wp-content/uploads/2025/08/barrick.jpg', alt: 'Barrick' },
  { src: 'https://ipproyectosindustriales.cl/wp-content/uploads/2025/08/cmpchile_logo.jpeg', alt: 'CMP' },
  { src: 'https://ipproyectosindustriales.cl/wp-content/uploads/2024/12/aura.png', alt: 'Aura Minerals' },
  { src: 'https://ipproyectosindustriales.cl/wp-content/uploads/2024/12/minerals.png', alt: 'Minerals' },
  { src: 'https://ipproyectosindustriales.cl/wp-content/uploads/2024/12/aguasvalle.jpg', alt: 'Aguas del Valle' },
  { src: 'https://ipproyectosindustriales.cl/wp-content/uploads/2025/08/cummnins.jpg', alt: 'Cummins' },
  { src: 'https://ipproyectosindustriales.cl/wp-content/uploads/2025/08/famesa.jpg', alt: 'Famesa' },
  { src: 'https://ipproyectosindustriales.cl/wp-content/uploads/2024/12/23.jpg', alt: 'Cliente' },
  { src: 'https://ipproyectosindustriales.cl/wp-content/uploads/2024/12/22.jpg', alt: 'Cliente' },
  { src: 'https://ipproyectosindustriales.cl/wp-content/uploads/2024/12/21.jpg', alt: 'Cliente' },
  { src: 'https://ipproyectosindustriales.cl/wp-content/uploads/2024/12/20.jpg', alt: 'Cliente' },
  { src: 'https://ipproyectosindustriales.cl/wp-content/uploads/2024/12/19.jpg', alt: 'Cliente' },
];

// Noticias (3 más recientes del data store)
const newsItems = await getLatestNews(3);
---

<BaseLayout
  title={title}
  description={description}
  ogVideo={ogVideo}
  videoJsonLd={videoJsonLd}
>
  <link slot="head" rel="preload" as="image" href={heroPosterLocal} fetchpriority="high" />

  <!-- 1. HERO con video de fondo + poster como LCP -->
  <section class="d-hero">
    <HeroMedia
      videoSrc={heroVideo}
      videoPoster={heroPoster.src}
      fallbackImage={heroPoster.src}
      fallbackAlt="Vista aérea de faena minera con grúas de alto tonelaje en operación, IP Proyectos Industriales"
      fallbackWidth={heroPoster.width}
      fallbackHeight={heroPoster.height}
      videoAriaLabel="Video institucional: servicios de ingeniería, montajes y arriendo de grúas de IP Proyectos Industriales para la gran minería"
      class="d-hero__media"
      videoClass="d-hero__bg"
    />
    <div class="d-hero__overlay"></div>
    <div class="d-hero__container">
      <div class="d-hero__content">
        <p class="d-hero__eyebrow">Desde el año 2000 junto a la Gran Minería</p>
        <h1 class="d-hero__title">La pasión y el valor por un <span>trabajo bien hecho</span></h1>
        <p class="d-hero__subtitle">Ingeniería, construcción, montajes y Rental de equipos. Todo de principio a fin, con una sola empresa.</p>
      </div>
    </div>
    <div class="d-hero__scroll">
      <span></span>
      Scroll
    </div>
  </section>

  <!-- 2. STATS COUNTER -->
  <StatsCounter
    stats={stats}
    variant="dark"
    layout="horizontal"
    columns={4}
    animated={true}
    duration={1500}
  />

  <!-- 3. QUIÉNES SOMOS -->
  <SplitSection
    eyebrow="Quiénes somos"
    title="En el corazón de los proyectos industriales más desafiantes"
    description="IP Proyectos Industriales se posiciona como referente en izajes seguros y eficientes, combinando tecnología de vanguardia con un equipo humano de alto nivel. Más de 25 años apoyando a la gran minería de Chile."
    image={faenaIzaje.src}
    imageAlt="Izaje en tándem con grúas de alto tonelaje en faena minera de Atacama, IP Proyectos Industriales"
    imageWidth={faenaIzaje.width}
    imageHeight={faenaIzaje.height}
    cta={{ label: 'Conocer la empresa', href: '/nosotros' }}
    variant="default"
    background="dark"
  />

  <!-- 4. CARRUSEL DE LOGOS -->
  <LogoCarousel
    logos={clientLogos}
    eyebrow="Confían en nosotros"
    title="Empresas líderes de la gran minería y la industria"
    subtitle="Más de dos décadas trabajando con clientes que son referente del sector en Chile."
    speed="normal"
    backgroundVariant="white"
    pauseOnHover={true}
  />

  <!-- 5. SERVICIOS -->
  <ServicesGrid
    eyebrow="Lo que hacemos"
    title="Una sola empresa para todo el ciclo de tu proyecto"
    services={services}
    layout="bento"
    variant="dark"
  />

  <!-- 6. HSEC / SEGURIDAD -->
  <SplitSection
    eyebrow="Seguridad, salud y medio ambiente"
    title="El cuidado de las personas es nuestro primer estándar"
    description="Contamos con un Departamento de Prevención de Riesgos y Medio Ambiente propio, y un Sistema de Gestión HSEC que respalda cada faena."
    image={montajesImg.src}
    imageAlt="Trabajo seguro en faena con EPP, sistema HSEC de IP Proyectos Industriales"
    imageWidth={montajesImg.width}
    imageHeight={montajesImg.height}
    variant="reversed"
    background="dark"
    miniStats={[
      { value: '460.000', label: 'Horas hombre trabajadas' },
      { value: '0,93%', label: 'Tasa de cotización (R12)' },
      { value: 'Bajo', label: 'Riesgo psicosocial' },
    ]}
    cta={{ label: 'Conocer Seguridad', href: '/compliance/hseq' }}
  />

  <!-- 7. CTA BAND -->
  <CTABand
    eyebrow="Cotización rápida"
    title="Tu próximo proyecto empieza con una conversación"
    backgroundImage={edificio.src}
    backgroundAlt="Edificio corporativo de IP Proyectos Industriales en Chile"
    backgroundWidth={edificio.width}
    backgroundHeight={edificio.height}
    buttons={[
      { label: 'Ir al cotizador', href: '/cotizador', variant: 'primary', icon: 'arrow-right', ariaLabel: 'Ir al cotizador en línea' },
      { label: 'Hablar por WhatsApp', href: 'https://wa.me/56965593202?text=Hola%20IP%20Proyectos%20Industriales%2C%20quisiera%20solicitar%20una%20cotizaci%C3%B3n.', variant: 'outline', external: true, icon: 'whatsapp' },
    ]}
    contentAlign="center"
    minHeight="md"
  />

  <!-- 9. NOTICIAS -->
  <NewsGrid
    eyebrow="Blog"
    title="Novedades"
    subtitle="Operaciones, seguridad y crecimiento de nuestra flota. Síguenos para conocer nuestros proyectos más recientes."
    items={newsItems}
    columns={3}
    variant="dark"
  />
</BaseLayout>

<style>
  /* ===== HERO ===== */
  .d-hero {
    position: relative;
    min-height: calc(65svh + var(--topbar-height, 40px) + var(--header-height, 80px));
    margin-top: calc(-1 * (var(--topbar-height, 40px) + var(--header-height, 80px)));
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }

  @media (max-width: 1180px) {
    .d-hero {
      min-height: calc(100svh + var(--topbar-height, 40px) + var(--header-height, 72px));
    }
  }

  .d-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .d-hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      180deg,
      rgba(13, 22, 17, 0.5) 0%,
      rgba(13, 22, 17, 0.12) 30%,
      rgba(13, 22, 17, 0.5) 60%,
      rgba(13, 22, 17, 0.96) 100%
    );
  }

  .d-hero__container {
    position: relative;
    z-index: 2;
    max-width: 1360px;
    width: 100%;
    margin-inline: auto;
    padding: 60px var(--container-padding, 20px) clamp(40px, 7vh, 90px);
  }

  .d-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--color-brand-300, #4ade80);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 20px;
  }

  .d-hero__eyebrow::before {
    content: '';
    width: 42px;
    height: 2px;
    background: var(--color-brand, #1a9c4a);
  }

  .d-hero__title {
    color: #fff;
    font-family: var(--font-heading);
    font-weight: 900;
    line-height: 0.98;
    letter-spacing: -0.03em;
    font-size: clamp(2.4rem, 6vw, 5.4rem);
    max-width: 16ch;
    text-wrap: balance;
    margin: 0;
  }

  .d-hero__title span {
    color: var(--color-brand-300, #4ade80);
    font-weight: 900;
  }

  .d-hero__subtitle {
    color: rgba(255, 255, 255, 0.86);
    font-size: clamp(1.05rem, 1.5vw, 1.3rem);
    max-width: 54ch;
    margin: 24px 0 0;
    line-height: 1.55;
  }

  .d-hero__scroll {
    position: absolute;
    left: 50%;
    bottom: 18px;
    transform: translateX(-50%);
    z-index: 3;
    color: rgba(255, 255, 255, 0.55);
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .d-hero__scroll span {
    width: 1px;
    height: 30px;
    background: linear-gradient(rgba(255, 255, 255, 0.55), transparent);
  }

  @media (max-width: 768px) {
    .d-hero__scroll {
      display: none;
    }
  }
</style>
