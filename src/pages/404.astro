---
// src/pages/404.astro
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import SectionLayout from '@/components/ui/SectionLayout.astro';

const title = 'Página no encontrada | IP Proyectos Industriales';
const description = 'La página que buscas no existe o ha sido movida.';
---

<BaseLayout title={title} description={description} noindex>
  <SectionLayout spacing="lg">
    <Container>
      <h1>404 — Página no encontrada</h1>
      <p>La página que buscas no existe o ha sido movida.</p>
      <a href="/" class="button">Volver al inicio</a>
    </Container>
  </SectionLayout>
</BaseLayout>

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0.625rem 1.25rem;
    margin-top: var(--space-6);
    background-color: var(--color-brand);
    color: var(--color-on-brand);
    font-weight: 600;
    border-radius: var(--radius-sm);
  }
</style>
