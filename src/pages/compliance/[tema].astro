---
// src/pages/compliance/[tema].astro
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import SectionLayout from '@/components/ui/SectionLayout.astro';
import { articleSchema } from '@/lib/seo';

export function getStaticPaths() {
  return [
    {
      params: { tema: 'hseq' },
      props: {
        title: 'HSEQ | IP Proyectos Industriales',
        description:
          'Política de seguridad, salud, medio ambiente y calidad de IP Proyectos Industriales.',
      },
    },
    {
      params: { tema: 'certificaciones' },
      props: {
        title: 'Certificaciones | IP Proyectos Industriales',
        description:
          'Certificaciones y estándares de calidad que respaldan nuestra operación.',
      },
    },
  ];
}

const { tema } = Astro.params;
const { title, description } = Astro.props;
const temaName = (tema as string).replace(/-/g, ' ').replace(/\b\w/g, (l) => l.toUpperCase());

const breadcrumbs = [
  { label: 'Inicio', url: '/' },
  { label: 'Compliance', url: '/compliance' },
  { label: temaName },
];

const jsonLd = articleSchema(temaName, description, Astro.url.pathname);
---

<BaseLayout title={title} description={description} breadcrumbs={breadcrumbs} jsonLd={jsonLd}>
  <SectionLayout spacing="lg">
    <Container>
      <h1>{temaName}</h1>
      <p>{description}</p>
    </Container>
  </SectionLayout>
</BaseLayout>
