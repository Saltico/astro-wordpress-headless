---
// src/pages/compliance/index.astro
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import SectionLayout from '@/components/ui/SectionLayout.astro';

const title = 'Compliance y HSEQ | IP Proyectos Industriales';
const description =
  'Compromiso con la seguridad, el medio ambiente y la calidad. Conoce nuestros estándares HSEQ y compliance.';

const breadcrumbs = [
  { label: 'Inicio', url: '/' },
  { label: 'Compliance' },
];
---

<BaseLayout title={title} description={description} breadcrumbs={breadcrumbs}>
  <SectionLayout spacing="lg">
    <Container>
      <h1>Compliance y HSEQ</h1>
      <p>Hub de documentación sobre seguridad, medio ambiente y calidad.</p>
      <ul>
        <li><a href="/compliance/hseq">HSEQ</a></li>
        <li><a href="/compliance/certificaciones">Certificaciones</a></li>
      </ul>
    </Container>
  </SectionLayout>
</BaseLayout>

<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  a {
    color: var(--color-brand);
    font-weight: 500;
  }

  a:hover,
  a:focus {
    text-decoration: underline;
  }
</style>
