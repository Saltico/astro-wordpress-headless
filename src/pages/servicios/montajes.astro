---
// src/pages/servicios/montajes.astro
import ServiceLayout from '@/layouts/ServiceLayout.astro';
import servMontajes from '@/assets/imgs/serv-montajes.jpg';
---

<ServiceLayout
  title="Montajes mineros e industriales"
  subtitle="Montaje electromecánico y estructural en faena, con foco en seguridad."
  description="Montaje preciso, seguro y a tiempo"
  heroImage={servMontajes.src}
  heroImageAlt="Montaje electromecánico y estructural en planta industrial minera, IP Proyectos Industriales"
  heroImageWidth={servMontajes.width}
  heroImageHeight={servMontajes.height}
  category="Servicios · Montajes"
  includes={[
    'Montaje electromecánico y de equipos mineros.',
    'Pipelines industriales y termofusión en HDPE.',
    'Cortinas y pantallas eólicas.',
    'Montaje de estructuras metálicas.',
  ]}
  breadcrumbs={[
    { label: 'Empresa', url: '/' },
    { label: 'Servicios', url: '/servicios' },
    { label: 'Montajes', url: '/servicios/montajes' },
  ]}
  whatsappMessage="Hola IP, quisiera cotizar montajes."
/>
