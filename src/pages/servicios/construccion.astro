---
// src/pages/servicios/construccion.astro
import ServiceLayout from '@/layouts/ServiceLayout.astro';
import servConstruccion from '@/assets/imgs/serv-construccion.jpg';
---

<ServiceLayout
  title="Obras civiles e industriales"
  subtitle="Construcción industrial con control de calidad en cada etapa, con estándares de la gran minería."
  description="Construcción con estándares de la gran minería"
  heroImage={servConstruccion.src}
  heroImageAlt="Construcción de obras civiles e industriales en faena minera, contratos EPC, IP Proyectos Industriales"
  heroImageWidth={servConstruccion.width}
  heroImageHeight={servConstruccion.height}
  category="Servicios · Construcción"
  includes={[
    'Contratos EPC y obras civiles.',
    'Prefabricados de hormigón y estructuras metálicas.',
    'Granallado ecológico.',
    'Pinturas especiales (Poliurea).',
  ]}
  breadcrumbs={[
    { label: 'Empresa', url: '/' },
    { label: 'Servicios', url: '/servicios' },
    { label: 'Construcción', url: '/servicios/construccion' },
  ]}
  whatsappMessage="Hola IP, quisiera cotizar construcción."
/>
