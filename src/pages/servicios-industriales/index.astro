---
// src/pages/servicios-industriales/index.astro
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import SectionLayout from '@/components/ui/SectionLayout.astro';
import { serviceSchema } from '@/lib/seo';

const title = 'Servicios Industriales | IP Proyectos Industriales';
const description =
  'Servicios industriales para la gran minería: montaje industrial, obras civiles y proyectos llave en mano.';

const breadcrumbs = [
  { label: 'Inicio', url: '/' },
  { label: 'Servicios Industriales' },
];
---

<BaseLayout
  title={title}
  description={description}
  breadcrumbs={breadcrumbs}
  jsonLd={serviceSchema('Servicios Industriales', description, Astro.url.pathname)}
>
  <SectionLayout spacing="lg">
    <Container>
      <h1>Servicios Industriales</h1>
      <p>Hub de servicios industriales para minería.</p>
      <ul>
        <li><a href="/servicios-industriales/montaje-industrial">Montaje Industrial</a></li>
        <li><a href="/servicios-industriales/obras-civiles">Obras Civiles</a></li>
      </ul>
    </Container>
  </SectionLayout>
</BaseLayout>

<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  a {
    color: var(--color-brand);
    font-weight: 500;
  }

  a:hover,
  a:focus {
    text-decoration: underline;
  }
</style>
