# Google Maps Places API key (pública, restringida por dominio en Google Cloud Console)
# Obtén tu clave en: https://console.cloud.google.com/apis/credentials
# Restringe la clave a:
#   - HTTP referrers: https://www.iprental.cl/*, http://localhost:4321/*
#   - APIs habilitadas: Maps JavaScript API, Places API
PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# SMTP Hostinger (privado, solo server-side)
# Configura tu cuenta de correo en Hostinger > Correos > Configuración de cliente
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tu-cuenta@tudominio.com
SMTP_PASS=tu-password

# Configuración de correos para cotizaciones
# Remitente (usar cuenta de correo del dominio en Hostinger)
QUOTE_EMAIL_FROM=cotizaciones@iprental.cl

# Destinatario interno (empresa - notificación de nueva cotización)
QUOTE_EMAIL_TO=matias.castillo@sansano.usm.cl

# Configuración de correos para formulario de contacto (/seguridad)
# Remitente (si no se define, usa QUOTE_EMAIL_FROM)
# CONTACT_EMAIL_FROM=contacto@iprental.cl

# Destinatario interno (notificación de nuevo mensaje de contacto)
# Si no se define, usa QUOTE_EMAIL_TO como fallback
CONTACT_EMAIL_TO=matiicasper@gmail.com

# WordPress REST API Configuration
# URL base de la API REST de WordPress (sin trailing slash)
# Ejemplo: https://ipproyectosindustriales.cl/wp-json
WP_API_URL=https://ipproyectosindustriales.cl/wp-json
