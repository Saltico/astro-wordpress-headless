# Google Maps Places API key (pública, restringida por dominio en Google Cloud Console)
# Obtén tu clave en: https://console.cloud.google.com/apis/credentials
# Restringe la clave a:
#   - HTTP referrers: https://ipproyectosindustriales.cl/*, http://localhost:4321/*
#   - APIs habilitadas: Maps JavaScript API, Places API
PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# Resend API Key (privada, solo server-side)
# Obtén tu clave en: https://resend.com/api-keys
# IMPORTANTE: Reemplaza 're_xxxxxxxxx' con tu API key real de Resend
RESEND_API_KEY=xxxx

# Configuración de correos para cotizaciones
# Remitente (usar dominio verificado en Resend para producción)
# En desarrollo puede usar: onboarding@resend.dev
QUOTE_EMAIL_FROM=onboarding@resend.dev

# Destinatario interno (empresa - notificación de nueva cotización)
QUOTE_EMAIL_TO=matias.castillo@sansano.usm.cl
